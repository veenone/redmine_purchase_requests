<%# filepath: app/views/capex/dashboard.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'capex', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title "#{l(:label_capex_dashboard)} - #{@project.name}" %>

<div class="contextual">
  <%= link_to project_capex_index_path(@project), class: 'pr-button pr-button-cancel pr-button-icon small' do %>
    <span class="icon icon-cancel"><%= l(:label_back_to_capex_list) %></span>
  <% end %>

  <% if User.current.allowed_to?(:view_tpc_codes, @project) %>
    <%= link_to project_tpc_codes_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
      <span class="icon icon-projects"><%= l(:label_tpc_codes) %></span>
    <% end %>
  <% end %>

  <% if User.current.allowed_to?(:manage_capex, @project) %>
    <%= link_to new_project_capex_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
      <span class="icon icon-add"><%= l(:label_new_capex_entry) %></span>
    <% end %>
  <% end %>
</div>

<h2><%= l(:label_capex_dashboard) %> — <%= @current_year %></h2>

<%= render 'shared/dashboard_filters',
      year_mode: :fixed,
      selected_year: @current_year,
      available_years: (2020..2030).to_a,
      available_tpc_codes: @available_tpc_codes,
      selected_tpc_code_id: @selected_tpc_code_id %>

<% if @capex_entries.any? %>
  <!-- Summary Stats -->
  <%
    # One severity vocabulary for the whole page: under 80% healthy, 80-99%
    # approaching, 100%+ over. Drives the meter fill and the Remaining tile so
    # a line at 140% can never render as a full green bar.
    capex_over_budget = @total_remaining.to_f < 0
    capex_severity = capex_over_budget ? 'high' : (@utilization_percentage.to_f >= 80 ? 'medium' : 'low')
  %>
  <% if @totals_unreliable %>
    <div class="pr-alert pr-alert--warning" role="status">
      <strong><%= l(:label_totals_not_comparable) %>.</strong>
      <% if @unconvertible_currencies.any? %>
        <%= l(:text_missing_exchange_rate, currencies: @unconvertible_currencies.join(', ')) %>
      <% else %>
        <%= l(:text_mixed_currency_no_rates) %>
      <% end %>
    </div>
  <% end %>
  <div class="summary-stats">
    <div class="stat-box pr-stat--accent">
      <div class="stat-number stat-currency">
        <% if @use_exchange_rates %>
          <%= capex_currency_symbol(@default_currency) %>
          <%= number_with_precision(@total_budget, precision: 2, delimiter: ',') %>
          <span class="currency-code"><%= @default_currency %></span>
        <% elsif @currency_breakdown.keys.length == 1 %>
          <%= Capex.new(currency: @currency_breakdown.keys.first).currency_symbol %>
          <%= number_with_precision(@total_budget, precision: 2, delimiter: ',') %>
          <span class="currency-code"><%= @currency_breakdown.keys.first %></span>
        <% else %>
          Multi-Currency
        <% end %>
      </div>
      <div class="stat-label">
        <%= l(:label_total_capex_budget) %>
        <% if @use_exchange_rates && @unconvertible_currencies.empty? %>
          <span class="conversion-note">(<%= l(:label_converted_to) %> <%= @default_currency %>)</span>
        <% elsif @unconvertible_currencies.any? %>
          <span class="pr-badge pr-badge--warning"><%= l(:label_rate_not_set) %>: <%= @unconvertible_currencies.join(', ') %></span>
        <% end %>
      </div>
    </div>

    <div class="stat-box pr-stat--success">
      <div class="stat-number stat-currency">
        <% if @use_exchange_rates %>
          <%= capex_currency_symbol(@default_currency) %>
          <%= number_with_precision(@total_utilized, precision: 2, delimiter: ',') %>
          <span class="currency-code"><%= @default_currency %></span>
        <% elsif @currency_breakdown.keys.length == 1 %>
          <%= Capex.new(currency: @currency_breakdown.keys.first).currency_symbol %>
          <%= number_with_precision(@total_utilized, precision: 2, delimiter: ',') %>
          <span class="currency-code"><%= @currency_breakdown.keys.first %></span>
        <% else %>
          Multi-Currency
        <% end %>
      </div>
      <div class="stat-label">
        <%= l(:label_utilized) %><% unless @totals_unreliable %> (<%= @utilization_percentage %>%)<% end %>
        <div class="utilization-bar utilization-bar--inline" aria-hidden="true">
          <div class="utilization-fill <%= capex_severity %>" style="width: <%= [@utilization_percentage.to_f, 100].min %>%"></div>
        </div>
      </div>
    </div>

    <div class="stat-box pr-stat--<%= capex_over_budget ? 'danger' : 'warning' %>">
      <%# Under an "Over budget by" label the figure must be positive: the
          label carries the direction, so the number carries only magnitude. %>
      <div class="stat-number stat-currency stat-currency--<%= capex_over_budget ? 'over' : 'neutral' %>">
        <% if @use_exchange_rates %>
          <%= capex_currency_symbol(@default_currency) %>
          <%= number_with_precision(@total_remaining.to_f.abs, precision: 2, delimiter: ',') %>
          <span class="currency-code"><%= @default_currency %></span>
        <% elsif @currency_breakdown.keys.length == 1 %>
          <%= Capex.new(currency: @currency_breakdown.keys.first).currency_symbol %>
          <%= number_with_precision(@total_remaining.to_f.abs, precision: 2, delimiter: ',') %>
          <span class="currency-code"><%= @currency_breakdown.keys.first %></span>
        <% else %>
          <%= l(:label_multi_currency) %>
        <% end %>
      </div>
      <div class="stat-label">
        <% if capex_over_budget %>
          <%= l(:label_over_budget_by) %>
        <% else %>
          <%= l(:label_remaining) %><% unless @totals_unreliable %> (<%= (100 - @utilization_percentage.to_f).round(2) %>%)<% end %>
        <% end %>
      </div>
    </div>

    <div class="stat-box pr-stat--violet">
      <div class="stat-number"><%= @capex_entries.count %></div>
      <div class="stat-label"><%= l(:label_capex_entries) %></div>
    </div>
  </div>

  <!-- Charts row -->
  <div class="dashboard-container">
    <!-- Budget Utilization Donut -->
    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <h3><%= l(:label_budget_utilization_overview) %></h3>
      </div>
      <div class="dashboard-card-body">
        <% if @totals_unreliable %>
          <%# A donut of unlike units would picture a meaningless sum. Point at
              the per-currency breakdown instead of drawing it. %>
          <p class="nodata"><%= l(:text_mixed_currency_no_rates) %></p>
        <% else %>
        <div class="capex-donut-container">
          <div class="capex-donut" id="utilization-donut-chart" data-chart-label="<%= l(:label_budget_utilization_overview) %>">
            <div class="capex-donut-center">
              <div style="font-weight:700;font-size:14px;"><%= @utilization_percentage %>%</div>
              <div style="font-size:10px;color:var(--pr-ink-muted);"><%= l(:label_utilized) %></div>
            </div>
          </div>
          <div style="flex:1;">
            <table class="dashboard-table">
              <caption class="sr-only"><%= l(:label_caption_budget_utilization) %></caption>
              <tr>
                <td><span class="status-indicator status-utilized"></span><%= l(:label_utilized) %></td>
                <td class="stat-currency">
                  <% if @use_exchange_rates %>
                    <%= capex_currency_symbol(@default_currency) %>
                    <%= number_with_precision(@total_utilized, precision: 2, delimiter: ',') %>
                    (<%= @utilization_percentage %>%)
                  <% elsif @currency_breakdown.keys.length == 1 %>
                    <%= Capex.new(currency: @currency_breakdown.keys.first).currency_symbol %>
                    <%= number_with_precision(@total_utilized, precision: 2, delimiter: ',') %>
                    (<%= @utilization_percentage %>%)
                  <% else %>
                    Multi-Currency (<%= @utilization_percentage %>%)
                  <% end %>
                </td>
              </tr>
              <tr>
                <td><span class="status-indicator status-remaining"></span><%= l(:label_remaining) %></td>
                <td class="stat-currency">
                  <% if @use_exchange_rates %>
                    <%= capex_currency_symbol(@default_currency) %>
                    <%= number_with_precision(@total_remaining, precision: 2, delimiter: ',') %>
                    (<%= (100 - @utilization_percentage).round(2) %>%)
                  <% elsif @currency_breakdown.keys.length == 1 %>
                    <%= Capex.new(currency: @currency_breakdown.keys.first).currency_symbol %>
                    <%= number_with_precision(@total_remaining, precision: 2, delimiter: ',') %>
                    (<%= (100 - @utilization_percentage).round(2) %>%)
                  <% else %>
                    Multi-Currency (<%= (100 - @utilization_percentage).round(2) %>%)
                  <% end %>
                </td>
              </tr>
            </table>
          </div>
        </div>
        <% end %>
      </div>
    </div>

    <!-- Quarterly Distribution Bar -->
    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <h3><%= l(:label_quarterly_distribution) %></h3>
      </div>
      <div class="dashboard-card-body">
        <div class="capex-bar-chart" id="quarterly-bar-chart" data-chart-label="<%= l(:label_quarterly_distribution) %>">
          <!-- bars injected by JS -->
        </div>

        <details class="pr-data-toggle">
          <summary><%= l(:label_view_data_table) %> — <%= l(:label_quarterly_distribution) %></summary>
          <table class="dashboard-table">
            <caption class="sr-only"><%= l(:label_caption_quarterly) %></caption>
            <tr>
              <th scope="col"><%= l(:label_quarter) %></th>
              <th scope="col"><%= l(:label_total_budget) %></th>
            </tr>
            <tr>
              <td>Q1</td>
              <td class="stat-currency">
                <% if @use_exchange_rates %>
                  <%= capex_currency_symbol(@default_currency) %><%= number_with_precision(@quarterly_data[:q1], precision: 2, delimiter: ',') %>
                <% elsif @currency_breakdown.keys.length == 1 %>
                  <%= Capex.new(currency: @currency_breakdown.keys.first).currency_symbol %><%= number_with_precision(@quarterly_data[:q1], precision: 2, delimiter: ',') %>
                <% else %>
                  <%= number_with_precision(@quarterly_data[:q1], precision: 2, delimiter: ',') %>
                <% end %>
              </td>
            </tr>
            <tr>
              <td>Q2</td>
              <td class="stat-currency">
                <% if @use_exchange_rates %>
                  <%= capex_currency_symbol(@default_currency) %><%= number_with_precision(@quarterly_data[:q2], precision: 2, delimiter: ',') %>
                <% elsif @currency_breakdown.keys.length == 1 %>
                  <%= Capex.new(currency: @currency_breakdown.keys.first).currency_symbol %><%= number_with_precision(@quarterly_data[:q2], precision: 2, delimiter: ',') %>
                <% else %>
                  <%= number_with_precision(@quarterly_data[:q2], precision: 2, delimiter: ',') %>
                <% end %>
              </td>
            </tr>
            <tr>
              <td>Q3</td>
              <td class="stat-currency">
                <% if @use_exchange_rates %>
                  <%= capex_currency_symbol(@default_currency) %><%= number_with_precision(@quarterly_data[:q3], precision: 2, delimiter: ',') %>
                <% elsif @currency_breakdown.keys.length == 1 %>
                  <%= Capex.new(currency: @currency_breakdown.keys.first).currency_symbol %><%= number_with_precision(@quarterly_data[:q3], precision: 2, delimiter: ',') %>
                <% else %>
                  <%= number_with_precision(@quarterly_data[:q3], precision: 2, delimiter: ',') %>
                <% end %>
              </td>
            </tr>
            <tr>
              <td>Q4</td>
              <td class="stat-currency">
                <% if @use_exchange_rates %>
                  <%= capex_currency_symbol(@default_currency) %><%= number_with_precision(@quarterly_data[:q4], precision: 2, delimiter: ',') %>
                <% elsif @currency_breakdown.keys.length == 1 %>
                  <%= Capex.new(currency: @currency_breakdown.keys.first).currency_symbol %><%= number_with_precision(@quarterly_data[:q4], precision: 2, delimiter: ',') %>
                <% else %>
                  <%= number_with_precision(@quarterly_data[:q4], precision: 2, delimiter: ',') %>
                <% end %>
              </td>
            </tr>
          </table>
        </details>
      </div>
    </div>
  </div>

  <!-- TPC Code Grouping -->
  <% if @tpc_grouping && @tpc_grouping.any? %>
    <div class="details-section">
      <h4><%= l(:label_budget_by_tpc_code) %></h4>
      <div class="dashboard-container">
        <% @tpc_grouping.each do |tpc_code, data| %>
          <div class="dashboard-card">
            <div class="dashboard-card-header">
              <h3><span class="tpc-number"><%= tpc_code %></span></h3>
            </div>
            <div class="dashboard-card-body">
              <div class="summary-stats" style="margin-bottom:12px;">
                <div class="stat-box pr-stat--accent">
                  <div class="stat-number stat-currency" style="font-size:16px;">
                    <%= data[:currency_symbol] %><%= number_with_precision(data[:total_budget], precision: 2, delimiter: ',') %>
                  </div>
                  <div class="stat-label"><%= l(:label_total_budget) %></div>
                </div>
                <div class="stat-box pr-stat--success">
                  <div class="stat-number stat-currency" style="font-size:16px;">
                    <%= data[:currency_symbol] %><%= number_with_precision(data[:total_utilized], precision: 2, delimiter: ',') %>
                  </div>
                  <div class="stat-label">Utilized</div>
                </div>
                <div class="stat-box">
                  <div class="stat-number" style="font-size:16px;"><%= data[:entries_count] %></div>
                  <div class="stat-label"><%= l(:label_entries) %></div>
                </div>
              </div>
              <div class="utilization-bar">
                <div class="utilization-fill <%= data[:utilization_percentage].to_f >= 100 ? 'high' : (data[:utilization_percentage].to_f >= 80 ? 'medium' : 'low') %>" style="width: <%= [data[:utilization_percentage].to_f, 100].min %>%"></div>
              </div>
              <div style="text-align:center;margin-top:8px;font-size:13px;color:var(--pr-ink-muted);">
                <%= data[:utilization_percentage] %><%= l(:label_percent_utilized) %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Currency Breakdown (multi-currency only) -->
  <% if @currency_breakdown.keys.length > 1 %>
    <div class="details-section">
      <h4><%= l(:label_capex_by_currency) %></h4>
      <div class="summary-stats">
        <% @currency_breakdown.each do |currency, amount| %>
          <div class="stat-box pr-stat--accent">
            <div class="stat-number stat-currency">
              <%= Capex.new(currency: currency).currency_symbol %><%= number_with_precision(amount, precision: 2, delimiter: ',') %>
            </div>
            <div class="stat-label"><%= currency %></div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- CAPEX Entries Details Table -->
  <div class="details-section">
    <h4><%= l(:label_capex_entries) %></h4>
    <div class="autoscroll">
      <table class="pr-table">
        <caption class="sr-only"><%= l(:label_caption_entries) %></caption>
        <thead>
          <tr>
            <th scope="col"><%= l(:label_tpc_code) %></th>
            <th scope="col"><%= l(:field_description) %></th>
            <th scope="col"><%= l(:label_total_budget) %></th>
            <th scope="col"><%= l(:label_utilized) %></th>
            <th scope="col"><%= l(:label_remaining) %></th>
            <th scope="col"><%= l(:label_utilization) %></th>
            <th scope="col"><%= l(:label_linked_prs) %></th>
            <th scope="col" class="buttons"><%= l(:label_actions) %></th>
          </tr>
        </thead>
        <tbody>
          <% @capex_entries.each do |capex| %>
            <tr class="<%= cycle('odd', 'even') %>">
              <td>
                <span class="tpc-number"><%= capex.tpc_code %></span>
              </td>
              <td><%= truncate(capex.description, length: 80) %></td>
              <td>
                <span class="capex-amount">
                  <%= capex.currency_symbol %><%= number_with_precision(capex.total_amount, precision: 2, delimiter: ',') %>
                </span>
                <span class="currency-code"><%= capex.currency %></span>
              </td>
              <td>
                <span class="amount utilized">
                  <%= capex.currency_symbol %><%= number_with_precision(capex.utilized_amount, precision: 2, delimiter: ',') %>
                </span>
              </td>
              <td>
                <span class="amount <%= capex.remaining_amount < 0 ? 'over-budget' : 'remaining' %>">
                  <%= capex.currency_symbol %><%= number_with_precision(capex.remaining_amount, precision: 2, delimiter: ',') %>
                </span>
              </td>
              <td>
                <div class="utilization-bar" style="width:80px;height:15px;">
                  <div class="utilization-fill <%= capex.utilization_percentage.to_f >= 100 ? 'high' : (capex.utilization_percentage.to_f >= 80 ? 'medium' : 'low') %>" style="width: <%= [capex.utilization_percentage.to_f, 100].min %>%"></div>
                </div>
                <span class="utilization-text"><%= capex.utilization_percentage %>%</span>
              </td>
              <td>
                <% pr_count = capex.purchase_requests.count %>
                <% if pr_count > 0 %>
                  <%= link_to "#{pr_count} PR#{'s' if pr_count != 1}",
                            project_capex_path(@project, capex),
                            class: 'capex-link' %>
                <% else %>
                  <span class="no-prs">—</span>
                <% end %>
              </td>
              <td class="buttons">
                <div class="pr-table-actions">
                  <%= link_to project_capex_path(@project, capex),
                              class: 'pr-button pr-button-secondary pr-button-icon small',
                              title: l(:label_view_capex) do %>
                    <span class="icon icon-magnifier"><%= l(:button_view) %></span>
                  <% end %>
                  <% if User.current.allowed_to?(:manage_capex, @project) %>
                    <%= link_to edit_project_capex_path(@project, capex),
                                class: 'pr-button pr-button-secondary pr-button-icon small',
                                title: l(:label_edit_capex) do %>
                      <span class="icon icon-edit"><%= l(:button_edit) %></span>
                    <% end %>
                    <%= link_to project_capex_path(@project, capex),
                                method: :delete,
                                data: { confirm: l(:text_are_you_sure) },
                                class: 'pr-button pr-button-danger pr-button-icon small',
                                title: l(:label_delete_capex) do %>
                      <span class="icon icon-del"><%= l(:button_delete) %></span>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

<% else %>
  <div class="pr-empty">
    <div class="pr-empty__icon">📊</div>
    <h3><%= l(:label_no_capex_data_for) %> <%= @current_year %></h3>
    <p><%= l(:text_no_capex_entries_for_year) %></p>
    <% if User.current.allowed_to?(:manage_capex, @project) %>
      <p>
        <%= link_to new_project_capex_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
          <span class="icon icon-add"></span> <%= l(:label_create_first_capex) %>
        <% end %>
      </p>
    <% end %>
  </div>
<% end %>

<script>
// Localised strings for the chart a11y contract (see purchase_requests.js).
var PR_CAPEX_LABELS = {
  utilized: '<%= j(l(:label_utilized)) %>',
  remaining: '<%= j(l(:label_remaining)) %>',
  noData: '<%= j(l(:label_no_data)) %>'
};
document.addEventListener('DOMContentLoaded', function() {
  <% if @capex_entries.any? %>
    // Generate CAPEX Utilization Donut Chart
    generateCapexDonutChart('utilization-donut-chart', {
      utilized: <%= @total_utilized %>,
      remaining: <%= @total_remaining %>,
      percentage: <%= @utilization_percentage %>
    });

    // Generate Quarterly Bar Chart
    generateCapexBarChart('quarterly-bar-chart', [
      { label: 'Q1', value: <%= @quarterly_data[:q1] %> },
      { label: 'Q2', value: <%= @quarterly_data[:q2] %> },
      { label: 'Q3', value: <%= @quarterly_data[:q3] %> },
      { label: 'Q4', value: <%= @quarterly_data[:q4] %> }
    ]);
  <% end %>
});

// Function to generate CAPEX donut chart using SVG
// Read design tokens at render time so the chart can never drift from the
// stylesheet the way hardcoded hexes did (utilized was amber here and green
// on the KPI tile). One source of truth: the CSS custom properties.
function prToken(name, fallback) {
  var v = getComputedStyle(document.documentElement).getPropertyValue(name);
  return (v && v.trim()) || fallback;
}

function generateCapexDonutChart(containerId, data) {
  var container = document.getElementById(containerId);
  if (!container) return;

  var size = 140;
  var outerRadius = size / 2 - 10;
  var innerRadius = outerRadius * 0.6;
  var centerX = size / 2;
  var centerY = size / 2;

  var svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('width', size);
  svg.setAttribute('height', size);
  svg.setAttribute('viewBox', '0 0 ' + size + ' ' + size);

  var total = data.utilized + data.remaining;
  if (total === 0) {
    prChartA11y(container, [], { empty: true, emptyText: PR_CAPEX_LABELS.noData });
    return;
  }

  prChartA11y(container, [
    { label: PR_CAPEX_LABELS.utilized, display: data.utilized.toLocaleString() },
    { label: PR_CAPEX_LABELS.remaining, display: data.remaining.toLocaleString() }
  ], {});

  var utilizedPercentage = data.utilized / total;
  var utilizedAngle = utilizedPercentage * 2 * Math.PI;

  if (utilizedPercentage > 0) {
    var path1 = createDonutPath(centerX, centerY, outerRadius, innerRadius, 0, utilizedAngle);
    var utilizedPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    utilizedPath.setAttribute('d', path1);
    utilizedPath.setAttribute('fill', prToken('--pr-success', '#2f9e44'));
    utilizedPath.setAttribute('stroke', prToken('--pr-surface', '#ffffff'));
    utilizedPath.setAttribute('stroke-width', '2');
    svg.appendChild(utilizedPath);
  }

  var remainingPercentage = data.remaining / total;
  if (remainingPercentage > 0) {
    var path2 = createDonutPath(centerX, centerY, outerRadius, innerRadius, utilizedAngle, 2 * Math.PI);
    var remainingPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    remainingPath.setAttribute('d', path2);
    remainingPath.setAttribute('fill', prToken('--pr-warning', '#df8709'));
    remainingPath.setAttribute('stroke', prToken('--pr-surface', '#ffffff'));
    remainingPath.setAttribute('stroke-width', '2');
    svg.appendChild(remainingPath);
  }

  container.insertBefore(svg, container.firstChild);
}

// Helper function to create donut path
function createDonutPath(centerX, centerY, outerRadius, innerRadius, startAngle, endAngle) {
  var x1 = centerX + outerRadius * Math.cos(startAngle);
  var y1 = centerY + outerRadius * Math.sin(startAngle);
  var x2 = centerX + outerRadius * Math.cos(endAngle);
  var y2 = centerY + outerRadius * Math.sin(endAngle);

  var x3 = centerX + innerRadius * Math.cos(endAngle);
  var y3 = centerY + innerRadius * Math.sin(endAngle);
  var x4 = centerX + innerRadius * Math.cos(startAngle);
  var y4 = centerY + innerRadius * Math.sin(startAngle);

  var largeArcFlag = endAngle - startAngle > Math.PI ? 1 : 0;

  return [
    'M ' + x1 + ' ' + y1,
    'A ' + outerRadius + ' ' + outerRadius + ' 0 ' + largeArcFlag + ' 1 ' + x2 + ' ' + y2,
    'L ' + x3 + ' ' + y3,
    'A ' + innerRadius + ' ' + innerRadius + ' 0 ' + largeArcFlag + ' 0 ' + x4 + ' ' + y4,
    'Z'
  ].join(' ');
}

// Function to generate CAPEX quarterly bar chart
function generateCapexBarChart(containerId, data) {
  var container = document.getElementById(containerId);
  if (!container || !data.length) return;

  while (container.firstChild) {
    container.removeChild(container.firstChild);
  }

  var maxValue = Math.max.apply(null, data.map(function(item) { return item.value; }));
  if (maxValue === 0) {
    prChartA11y(container, [], { empty: true, emptyText: PR_CAPEX_LABELS.noData });
    return;
  }

  prChartA11y(container, data.map(function (item) {
    return { label: item.label, display: item.value.toLocaleString() };
  }), { scrollable: true });

  data.forEach(function(item) {
    var barHeight = (item.value / maxValue) * 80;

    var bar = document.createElement('div');
    bar.className = 'capex-quarter-bar';
    bar.style.height = barHeight + 'px';

    var valueLabel = document.createElement('div');
    valueLabel.className = 'capex-quarter-value';
    valueLabel.textContent = item.value.toLocaleString();
    bar.appendChild(valueLabel);

    var quarterLabel = document.createElement('div');
    quarterLabel.className = 'capex-quarter-label';
    quarterLabel.textContent = item.label;
    bar.appendChild(quarterLabel);

    bar.title = item.label + ': ' + item.value.toLocaleString();

    container.appendChild(bar);
  });
}
</script>
