<%# filepath: app/views/capex/edit.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'capex', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title "Edit CAPEX Entry - #{@capex.tpc_code} - #{@project.name}" %>

<div class="contextual">
  <%= link_to project_capex_index_path(@project), class: 'pr-button pr-button-cancel pr-button-icon small' do %>
    <span class="icon icon-cancel">Back to CAPEX List</span>
  <% end %>
</div>

<div class="pr-form-container">
  <div class="pr-form-header">
    <div class="pr-form-title">
      <h2>Edit CAPEX Entry</h2>
      <div class="pr-form-subtitle">
        <span class="icon icon-edit"></span>
        <span class="tpc-number"><%= @capex.tpc_code %></span> &mdash; <%= @project.name %>
      </div>
    </div>
  </div>

  <div class="pr-form-instructions">
    <div class="pr-alert pr-alert-info">
      <span class="icon icon-info"></span>
      <div class="pr-alert-content">
        <h4>Edit CAPEX Entry</h4>
        <p>Update the details below for this CAPEX budget entry. Quarterly amounts must sum to the total amount.</p>
      </div>
    </div>
  </div>

  <div class="pr-form-box">
    <div class="pr-form-content">
      <%= render 'form' %>
    </div>
  </div>
</div>
