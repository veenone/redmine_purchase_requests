<%# filepath: app/views/capex/index.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'capex', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title "CAPEX Management - #{@project.name}" %>

<div class="contextual">
  <% if User.current.allowed_to?(:manage_capex, @project) %>
    <%= link_to new_project_capex_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
      <span class="icon icon-add">New CAPEX Entry</span>
    <% end %>
  <% end %>

  <%= link_to dashboard_project_capex_index_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-stats">CAPEX Dashboard</span>
  <% end %>
</div>

<h2>CAPEX Management</h2>

<div class="info-box">
  <p>Manage CAPEX (Capital Expenditure) entries for this project. CAPEX entries can be linked to purchase requests for budget tracking.</p>
</div>

<%= form_tag project_capex_index_path(@project), method: :get, local: true do %>
  <fieldset class="pr-filters">
    <legend>Filters</legend>
    <div class="filter-row">
      <label for="year">Year:</label>
      <%= select_tag 'year',
                     options_for_select(@years.map { |y| [y, y] }, @selected_year),
                     include_blank: 'All Years',
                     onchange: 'this.form.submit()' %>

      <label for="search">Search:</label>
      <%= text_field_tag 'search', params[:search], size: 30, placeholder: 'Search by description or TPC code' %>

      <%= render 'shared/tpc_filter_field', available_tpc_codes: @available_tpc_codes, selected_tpc_code_ids: selected_tpc_code_ids %>
      <%= submit_tag 'Search', name: nil, class: 'pr-button pr-button-secondary' %>
      <% if params[:year].present? || params[:search].present? || params[:tpc_code_id].present? %>
        <%= link_to project_capex_index_path(@project), class: 'pr-button pr-button-cancel' do %>
          Clear
        <% end %>
      <% end %>
    </div>
  </fieldset>
<% end %>

<%
  capex_export_query = {
    year: @selected_year,
    search: params[:search].presence,
    tpc_code_id: selected_tpc_code_ids.presence
  }.compact
%>
<%= render 'shared/export_actions',
           csv_path:  export_csv_project_capex_index_path(@project, capex_export_query),
           xlsx_path: export_xlsx_project_capex_index_path(@project, capex_export_query),
           pdf_path:  export_pdf_project_capex_index_path(@project, capex_export_query) %>

<% if @capex_entries.any? %>
  <div class="autoscroll">
    <table class="pr-table">
      <thead>
        <tr>
          <%= sort_header_tag('year', caption: 'Year') %>
          <%= sort_header_tag('tpc_code_id', caption: 'TPC Code') %>
          <%= sort_header_tag('description', caption: 'Description') %>
          <%= sort_header_tag('total_amount', caption: 'Total Amount') %>
          <th scope="col">Quarterly Distribution</th>
          <th scope="col">Utilized</th>
          <th scope="col">Remaining</th>
          <th scope="col">Utilization %</th>
          <th scope="col" class="buttons">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @capex_entries.each do |capex| %>
          <tr class="<%= cycle('odd', 'even') %>">
            <td><%= capex.capex_year %></td>
            <td>
              <%= link_to capex.tpc_code_display, project_capex_path(@project, capex), class: 'capex-link' %>
            </td>
            <td><%= truncate(capex.description, length: 50) %></td>
            <td>
              <span class="capex-amount">
                <%= capex.currency_symbol %><%= number_with_precision(capex.total_amount, precision: 2, delimiter: ',') %>
              </span>
              <span class="currency-code"><%= capex.currency %></span>
            </td>
            <td>
              <div style="display:flex;gap:6px;font-size: var(--pr-text-xs);">
                <% [1, 2, 3, 4].each do |q| %>
                  <div style="text-align:center;min-width:42px;">
                    <div style="font-weight:700;color:var(--pr-ink-muted);">Q<%= q %></div>
                    <div style="font-size: var(--pr-text-2xs);color:var(--pr-ink);"><%= capex.currency_symbol %><%= number_with_precision(capex.send("q#{q}_amount"), precision: 0, delimiter: ',') %></div>
                    <div style="font-size: var(--pr-text-2xs);color:var(--pr-ink-faint);"><%= capex.quarterly_percentage(q) %>%</div>
                  </div>
                <% end %>
              </div>
            </td>
            <td>
              <span class="amount utilized">
                <%= capex.currency_symbol %><%= number_with_precision(capex.utilized_amount, precision: 2, delimiter: ',') %>
              </span>
            </td>
            <td>
              <span class="amount <%= capex.remaining_amount < 0 ? 'over-budget' : 'remaining' %>">
                <%= capex.currency_symbol %><%= number_with_precision(capex.remaining_amount, precision: 2, delimiter: ',') %>
              </span>
            </td>
            <td>
              <div class="progress-bar" style="width:80px;">
                <div class="progress-fill <%= 'over-utilized' if capex.utilization_percentage > 100 %>" style="width: <%= [capex.utilization_percentage, 100].min %>%"></div>
                <span class="progress-text <%= 'over-utilized' if capex.utilization_percentage > 100 %>"><%= capex.utilization_percentage.round(1) %>%</span>
              </div>
            </td>
            <td class="buttons">
              <div class="pr-table-actions">
                <%= link_to project_capex_path(@project, capex),
                            class: 'pr-button pr-button-secondary pr-button-icon small',
                            title: 'View' do %>
                  <span class="icon icon-magnifier">View</span>
                <% end %>
                <% if User.current.allowed_to?(:manage_capex, @project) %>
                  <%= link_to edit_project_capex_path(@project, capex),
                              class: 'pr-button pr-button-secondary pr-button-icon small',
                              title: 'Edit' do %>
                    <span class="icon icon-edit">Edit</span>
                  <% end %>
                  <%= link_to project_capex_path(@project, capex),
                              method: :delete,
                              data: { confirm: 'Are you sure?' },
                              class: 'pr-button pr-button-danger pr-button-icon small',
                              title: 'Delete' do %>
                    <span class="icon icon-del">Delete</span>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="pr-empty">
    <div class="pr-empty__icon">📊</div>
    <h3>No CAPEX Entries Found</h3>
    <p>No CAPEX entries match the current filters for this project.</p>
    <% if User.current.allowed_to?(:manage_capex, @project) %>
      <p>
        <%= link_to new_project_capex_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
          <span class="icon icon-add"></span> Create First CAPEX Entry
        <% end %>
      </p>
    <% end %>
  </div>
<% end %>
