<%# filepath: app/views/capex/show.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'capex', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title "CAPEX: #{@capex.tpc_code} - #{@project.name}" %>

<div class="contextual">
  <%= link_to project_capex_index_path(@project), class: 'pr-button pr-button-cancel pr-button-icon small' do %>
    <span class="icon icon-cancel">Back to CAPEX List</span>
  <% end %>

  <% if User.current.allowed_to?(:manage_capex, @project) %>
    <%= link_to edit_project_capex_path(@project, @capex), class: 'pr-button pr-button-secondary pr-button-icon small' do %>
      <span class="icon icon-edit">Edit</span>
    <% end %>

    <%= link_to project_capex_path(@project, @capex),
                method: :delete,
                data: { confirm: 'Are you sure you want to delete this CAPEX entry?' },
                class: 'pr-button pr-button-danger pr-button-icon small' do %>
      <span class="icon icon-del">Delete</span>
    <% end %>
  <% end %>
</div>

<div class="pr-form-container">
  <div class="pr-form-header">
    <div class="pr-form-title">
      <h2>
        CAPEX
        <span class="request-id"><span class="tpc-number"><%= @capex.tpc_code_display %></span></span>
      </h2>
      <div class="pr-form-subtitle">
        <span class="icon icon-info"></span>
        <%= @capex.description %> &mdash; <%= @project.name %>
      </div>
    </div>
    <div class="pr-form-status">
      <span class="capex-badge active"><%= @capex.capex_year %></span>
    </div>
  </div>

  <!-- KPI tiles -->
  <div class="summary-stats">
    <div class="stat-box pr-stat--accent">
      <div class="stat-number stat-currency">
        <%= @capex.currency_symbol %><%= number_with_precision(@capex.total_amount, precision: 2, delimiter: ',') %>
        <span class="currency-code"><%= @capex.currency %></span>
      </div>
      <div class="stat-label">Total Budget</div>
    </div>

    <div class="stat-box pr-stat--success">
      <div class="stat-number stat-currency">
        <%= @capex.currency_symbol %><%= number_with_precision(@capex.utilized_amount, precision: 2, delimiter: ',') %>
        <span class="currency-code"><%= @capex.currency %></span>
      </div>
      <div class="stat-label">Utilized</div>
    </div>

    <div class="stat-box pr-stat--warning">
      <div class="stat-number stat-currency <%= @capex.remaining_amount < 0 ? 'over-budget' : 'remaining-budget' %>">
        <%= @capex.currency_symbol %><%= number_with_precision(@capex.remaining_amount, precision: 2, delimiter: ',') %>
        <span class="currency-code"><%= @capex.currency %></span>
      </div>
      <div class="stat-label">Remaining</div>
    </div>

    <div class="stat-box pr-stat--violet">
      <div class="stat-number utilization-percentage">
        <%= @capex.utilization_percentage.round(1) %>%
      </div>
      <div class="stat-label">Utilization</div>
    </div>
  </div>

  <!-- Utilization bar -->
  <div class="dashboard-card pr-block-gap">
    <div class="dashboard-card-header">
      <h3>Budget Utilization</h3>
    </div>
    <div class="dashboard-card-body">
      <div class="utilization-bar">
        <div class="utilization-fill <%= @capex.utilization_percentage > 100 ? 'over-utilized' : '' %>"
             style="width: <%= [@capex.utilization_percentage, 100].min %>%"></div>
      </div>
      <span class="utilization-text"><%= @capex.utilization_percentage.round(1) %>% Utilized</span>
      <% if @capex.utilization_percentage > 100 %>
        <div class="pr-alert pr-alert-warning" style="margin-top:12px;">
          <span class="icon icon-warning"></span>
          <div class="pr-alert-content">
            <strong>Warning:</strong> Budget utilization exceeds 100% by <%= (@capex.utilization_percentage - 100).round(2) %>%
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Details + Quarterly in two-column grid -->
  <div class="dashboard-container">
    <!-- CAPEX Information -->
    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <h3>CAPEX Information</h3>
      </div>
      <div class="dashboard-card-body">
        <div class="details-grid">
          <div class="grid-row">
            <span class="label">Year:</span>
            <span class="value"><%= @capex.capex_year %></span>
          </div>
          <div class="grid-row">
            <span class="label">TPC Code:</span>
            <span class="value"><span class="tpc-number"><%= @capex.tpc_code_display %></span></span>
          </div>
          <div class="grid-row">
            <span class="label">Description:</span>
            <span class="value"><%= @capex.description %></span>
          </div>
          <div class="grid-row">
            <span class="label">Total Amount:</span>
            <span class="value">
              <span class="capex-amount"><%= @capex.currency_symbol %><%= number_with_precision(@capex.total_amount, precision: 2, delimiter: ',') %></span>
              <span class="currency-code"><%= @capex.currency %></span>
            </span>
          </div>
          <% if @capex.notes.present? %>
            <div class="grid-row">
              <span class="label">Notes:</span>
              <span class="value"><%= simple_format(@capex.notes) %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Quarterly Section -->
    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <h3>Quarterly Overview</h3>
      </div>
      <div class="dashboard-card-body">
        <!-- Consumption per quarter -->
        <div class="details-section">
          <h4>Quarterly Consumption</h4>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
            <% [1, 2, 3, 4].each do |quarter| %>
              <% quarterly_consumption = @capex.quarterly_consumption(quarter) %>
              <div class="capex-details-display">
                <div><strong>Q<%= quarter %> <%= @capex.capex_year %></strong></div>
                <div>
                  <span class="capex-amount"><%= @capex.currency_symbol %><%= number_with_precision(quarterly_consumption, precision: 2, delimiter: ',') %></span>
                  consumed
                </div>
                <div style="color:var(--pr-ink-muted);font-size: var(--pr-text-xs);">
                  <%= quarterly_consumption > 0 ? ((quarterly_consumption / @capex.send("q#{quarter}_amount").to_f) * 100).round(2) : 0 %>% of Q<%= quarter %> budget
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Distribution per quarter -->
        <div class="details-section">
          <h4>Quarterly Distribution</h4>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <% [1, 2, 3, 4].each do |quarter| %>
              <div class="capex-details-display">
                <div><strong>Q<%= quarter %> <%= @capex.capex_year %></strong></div>
                <div>
                  <span class="capex-amount"><%= @capex.currency_symbol %><%= number_with_precision(@capex.send("q#{quarter}_amount"), precision: 2, delimiter: ',') %></span>
                </div>
                <div style="color:var(--pr-ink-muted);font-size: var(--pr-text-xs);"><%= @capex.quarterly_percentage(quarter) %>% of total</div>
                <div class="capex-progress" style="margin-top:6px;">
                  <div class="capex-progress-bar low" style="width: <%= @capex.quarterly_percentage(quarter) %>%"></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Linked Purchase Requests -->
  <% if @purchase_requests.any? %>
    <div class="details-section" style="margin-top:8px;">
      <% counting = @purchase_requests.count(&:counts_toward_budget?) %>
      <h4>
        <%= l(:label_linked_purchase_requests) %> (<%= @purchase_requests.count %>)
        <% if counting < @purchase_requests.count %>
          <span class="pr-hint"><%= l(:text_n_count_toward_budget, count: counting) %></span>
        <% end %>
      </h4>
      <div class="autoscroll">
        <table class="pr-table">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Title</th>
              <th scope="col">Status</th>
              <th scope="col">Author</th>
              <th scope="col">Estimated Price</th>
              <th scope="col">Proposed Quarter</th>
              <th scope="col">Created</th>
              <th scope="col" class="buttons">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @purchase_requests.each do |pr| %>
              <tr class="<%= cycle('odd', 'even') %> <%= 'pr-row--void' unless pr.counts_toward_budget? %>">
                <td class="pr-cell-id">
                  <%= link_to "##{pr.id}", project_purchase_request_path(@project, pr) %>
                  <% unless pr.counts_toward_budget? %>
                    <span class="pr-hint"><%= l(:text_does_not_count_toward_budget) %></span>
                  <% end %>
                </td>
                <td>
                  <%= link_to truncate(pr.title, length: 50), project_purchase_request_path(@project, pr), class: 'pr-title-link' %>
                </td>
                <td>
                  <span class="status-badge" style="background-color: <%= pr.status.display_color %>; color: <%= readable_text_color(pr.status.display_color) %>">
                    <%= pr.status.name %>
                  </span>
                </td>
                <td><%= link_to_user pr.user %></td>
                <td>
                  <% if pr.estimated_price.present? %>
                    <span class="capex-amount">
                      <%= pr.currency == @capex.currency ? @capex.currency_symbol : pr.currency %>
                      <%= number_with_precision(pr.estimated_price, precision: 2, delimiter: ',') %>
                    </span>
                    <span class="currency-code"><%= pr.currency %></span>
                  <% else %>
                    <span class="no-data">—</span>
                  <% end %>
                </td>
                <td>
                  <% if pr.has_quarterly_allocation? %>
                    <span class="pr-badge pr-badge--accent">Q<%= pr.allocated_quarter %></span>
                    <div style="font-size: var(--pr-text-sm);color:var(--pr-ink-muted);margin-top:2px;">
                      <%= pr.currency == @capex.currency ? @capex.currency_symbol : pr.currency %>
                      <%= number_with_precision(pr.allocated_amount, precision: 2, delimiter: ',') %>
                    </div>
                  <% else %>
                    <span class="no-data">—</span>
                  <% end %>
                </td>
                <td><span class="date-display"><%= format_time(pr.created_at) %></span></td>
                <td class="buttons">
                  <div class="pr-table-actions">
                    <%= link_to project_purchase_request_path(@project, pr),
                                class: 'pr-button pr-button-secondary pr-button-icon small',
                                title: 'View' do %>
                      <span class="icon icon-magnifier">View</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="details-section" style="margin-top:8px;">
      <h4>Linked Purchase Requests</h4>
      <div class="pr-empty">
        <div class="pr-empty__icon">📋</div>
        <h3>No Linked Purchase Requests</h3>
        <p>No purchase requests are currently linked to this CAPEX entry.</p>
        <% if User.current.allowed_to?(:add_purchase_requests, @project) %>
          <p>
            <%= link_to new_project_purchase_request_path(@project, capex_id: @capex.id),
                        class: 'pr-button pr-button-primary pr-button-icon' do %>
              <span class="icon icon-add">Create Purchase Request for this CAPEX</span>
            <% end %>
          </p>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="pr-form-actions left-aligned">
    <% if User.current.allowed_to?(:manage_capex, @project) %>
      <%= link_to edit_project_capex_path(@project, @capex), class: 'pr-button pr-button-primary' do %>
        Edit CAPEX Entry
      <% end %>
    <% end %>
    <%= link_to project_capex_index_path(@project), class: 'pr-button pr-button-cancel' do %>
      Back to List
    <% end %>
  </div>
</div>
