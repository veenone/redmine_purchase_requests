<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<div class="contextual">
  <%= link_to new_department_path_for, class: 'pr-button pr-button-primary pr-button-icon' do %>
    <span class="icon icon-add"><%= l(:label_department_new, default: 'New Department') %></span>
  <% end %>
</div>

<h2><%= l(:label_departments, default: 'Departments') %></h2>

<% if @departments.any? %>
  <div class="autoscroll">
    <table class="pr-table">
      <thead>
        <tr>
          <th scope="col"><%= l(:field_department_code, default: 'Code') %></th>
          <th scope="col"><%= l(:field_department_name, default: 'Name') %></th>
          <th scope="col"><%= l(:label_tpc_codes, default: 'TPC Codes') %></th>
          <th scope="col" class="buttons"></th>
        </tr>
      </thead>
      <tbody>
        <% @departments.each do |department| %>
          <tr>
            <td><%= department.code.presence || '-' %></td>
            <td><%= department.name %></td>
            <td><%= @tpc_counts.fetch(department.id, 0) %></td>
            <td class="buttons">
              <div class="pr-table-actions">
                <%= link_to edit_department_path_for(department), class: 'pr-button pr-button-secondary pr-button-icon small' do %>
                  <span class="icon icon-edit"><%= l(:button_edit) %></span>
                <% end %>
                <%= link_to department_path_for(department), method: :delete,
                            data: { confirm: l(:text_are_you_sure) },
                            class: 'pr-button pr-button-danger pr-button-icon small' do %>
                  <span class="icon icon-del"><%= l(:button_delete) %></span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="nodata"><%= l(:label_no_departments) %></p>
<% end %>
