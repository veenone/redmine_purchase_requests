<%# filepath: app/views/opex/dashboard.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title "#{l(:label_opex_dashboard)} - #{@project.name}" %>

<div class="contextual">
  <%= link_to project_opex_index_path(@project), class: 'pr-button pr-button-cancel pr-button-icon small' do %>
    <span class="icon icon-cancel"><%= l(:label_back_to_opex_list) %></span>
  <% end %>

  <% if User.current.allowed_to?(:view_tpc_codes, @project) %>
    <%= link_to project_tpc_codes_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
      <span class="icon icon-projects"><%= l(:label_tpc_codes) %></span>
    <% end %>
  <% end %>

  <% if User.current.allowed_to?(:manage_opex, @project) %>
    <%= link_to new_project_opex_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
      <span class="icon icon-add"><%= l(:label_new_opex_entry) %></span>
    <% end %>
  <% end %>
</div>

<h2><%= l(:label_opex_dashboard) %> — <%= @current_year %></h2>

<%= render 'shared/dashboard_filters',
      year_mode: :fixed,
      selected_year: @current_year,
      available_years: (2020..2030).to_a,
      available_tpc_codes: @available_tpc_codes,
      selected_tpc_code_ids: selected_tpc_code_ids,
      selected_category: @selected_category %>

<%= render 'shared/budget_dashboard',
      grouping_partial: 'opex/grouping',
      entries_partial:  'opex/entries_table',
      entries: @opex_entries,
      labels: {
        total_budget: l(:label_total_opex_budget),
        by_currency:  l(:label_opex_by_currency),
        entries:      l(:label_opex_entries)
      },
      empty_state: {
        title:        l(:label_no_opex_data_for),
        text:         l(:text_no_opex_entries_for_year),
        action_label: l(:label_create_first_opex),
        action_path:  new_project_opex_path(@project),
        permission:   :manage_opex
      },
      currency_symbol: opex_currency_symbol(@default_currency),
      currency_symbol_for: ->(cur) { Opex.new(currency: cur).currency_symbol } %>

<%# Redmine's own other-formats block rather than a button in .contextual:
    every list in this application offers CSV in exactly this place, and a
    dashboard that replaces a spreadsheet has to let the numbers leave it. %>
<% if @opex_entries.any? %>
  <p class="other-formats">
    <%= l(:label_export_to) %>
    <%= link_to 'CSV',
                dashboard_project_opex_index_path(@project,
                  { year: @current_year, tpc_code_id: @selected_tpc_code_id,
                    category: @selected_category,
                    sort: @sort_key, direction: @sort_dir, format: 'csv' }.compact),
                class: 'csv' %>
  </p>
<% end %>
<script>
// Localised strings for the chart a11y contract (see purchase_requests.js).
var PR_OPEX_LABELS = {
  utilized: '<%= j(l(:label_utilized)) %>',
  remaining: '<%= j(l(:label_remaining)) %>',
  overBudgetBy: '<%= j(l(:label_over_budget_by)) %>',
  noData: '<%= j(l(:label_no_budget_data)) %>'
};
document.addEventListener('DOMContentLoaded', function() {
  <% if @opex_entries.any? %>
    // Generate OPEX Utilization Donut Chart (shared implementation — see
    // generateBudgetDonutChart in purchase_requests.js).
    generateBudgetDonutChart('utilization-donut-chart', {
      utilized: <%= @total_utilized %>,
      remaining: <%= @total_remaining %>,
      percentage: <%= @utilization_percentage %>
    }, PR_OPEX_LABELS);

    // Generate Quarterly Bar Chart
    generateBudgetBarChart('quarterly-bar-chart', [
      { label: 'Q1', value: <%= @quarterly_data[:q1] %> },
      { label: 'Q2', value: <%= @quarterly_data[:q2] %> },
      { label: 'Q3', value: <%= @quarterly_data[:q3] %> },
      { label: 'Q4', value: <%= @quarterly_data[:q4] %> }
    ], PR_OPEX_LABELS);
  <% end %>
});
</script>
