<%# filepath: app/views/opex/index.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title "OPEX Management - #{@project.name}" %>

<div class="contextual">
  <% if User.current.allowed_to?(:manage_opex, @project) %>
    <%= link_to new_project_opex_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
      <span class="icon icon-add">New OPEX Entry</span>
    <% end %>
  <% end %>
  <%= link_to dashboard_project_opex_index_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-stats">OPEX Dashboard</span>
  <% end %>
</div>

<h2>OPEX Management - <%= @project.name %></h2>

<div class="info-box">
  <p>Manage OPEX (Operating Expenditure) entries for this project. OPEX entries can be linked to purchase requests for budget tracking.</p>
</div>

<%= form_tag project_opex_index_path(@project), method: :get, local: true do %>
  <fieldset class="pr-filters">
    <legend>Filters</legend>
    <div class="filter-row">
      <label for="year">Year:</label>
      <%= select_tag 'year',
                     options_for_select(@years&.map { |y| [y, y] } || [], @selected_year),
                     include_blank: 'All Years',
                     onchange: 'this.form.submit()' %>

      <label for="search">Search:</label>
      <%= text_field_tag 'search', params[:search], size: 30, placeholder: 'Search by description or OPEX code' %>

      <%= render 'shared/tpc_filter_field', available_tpc_codes: @available_tpc_codes, selected_tpc_code_ids: selected_tpc_code_ids %>
      <%= submit_tag 'Search', name: nil, class: 'pr-button pr-button-secondary' %>
      <% if params[:year].present? || params[:search].present? || params[:tpc_code_id].present? %>
        <%= link_to project_opex_index_path(@project), class: 'pr-button pr-button-cancel' do %>
          Clear
        <% end %>
      <% end %>
    </div>
  </fieldset>
<% end %>

<% if @opex_entries.any? %>
  <div class="autoscroll">
    <table class="pr-table">
      <thead>
        <tr>
          <%= sort_header_tag('year', caption: 'Year') %>
          <%= sort_header_tag('opex_code', caption: 'OPEX Code') %>
          <%= sort_header_tag('description', caption: 'Description') %>
          <%= sort_header_tag('total_amount', caption: 'Total Amount') %>
          <th>Quarterly Distribution</th>
          <%= sort_header_tag('category_id', caption: 'Category') %>
          <%= sort_header_tag('tpc_code_id', caption: 'TPC Code') %>
          <th>Utilized</th>
          <th>Remaining</th>
          <th>Utilization %</th>
          <th class="buttons">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @opex_entries.each do |opex| %>
          <tr class="<%= cycle('odd', 'even') %>">
            <td class="year"><%= opex.year %></td>
            <td class="opex-code">
              <%= link_to opex.opex_code, project_opex_path(@project, opex), class: 'pr-title-link' %>
            </td>
            <td class="description">
              <%= truncate(opex.description, length: 50) %>
            </td>
            <td class="total-amount">
              <span class="stat-currency">
                <%= opex.currency_symbol %><%= number_with_precision(opex.total_amount, precision: 2, delimiter: ',') %>
              </span>
              <span class="currency-code"><%= opex.currency %></span>
            </td>
            <td class="quarterly-distribution">
              <div class="capex-quarterly-grid" style="grid-template-columns: repeat(4,auto); gap:4px; font-size:11px;">
                <% [1, 2, 3, 4].each do |q| %>
                  <div class="capex-quarterly-field" style="text-align:center; min-width:38px;">
                    <div style="font-weight:600; color:var(--pr-ink-muted);">Q<%= q %></div>
                    <div style="font-size:10px; color:var(--pr-ink);">
                      <%= opex.currency_symbol %><%= number_with_precision(opex.send("q#{q}_amount"), precision: 0, delimiter: ',') %>
                    </div>
                    <div style="font-size:9px; color:var(--pr-ink-faint);"><%= opex.quarterly_percentage(q) %>%</div>
                  </div>
                <% end %>
              </div>
            </td>
            <td class="category">
              <span class="pr-badge pr-badge--info"><%= opex.category_display %></span>
            </td>
            <td class="tpc-code">
              <% if opex.tpc_code.present? %>
                <div>
                  <span class="tpc-number"><%= opex.tpc_code.tpc_number %></span>
                  <% if opex.tpc_code.department.present? %>
                    <div style="font-size:10px; color:var(--pr-ink-faint); font-style:italic;"><%= opex.tpc_code.department.name %></div>
                  <% end %>
                </div>
              <% else %>
                <span class="no-data">No TPC</span>
              <% end %>
            </td>
            <td class="utilized-amount">
              <span class="stat-currency">
                <%= opex.currency_symbol %><%= number_with_precision(opex.utilized_amount, precision: 2, delimiter: ',') %>
              </span>
            </td>
            <td class="remaining-amount">
              <span class="<%= opex.remaining_amount < 0 ? 'over-budget' : 'remaining-budget' %>">
                <%= opex.currency_symbol %><%= number_with_precision(opex.remaining_amount, precision: 2, delimiter: ',') %>
              </span>
            </td>
            <td class="utilization-percentage">
              <div class="progress-bar">
                <div class="progress-fill <%= 'over-utilized' if opex.utilization_percentage > 100 %>"
                     style="width: <%= [opex.utilization_percentage, 100].min %>%"></div>
                <span class="progress-text"><%= opex.utilization_percentage.round(1) %>%</span>
              </div>
            </td>
            <td class="buttons">
              <div class="pr-table-actions">
                <%= link_to project_opex_path(@project, opex),
                            class: 'pr-button pr-button-secondary pr-button-icon small',
                            title: 'View' do %>
                  <span class="icon icon-magnifier">View</span>
                <% end %>
                <% if User.current.allowed_to?(:manage_opex, @project) %>
                  <%= link_to edit_project_opex_path(@project, opex),
                              class: 'pr-button pr-button-secondary pr-button-icon small',
                              title: 'Edit' do %>
                    <span class="icon icon-edit">Edit</span>
                  <% end %>
                  <%= link_to project_opex_path(@project, opex),
                              method: :delete,
                              data: { confirm: 'Are you sure?' },
                              class: 'pr-button pr-button-danger pr-button-icon small',
                              title: 'Delete' do %>
                    <span class="icon icon-del">Delete</span>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="pr-empty">
    <div class="pr-empty__icon">💰</div>
    <h3>No OPEX Entries Found</h3>
    <p>No OPEX entries match your current filters, or none have been created yet.</p>
    <% if User.current.allowed_to?(:manage_opex, @project) %>
      <p>
        <%= link_to new_project_opex_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
          <span class="icon icon-add"></span> Create First OPEX Entry
        <% end %>
      </p>
    <% end %>
  </div>
<% end %>
