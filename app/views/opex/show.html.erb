<%# filepath: app/views/opex/show.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title "OPEX: #{@opex.opex_code} - #{@project.name}" %>

<div class="contextual">
  <%= link_to project_opex_index_path(@project), class: 'pr-button pr-button-cancel pr-button-icon small' do %>
    <span class="icon icon-cancel">Back to OPEX List</span>
  <% end %>

  <% if User.current.allowed_to?(:manage_opex, @project) %>
    <%= link_to edit_project_opex_path(@project, @opex), class: 'pr-button pr-button-secondary pr-button-icon' do %>
      <span class="icon icon-edit">Edit</span>
    <% end %>

    <%= link_to project_opex_path(@project, @opex),
                method: :delete,
                data: { confirm: 'Are you sure you want to delete this OPEX entry?' },
                class: 'pr-button pr-button-danger pr-button-icon' do %>
      <span class="icon icon-del">Delete</span>
    <% end %>
  <% end %>
</div>

<h2><%= @opex.opex_code %> - <%= @opex.description %></h2>

<!-- Summary stat tiles -->
<div class="summary-stats">
  <div class="stat-box pr-stat--accent">
    <div class="stat-number stat-currency">
      <%= @opex.currency_symbol %><%= number_with_precision(@opex.total_amount, precision: 2, delimiter: ',') %>
    </div>
    <div class="stat-label">Total Budget <span class="currency-code"><%= @opex.currency %></span></div>
  </div>

  <div class="stat-box pr-stat--warning">
    <div class="stat-number stat-currency">
      <%= @opex.currency_symbol %><%= number_with_precision(@opex.utilized_amount, precision: 2, delimiter: ',') %>
    </div>
    <div class="stat-label">
      Utilized
      <span class="utilization-percentage <%= @opex.utilization_percentage > 100 ? 'over-budget' : '' %>">
        (<%= @opex.utilization_percentage %>%)
      </span>
    </div>
  </div>

  <div class="stat-box pr-stat--success">
    <div class="stat-number stat-currency <%= @opex.remaining_amount < 0 ? 'over-budget' : '' %>">
      <%= @opex.currency_symbol %><%= number_with_precision(@opex.remaining_amount, precision: 2, delimiter: ',') %>
    </div>
    <div class="stat-label">
      Remaining
      <span class="<%= @opex.remaining_amount < 0 ? 'over-budget' : '' %>">
        (<%= (100 - @opex.utilization_percentage).round(2) %>%)
      </span>
    </div>
  </div>
</div>

<!-- Utilization progress bar -->
<div class="details-section">
  <h4>Budget Utilization</h4>
  <div class="utilization-bar">
    <div class="utilization-fill" style="width: <%= [@opex.utilization_percentage, 100].min %>%"></div>
  </div>
  <div style="text-align:right; font-size:12px; color:var(--pr-ink-muted); margin-top:4px;">
    <%= @opex.utilization_percentage %>% Utilized
  </div>
  <% if @opex.utilization_percentage > 100 %>
    <div class="pr-alert pr-alert-warning" style="margin-top:10px;">
      <span class="icon icon-warning"></span>
      <div class="pr-alert-content">
        <strong>Warning:</strong> Budget utilization exceeds 100% by <%= (@opex.utilization_percentage - 100).round(2) %>%
      </div>
    </div>
  <% end %>
</div>

<!-- Info grid: OPEX details + quarterly -->
<div class="details-columns" style="display:grid; grid-template-columns:1fr 1fr; gap:30px; margin-top:20px;">
  <div>
    <div class="details-section">
      <h4>OPEX Information</h4>
      <div class="details-grid">
        <div class="grid-row">
          <span class="label">Year:</span>
          <span class="value"><%= @opex.year %></span>
        </div>
        <div class="grid-row">
          <span class="label">OPEX Code:</span>
          <span class="value tpc-number"><%= @opex.opex_code %></span>
        </div>
        <div class="grid-row">
          <span class="label">Description:</span>
          <span class="value"><%= @opex.description %></span>
        </div>
        <div class="grid-row">
          <span class="label">Category:</span>
          <span class="value"><span class="pr-badge pr-badge--info"><%= @opex.category_display %></span></span>
        </div>
        <div class="grid-row">
          <span class="label">Total Amount:</span>
          <span class="value stat-currency">
            <%= @opex.currency_symbol %><%= number_with_precision(@opex.total_amount, precision: 2, delimiter: ',') %>
            <span class="currency-code"><%= @opex.currency %></span>
          </span>
        </div>
        <% if @opex.cost_center.present? %>
          <div class="grid-row">
            <span class="label">Cost Center:</span>
            <span class="value"><%= @opex.cost_center %></span>
          </div>
        <% end %>
        <% if @opex.notes.present? %>
          <div class="grid-row">
            <span class="label">Notes:</span>
            <span class="value"><%= simple_format(@opex.notes) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div>
    <div class="details-section">
      <h4>Quarterly Consumption</h4>
      <div class="capex-quarterly-grid">
        <% [1, 2, 3, 4].each do |quarter| %>
          <% quarterly_consumption = @opex.quarterly_consumption(quarter) %>
          <div class="capex-quarterly-field">
            <div style="font-weight:600; color:var(--pr-ink); margin-bottom:6px;">Q<%= quarter %> <%= @opex.year %></div>
            <div class="stat-currency" style="font-size:13px;">
              Consumed: <%= @opex.currency_symbol %><%= number_with_precision(quarterly_consumption, precision: 2, delimiter: ',') %>
            </div>
            <div style="font-size:12px; color:var(--pr-ink-muted); margin-top:3px;">
              <%= quarterly_consumption > 0 ? ((quarterly_consumption / @opex.send("q#{quarter}_amount")) * 100).round(2) : 0 %>% of Q<%= quarter %> budget
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="details-section" style="margin-top:20px;">
      <h4>Quarterly Distribution</h4>
      <div class="capex-quarterly-grid">
        <% [1, 2, 3, 4].each do |quarter| %>
          <div class="capex-quarterly-field">
            <div style="font-weight:600; color:var(--pr-ink); margin-bottom:6px;">Q<%= quarter %> <%= @opex.year %></div>
            <div class="stat-currency" style="font-size:14px; font-weight:600;">
              <%= @opex.currency_symbol %><%= number_with_precision(@opex.send("q#{quarter}_amount"), precision: 2, delimiter: ',') %>
            </div>
            <div style="font-size:12px; color:var(--pr-ink-muted); margin:4px 0;">
              <%= @opex.quarterly_percentage(quarter) %>% of total
            </div>
            <div class="progress-bar" style="height:6px;">
              <div class="progress-fill" style="width: <%= @opex.quarterly_percentage(quarter) %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Linked Purchase Requests -->
<% if @linked_requests.any? %>
  <div class="details-section" style="margin-top:30px; padding-top:20px; border-top:1px solid var(--pr-border);">
    <h4>Linked Purchase Requests (<%= @linked_requests.count %>)</h4>

    <div class="autoscroll">
      <table class="pr-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Title</th>
            <th>Status</th>
            <th>Author</th>
            <th>Estimated Price</th>
            <th>Proposed Quarter</th>
            <th>Created</th>
            <th class="buttons">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @linked_requests.each do |pr| %>
            <tr class="<%= cycle('odd', 'even') %>">
              <td class="pr-cell-id">
                <%= link_to "##{pr.id}", project_purchase_request_path(@project, pr) %>
              </td>
              <td class="title">
                <%= link_to truncate(pr.title, length: 50), project_purchase_request_path(@project, pr), class: 'pr-title-link' %>
              </td>
              <td class="status">
                <span class="status-badge" style="background-color: <%= pr.status.color.presence || '#777777' %>">
                  <%= pr.status.name %>
                </span>
              </td>
              <td class="author">
                <%= link_to_user pr.user %>
              </td>
              <td class="price">
                <% if pr.estimated_price.present? %>
                  <span class="stat-currency">
                    <%= pr.currency == @opex.currency ? @opex.currency_symbol : pr.currency %>
                    <%= number_with_precision(pr.estimated_price, precision: 2, delimiter: ',') %>
                    <span class="currency-code"><%= pr.currency %></span>
                  </span>
                <% else %>
                  <span class="no-data">-</span>
                <% end %>
              </td>
              <td class="quarter">
                <% if pr.has_quarterly_allocation? %>
                  <span class="pr-badge pr-badge--accent">Q<%= pr.allocated_quarter %></span>
                  <div style="font-size:12px; color:var(--pr-ink-muted); margin-top:2px;">
                    <%= pr.currency == @opex.currency ? @opex.currency_symbol : pr.currency %>
                    <%= number_with_precision(pr.allocated_amount, precision: 2, delimiter: ',') %>
                  </div>
                <% else %>
                  <span class="no-data">-</span>
                <% end %>
              </td>
              <td class="created-on">
                <span class="date-display"><%= format_time(pr.created_at) %></span>
              </td>
              <td class="buttons">
                <div class="pr-table-actions">
                  <%= link_to project_purchase_request_path(@project, pr),
                              class: 'pr-button pr-button-secondary pr-button-icon small',
                              title: 'View' do %>
                    <span class="icon icon-magnifier">View</span>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="details-section" style="margin-top:30px; padding-top:20px; border-top:1px solid var(--pr-border);">
    <h4>Linked Purchase Requests</h4>
    <div class="pr-empty">
      <div class="pr-empty__icon">📋</div>
      <h3>No Linked Purchase Requests</h3>
      <p>No purchase requests are currently linked to this OPEX entry.</p>
      <% if User.current.allowed_to?(:add_purchase_requests, @project) %>
        <p>
          <%= link_to new_project_purchase_request_path(@project, opex_id: @opex.id),
                      class: 'pr-button pr-button-primary pr-button-icon' do %>
            <span class="icon icon-add">Create Purchase Request for this OPEX</span>
          <% end %>
        </p>
      <% end %>
    </div>
  </div>
<% end %>

<div class="pr-form-actions left-aligned" style="margin-top:20px;">
  <%= link_to project_opex_index_path(@project), class: 'pr-button pr-button-cancel' do %>
    Back to OPEX List
  <% end %>
  <% if User.current.allowed_to?(:manage_opex, @project) %>
    <%= link_to edit_project_opex_path(@project, @opex), class: 'pr-button pr-button-primary' do %>
      Edit Entry
    <% end %>
  <% end %>
</div>
