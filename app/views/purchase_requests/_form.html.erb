<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/purchase_requests/_form.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<%= form_for purchase_request,
               url: defined?(form_url) ? form_url : nil,
               html: { multipart: true, id: 'purchase-request-form' } do |form| %>
  <% if purchase_request.errors.any? %>
    <div id="error_explanation" class="flash error">
      <h3><%= l(:label_form_contains_errors, count: purchase_request.errors.count) %></h3>
      <ul>
        <% purchase_request.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div id="tab-general" class="tab-pane tabbed-form active">
    <div class="box tabular general-fields">
      <div class="form-row">
        <p>
          <%= form.label :title, l(:field_title) %> <span class="required">*</span>
          <%= form.text_field :title, required: true, size: 60, maxlength: 255, class: 'form-control' %>
          <em class="info"><%= l(:text_purchase_title_info) %></em>
        </p>
      </div>

      <div class="form-row">
        <p>
          <%= form.label :description, l(:field_description) %>
          <%= form.text_area :description, rows: 6, cols: 60, class: 'wiki-edit form-control' %>
          <em class="info">Provide a detailed description. For purchases over $1,000, minimum 50 characters required for business justification.</em>
        </p>
      </div>

      <div class="form-row">
        <p>
          <%= form.label :status_id, l(:field_status) %> <span class="required">*</span>
          <%= form.collection_select :status_id, PurchaseRequestStatus.sorted, :id, :name,
                                   { selected: purchase_request.status_id || PurchaseRequestStatus.default&.id || PurchaseRequestStatus.first&.id },
                                   { required: true, class: 'form-control' } %>
        </p>
      </div>

      <div class="form-row">
        <p>
          <%= form.label :priority, l(:field_priority) %>
          <%= form.select :priority,
                       [[l(:label_priority_low), 'low'],
                        [l(:label_priority_normal), 'normal'],
                        [l(:label_priority_high), 'high'],
                        [l(:label_priority_urgent), 'urgent']],
                       { selected: purchase_request.priority || 'normal' },
                       { class: 'form-control' } %>
        </p>
      </div>

      <div class="form-row">
        <p>
          <%= form.label :due_date, l(:field_due_date) %>
          <%= form.date_field :due_date, class: 'form-control' %>
          <em class="info"><%= l(:text_due_date_info) %></em>
        </p>
      </div>

    </div>
  </div>

  <div id="tab-details" class="tab-pane tabbed-form" style="display: none;">
    <div class="box tabular detail-fields">
      <div class="form-row">
        <p>
          <%= form.label :product_url, l(:field_product_url) %>
          <%= form.text_field :product_url, size: 60, class: 'form-control', placeholder: 'https://example.com/product' %>
          <em class="info">Product URL must start with http:// or https:// (optional)</em>
        </p>
      </div>

      <div class="form-row">
        <p>
          <%= form.label :estimated_price, l(:field_estimated_price) %>
          <span class="currency-price-wrapper">
            <span class="currency-select-wrapper">
              <%= form.select :currency,
                            currency_options,
                            { selected: purchase_request.currency || Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' },
                            { class: 'currency-select' } %>
            </span>
            <%= form.number_field :estimated_price, min: 0, step: '0.01', class: 'price-field' %>
          </span>
          <em class="info"><%= l(:text_estimated_price_info) %></em>
        </p>
      </div>

      <div class="form-row">
        <p>
          <%= form.label :vendor, l(:field_vendor) %>
        </p>
          <%
            vendors = Vendor.sorted
            allow_custom = Setting.plugin_redmine_purchase_requests['allow_custom_vendors'] == '1'

            if vendors.any?
              current_vendor = nil
              current_vendor_name = nil

              if purchase_request.vendor_id.present?
                current_vendor = Vendor.find_by(id: purchase_request.vendor_id)
                current_vendor_name = current_vendor.try(:name)
              elsif purchase_request.vendor.present?
                current_vendor_name = purchase_request.vendor
              end
          %>
            <div class="vendor-selector">
              <p>
              <% if Redmine::VERSION::MAJOR >= 4 %>
                <%= form.select :vendor_id,
                              vendors.collect{|v| [v.name, v.id]},
                              { include_blank: true, selected: purchase_request.vendor_id },
                              { class: 'vendor-select form-control',
                                'data-autocomplete-url': autocomplete_vendors_path } %>
              <% else %>
                <%= form.select :vendor_id,
                              vendors.collect{|v| [v.name, v.id]},
                              { include_blank: true },
                              { class: 'vendor-select form-control',
                                'data-autocomplete-url': autocomplete_vendors_path } %>
              <% end %>

              <% if allow_custom %>
                <%= form.text_field :vendor, size: 40, class: 'form-control vendor-input',
                                  style: 'display: none;',
                                  placeholder: l(:label_enter_custom_vendor) %>
                <%= check_box_tag 'custom_vendor', '1', purchase_request.vendor_id.blank? && purchase_request.vendor.present?,
                                class: 'custom-vendor-checkbox' %>
                <%= label_tag 'custom_vendor', l(:label_use_custom_vendor), class: 'checkbox-label' %>
              <% end %>
              </p>
            </div>

            <div class="vendor-details" style="display: none;">
              <table class="vendor-info-table">
                <tr id="vendor-id-row" style="display: none;">
                  <td class="vendor-label"><%= l(:field_vendor_id) %>:</td>
                  <td class="vendor-value" id="vendor-id-value"></td>
                </tr>
                <tr id="vendor-address-row" style="display: none;">
                  <td class="vendor-label"><%= l(:field_address) %>:</td>
                  <td class="vendor-value" id="vendor-address-value"></td>
                </tr>
                <tr id="vendor-contact-row" style="display: none;">
                  <td class="vendor-label"><%= l(:field_contact_person) %>:</td>
                  <td class="vendor-value" id="vendor-contact-value"></td>
                </tr>
                <tr id="vendor-phone-row" style="display: none;">
                  <td class="vendor-label"><%= l(:field_phone) %>:</td>
                  <td class="vendor-value" id="vendor-phone-value"></td>
                </tr>
                <tr id="vendor-email-row" style="display: none;">
                  <td class="vendor-label"><%= l(:field_email) %>:</td>
                  <td class="vendor-value" id="vendor-email-value"></td>
                </tr>
              </table>
            </div>
          <% else %>
            <%= form.text_field :vendor, size: 40, class: 'form-control vendor-input' %>
          <% end %>
          <em class="info"><%= l(:text_vendor_info) %></em>
      </div>

      <!-- Budget Section -->
      <div class="form-section">
        <div class="form-section-title">Budget Tracking</div>

        <!-- Budget Type Selection -->
        <div class="form-row">
          <div class="budget-type-container">
            <span class="budget-type-label"><%= l(:label_budget_type) %> <span class="required">*</span></span>
            <div class="budget-type-selector">
              <label class="budget-option">
                <%= radio_button_tag 'budget_type', 'capex', purchase_request.capex_id.present?,
                                   class: 'budget-type-radio', id: 'budget_type_capex' %>
                <span class="budget-type-option">CAPEX (Capital Expenditure)</span>
              </label>

              <label class="budget-option">
                <%= radio_button_tag 'budget_type', 'opex', purchase_request.opex_id.present?,
                                   class: 'budget-type-radio', id: 'budget_type_opex' %>
                <span class="budget-type-option">OPEX (Operational Expenditure)</span>
              </label>

              <label class="budget-option">
                <%= radio_button_tag 'budget_type', 'none', purchase_request.capex_id.blank? && purchase_request.opex_id.blank?,
                                   class: 'budget-type-radio', id: 'budget_type_none' %>
                <span class="budget-type-option"><%= l(:label_no_budget_tracking) %></span>
              </label>
            </div>
            <em class="info"><%= l(:text_budget_type_info) %></em>
          </div>
        </div>

        <!-- TPC Code Selection for No Budget Tracking -->
        <div class="form-row budget-section-none" id="tpc-code-section" style="display: none;">
          <p>
            <%= form.label :tpc_code_id, l(:label_tpc_code) %> <span class="required">*</span>
            <%
              tpc_codes = TpcCode.all.order(:tpc_number)
              if tpc_codes.any?
            %>
              <%= form.select :tpc_code_id,
                            options_from_collection_for_select(tpc_codes, :id, :tpc_number_with_description, purchase_request.tpc_code_id),
                            { include_blank: l(:label_select_tpc_code) },
                            { class: 'form-control', id: 'purchase_request_tpc_code_id' } %>
              <em class="info"><%= l(:text_tpc_code_owner_info) %></em>
            <% else %>
              <div class="no-budget-entry">
                <span class="no-entries-message"><%= l(:text_no_tpc_codes_available) %></span>
                <% if User.current.admin? || User.current.allowed_to?(:manage_global_tpc_codes, nil, global: true) %>
                  <br><em class="info">
                    <%= link_to l(:label_create_tpc_code), new_global_tpc_codes_path,
                              class: 'budget-create-link', target: '_blank' %>
                  </em>
                <% end %>
              </div>
            <% end %>
          </p>
        </div>

        <!-- CAPEX Selection -->
        <div class="form-row budget-section-capex" id="capex-section" style="display: none;">
          <p>
            <%= form.label :capex_id, l(:label_capex_entry) %>
            <%
              capex_entries = @project.capex.for_year(Date.current.year).ordered if @project
              if capex_entries && capex_entries.any?
            %>
              <%= form.select :capex_id,
                            options_from_collection_for_select(capex_entries, :id, :display_name, purchase_request.capex_id),
                            { include_blank: l(:label_select_capex_entry) },
                            { class: 'form-control', id: 'purchase_request_capex_id' } %>
              <em class="info"><%= l(:text_capex_selection_info) %></em>

              <div class="budget-details" id="capex-details" style="display: none;">
                <table class="budget-info-table">
                  <tr>
                    <td class="budget-label"><%= l(:field_capex_year) %>:</td>
                    <td class="budget-value" id="capex-year-value"></td>
                  </tr>
                  <tr>
                    <td class="budget-label"><%= l(:field_capex_total_amount) %>:</td>
                    <td class="budget-value" id="capex-budget-value"></td>
                  </tr>
                  <tr>
                    <td class="budget-label"><%= l(:field_capex_remaining_amount) %>:</td>
                    <td class="budget-value" id="capex-remaining-value"></td>
                  </tr>
                  <tr>
                    <td class="budget-label"><%= l(:field_capex_description) %>:</td>
                    <td class="budget-value" id="capex-description-value"></td>
                  </tr>
                </table>
              </div>
            <% else %>
              <div class="no-budget-entry">
                <span class="no-entries-message"><%= l(:text_no_capex_entries_available) %></span>
                <% if User.current.allowed_to?(:manage_capex, @project) %>
                  <br><em class="info">
                    <%= link_to l(:label_create_capex_entry), new_project_capex_path(@project),
                              class: 'budget-create-link', target: '_blank' %>
                  </em>
                <% end %>
              </div>
            <% end %>
          </p>
        </div>

        <!-- OPEX Selection -->
        <div class="form-row budget-section-opex" id="opex-section" style="display: none;">
          <p>
            <%= form.label :opex_id, l(:label_opex_entry) %>
            <%
              opex_entries = @project.opex.for_year(Date.current.year).ordered if @project
              if opex_entries && opex_entries.any?
            %>
              <%= form.select :opex_id,
                            options_from_collection_for_select(opex_entries, :id, :display_name, purchase_request.opex_id),
                            { include_blank: l(:label_select_opex_entry) },
                            { class: 'form-control', id: 'purchase_request_opex_id' } %>
              <em class="info"><%= l(:text_opex_selection_info) %></em>

              <!-- OPEX Category Selection -->
              <div class="form-row" style="margin-top: 15px;">
                <p>
                  <%= form.label :category_id, l(:field_opex_category) %> <span class="required">*</span>
                  <%= form.collection_select :category_id, OpexCategory.all, :id, :name,
                                           { prompt: l(:label_select_opex_category) },
                                           { required: true, class: 'form-control', id: 'purchase_request_category_id' } %>
                  <em class="info"><%= l(:text_opex_category_info) %></em>
                </p>
              </div>

              <div class="budget-details" id="opex-details" style="display: none;">
                <table class="budget-info-table">
                  <tr>
                    <td class="budget-label"><%= l(:field_opex_year) %>:</td>
                    <td class="budget-value" id="opex-year-value"></td>
                  </tr>
                  <tr>
                    <td class="budget-label"><%= l(:field_opex_total_amount) %>:</td>
                    <td class="budget-value" id="opex-budget-value"></td>
                  </tr>
                  <tr>
                    <td class="budget-label"><%= l(:field_opex_remaining_amount) %>:</td>
                    <td class="budget-value" id="opex-remaining-value"></td>
                  </tr>
                  <tr>
                    <td class="budget-label"><%= l(:field_opex_description) %>:</td>
                    <td class="budget-value" id="opex-description-value"></td>
                  </tr>
                </table>
              </div>
            <% else %>
              <div class="no-budget-entry">
                <span class="no-entries-message"><%= l(:text_no_opex_entries_available) %></span>
                <% if User.current.allowed_to?(:manage_opex, @project) %>
                  <br><em class="info">
                    <%= link_to l(:label_create_opex_entry), new_project_opex_path(@project),
                              class: 'budget-create-link', target: '_blank' %>
                  </em>
                <% end %>
              </div>
            <% end %>
          </p>
        </div>

        <!-- Quarterly Allocation Section -->
        <div class="form-row quarterly-allocation-section" id="quarterly-allocation-section" style="display: none;">
          <div class="form-section">
            <div class="form-section-title"><%= l(:label_quarterly_allocation) %></div>
            <p class="quarterly-allocation-info">
              <em class="info"><%= l(:text_quarterly_allocation_info) %></em>
            </p>

            <div class="quarterly-allocation-fields">
              <div class="form-row pr-field-pair">
                <div>
                  <p>
                    <%= form.label :allocated_quarter, l(:field_allocated_quarter) %>
                    <%= form.select :allocated_quarter,
                                  [[l(:label_quarter_1), 1],
                                   [l(:label_quarter_2), 2],
                                   [l(:label_quarter_3), 3],
                                   [l(:label_quarter_4), 4]],
                                  { include_blank: l(:label_no_specific_quarter) },
                                  { class: 'form-control', id: 'purchase_request_allocated_quarter' } %>
                    <em class="info"><%= l(:text_allocated_quarter_info) %></em>
                  </p>
                </div>

                <div>
                  <p>
                    <%= form.label :allocated_amount, l(:field_allocated_amount) %>
                    <%= form.number_field :allocated_amount,
                                        step: 0.01,
                                        min: 0,
                                        placeholder: l(:text_allocated_amount_placeholder),
                                        class: 'form-control',
                                        id: 'purchase_request_allocated_amount' %>
                    <em class="info"><%= l(:text_allocated_amount_info) %></em>
                  </p>
                </div>
              </div>

              <div class="quarterly-impact-preview" id="quarterly-impact-preview" style="display: none;">
                <div class="form-section">
                  <div class="form-section-title"><%= l(:label_allocation_impact) %></div>
                  <div class="allocation-impact-details">
                    <table class="budget-info-table">
                      <tr>
                        <td class="budget-label"><%= l(:field_selected_quarter) %>:</td>
                        <td class="budget-value" id="impact-quarter-value"></td>
                      </tr>
                      <tr>
                        <td class="budget-label"><%= l(:field_original_quarter_budget) %>:</td>
                        <td class="budget-value" id="impact-original-value"></td>
                      </tr>
                      <tr>
                        <td class="budget-label"><%= l(:field_allocated_amount) %>:</td>
                        <td class="budget-value" id="impact-allocated-value"></td>
                      </tr>
                      <tr>
                        <td class="budget-label"><%= l(:field_remaining_quarter_budget) %>:</td>
                        <td class="budget-value" id="impact-remaining-value"></td>
                      </tr>
                    </table>
                    <div class="allocation-warning" id="allocation-warning" style="display: none;">
                      <span class="icon icon-warning"></span>
                      <strong><%= l(:warning_over_allocation) %></strong>
                      <%= l(:text_over_allocation_warning) %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <div id="tab-attachments" class="tab-pane tabbed-form" style="display: none;">
    <div class="box tabular attachment-fields">
      <div class="form-row">
        <p>
          <%= form.label :notes, l(:label_additional_notes) %>
          <%= form.text_area :notes, rows: 6, cols: 60, placeholder: l(:text_additional_notes_placeholder), class: 'form-control' %>
          <em class="info">Add any additional information, specifications, or requirements for this purchase request.</em>
        </p>
      </div>

      <div class="form-row">
        <p>
          <%= form.check_box :notify_manager, class: 'form-control-checkbox' %>
          <%= form.label :notify_manager, l(:field_notify_manager) %>
          <em class="info"><%= l(:text_notify_manager_info) %></em>
        </p>
      </div>

      <div class="form-row">
        <p>
          <%= form.label :attachment, l(:label_attachment_plural) %>
          <%= form.file_field :attachments, multiple: true, class: 'attachments-field form-control' %>
          <em class="info"><%= l(:text_attachment_info) %></em>
        </p>
      </div>

      <% if purchase_request.attachments.any? %>
        <div class="existing-attachments">
          <h3><%= l(:label_existing_attachments) %></h3>
          <ul>
            <% purchase_request.attachments.each do |attachment| %>
              <li>
                <%= link_to_attachment attachment, class: 'icon icon-attachment' %>
                <span class="size">(<%= number_to_human_size(attachment.filesize) %>)</span>
                <span class="author"><%= attachment.author.name %>, <%= format_time(attachment.created_on) %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-instructions">
        <div class="form-section">
          <div class="form-section-title">Final Review</div>
          <p><strong>Before submitting your purchase request, please review:</strong></p>
          <ul>
            <li>All required fields are filled correctly</li>
            <li>Product specifications and vendor information are accurate</li>
            <li>Budget allocation is appropriate (CAPEX vs OPEX)</li>
            <li>Any supporting documents are attached</li>
            <li>Manager notification is set as needed</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <% unless purchase_request.new_record? %>
  <div id="tab-workflow" class="tab-pane tabbed-form" style="display: none;">
    <div class="box tabular workflow-section">
      <h3><%= l(:label_workflow_status) %></h3>

      <% if purchase_request.has_linked_issue? %>
        <div class="workflow-main-issue">
          <div class="workflow-issue-header">
            <span class="icon icon-issue"></span>
            <strong><%= l(:label_linked_issue) %>:</strong>
            <%= link_to "##{purchase_request.issue.id}: #{purchase_request.issue.subject}",
                        issue_path(purchase_request.issue),
                        class: 'workflow-issue-link' %>
            <span class="issue-status-badge">
              <%= purchase_request.issue.status.name %>
            </span>
          </div>

          <div class="workflow-progress-container">
            <div class="workflow-progress-label">
              <span><%= l(:label_workflow_progress) %></span>
              <span class="progress-percentage"><%= purchase_request.workflow_progress %>%</span>
            </div>
            <div class="workflow-progress-bar">
              <div class="workflow-progress-fill" style="width: <%= purchase_request.workflow_progress %>%;"></div>
            </div>
          </div>

          <% if purchase_request.subtask_issues.any? %>
            <div class="workflow-subtasks">
              <h4><%= l(:label_workflow_subtasks) %></h4>
              <table class="workflow-subtasks-table">
                <thead>
                  <tr>
                    <th><%= l(:field_subject) %></th>
                    <th><%= l(:field_status) %></th>
                    <th><%= l(:field_assigned_to) %></th>
                    <th><%= l(:field_done_ratio) %></th>
                  </tr>
                </thead>
                <tbody>
                  <% purchase_request.subtask_issues.order(:id).each do |subtask| %>
                    <tr class="<%= subtask.status.is_closed? ? 'subtask-completed' : 'subtask-pending' %>">
                      <td><%= link_to "##{subtask.id}: #{subtask.subject}", issue_path(subtask) %></td>
                      <td>
                        <span class="subtask-status-badge">
                          <%= subtask.status.name %>
                        </span>
                      </td>
                      <td><%= subtask.assigned_to&.name || '-' %></td>
                      <td><%= subtask.done_ratio %>%</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% end %>

          <% if purchase_request.all_subtasks_completed? %>
            <div class="workflow-complete-notice">
              <span class="icon icon-checked"></span>
              <%= l(:notice_workflow_complete) %>
            </div>
          <% end %>
        </div>
      <% elsif purchase_request.workflow_enabled? %>
        <div class="workflow-not-started">
          <div class="workflow-notice">
            <span class="icon icon-info"></span>
            <%= l(:notice_workflow_not_started) %>
          </div>
          <% if User.current.allowed_to?(:edit_purchase_requests, @project) %>
            <%= link_to create_workflow_issue_project_purchase_request_path(@project, purchase_request),
                        method: :post,
                        class: 'pr-button pr-button-primary workflow-create-button' do %>
              <span class="icon icon-add"></span>
              <%= l(:button_create_workflow_issue) %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="workflow-not-enabled">
          <div class="workflow-notice">
            <span class="icon icon-warning"></span>
            <%= l(:text_workflow_not_enabled) %>
          </div>
          <% if User.current.admin? %>
            <p class="workflow-setup-hint">
              <%= link_to l(:label_configure_workflow, default: 'Configure Workflow'),
                          plugin_settings_path('redmine_purchase_requests', anchor: 'workflow'),
                          class: 'icon icon-settings' %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>

  <div class="pr-form-actions">
    <% if purchase_request.new_record? %>
      <%= form.submit defined?(button_label) ? button_label : l(:button_create), class: 'pr-button pr-button-primary' %>
    <% else %>
      <%= form.submit defined?(button_label) ? button_label : l(:button_save), class: 'pr-button pr-button-primary' %>
    <% end %>
    <%= link_to l(:button_cancel), defined?(cancel_path) ? cancel_path : project_purchase_requests_path(@project), class: 'pr-button pr-button-cancel' %>
  </div>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Tab functionality
  function showTab(targetTabId) {
    // Hide all tab panes
    var tabPanes = document.querySelectorAll('.tab-pane');
    tabPanes.forEach(function(pane) {
      pane.style.display = 'none';
    });

    // Remove active class from all tabs
    var tabs = document.querySelectorAll('.pr-tab');
    tabs.forEach(function(tab) {
      tab.classList.remove('active');
    });

    // Show target tab and mark as active
    var targetTab = document.getElementById(targetTabId);
    var targetLink = document.querySelector('[href="#' + targetTabId + '"]');

    if (targetTab) targetTab.style.display = 'block';
    if (targetLink) targetLink.classList.add('active');
  }

  // Tab click handlers
  var tabLinks = document.querySelectorAll('.pr-tabs a');
  tabLinks.forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      var targetTabId = this.getAttribute('href').substring(1);
      showTab(targetTabId);
    });
  });

  // Show first tab by default
  showTab('tab-general');

  // Budget type radio button functionality
  var budgetTypeRadios = document.querySelectorAll('.budget-type-radio');
  var capexSection = document.getElementById('capex-section');
  var opexSection = document.getElementById('opex-section');
  var tpcCodeSection = document.getElementById('tpc-code-section');
  var capexSelect = document.getElementById('purchase_request_capex_id');
  var opexSelect = document.getElementById('purchase_request_opex_id');
  var tpcCodeSelect = document.getElementById('purchase_request_tpc_code_id');

  function toggleBudgetSections() {
    var selectedType = document.querySelector('.budget-type-radio:checked');
    var categorySelect = document.getElementById('purchase_request_category_id');

    if (selectedType) {
      if (selectedType.value === 'capex') {
        capexSection.style.display = 'block';
        opexSection.style.display = 'none';
        tpcCodeSection.style.display = 'none';
        if (opexSelect) opexSelect.value = '';
        if (tpcCodeSelect) tpcCodeSelect.value = '';
        if (categorySelect) {
          categorySelect.removeAttribute('required');
          categorySelect.value = '';
        }
        if (tpcCodeSelect) {
          tpcCodeSelect.removeAttribute('required');
        }
      } else if (selectedType.value === 'opex') {
        opexSection.style.display = 'block';
        capexSection.style.display = 'none';
        tpcCodeSection.style.display = 'none';
        if (capexSelect) capexSelect.value = '';
        if (tpcCodeSelect) tpcCodeSelect.value = '';
        if (categorySelect) {
          categorySelect.setAttribute('required', 'required');
        }
        if (tpcCodeSelect) {
          tpcCodeSelect.removeAttribute('required');
        }
      } else {
        capexSection.style.display = 'none';
        opexSection.style.display = 'none';
        tpcCodeSection.style.display = 'block';
        if (capexSelect) capexSelect.value = '';
        if (opexSelect) opexSelect.value = '';
        if (categorySelect) {
          categorySelect.removeAttribute('required');
          categorySelect.value = '';
        }
        if (tpcCodeSelect) {
          tpcCodeSelect.setAttribute('required', 'required');
        }
      }
    }
  }

  // Budget type change handlers
  budgetTypeRadios.forEach(function(radio) {
    radio.addEventListener('change', toggleBudgetSections);
  });

  // Add click handlers for budget options to make the entire div clickable
  var budgetOptions = document.querySelectorAll('.budget-option');
  budgetOptions.forEach(function(option) {
    option.addEventListener('click', function() {
      var radio = this.querySelector('.budget-type-radio');
      if (radio) {
        radio.checked = true;
        toggleBudgetSections();
      }
    });
  });

  // Initialize budget sections on page load
  initializeBudgetType();
  toggleBudgetSections();

  // Function to initialize budget type based on pre-selected values
  function initializeBudgetType() {
    var capexSelected = capexSelect && capexSelect.value;
    var opexSelected = opexSelect && opexSelect.value;

    if (capexSelected) {
      document.getElementById('budget_type_capex').checked = true;
    } else if (opexSelected) {
      document.getElementById('budget_type_opex').checked = true;
    } else {
      var anyChecked = document.querySelector('.budget-type-radio:checked');
      if (!anyChecked) {
        document.getElementById('budget_type_none').checked = true;
      }
    }
  }

  // Budget tracking functionality
  var capexDetails = document.getElementById('capex-details');
  var opexDetails = document.getElementById('opex-details');

  // Handle CAPEX selection changes
  if (capexSelect && capexDetails) {
    capexSelect.addEventListener('change', function() {
      if (this.value) {
        capexDetails.style.display = 'block';
      } else {
        capexDetails.style.display = 'none';
      }
    });
  }

  // Handle OPEX selection changes
  if (opexSelect && opexDetails) {
    opexSelect.addEventListener('change', function() {
      if (this.value) {
        opexDetails.style.display = 'block';
      } else {
        opexDetails.style.display = 'none';
      }
    });
  }

  // Initialize budget details on page load
  if (capexSelect && capexSelect.value && capexDetails) {
    capexDetails.style.display = 'block';
  }
  if (opexSelect && opexSelect.value && opexDetails) {
    opexDetails.style.display = 'block';
  }

  // Load CAPEX data for selected entry
  function loadCapexData(capexId) {
    if (!capexId || !capexDetails) return;

    capexDetails.style.display = 'block';

    const yearValue = document.getElementById('capex-year-value');
    const budgetValue = document.getElementById('capex-budget-value');
    const remainingValue = document.getElementById('capex-remaining-value');
    const descriptionValue = document.getElementById('capex-description-value');

    if (yearValue) yearValue.textContent = new Date().getFullYear();
    if (budgetValue) budgetValue.textContent = 'Loading budget data...';
    if (remainingValue) remainingValue.textContent = 'Loading remaining budget...';
    if (descriptionValue) descriptionValue.textContent = 'Loading CAPEX description...';
  }

  // Load OPEX data for selected entry
  function loadOpexData(opexId) {
    if (!opexId || !opexDetails) return;

    opexDetails.style.display = 'block';

    const yearValue = document.getElementById('opex-year-value');
    const budgetValue = document.getElementById('opex-budget-value');
    const remainingValue = document.getElementById('opex-remaining-value');
    const descriptionValue = document.getElementById('opex-description-value');

    if (yearValue) yearValue.textContent = new Date().getFullYear();
    if (budgetValue) budgetValue.textContent = 'Loading budget data...';
    if (remainingValue) remainingValue.textContent = 'Loading remaining budget...';
    if (descriptionValue) descriptionValue.textContent = 'Loading OPEX description...';
  }

  // Initialize budget sections visibility on page load
  initializeBudgetType();
  toggleBudgetSections();

  // Load existing budget details if editing
  if (capexSelect && capexSelect.value) {
    loadCapexData(capexSelect.value);
  }
  if (opexSelect && opexSelect.value) {
    loadOpexData(opexSelect.value);
  }

  // Quarterly allocation functionality
  var quarterlyAllocationSection = document.getElementById('quarterly-allocation-section');
  var allocatedQuarterSelect = document.getElementById('purchase_request_allocated_quarter');
  var allocatedAmountInput = document.getElementById('purchase_request_allocated_amount');
  var quarterlyImpactPreview = document.getElementById('quarterly-impact-preview');
  var allocationWarning = document.getElementById('allocation-warning');

  // Show/hide quarterly allocation section based on budget selection
  function toggleQuarterlyAllocationSection() {
    var selectedBudgetType = document.querySelector('.budget-type-radio:checked');
    var hasBudgetSelected = selectedBudgetType && selectedBudgetType.value !== 'none';
    var hasBudgetEntry = (capexSelect && capexSelect.value) || (opexSelect && opexSelect.value);

    if (hasBudgetSelected && hasBudgetEntry) {
      quarterlyAllocationSection.style.display = 'block';
    } else {
      quarterlyAllocationSection.style.display = 'none';
      if (allocatedQuarterSelect) allocatedQuarterSelect.value = '';
      if (allocatedAmountInput) allocatedAmountInput.value = '';
      if (quarterlyImpactPreview) quarterlyImpactPreview.style.display = 'none';
    }
  }

  // Update quarterly impact preview
  function updateQuarterlyImpactPreview() {
    if (!allocatedQuarterSelect || !allocatedAmountInput || !quarterlyImpactPreview) return;

    var selectedQuarter = allocatedQuarterSelect.value;
    var allocatedAmount = parseFloat(allocatedAmountInput.value) || 0;

    if (selectedQuarter && allocatedAmount > 0) {
      var selectedBudgetType = document.querySelector('.budget-type-radio:checked');

      if (selectedBudgetType && selectedBudgetType.value === 'capex' && capexSelect && capexSelect.value) {
        getCapexQuarterlyData(capexSelect.value, selectedQuarter)
          .then(function(budgetData) {
            displayQuarterlyImpact(selectedQuarter, budgetData, allocatedAmount);
            quarterlyImpactPreview.style.display = 'block';
          })
          .catch(function(error) {
            console.error('Error fetching CAPEX quarterly data:', error);
            quarterlyImpactPreview.style.display = 'none';
          });
      } else if (selectedBudgetType && selectedBudgetType.value === 'opex' && opexSelect && opexSelect.value) {
        getOpexQuarterlyData(opexSelect.value, selectedQuarter)
          .then(function(budgetData) {
            displayQuarterlyImpact(selectedQuarter, budgetData, allocatedAmount);
            quarterlyImpactPreview.style.display = 'block';
          })
          .catch(function(error) {
            console.error('Error fetching OPEX quarterly data:', error);
            quarterlyImpactPreview.style.display = 'none';
          });
      } else {
        quarterlyImpactPreview.style.display = 'none';
      }
    } else {
      quarterlyImpactPreview.style.display = 'none';
    }
  }

  // Display quarterly impact information
  function displayQuarterlyImpact(quarter, budgetData, allocatedAmount) {
    var quarterValue = document.getElementById('impact-quarter-value');
    var originalValue = document.getElementById('impact-original-value');
    var allocatedValue = document.getElementById('impact-allocated-value');
    var remainingValue = document.getElementById('impact-remaining-value');

    var originalAmount = parseFloat(budgetData.original) || 0;
    var allocatedAmountNum = parseFloat(allocatedAmount) || 0;
    var remaining = originalAmount - allocatedAmountNum;

    if (quarterValue) quarterValue.textContent = 'Q' + quarter;
    if (originalValue) originalValue.textContent = formatCurrency(originalAmount, budgetData.currency);
    if (allocatedValue) allocatedValue.textContent = formatCurrency(allocatedAmountNum, budgetData.currency);

    if (remainingValue) {
      remainingValue.textContent = formatCurrency(remaining, budgetData.currency);
      remainingValue.className = 'budget-value ' + (remaining < 0 ? 'over-allocated' : 'within-budget');
    }

    if (allocationWarning) {
      allocationWarning.style.display = remaining < 0 ? 'block' : 'none';
    }
  }

  // Get quarterly data from server via AJAX
  function getCapexQuarterlyData(capexId, quarter) {
    return new Promise(function(resolve, reject) {
      if (!capexId || !quarter) {
        resolve({ original: 0, currency: 'USD' });
        return;
      }

      var url = '/projects/<%= @project.id %>/capex/' + capexId + '/quarterly_data?quarter=' + quarter;
      console.log('Fetching CAPEX quarterly data from:', url);

      var xhr = new XMLHttpRequest();
      xhr.open('GET', url, true);
      xhr.setRequestHeader('Accept', 'application/json');
      xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

      var token = document.querySelector('meta[name="csrf-token"]');
      if (token) {
        xhr.setRequestHeader('X-CSRF-Token', token.getAttribute('content'));
      }

      xhr.onreadystatechange = function() {
        if (xhr.readyState === 4) {
          if (xhr.status === 200) {
            try {
              var data = JSON.parse(xhr.responseText);
              console.log('CAPEX quarterly data received:', data);
              resolve(data);
            } catch (e) {
              console.error('Error parsing CAPEX response:', e);
              reject(e);
            }
          } else {
            console.error('CAPEX request failed with status:', xhr.status);
            reject(new Error('Failed to fetch CAPEX data'));
          }
        }
      };

      xhr.send();
    });
  }

  function getOpexQuarterlyData(opexId, quarter) {
    return new Promise(function(resolve, reject) {
      if (!opexId || !quarter) {
        resolve({ original: 0, currency: 'USD' });
        return;
      }

      var url = '/projects/<%= @project.id %>/opex/' + opexId + '/quarterly_data?quarter=' + quarter;
      console.log('Fetching OPEX quarterly data from:', url);

      var xhr = new XMLHttpRequest();
      xhr.open('GET', url, true);
      xhr.setRequestHeader('Accept', 'application/json');
      xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

      var token = document.querySelector('meta[name="csrf-token"]');
      if (token) {
        xhr.setRequestHeader('X-CSRF-Token', token.getAttribute('content'));
      }

      xhr.onreadystatechange = function() {
        if (xhr.readyState === 4) {
          if (xhr.status === 200) {
            try {
              var data = JSON.parse(xhr.responseText);
              console.log('OPEX quarterly data received:', data);
              resolve(data);
            } catch (e) {
              console.error('Error parsing OPEX response:', e);
              reject(e);
            }
          } else {
            console.error('OPEX request failed with status:', xhr.status);
            reject(new Error('Failed to fetch OPEX data'));
          }
        }
      };

      xhr.send();
    });
  }

  // Format currency helper
  function formatCurrency(amount, currency) {
    var symbol = getCurrencySymbol(currency || 'USD');
    var numericAmount = parseFloat(amount) || 0;
    return symbol + numericAmount.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
  }

  // Get currency symbol helper — map is rendered server-side from CURRENCY_SYMBOLS constant
  var _currencySymbols = <%= PurchaseRequestsHelper::CURRENCY_SYMBOLS.to_json.html_safe %>;
  function getCurrencySymbol(currency) {
    return _currencySymbols[currency] || currency;
  }

  // Event listeners for quarterly allocation
  if (allocatedQuarterSelect) {
    allocatedQuarterSelect.addEventListener('change', updateQuarterlyImpactPreview);
  }
  if (allocatedAmountInput) {
    allocatedAmountInput.addEventListener('input', updateQuarterlyImpactPreview);
  }

  // Update quarterly allocation section when budget changes
  budgetTypeRadios.forEach(function(radio) {
    radio.addEventListener('change', function() {
      toggleBudgetSections();
      setTimeout(function() {
        toggleQuarterlyAllocationSection();
      }, 100);
    });
  });

  if (capexSelect) {
    capexSelect.addEventListener('change', function() {
      toggleQuarterlyAllocationSection();
      updateQuarterlyImpactPreview();
    });
  }

  if (opexSelect) {
    opexSelect.addEventListener('change', function() {
      toggleQuarterlyAllocationSection();
      updateQuarterlyImpactPreview();
    });
  }

  // Initialize quarterly allocation section
  toggleQuarterlyAllocationSection();

  // Form validation
  function validateForm() {
    var selectedBudgetType = document.querySelector('.budget-type-radio:checked');
    var categorySelect = document.getElementById('purchase_request_category_id');

    if (selectedBudgetType && selectedBudgetType.value !== 'none') {
      if (selectedBudgetType.value === 'capex' && (!capexSelect || !capexSelect.value)) {
        alert('Please select a CAPEX entry when CAPEX budget type is selected.');
        return false;
      }
      if (selectedBudgetType.value === 'opex') {
        if (!opexSelect || !opexSelect.value) {
          alert('Please select an OPEX entry when OPEX budget type is selected.');
          return false;
        }
        if (!categorySelect || !categorySelect.value) {
          alert('Please select an OPEX category when OPEX budget type is selected.');
          return false;
        }
      }
    }

    // Validate quarterly allocation consistency
    if (allocatedQuarterSelect && allocatedAmountInput) {
      var hasQuarter = allocatedQuarterSelect.value;
      var hasAmount = allocatedAmountInput.value && parseFloat(allocatedAmountInput.value) > 0;

      if (hasQuarter && !hasAmount) {
        alert('Please enter an allocated amount when selecting a quarter.');
        return false;
      }

      if (hasAmount && !hasQuarter) {
        alert('Please select a quarter when entering an allocated amount.');
        return false;
      }

      var estimatedPriceInput = document.getElementById('purchase_request_estimated_price');
      if (hasAmount && estimatedPriceInput && estimatedPriceInput.value) {
        var estimatedPrice = parseFloat(estimatedPriceInput.value);
        var allocatedAmount = parseFloat(allocatedAmountInput.value);

        if (allocatedAmount > estimatedPrice) {
          alert('Allocated amount cannot exceed the estimated price.');
          return false;
        }
      }
    }

    return true;
  }

  // Attach validation to form submit
  var form = document.getElementById('purchase-request-form');
  if (form) {
    form.addEventListener('submit', function(e) {
      if (!validateForm()) {
        e.preventDefault();
        return false;
      }
    });
  }
});
</script>
