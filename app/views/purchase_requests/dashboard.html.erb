<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title l(:label_purchase_request_dashboard) %>


<h2><%= l(:label_purchase_request_dashboard) %></h2>

<div class="contextual">
  <%= link_to project_purchase_requests_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-list"><%= l(:label_purchase_requests) %></span>
  <% end %>
  <%= link_to new_project_purchase_request_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
    <span class="icon icon-add"><%= l(:label_new_purchase_request) %></span>
  <% end %>
  <% if User.current.allowed_to?(:view_tpc_codes, @project) %>
    <%= link_to project_tpc_codes_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
      <span class="icon icon-projects"><%= l(:label_tpc_codes) %></span>
    <% end %>
  <% end %>
</div>

<!-- Year Filter -->
<%= render 'shared/dashboard_filters',
      year_mode: :list,
      selected_year: @selected_year,
      available_years: @available_years,
      available_tpc_codes: @available_tpc_codes,
      selected_tpc_code_id: @selected_tpc_code_id %>

<div class="summary-stats">
  <div class="stat-box pr-stat--accent">
    <div class="stat-number"><%= @total_requests %></div>
    <div class="stat-label"><%= l(:label_total_requests) %></div>
  </div>

  <div class="stat-box pr-stat--warning">
    <div class="stat-number"><%= @open_requests %></div>
    <div class="stat-label"><%= l(:label_open_requests) %></div>
  </div>

  <div class="stat-box pr-stat--success">
    <div class="stat-number"><%= @closed_requests %></div>
    <div class="stat-label"><%= l(:label_closed_requests) %></div>
  </div>

  <%
    summary_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
    summary_symbol = currency_symbol(summary_currency)
  %>
  <div class="stat-box pr-stat--violet">
    <div class="stat-number stat-currency"><%= summary_symbol %><%= number_with_precision(@total_estimated_cost, precision: 2, delimiter: ',') %></div>
    <div class="stat-label"><%= l(:label_total_estimated_cost) %></div>
  </div>
</div>

<div class="dashboard-container">
  <!-- Status Distribution Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_status_distribution) %></h3>
    </div>
    <div class="dashboard-card-body">
      <% if @status_distribution.present? && @status_distribution.any? %>
        <div class="chart-pie-container">
          <div class="chart-pie" id="status-pie-chart"></div>
          <div class="chart-pie-legend">
            <% @status_distribution.each do |status| %>
              <div class="legend-item">
                <div class="legend-color" style="background-color: <%= status[:color].presence || '#6b7280' %>;"></div>
                <span><%= status[:name] %> (<%= status[:count] %> - <%= status[:percentage] %>%)</span>
              </div>
            <% end %>
          </div>
        </div>

        <table class="dashboard-table">
          <caption class="sr-only">Purchase requests by status</caption>
          <thead>
            <tr>
              <th scope="col"><%= l(:field_status) %></th>
              <th scope="col"><%= l(:label_count) %></th>
              <th scope="col"><%= l(:label_percentage) %></th>
            </tr>
          </thead>
          <tbody>
          <% @status_distribution.each do |status| %>
            <tr>
              <td>
                <span class="pr-swatch" style="background-color: <%= status[:color].presence || '#6b7280' %>;"></span>
                <%= status[:name] %>
              </td>
              <td><%= status[:count] %></td>
              <td><%= status[:percentage] %>%</td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  <!-- Priority Distribution Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_priority_distribution) %></h3>
    </div>
    <div class="dashboard-card-body">
      <% if @priority_distribution.present? && @priority_distribution.values.sum > 0 %>
        <div class="chart-pie-container">
          <div class="chart-pie" id="priority-pie-chart"></div>
          <div class="chart-pie-legend">
            <div class="legend-item">
              <div class="legend-color" style="background-color: #dc3a3a;"></div>
              <span><%= l(:label_priority_urgent) %> (<%= @priority_distribution[:urgent] %> - <%= @priority_percentages[:urgent] %>%)</span>
            </div>
            <div class="legend-item">
              <div class="legend-color" style="background-color: #df8709;"></div>
              <span><%= l(:label_priority_high) %> (<%= @priority_distribution[:high] %> - <%= @priority_percentages[:high] %>%)</span>
            </div>
            <div class="legend-item">
              <div class="legend-color" style="background-color: #2f9e44;"></div>
              <span><%= l(:label_priority_normal) %> (<%= @priority_distribution[:normal] %> - <%= @priority_percentages[:normal] %>%)</span>
            </div>
            <div class="legend-item">
              <div class="legend-color" style="background-color: #2272c4;"></div>
              <span><%= l(:label_priority_low) %> (<%= @priority_distribution[:low] %> - <%= @priority_percentages[:low] %>%)</span>
            </div>
          </div>
        </div>

        <table class="dashboard-table">
          <caption class="sr-only">Purchase requests by priority</caption>
          <thead>
            <tr>
              <th scope="col"><%= l(:field_priority) %></th>
              <th scope="col"><%= l(:label_count) %></th>
              <th scope="col"><%= l(:label_percentage) %></th>
            </tr>
          </thead>
          <tbody>
          <tr>
            <td><span class="pr-swatch" style="background-color: #dc3a3a;"></span><%= l(:label_priority_urgent) %></td>
            <td><%= @priority_distribution[:urgent] %></td>
            <td><%= @priority_percentages[:urgent] %>%</td>
          </tr>
          <tr>
            <td><span class="pr-swatch" style="background-color: #df8709;"></span><%= l(:label_priority_high) %></td>
            <td><%= @priority_distribution[:high] %></td>
            <td><%= @priority_percentages[:high] %>%</td>
          </tr>
          <tr>
            <td><span class="pr-swatch" style="background-color: #2f9e44;"></span><%= l(:label_priority_normal) %></td>
            <td><%= @priority_distribution[:normal] %></td>
            <td><%= @priority_percentages[:normal] %>%</td>
          </tr>
          <tr>
            <td><span class="pr-swatch" style="background-color: #2272c4;"></span><%= l(:label_priority_low) %></td>
            <td><%= @priority_distribution[:low] %></td>
            <td><%= @priority_percentages[:low] %>%</td>
          </tr>
          </tbody>
        </table>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  <!-- Financial Overview Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_financial_overview) %></h3>
    </div>
    <div class="dashboard-card-body">
      <table class="dashboard-table">
        <caption class="sr-only">Financial overview</caption>
        <%
          default_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
          default_symbol = currency_symbol(default_currency)
        %>
        <tbody>
        <tr>
          <th scope="row"><%= l(:label_total_estimated_cost) %></th>
          <td class="stat-currency">
            <%= default_symbol %><%= number_with_precision(@total_estimated_cost, precision: 2, delimiter: ',') %>
            <span class="currency-code"><%= default_currency %></span>
          </td>
        </tr>
        <tr>
          <th scope="row"><%= l(:label_pending_cost) %></th>
          <td class="stat-currency">
            <%= default_symbol %><%= number_with_precision(@pending_cost, precision: 2, delimiter: ',') %>
            <span class="currency-code"><%= default_currency %></span>
          </td>
        </tr>
        <tr>
          <th scope="row"><%= l(:label_approved_cost) %></th>
          <td class="stat-currency">
            <%= default_symbol %><%= number_with_precision(@approved_cost, precision: 2, delimiter: ',') %>
            <span class="currency-code"><%= default_currency %></span>
          </td>
        </tr>
        <tr>
          <th scope="row"><%= l(:label_average_request_amount) %></th>
          <td class="stat-currency">
            <% avg = @total_requests > 0 ? @total_estimated_cost / @total_requests : 0 %>
            <%= default_symbol %><%= number_with_precision(avg, precision: 2, delimiter: ',') %>
            <span class="currency-code"><%= default_currency %></span>
          </td>
        </tr>

        <% if @currency_distribution && @currency_distribution.size > 1 %>
          <tr>
            <th colspan="2" class="section-header"><%= l(:label_currency_breakdown) %></th>
          </tr>
          <% @currency_distribution.each do |currency, amount| %>
            <tr>
              <th scope="row"><%= currency %></th>
              <td class="stat-currency">
                <%= currency_symbol(currency) %><%= number_with_precision(amount, precision: 2, delimiter: ',') %>
              </td>
            </tr>
          <% end %>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Top Requesters Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_top_requesters) %></h3>
    </div>
    <div class="dashboard-card-body">
      <% if @top_requesters.present? && @top_requesters.any? %>
        <table class="dashboard-table">
          <caption class="sr-only">Top requesters</caption>
          <thead>
            <tr>
              <th scope="col"><%= l(:field_user) %></th>
              <th scope="col"><%= l(:label_requests) %></th>
              <th scope="col"><%= l(:label_total_cost) %></th>
            </tr>
          </thead>
          <tbody>
          <%
            requester_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
            requester_symbol = currency_symbol(requester_currency)
          %>
          <% @top_requesters.each do |user| %>
            <tr>
              <td><%= link_to(user.name.presence || user.login, user_path(user)) %></td>
              <td><%= user.request_count %></td>
              <td class="stat-currency"><%= requester_symbol %><%= number_with_precision(user.total_cost, precision: 2, delimiter: ',') %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  <!-- Monthly Trends Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_monthly_trends) %></h3>
    </div>
    <div class="dashboard-card-body">
      <% if @monthly_trends.present? && @monthly_trends.any? %>
        <div class="chart-bar-container" id="monthly-trends-chart"></div>

        <table class="dashboard-table">
          <caption class="sr-only">Monthly purchase request trends</caption>
          <thead>
            <tr>
              <th scope="col"><%= l(:label_month) %></th>
              <th scope="col"><%= l(:label_requests) %></th>
              <th scope="col"><%= l(:label_amount) %></th>
            </tr>
          </thead>
          <tbody>
          <% @monthly_trends.each do |trend| %>
            <tr>
              <td><%= trend[:month] %></td>
              <td><%= trend[:count] %></td>
              <td class="stat-currency">
                <%= currency_symbol(default_currency) %><%= number_with_precision(trend[:amount], precision: 2, delimiter: ',') %>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  <!-- Recent Activity Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_recent_requests) %></h3>
    </div>
    <div class="dashboard-card-body">
      <% if @recent_requests.present? && @recent_requests.any? %>
        <table class="dashboard-table">
          <caption class="sr-only">Recent purchase requests</caption>
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col"><%= l(:field_title) %></th>
              <th scope="col"><%= l(:field_status) %></th>
              <th scope="col"><%= l(:field_created_on) %></th>
            </tr>
          </thead>
          <tbody>
          <% @recent_requests.each do |request| %>
            <tr>
              <td><%= link_to "##{request.id}", project_purchase_request_path(@project, request), class: 'pr-id-link' %></td>
              <td><%= link_to truncate(request.title, length: 30), project_purchase_request_path(@project, request), class: 'pr-title-link' %></td>
              <td>
                <span class="status-badge" style="background-color: <%= request.status.display_color %>; color: <%= readable_text_color(request.status.display_color) %>">
                  <%= request.status.name %>
                </span>
              </td>
              <td><%= format_time(request.created_at) %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  <!-- Top Vendors Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_top_vendors) %></h3>
    </div>
    <div class="dashboard-card-body">
      <% if @top_vendors.present? && @top_vendors.any? %>
        <table class="dashboard-table">
          <caption class="sr-only">Top vendors by purchase requests</caption>
          <thead>
            <tr>
              <th scope="col"><%= l(:field_vendor) %></th>
              <th scope="col"><%= l(:label_requests) %></th>
              <th scope="col"><%= l(:label_total_cost) %></th>
            </tr>
          </thead>
          <tbody>
          <%
            vendor_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
            vendor_symbol = currency_symbol(vendor_currency)
          %>
          <% @top_vendors.each do |vendor| %>
            <tr>
              <td><%= vendor[:vendor] %></td>
              <td><%= vendor[:count] %></td>
              <td class="stat-currency"><%= vendor_symbol %><%= number_with_precision(vendor[:total_cost], precision: 2, delimiter: ',') %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  <!-- TPC Code Distribution Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3>Budget Distribution by TPC Code</h3>
    </div>
    <div class="dashboard-card-body">
      <% if @tpc_distribution.present? && @tpc_distribution.any? %>
        <table class="dashboard-table">
          <caption class="sr-only">Budget distribution by TPC code</caption>
          <thead>
            <tr>
              <th scope="col">TPC Code</th>
              <th scope="col">Requests</th>
              <th scope="col">Total Cost</th>
            </tr>
          </thead>
          <tbody>
          <%
            tpc_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
            tpc_symbol = currency_symbol(tpc_currency)
          %>
          <% @tpc_distribution.each do |tpc| %>
            <tr>
              <td class="tpc-code-cell"><strong><%= tpc[:tpc_code] %></strong></td>
              <td><%= tpc[:count] %></td>
              <td class="stat-currency"><%= tpc_symbol %><%= number_with_precision(tpc[:total_cost], precision: 2, delimiter: ',') %></td>
            </tr>
          <% end %>
          </tbody>
        </table>

        <div class="chart-bar-container" id="tpc-distribution-chart"></div>
      <% else %>
        <p class="nodata">No TPC code data available</p>
      <% end %>
    </div>
  </div>

  <!-- Response Time Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_average_response_time) %></h3>
    </div>
    <div class="dashboard-card-body">
      <div class="stat-box pr-stat--accent">
        <div class="stat-number"><%= @avg_response_days %> <%= l(:label_days) %></div>
        <div class="stat-label"><%= l(:label_avg_processing_time) %></div>
      </div>
    </div>
  </div>

  <!-- Currency Breakdown with Conversion Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_currency_breakdown_with_conversion) %></h3>
    </div>
    <div class="dashboard-card-body">
      <% if @converted_currency_distribution && @converted_currency_distribution.any? %>
        <table class="dashboard-table">
          <caption class="sr-only">Currency breakdown with conversion</caption>
          <thead>
            <tr>
              <th scope="col"><%= l(:field_currency) %></th>
              <th scope="col"><%= l(:label_original_amount) %></th>
              <th scope="col"><%= l(:label_equivalent_in_default) %></th>
            </tr>
          </thead>
          <tbody>
          <%
            default_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
          %>
          <% @converted_currency_distribution.each do |currency, data| %>
            <tr>
              <th scope="row"><%= currency %></th>
              <td class="stat-currency">
                <%= currency_symbol(currency) %><%= number_with_precision(data[:original], precision: 2, delimiter: ',') %>
              </td>
              <td class="stat-currency">
                <%= currency_symbol(default_currency) %><%= number_with_precision(data[:converted], precision: 2, delimiter: ',') %>
              </td>
            </tr>
          <% end %>
          <tr class="total-row">
            <th scope="row"><%= l(:label_total_in) %> <%= default_currency %></th>
            <td></td>
            <td class="stat-currency total-value">
              <%= currency_symbol(default_currency) %><%= number_with_precision(@total_estimated_cost, precision: 2, delimiter: ',') %>
            </td>
          </tr>
          </tbody>
        </table>

        <%
          exchange_rates = Setting.plugin_redmine_purchase_requests['exchange_rates'] || {}
          if exchange_rates.any?
        %>
          <div class="pr-section-title">
            <%= l(:label_exchange_rates) %>
          </div>
          <p class="info"><%= l(:text_exchange_rates_info) %></p>
          <table class="dashboard-table">
            <caption class="sr-only">Exchange rates</caption>
            <thead>
              <tr>
                <th scope="col"><%= l(:field_currency) %></th>
                <th scope="col"><%= l(:label_rate_to) %> <%= default_currency %></th>
              </tr>
            </thead>
            <tbody>
            <% exchange_rates.each do |currency, rate| %>
              <tr>
                <td><%= currency %></td>
                <td><%= number_with_precision(rate.to_f, precision: 6) %></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        <% end %>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>
</div>

<div class="pr-form-actions left-aligned">
  <%= link_to project_purchase_requests_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-magnifier"><%= l(:label_view_all_requests) %></span>
  <% end %>
  <%= link_to new_project_purchase_request_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
    <span class="icon icon-add"><%= l(:label_new_purchase_request) %></span>
  <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Generate Status Distribution Pie Chart
  <% if @status_distribution.present? && @status_distribution.any? %>
  generatePieChart('status-pie-chart', [
    <% @status_distribution.each do |status| %>
      {
        label: '<%= j(status[:name]) %>',
        value: <%= status[:count] %>,
        color: '<%= status[:color].presence || '#6b7280' %>'
      },
    <% end %>
  ]);
  <% end %>

  // Generate Priority Distribution Pie Chart
  <% if @priority_distribution.present? && @priority_distribution.values.sum > 0 %>
  generatePieChart('priority-pie-chart', [
    <% if @priority_distribution[:urgent] > 0 %>
      { label: '<%= j(l(:label_priority_urgent)) %>', value: <%= @priority_distribution[:urgent] %>, color: '#dc3a3a' },
    <% end %>
    <% if @priority_distribution[:high] > 0 %>
      { label: '<%= j(l(:label_priority_high)) %>', value: <%= @priority_distribution[:high] %>, color: '#df8709' },
    <% end %>
    <% if @priority_distribution[:normal] > 0 %>
      { label: '<%= j(l(:label_priority_normal)) %>', value: <%= @priority_distribution[:normal] %>, color: '#2f9e44' },
    <% end %>
    <% if @priority_distribution[:low] > 0 %>
      { label: '<%= j(l(:label_priority_low)) %>', value: <%= @priority_distribution[:low] %>, color: '#2272c4' },
    <% end %>
  ]);
  <% end %>

  // Generate Monthly Trends Bar Chart
  <% if @monthly_trends.present? && @monthly_trends.any? %>
  generateBarChart('monthly-trends-chart', [
    <% @monthly_trends.each do |trend| %>
      { label: '<%= j(trend[:month]) %>', value: <%= trend[:count] %>, amount: <%= trend[:amount] %> },
    <% end %>
  ]);
  <% end %>
});

// Native pie chart (SVG)
function generatePieChart(containerId, data) {
  const container = document.getElementById(containerId);
  if (!container || !data.length) return;

  const size = 120;
  const radius = size / 2 - 10;
  const centerX = size / 2;
  const centerY = size / 2;

  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('width', size);
  svg.setAttribute('height', size);
  svg.setAttribute('viewBox', `0 0 ${size} ${size}`);

  const total = data.reduce((sum, item) => sum + item.value, 0);
  if (total === 0) return;

  let currentAngle = 0;

  data.forEach((item) => {
    const percentage = item.value / total;
    const angle = percentage * 2 * Math.PI;

    if (percentage > 0) {
      const startAngle = currentAngle;
      const endAngle = currentAngle + angle;

      const x1 = centerX + radius * Math.cos(startAngle);
      const y1 = centerY + radius * Math.sin(startAngle);
      const x2 = centerX + radius * Math.cos(endAngle);
      const y2 = centerY + radius * Math.sin(endAngle);

      const largeArcFlag = angle > Math.PI ? 1 : 0;

      const pathData = [
        `M ${centerX} ${centerY}`,
        `L ${x1} ${y1}`,
        `A ${radius} ${radius} 0 ${largeArcFlag} 1 ${x2} ${y2}`,
        'Z'
      ].join(' ');

      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', pathData);
      path.setAttribute('fill', item.color);
      path.setAttribute('stroke', '#fff');
      path.setAttribute('stroke-width', '1');
      path.setAttribute('class', 'pie-slice');

      path.addEventListener('mouseenter', function() {
        this.style.opacity = '0.8';
        this.style.transform = 'scale(1.05)';
        this.style.transformOrigin = `${centerX}px ${centerY}px`;
      });

      path.addEventListener('mouseleave', function() {
        this.style.opacity = '1';
        this.style.transform = 'scale(1)';
      });

      svg.appendChild(path);
      currentAngle += angle;
    }
  });

  container.appendChild(svg);
}

// Native bar chart
function generateBarChart(containerId, data) {
  const container = document.getElementById(containerId);
  if (!container || !data.length) return;

  container.replaceChildren();

  const maxValue = Math.max(...data.map(item => item.value));
  if (maxValue === 0) return;

  data.forEach((item) => {
    const barHeight = (item.value / maxValue) * 120;

    const bar = document.createElement('div');
    bar.className = 'chart-bar';
    bar.style.height = barHeight + 'px';

    const valueLabel = document.createElement('div');
    valueLabel.className = 'chart-bar-value';
    valueLabel.textContent = item.value;
    bar.appendChild(valueLabel);

    const monthLabel = document.createElement('div');
    monthLabel.className = 'chart-bar-label';
    monthLabel.textContent = item.label;
    bar.appendChild(monthLabel);

    bar.title = `${item.label}: ${item.value} requests`;
    if (item.amount !== undefined) {
      bar.title += ` (Total: $${item.amount.toLocaleString()})`;
    }

    container.appendChild(bar);
  });
}

// Generate TPC Distribution Bar Chart
<% if @tpc_distribution.present? && @tpc_distribution.any? %>
const tpcDistributionData = <%= raw @tpc_distribution.to_json %>;
const tpcChartContainer = document.getElementById('tpc-distribution-chart');

if (tpcChartContainer && tpcDistributionData.length > 0) {
  const tpcChartData = tpcDistributionData.map(item => ({
    label: item.tpc_code,
    value: item.total_cost,
    count: item.count
  }));

  generateBarChart('tpc-distribution-chart', tpcChartData);
}
<% end %>
</script>
