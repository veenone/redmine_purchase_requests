<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title l(:label_purchase_request_dashboard) %>


<h2><%= l(:label_purchase_request_dashboard) %></h2>

<div class="contextual">
  <%= link_to project_purchase_requests_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-list"><%= l(:label_purchase_requests) %></span>
  <% end %>
  <%= link_to new_project_purchase_request_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
    <span class="icon icon-add"><%= l(:label_new_purchase_request) %></span>
  <% end %>
  <% if User.current.allowed_to?(:view_tpc_codes, @project) %>
    <%= link_to project_tpc_codes_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
      <span class="icon icon-projects"><%= l(:label_tpc_codes) %></span>
    <% end %>
  <% end %>
</div>

<!-- Year Filter -->
<%= render 'shared/dashboard_filters',
      year_mode: :list,
      selected_year: @selected_year,
      available_years: @available_years,
      available_tpc_codes: @available_tpc_codes,
      selected_tpc_code_ids: selected_tpc_code_ids,
      year_defaulted: @budget_year_defaulted,
      year_required: true,
      compare_mode: true,
      compare_year: @compare_year %>

<% if @project && (User.current.allowed_to?(:view_capex, @project) || User.current.allowed_to?(:view_opex, @project)) %>
  <% band_tpcs = @available_tpc_codes.select { |t| selected_tpc_code_ids.include?(t.id.to_s) } %>
  <div class="pr-card pr-budget-band">
    <div class="pr-card__header">
      <h3>
        <%= l(:label_budget_health, default: 'Budget health') %>
        &mdash; <%= @budget_year %><% if band_tpcs.one? %> &middot; <%= band_tpcs.first.tpc_number %><% elsif band_tpcs.any? %> &middot; <%= band_tpcs.size %> <%= l(:label_tpc) %><% end %>
      </h3>
      <% if @budget_year_defaulted %>
        <span class="pr-badge pr-badge--neutral"><%= l(:label_showing_current_year, default: 'Showing current year') %></span>
      <% end %>
    </div>
    <div class="pr-card__body">
      <% budget_symbol = currency_symbol(@budget_currency) %>
      <% if @has_budget %>
        <%
          # Both come from BudgetDashboard now. This band used to decide
          # `@budget_remaining < 0` on its own, with no notion of whether the
          # total it was comparing was a sum of unlike units — so it drew the
          # over-budget conclusion the CAPEX and OPEX dashboards refuse to draw
          # on exactly the same rows, on the surface most people see first.
          over_budget = @budget_over
          severity = @budget_severity
        %>
        <% if @budget_totals_unreliable %>
          <div class="pr-alert pr-alert-warning" role="status">
            <strong><%= l(:label_totals_not_comparable) %>.</strong>
            <%= l(:text_missing_exchange_rate, currencies: @budget_unconvertible_currencies.join(', ')) %>
          </div>
        <% end %>
        <div class="pr-stats">
          <div class="pr-stat pr-stat--accent">
            <div class="pr-stat__value num"><%= budget_symbol %><%= number_with_precision(@budget_total, precision: 2, delimiter: ',') %> <span class="currency-code"><%= @budget_currency %></span></div>
            <div class="pr-stat__label"><%= l(:label_total_budget, default: 'Total budget') %></div>
          </div>
          <div class="pr-stat pr-stat--<%= over_budget ? 'danger' : (@budget_utilization_pct >= 80 ? 'warning' : 'success') %>">
            <%# Utilized is a sum with no state of its own — per the Money-State
                Rule it reads as plain ink; the alarm belongs on the overage. %>
            <div class="pr-stat__value num stat-currency--neutral"><%= budget_symbol %><%= number_with_precision(@budget_utilized, precision: 2, delimiter: ',') %> <span class="currency-code"><%= @budget_currency %></span></div>
            <div class="pr-stat__label" title="<%= l(:label_committed_note) %>"><%= l(:label_utilized, default: 'Committed') %></div>
          </div>
          <div class="pr-stat pr-stat--<%= over_budget ? 'danger' : 'success' %>">
            <%# Under an "Over budget by" label the figure must be positive:
                the label already carries the direction. But .abs is valid ONLY
                when the label actually says it. over_budget is forced false
                when totals are unreliable, so an unguarded .abs would print an
                unconverted deficit as a positive "Remaining" — a sign
                inversion worse than the false alarm the suppression prevents.
                Same guard as the CAPEX/OPEX tile. %>
            <div class="pr-stat__value num stat-currency--<%= over_budget ? 'over' : 'approved' %>"><%= budget_symbol %><%= number_with_precision((over_budget ? @budget_remaining.to_f.abs : @budget_remaining.to_f), precision: 2, delimiter: ',') %> <span class="currency-code"><%= @budget_currency %></span></div>
            <div class="pr-stat__label"><%= over_budget ? l(:label_over_budget_by, default: 'Over budget by') : l(:label_remaining, default: 'Remaining') %></div>
          </div>
          <div class="pr-stat pr-stat--violet">
            <%# A percentage of a sum of unlike units is not a percentage. %>
            <div class="pr-stat__value num"><%= @budget_totals_unreliable ? '—' : "#{@budget_utilization_pct}%" %></div>
            <div class="pr-stat__label"><%= l(:label_utilization, default: 'Utilization') %></div>
          </div>
        </div>
        <% unless @budget_totals_unreliable %>
          <div class="utilization-bar pr-budget-band__meter" aria-hidden="true">
            <div class="pr-meter__fill <%= severity %>" style="width: <%= [@budget_utilization_pct, 100].min %>%"></div>
          </div>
        <% end %>
        <% if @compare_year %>
          <p class="pr-budget-band__compare">
            <span class="pr-badge pr-badge--neutral"><%= l(:label_vs) %> <%= @compare_year %></span>
            <% if @compare_has_budget %>
              <%= l(:label_utilized) %>
              <strong><%= budget_symbol %><%= number_with_precision(@compare_budget_utilized, precision: 2, delimiter: ',') %></strong>
              <% if @compare_utilized_delta_pct %>
                <span class="stat-currency--<%= @compare_utilized_delta_pct > 0 ? 'pending' : 'approved' %>">
                  (<%= @compare_utilized_delta_pct > 0 ? '+' : '' %><%= @compare_utilized_delta_pct %>%)
                </span>
              <% end %>
              &middot;
              <%= l(:label_total_budget) %>
              <strong><%= budget_symbol %><%= number_with_precision(@compare_budget_total, precision: 2, delimiter: ',') %></strong>
              &middot;
              <%= @compare_utilization_pct %>%
            <% else %>
              <%= l(:label_no_budget_for_year) %> <%= @compare_year %>.
            <% end %>
          </p>
        <% end %>
        <p class="pr-budget-band__note conversion-note"><%= l(:label_committed_note) %>.</p>
        <p class="pr-budget-band__split conversion-note">
          <strong>CAPEX</strong> <%= budget_symbol %><%= number_with_precision(@capex_utilized, precision: 2, delimiter: ',') %> / <%= budget_symbol %><%= number_with_precision(@capex_budget, precision: 2, delimiter: ',') %>
          &nbsp;&middot;&nbsp;
          <strong>OPEX</strong> <%= budget_symbol %><%= number_with_precision(@opex_utilized, precision: 2, delimiter: ',') %> / <%= budget_symbol %><%= number_with_precision(@opex_budget, precision: 2, delimiter: ',') %>
          &nbsp;<%= @budget_currency %>
        </p>
      <% else %>
        <p class="conversion-note"><%= l(:label_no_budget_defined, default: 'No CAPEX/OPEX budget defined for') %> <%= @budget_year %>.</p>
      <% end %>
    </div>
  </div>
<% end %>

<div class="summary-stats">
  <div class="stat-box pr-stat--accent">
    <div class="stat-number"><%= @total_requests %></div>
    <div class="stat-label"><%= l(:label_total_requests) %></div>
  </div>

  <div class="stat-box pr-stat--warning">
    <div class="stat-number"><%= @open_requests %></div>
    <div class="stat-label"><%= l(:label_open_requests) %></div>
  </div>

  <div class="stat-box pr-stat--success">
    <div class="stat-number"><%= @closed_requests %></div>
    <div class="stat-label"><%= l(:label_closed_requests) %></div>
  </div>

  <%
    summary_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
    summary_symbol = currency_symbol(summary_currency)
  %>
  <div class="stat-box pr-stat--accent">
    <div class="stat-number stat-currency stat-currency--neutral"><%= summary_symbol %><%= number_with_precision(@total_estimated_cost, precision: 2, delimiter: ',') %></div>
    <div class="stat-label"><%= l(:label_total_estimated_cost) %></div>
  </div>
</div>

<section class="pr-section">
  <h3 class="pr-section__title"><%= l(:label_section_financial) %></h3>
  <div class="dashboard-container">
  <!-- Financial Overview Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h4><%= l(:label_financial_overview) %></h4>
    </div>
    <div class="dashboard-card-body">
      <table class="dashboard-table">
        <caption class="sr-only"><%= l(:label_caption_financial_overview) %></caption>
        <%
          default_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
          default_symbol = currency_symbol(default_currency)
        %>
        <tbody>
        <tr>
          <th scope="row"><%= l(:label_total_estimated_cost) %></th>
          <td class="stat-currency stat-currency--neutral">
            <%= default_symbol %><%= number_with_precision(@total_estimated_cost, precision: 2, delimiter: ',') %>
            <span class="currency-code"><%= default_currency %></span>
          </td>
        </tr>
        <tr>
          <th scope="row"><%= l(:label_pending_cost) %></th>
          <td class="stat-currency stat-currency--pending">
            <%= default_symbol %><%= number_with_precision(@pending_cost, precision: 2, delimiter: ',') %>
            <span class="currency-code"><%= default_currency %></span>
          </td>
        </tr>
        <tr>
          <th scope="row"><%= l(:label_approved_cost) %></th>
          <td class="stat-currency stat-currency--approved">
            <%= default_symbol %><%= number_with_precision(@approved_cost, precision: 2, delimiter: ',') %>
            <span class="currency-code"><%= default_currency %></span>
          </td>
        </tr>
        <tr>
          <th scope="row"><%= l(:label_average_request_amount) %></th>
          <td class="stat-currency stat-currency--neutral">
            <% avg = @total_requests > 0 ? @total_estimated_cost / @total_requests : 0 %>
            <%= default_symbol %><%= number_with_precision(avg, precision: 2, delimiter: ',') %>
            <span class="currency-code"><%= default_currency %></span>
          </td>
        </tr>

        <% if @currency_distribution && @currency_distribution.size > 1 %>
          <tr>
            <th scope="col" colspan="2" class="section-header"><%= l(:label_currency_breakdown) %></th>
          </tr>
          <% @currency_distribution.each do |currency, amount| %>
            <tr>
              <th scope="row"><%= currency %></th>
              <td class="stat-currency">
                <%= currency_symbol(currency) %><%= number_with_precision(amount, precision: 2, delimiter: ',') %>
              </td>
            </tr>
          <% end %>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Currency Breakdown with Conversion Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h4><%= l(:label_currency_breakdown_with_conversion) %></h4>
    </div>
    <div class="dashboard-card-body">
      <% if @converted_currency_distribution && @converted_currency_distribution.any? %>
        <table class="dashboard-table">
          <caption class="sr-only"><%= l(:label_caption_currency_conversion) %></caption>
          <th scope="col"ead>
            <tr>
              <th scope="col"><%= l(:field_currency) %></th>
              <th scope="col"><%= l(:label_original_amount) %></th>
              <th scope="col"><%= l(:label_equivalent_in_default) %></th>
            </tr>
          </thead>
          <tbody>
          <%
            default_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
          %>
          <% @converted_currency_distribution.each do |currency, data| %>
            <tr>
              <th scope="row"><%= currency %></th>
              <td class="stat-currency">
                <%= currency_symbol(currency) %><%= number_with_precision(data[:original], precision: 2, delimiter: ',') %>
              </td>
              <td class="stat-currency">
                <%= currency_symbol(default_currency) %><%= number_with_precision(data[:converted], precision: 2, delimiter: ',') %>
              </td>
            </tr>
          <% end %>
          <tr class="total-row">
            <th scope="row"><%= l(:label_total_in) %> <%= default_currency %></th>
            <td></td>
            <td class="stat-currency total-value">
              <%= currency_symbol(default_currency) %><%= number_with_precision(@total_estimated_cost, precision: 2, delimiter: ',') %>
            </td>
          </tr>
          </tbody>
        </table>

        <%
          exchange_rates = Setting.plugin_redmine_purchase_requests['exchange_rates'] || {}
          if exchange_rates.any?
        %>
          <div class="pr-section-title">
            <%= l(:label_exchange_rates) %>
          </div>
          <p class="info"><%= l(:text_exchange_rates_info) %></p>
          <table class="dashboard-table">
            <caption class="sr-only"><%= l(:label_caption_exchange_rates) %></caption>
            <th scope="col"ead>
              <tr>
                <th scope="col"><%= l(:field_currency) %></th>
                <th scope="col"><%= l(:label_rate_to) %> <%= default_currency %></th>
              </tr>
            </thead>
            <tbody>
            <% exchange_rates.each do |currency, rate| %>
              <tr>
                <td><%= currency %></td>
                <td><%= number_with_precision(rate.to_f, precision: 6) %></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        <% end %>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>
  <!-- Monthly Trends Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h4><%= l(:label_monthly_trends) %></h4>
    </div>
    <div class="dashboard-card-body">
      <% if @monthly_trends.present? && @monthly_trends.any? %>
        <div class="chart-bar-container" id="monthly-trends-chart" data-chart-label="<%= l(:label_monthly_trends) %>"></div>

        <details class="pr-data-toggle">
          <summary><%= l(:label_view_data_table, default: "View data table") %> — <%= l(:label_monthly_trends) %></summary>
          <table class="dashboard-table">
            <caption class="sr-only"><%= l(:label_caption_monthly_trends) %></caption>
            <th scope="col"ead>
              <tr>
                <th scope="col"><%= l(:label_month) %></th>
                <th scope="col"><%= l(:label_requests) %></th>
                <th scope="col"><%= l(:label_amount) %></th>
              </tr>
            </thead>
            <tbody>
            <% @monthly_trends.each do |trend| %>
              <tr>
                <td><%= trend[:month] %></td>
                <td><%= trend[:count] %></td>
                <td class="stat-currency">
                  <%= currency_symbol(default_currency) %><%= number_with_precision(trend[:amount], precision: 2, delimiter: ',') %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </details>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  </div>
</section>

<section class="pr-section">
  <h3 class="pr-section__title"><%= l(:label_section_governance) %></h3>
  <div class="dashboard-container">
  <!-- TPC Code Distribution Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h4><%= l(:label_tpc_code_distribution) %></h4>
    </div>
    <div class="dashboard-card-body">
      <% if @tpc_distribution.present? && @tpc_distribution.any? %>
        <div class="chart-bar-container" id="tpc-distribution-chart" data-chart-label="<%= l(:label_tpc_code_distribution) %>"></div>

        <details class="pr-data-toggle">
          <summary><%= l(:label_view_data_table, default: "View data table") %> — <%= l(:label_tpc_code_distribution, default: "Budget Distribution by TPC Code") %></summary>
          <table class="dashboard-table">
            <caption class="sr-only"><%= l(:label_caption_tpc_distribution) %></caption>
            <th scope="col"ead>
              <tr>
                <th scope="col"><%= l(:label_tpc_code) %></th>
                <th scope="col"><%= l(:label_requests) %></th>
                <th scope="col"><%= l(:label_total_cost) %></th>
              </tr>
            </thead>
            <tbody>
            <%
              tpc_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
              tpc_symbol = currency_symbol(tpc_currency)
            %>
            <% @tpc_distribution.each do |tpc| %>
              <tr>
                <td class="tpc-code-cell"><strong><%= tpc[:tpc_code] %></strong></td>
                <td><%= tpc[:count] %></td>
                <td class="stat-currency"><%= tpc_symbol %><%= number_with_precision(tpc[:total_cost], precision: 2, delimiter: ',') %></td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </details>
      <% else %>
        <p class="nodata"><%= l(:label_no_tpc_data) %></p>
      <% end %>
    </div>
  </div>

  <!-- Top Vendors Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h4><%= l(:label_top_vendors) %></h4>
    </div>
    <div class="dashboard-card-body">
      <% if @top_vendors.present? && @top_vendors.any? %>
        <table class="dashboard-table">
          <caption class="sr-only"><%= l(:label_caption_top_vendors) %></caption>
          <th scope="col"ead>
            <tr>
              <th scope="col"><%= l(:field_vendor) %></th>
              <th scope="col"><%= l(:label_requests) %></th>
              <th scope="col"><%= l(:label_total_cost) %></th>
            </tr>
          </thead>
          <tbody>
          <%
            vendor_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
            vendor_symbol = currency_symbol(vendor_currency)
          %>
          <% @top_vendors.each do |vendor| %>
            <tr>
              <td><%= vendor[:vendor] %></td>
              <td><%= vendor[:count] %></td>
              <td class="stat-currency"><%= vendor_symbol %><%= number_with_precision(vendor[:total_cost], precision: 2, delimiter: ',') %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  </div>
</section>

<section class="pr-section">
  <h3 class="pr-section__title"><%= l(:label_section_activity) %></h3>
  <div class="dashboard-container">
  <!-- Status Distribution Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h4><%= l(:label_status_distribution) %></h4>
    </div>
    <div class="dashboard-card-body">
      <% if @status_distribution.present? && @status_distribution.any? %>
        <div class="chart-pie-container">
          <div class="chart-pie" id="status-pie-chart" data-chart-label="<%= l(:label_status_distribution) %>"></div>
          <div class="chart-pie-legend">
            <% @status_distribution.each do |status| %>
              <div class="legend-item">
                <div class="legend-color" style="background-color: <%= status[:color].presence || 'var(--pr-ink-muted)' %>;"></div>
                <span><%= status[:name] %> (<%= status[:count] %> - <%= status[:percentage] %>%)</span>
              </div>
            <% end %>
          </div>
        </div>

        <details class="pr-data-toggle">
          <summary><%= l(:label_view_data_table, default: "View data table") %> — <%= l(:label_status_distribution) %></summary>
          <div class="autoscroll">
          <table class="dashboard-table">
            <caption class="sr-only"><%= l(:label_caption_by_status) %></caption>
            <th scope="col"ead>
              <tr>
                <th scope="col"><%= l(:field_status) %></th>
                <th scope="col"><%= l(:label_count) %></th>
                <th scope="col"><%= l(:label_percentage) %></th>
              </tr>
            </thead>
            <tbody>
            <% @status_distribution.each do |status| %>
              <tr>
                <td>
                  <span class="pr-swatch" style="background-color: <%= status[:color].presence || 'var(--pr-ink-muted)' %>;"></span>
                  <%= status[:name] %>
                </td>
                <td><%= status[:count] %></td>
                <td><%= status[:percentage] %>%</td>
              </tr>
            <% end %>
            </tbody>
          </table>
          </div>
        </details>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  <!-- Priority Distribution Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h4><%= l(:label_priority_distribution) %></h4>
    </div>
    <div class="dashboard-card-body">
      <% if @priority_distribution.present? && @priority_distribution.values.sum > 0 %>
        <div class="chart-pie-container">
          <div class="chart-pie" id="priority-pie-chart" data-chart-label="<%= l(:label_priority_distribution) %>"></div>
          <div class="chart-pie-legend">
            <div class="legend-item">
              <div class="legend-color" style="background-color: var(--pr-danger);"></div>
              <span><%= l(:label_priority_urgent) %> (<%= @priority_distribution[:urgent] %> - <%= @priority_percentages[:urgent] %>%)</span>
            </div>
            <div class="legend-item">
              <div class="legend-color" style="background-color: var(--pr-warning);"></div>
              <span><%= l(:label_priority_high) %> (<%= @priority_distribution[:high] %> - <%= @priority_percentages[:high] %>%)</span>
            </div>
            <div class="legend-item">
              <div class="legend-color" style="background-color: var(--pr-success);"></div>
              <span><%= l(:label_priority_normal) %> (<%= @priority_distribution[:normal] %> - <%= @priority_percentages[:normal] %>%)</span>
            </div>
            <div class="legend-item">
              <div class="legend-color" style="background-color: var(--pr-info);"></div>
              <span><%= l(:label_priority_low) %> (<%= @priority_distribution[:low] %> - <%= @priority_percentages[:low] %>%)</span>
            </div>
          </div>
        </div>

        <details class="pr-data-toggle">
          <summary><%= l(:label_view_data_table, default: "View data table") %> — <%= l(:label_priority_distribution) %></summary>
          <table class="dashboard-table">
            <caption class="sr-only"><%= l(:label_caption_by_priority) %></caption>
            <th scope="col"ead>
              <tr>
                <th scope="col"><%= l(:field_priority) %></th>
                <th scope="col"><%= l(:label_count) %></th>
                <th scope="col"><%= l(:label_percentage) %></th>
              </tr>
            </thead>
            <tbody>
            <tr>
              <td><span class="pr-swatch" style="background-color: var(--pr-danger);"></span><%= l(:label_priority_urgent) %></td>
              <td><%= @priority_distribution[:urgent] %></td>
              <td><%= @priority_percentages[:urgent] %>%</td>
            </tr>
            <tr>
              <td><span class="pr-swatch" style="background-color: var(--pr-warning);"></span><%= l(:label_priority_high) %></td>
              <td><%= @priority_distribution[:high] %></td>
              <td><%= @priority_percentages[:high] %>%</td>
            </tr>
            <tr>
              <td><span class="pr-swatch" style="background-color: var(--pr-success);"></span><%= l(:label_priority_normal) %></td>
              <td><%= @priority_distribution[:normal] %></td>
              <td><%= @priority_percentages[:normal] %>%</td>
            </tr>
            <tr>
              <td><span class="pr-swatch" style="background-color: var(--pr-info);"></span><%= l(:label_priority_low) %></td>
              <td><%= @priority_distribution[:low] %></td>
              <td><%= @priority_percentages[:low] %>%</td>
            </tr>
            </tbody>
          </table>
        </details>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  <!-- Recent Activity Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h4><%= l(:label_recent_requests) %></h4>
    </div>
    <div class="dashboard-card-body">
      <% if @recent_requests.present? && @recent_requests.any? %>
        <table class="dashboard-table">
          <caption class="sr-only"><%= l(:label_caption_recent_requests) %></caption>
          <th scope="col"ead>
            <tr>
              <th scope="col">#</th>
              <th scope="col"><%= l(:field_title) %></th>
              <th scope="col"><%= l(:field_status) %></th>
              <th scope="col"><%= l(:field_created_on) %></th>
            </tr>
          </thead>
          <tbody>
          <% @recent_requests.each do |request| %>
            <tr>
              <td><%= link_to "##{request.id}", project_purchase_request_path(@project, request), class: 'pr-id-link' %></td>
              <td><%= link_to truncate(request.title, length: 30), project_purchase_request_path(@project, request), class: 'pr-title-link' %></td>
              <td>
                <span class="status-badge" style="background-color: <%= request.status.display_color %>; color: <%= readable_text_color(request.status.display_color) %>">
                  <%= request.status.name %>
                </span>
              </td>
              <td><%= format_time(request.created_at) %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  <!-- Top Requesters Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h4><%= l(:label_top_requesters) %></h4>
    </div>
    <div class="dashboard-card-body">
      <% if @top_requesters.present? && @top_requesters.any? %>
        <table class="dashboard-table">
          <caption class="sr-only"><%= l(:label_caption_top_requesters) %></caption>
          <th scope="col"ead>
            <tr>
              <th scope="col"><%= l(:field_user) %></th>
              <th scope="col"><%= l(:label_requests) %></th>
              <th scope="col"><%= l(:label_total_cost) %></th>
            </tr>
          </thead>
          <tbody>
          <%
            requester_currency = Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD'
            requester_symbol = currency_symbol(requester_currency)
          %>
          <% @top_requesters.each do |user| %>
            <tr>
              <td><%= link_to(user.name.presence || user.login, user_path(user)) %></td>
              <td><%= user.request_count %></td>
              <td class="stat-currency"><%= requester_symbol %><%= number_with_precision(user.total_cost, precision: 2, delimiter: ',') %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="nodata"><%= l(:label_no_data) %></p>
      <% end %>
    </div>
  </div>

  <!-- Response Time Card -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h4><%= l(:label_average_response_time) %></h4>
    </div>
    <div class="dashboard-card-body">
      <div class="pr-stat__value num"><%= @avg_response_days %> <%= l(:label_days) %></div>
      <div class="pr-stat__label"><%= l(:label_avg_processing_time) %></div>
    </div>
  </div>

  </div>
</section>


<div class="pr-form-actions left-aligned">
  <%= link_to project_purchase_requests_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-magnifier"><%= l(:label_view_all_requests) %></span>
  <% end %>
  <%= link_to new_project_purchase_request_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
    <span class="icon icon-add"><%= l(:label_new_purchase_request) %></span>
  <% end %>
</div>

<%= render 'purchase_requests_reports/chart_colors' %>
<script>
// Chart copy and currency come from the server so charts stay localized and
// respect the configured default currency instead of hardcoding "$".
const PR_CHART_LABELS = {
  requests: '<%= j(l(:label_requests)) %>',
  total: '<%= j(l(:label_total_cost)) %>',
  noData: '<%= j(l(:label_no_data)) %>',
  currencySymbol: '<%= j(currency_symbol(Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD')) %>'
};

function formatChartMoney(amount) {
  return PR_CHART_LABELS.currencySymbol + Number(amount).toLocaleString(undefined, {
    minimumFractionDigits: 0,
    maximumFractionDigits: 0
  });
}

document.addEventListener('DOMContentLoaded', function() {
  // Generate Status Distribution Pie Chart
  <% if @status_distribution.present? && @status_distribution.any? %>
  generatePieChart('status-pie-chart', [
    <% @status_distribution.each do |status| %>
      {
        label: '<%= j(status[:name]) %>',
        value: <%= status[:count] %>,
        color: '<%= status[:color].presence || '#6b7280' %>'
      },
    <% end %>
  ]);
  <% end %>

  // Generate Priority Distribution Pie Chart
  <% if @priority_distribution.present? && @priority_distribution.values.sum > 0 %>
  generatePieChart('priority-pie-chart', [
    <% if @priority_distribution[:urgent] > 0 %>
      { label: '<%= j(l(:label_priority_urgent)) %>', value: <%= @priority_distribution[:urgent] %>, color: PR_TOKEN('--pr-danger') },
    <% end %>
    <% if @priority_distribution[:high] > 0 %>
      { label: '<%= j(l(:label_priority_high)) %>', value: <%= @priority_distribution[:high] %>, color: PR_TOKEN('--pr-warning') },
    <% end %>
    <% if @priority_distribution[:normal] > 0 %>
      { label: '<%= j(l(:label_priority_normal)) %>', value: <%= @priority_distribution[:normal] %>, color: PR_TOKEN('--pr-success') },
    <% end %>
    <% if @priority_distribution[:low] > 0 %>
      { label: '<%= j(l(:label_priority_low)) %>', value: <%= @priority_distribution[:low] %>, color: PR_TOKEN('--pr-info') },
    <% end %>
  ]);
  <% end %>

  // Generate Monthly Trends Bar Chart
  <% if @monthly_trends.present? && @monthly_trends.any? %>
  generateBarChart('monthly-trends-chart', [
    <% @monthly_trends.each_with_index do |trend, idx| %>
      { label: '<%= j(trend[:month]) %>', value: <%= trend[:count] %>, amount: <%= trend[:amount] %><% if @compare_monthly_trends %>,
        compare: <%= @compare_monthly_trends[idx][:count] %>,
        compareLabel: '<%= j(@compare_monthly_trends[idx][:month]) %>'<% end %> },
    <% end %>
  ]);
  <% end %>
});

// Native pie chart (SVG)
function generatePieChart(containerId, data) {
  const container = document.getElementById(containerId);
  if (!container || !data.length) return;

  // Match generateBarChart: clear first so a re-render replaces the chart
  // instead of stacking a second SVG on top of the first.
  container.replaceChildren();

  const size = 120;
  const radius = size / 2 - 10;
  const centerX = size / 2;
  const centerY = size / 2;

  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('width', size);
  svg.setAttribute('height', size);
  svg.setAttribute('viewBox', `0 0 ${size} ${size}`);

  const total = data.reduce((sum, item) => sum + item.value, 0);
  if (total === 0) return;

  // The chart is a single image for assistive tech: announce the whole
  // breakdown rather than leaving the graphic silent. The adjacent legend and
  // the "View data table" disclosure carry the same figures as real text.
  svg.setAttribute('role', 'img');
  svg.setAttribute('aria-label', container.dataset.chartLabel
    ? `${container.dataset.chartLabel}: ${data.map(i => `${i.label} ${Math.round(i.value / total * 100)}%`).join(', ')}`
    : data.map(i => `${i.label} ${Math.round(i.value / total * 100)}%`).join(', '));

  let currentAngle = 0;

  data.forEach((item) => {
    const percentage = item.value / total;
    const angle = percentage * 2 * Math.PI;

    if (percentage > 0) {
      const startAngle = currentAngle;
      const endAngle = currentAngle + angle;

      const x1 = centerX + radius * Math.cos(startAngle);
      const y1 = centerY + radius * Math.sin(startAngle);
      const x2 = centerX + radius * Math.cos(endAngle);
      const y2 = centerY + radius * Math.sin(endAngle);

      const largeArcFlag = angle > Math.PI ? 1 : 0;

      const pathData = [
        `M ${centerX} ${centerY}`,
        `L ${x1} ${y1}`,
        `A ${radius} ${radius} 0 ${largeArcFlag} 1 ${x2} ${y2}`,
        'Z'
      ].join(' ');

      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', pathData);
      path.setAttribute('fill', item.color);
      path.setAttribute('stroke', '#fff');
      path.setAttribute('stroke-width', '1');
      path.setAttribute('class', 'pie-slice');

      // Slice tooltip, matching the bar charts' hover affordance.
      const sliceTitle = document.createElementNS('http://www.w3.org/2000/svg', 'title');
      sliceTitle.textContent = `${item.label}: ${item.value} (${Math.round(percentage * 100)}%)`;
      path.appendChild(sliceTitle);

      path.addEventListener('mouseenter', function() {
        this.style.opacity = '0.8';
        // Honor the OS reduced-motion preference: keep the opacity cue (which
        // is not movement) and skip the scale for users who asked for less.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          this.style.transform = 'scale(1.05)';
          this.style.transformOrigin = `${centerX}px ${centerY}px`;
        }
      });

      path.addEventListener('mouseleave', function() {
        this.style.opacity = '1';
        this.style.transform = 'scale(1)';
      });

      svg.appendChild(path);
      currentAngle += angle;
    }
  });

  container.appendChild(svg);
}

// Native bar chart
function generateBarChart(containerId, data) {
  const container = document.getElementById(containerId);
  if (!container || !data.length) return;

  container.replaceChildren();

  const chartLabel = container.dataset.chartLabel ? container.dataset.chartLabel + ': ' : '';
  const hasCompare = data.some(item => item.compare !== undefined);
  // Both years share one scale, or the ghost bars would misrepresent size.
  const maxValue = Math.max(...data.map(item => Math.max(item.value, item.compare || 0)));

  // An all-zero series is a real, common result (a year with no requests), not
  // an error — say so rather than leaving an empty bordered box. The label is
  // set before this early return so the chart is never silently unlabelled.
  if (maxValue === 0) {
    container.setAttribute('role', 'img');
    container.setAttribute('aria-label', chartLabel + PR_CHART_LABELS.noData);
    container.classList.add('is-empty');
    const empty = document.createElement('p');
    empty.className = 'nodata';
    empty.textContent = PR_CHART_LABELS.noData;
    container.appendChild(empty);
    return;
  }

  // Announce the series as one image rather than a stream of unlabelled
  // numbers. The container scrolls, so it is also a focus stop — otherwise its
  // later bars are keyboard-unreachable.
  container.setAttribute('role', 'img');
  container.setAttribute('aria-label', chartLabel +
    data.map(i => {
      const v = i.display !== undefined ? i.display : i.value;
      return i.compare !== undefined
        ? `${i.label} ${v}, ${i.compareLabel} ${i.compare}`
        : `${i.label} ${v}`;
    }).join(', '));
  container.setAttribute('tabindex', '0');

  data.forEach((item) => {
    const barHeight = (item.value / maxValue) * 120;

    // With a comparison year each month is a slot holding a muted ghost bar
    // (previous year) behind the solid bar (selected year).
    let slot = null;
    if (hasCompare) {
      slot = document.createElement('div');
      slot.className = 'chart-bar-slot';
      const ghost = document.createElement('div');
      ghost.className = 'chart-bar-ghost';
      ghost.style.height = ((item.compare || 0) / maxValue) * 120 + 'px';
      ghost.title = `${item.compareLabel}: ${item.compare} ${PR_CHART_LABELS.requests}`;
      slot.appendChild(ghost);
    }

    const bar = document.createElement('div');
    bar.className = 'chart-bar';
    bar.style.height = barHeight + 'px';

    const valueLabel = document.createElement('div');
    valueLabel.className = 'chart-bar-value';
    // `value` drives bar height; `display` is what a human should read. Money
    // charts pass a formatted string so bars never show a raw float.
    valueLabel.textContent = item.display !== undefined ? item.display : item.value;
    bar.appendChild(valueLabel);

    const monthLabel = document.createElement('div');
    monthLabel.className = 'chart-bar-label';
    monthLabel.textContent = item.label;
    bar.appendChild(monthLabel);

    bar.title = item.tooltip !== undefined
      ? item.tooltip
      : `${item.label}: ${item.value} ${PR_CHART_LABELS.requests}`;
    if (item.amount !== undefined) {
      bar.title += ` (${PR_CHART_LABELS.total}: ${formatChartMoney(item.amount)})`;
    }

    if (slot) {
      slot.appendChild(bar);
      container.appendChild(slot);
    } else {
      container.appendChild(bar);
    }
  });
}

// Generate TPC Distribution Bar Chart
<% if @tpc_distribution.present? && @tpc_distribution.any? %>
const tpcDistributionData = <%= raw @tpc_distribution.to_json %>;
const tpcChartContainer = document.getElementById('tpc-distribution-chart');

if (tpcChartContainer && tpcDistributionData.length > 0) {
  const tpcChartData = tpcDistributionData.map(item => ({
    label: item.tpc_code,
    value: item.total_cost,
    count: item.count,
    // Bars are sized by total_cost but must read as money, not a bare float.
    display: formatChartMoney(item.total_cost),
    tooltip: `${item.tpc_code}: ${formatChartMoney(item.total_cost)} (${item.count} ${PR_CHART_LABELS.requests})`
  }));

  generateBarChart('tpc-distribution-chart', tpcChartData);
}
<% end %>
</script>
