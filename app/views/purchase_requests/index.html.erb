<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/purchase_requests/index.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title("Purchase Requests - #{@project.name}") %>

<div class="contextual">
  <%= link_to new_project_purchase_request_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
    <span class="icon icon-add"><%= l(:label_new_purchase_request) %></span>
  <% end %>
  <%= link_to project_purchase_requests_path(@project, format: :csv), class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-download">Export CSV</span>
  <% end %>
</div>

<h2>
  <%= l(:label_purchase_requests) %> - <%= @project.name %>
  <span class="count">(<%= @purchase_requests.count %>)</span>
</h2>

<div class="info-box">
  <p><strong>Project Purchase Requests</strong></p>
  <p>Manage purchase requests for <strong><%= @project.name %></strong>. Track requests from creation to completion with budget integration and status monitoring.</p>
</div>

<% if @unfiltered_count.zero? %>
  <div class="pr-empty">
    <div class="pr-empty__icon">📋</div>
    <h3>No Purchase Requests Yet</h3>
    <p>No purchase requests have been created for this project.</p>
    <p>
      <%= link_to new_project_purchase_request_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
        <span class="icon icon-add"></span> Create First Purchase Request
      <% end %>
    </p>
  </div>
<% else %>
  <%= form_with url: project_purchase_requests_path(@project), method: :get, local: true, class: 'pr-filter-form' do |f| %>
    <fieldset class="pr-filters">
      <legend>Filters</legend>
      <div class="filter-row">
        <label for="search">Search:</label>
        <%= f.text_field :search, value: params[:search], placeholder: "Title, description, or ID" %>

        <label for="status_id">Status:</label>
        <%= f.select :status_id,
                     options_from_collection_for_select(PurchaseRequestStatus.sorted, :id, :name, params[:status_id]),
                     { include_blank: 'All Statuses' } %>

        <label for="lifecycle"><%= l(:field_lifecycle) %></label>
        <%= f.select :lifecycle,
                     options_for_select(
                       [[l(:label_lifecycle_active), 'active'],
                        [l(:label_lifecycle_cancelled), 'cancelled'],
                        [l(:label_lifecycle_superseded), 'superseded'],
                        [l(:label_lifecycle_all), 'all']],
                       @lifecycle) %>

        <%= render 'shared/tpc_filter_field', available_tpc_codes: @available_tpc_codes, selected_tpc_code_ids: selected_tpc_code_ids %>
        <%= f.submit 'Filter', class: 'pr-button pr-button-secondary' %>
        <% if params[:status_id].present? || params[:search].present? || params[:tpc_code_id].present? || (params[:lifecycle].present? && params[:lifecycle] != 'active') %>
          <%= link_to 'Clear', project_purchase_requests_path(@project), class: 'pr-button pr-button-cancel' %>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <% if @purchase_request_count.zero? %>
    <div class="pr-empty">
      <div class="pr-empty__icon">🔍</div>
      <h3><%= l(:label_no_matching_requests) %></h3>
      <p><%= l(:text_no_requests_match_filters) %></p>
      <p>
        <%= link_to 'Clear', project_purchase_requests_path(@project), class: 'pr-button pr-button-secondary' %>
      </p>
    </div>
  <% else %>
  <div class="autoscroll">
    <table class="pr-table">
      <caption class="sr-only">Purchase requests</caption>
      <thead>
        <tr>
          <%= sort_header_tag('id', caption: 'ID', scope: 'col') %>
          <%= sort_header_tag('title', caption: 'Title', scope: 'col') %>
          <%= sort_header_tag('status_id', caption: 'Status', scope: 'col') %>
          <%= sort_header_tag('user_id', caption: 'Author', scope: 'col') %>
          <%= sort_header_tag('estimated_price', caption: 'Estimated Price', scope: 'col') %>
          <th scope="col">Budget Entry</th>
          <%= sort_header_tag('tpc_code_id', caption: 'TPC Code', scope: 'col') %>
          <%= sort_header_tag('created_at', caption: 'Created', scope: 'col') %>
          <%= sort_header_tag('updated_at', caption: 'Updated', scope: 'col') %>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @purchase_requests.each do |purchase_request| %>
          <tr class="<%= cycle('odd', 'even') %> <%= purchase_request.status.is_closed? ? 'closed' : '' %> <%= purchase_request.counts_toward_budget? ? '' : 'pr-row--void' %>">
            <td class="pr-cell-id">
              <%= link_to "##{purchase_request.id}", project_purchase_request_path(@project, purchase_request) %>
              <% unless purchase_request.counts_toward_budget? %>
                <span class="pr-badge <%= purchase_request.cancelled? ? 'pr-badge--danger' : 'pr-badge--neutral' %>">
                  <%= purchase_request.cancelled? ? l(:label_lifecycle_cancelled) : l(:label_lifecycle_superseded) %>
                </span>
              <% end %>
              <% if purchase_request.revision_number > 1 %>
                <span class="pr-badge pr-badge--info"><%= l(:label_revision_number, number: purchase_request.revision_number) %></span>
              <% end %>
            </td>
            <td class="title">
              <%= link_to purchase_request.title, project_purchase_request_path(@project, purchase_request), class: 'pr-title-link' %>
              <% if purchase_request.description.present? %>
                <div class="description-preview">
                  <%= truncate(strip_tags(purchase_request.description), length: 60) %>
                </div>
              <% end %>
            </td>
            <td class="status">
              <span class="status-badge"
                    style="background-color: <%= purchase_request.status.display_color %>; color: <%= readable_text_color(purchase_request.status.display_color) %>">
                <%= purchase_request.status.name %>
              </span>
            </td>
            <td class="author">
              <%= avatar(purchase_request.user, size: "16") %>
              <%= link_to_user purchase_request.user %>
            </td>
            <td class="price">
              <% if purchase_request.estimated_price.present? %>
                <div class="price-display">
                  <%
                    currency_code = purchase_request.currency
                    symbol = currency_symbol(currency_code)
                  %>
                  <span class="price-amount">
                    <%= symbol %><%= number_with_precision(purchase_request.estimated_price, precision: 2, delimiter: ',') %>
                  </span>
                  <span class="currency-code"><%= purchase_request.currency %></span>
                </div>
              <% else %>
                <span class="no-data">Not specified</span>
              <% end %>
            </td>
            <td class="budget-entry">
              <% if purchase_request.capex.present? %>
                <div class="budget-link-container">
                  <%= link_to purchase_request.capex.display_name,
                            project_capex_path(@project, purchase_request.capex),
                            class: 'budget-link capex-link',
                            title: "CAPEX - #{purchase_request.capex.tpc_code} - #{purchase_request.capex.year}" %>
                  <% capex_over = purchase_request.capex.utilization_percentage > 100 %>
                  <div class="budget-utilization-badge <%= 'over-budget' if capex_over %>"
                       <%= capex_over ? 'title="Over budget" aria-label="Over budget: #{purchase_request.capex.utilization_percentage.round(1)}%"'.html_safe : '' %>>
                    <% if capex_over %><span aria-hidden="true">&#9888; </span><% end %><%= purchase_request.capex.utilization_percentage.round(1) %>%
                  </div>
                </div>
              <% elsif purchase_request.opex.present? %>
                <div class="budget-link-container">
                  <%= link_to purchase_request.opex.display_name,
                            project_opex_path(@project, purchase_request.opex),
                            class: 'budget-link opex-link',
                            title: "OPEX - #{purchase_request.opex.opex_code} - #{purchase_request.opex.year}" %>
                  <% opex_over = purchase_request.opex.utilization_percentage > 100 %>
                  <div class="budget-utilization-badge <%= 'over-budget' if opex_over %>"
                       <%= opex_over ? 'title="Over budget" aria-label="Over budget: #{purchase_request.opex.utilization_percentage.round(1)}%"'.html_safe : '' %>>
                    <% if opex_over %><span aria-hidden="true">&#9888; </span><% end %><%= purchase_request.opex.utilization_percentage.round(1) %>%
                  </div>
                </div>
              <% else %>
                <span class="no-data">No Budget</span>
              <% end %>
            </td>
            <td class="tpc-code">
              <% tpc_display = purchase_request.tpc_code_display %>
              <% if tpc_display.present? %>
                <div class="tpc-code-display">
                  <span class="tpc-number"><%= tpc_display %></span>
                  <% if purchase_request.tpc_code.present? %>
                    <span class="tpc-source direct">Direct</span>
                  <% elsif purchase_request.capex&.tpc_code_record.present? %>
                    <span class="tpc-source capex">via CAPEX</span>
                  <% elsif purchase_request.opex&.tpc_code.present? %>
                    <span class="tpc-source opex">via OPEX</span>
                  <% end %>
                </div>
              <% else %>
                <span class="no-data">No TPC</span>
              <% end %>
            </td>
            <td class="created-on">
              <span class="date-display"><%= format_time(purchase_request.created_at) %></span>
            </td>
            <td class="updated-on">
              <span class="date-display"><%= format_time(purchase_request.updated_at) %></span>
            </td>
            <td class="buttons">
              <div class="pr-table-actions">
                <%= link_to project_purchase_request_path(@project, purchase_request),
                            class: 'pr-button pr-button-secondary pr-button-icon small',
                            title: 'View Details' do %>
                  <span class="icon icon-magnifier">View</span>
                <% end %>
                <%= link_to edit_project_purchase_request_path(@project, purchase_request),
                            class: 'pr-button pr-button-secondary pr-button-icon small',
                            title: 'Edit Request' do %>
                  <span class="icon icon-edit">Edit</span>
                <% end %>
                <%= link_to project_purchase_request_path(@project, purchase_request),
                            method: :delete,
                            data: { confirm: 'Are you sure you want to delete this purchase request?' },
                            class: 'pr-button pr-button-danger pr-button-icon small',
                            title: 'Delete Request' do %>
                  <span class="icon icon-del">Delete</span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if defined?(@purchase_request_count) && @purchase_request_count && @purchase_request_count > @limit %>
    <div class="pr-pagination">
      <%= pagination_links_full @pages, @purchase_request_count, per_page: @limit %>
    </div>
  <% end %>
  <% end %>
<% end %>
