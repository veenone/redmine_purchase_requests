<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<div class="contextual">
  <%= link_to project_purchase_requests_path(@project), class: 'pr-button pr-button-cancel pr-button-icon small', title: l(:button_back_to_list) do %>
    <span class="icon icon-cancel"><%= l(:button_back_to_list) %></span>
  <% end %>
</div>

<div class="pr-form-container">
  <div class="pr-form-header">
    <div class="pr-form-title">
      <h2><%= l(:label_new_purchase_request) %></h2>
      <div class="pr-form-subtitle">
        <span class="icon icon-info"></span>
        <%= l(:text_new_purchase_request_subtitle) %>
      </div>
    </div>
    <div class="pr-form-progress">
      <div class="pr-progress-indicator">
        <div class="pr-progress-step active" data-step="1">
          <div class="pr-step-number">1</div>
          <div class="pr-step-label"><%= l(:label_basic_info) %></div>
        </div>
        <div class="pr-progress-step" data-step="2">
          <div class="pr-step-number">2</div>
          <div class="pr-step-label"><%= l(:label_product_details) %></div>
        </div>
        <div class="pr-progress-step" data-step="3">
          <div class="pr-step-number">3</div>
          <div class="pr-step-label"><%= l(:label_attachments_review) %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="pr-form-instructions">
    <div class="pr-alert pr-alert-info">
      <span class="icon icon-info"></span>
      <div class="pr-alert-content">
        <h4><%= l(:label_before_you_begin) %></h4>
        <p><%= l(:text_purchase_request_guidelines) %></p>
        <ul class="pr-checklist">
          <li><%= l(:text_check_budget_approval) %></li>
          <li><%= l(:text_check_vendor_requirements) %></li>
          <li><%= l(:text_prepare_specifications) %></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="pr-form-box">
    <div class="pr-tabs">
      <ul class="pr-tab-nav" role="tablist" aria-label="Purchase request sections">
        <li class="pr-tab-item active">
          <a href="#tab-general" class="pr-tab-link" data-tab="tab-general"
             role="tab" id="tab-general-tab" aria-controls="tab-general" aria-selected="true" tabindex="0">
            <span class="icon icon-edit"></span>
            <%= l(:label_basic_information) %>
          </a>
        </li>
        <li class="pr-tab-item">
          <a href="#tab-details" class="pr-tab-link" data-tab="tab-details"
             role="tab" id="tab-details-tab" aria-controls="tab-details" aria-selected="false" tabindex="-1">
            <span class="icon icon-package"></span>
            <%= l(:label_product_details) %>
          </a>
        </li>
        <li class="pr-tab-item">
          <a href="#tab-attachments" class="pr-tab-link" data-tab="tab-attachments"
             role="tab" id="tab-attachments-tab" aria-controls="tab-attachments" aria-selected="false" tabindex="-1">
            <span class="icon icon-attachment"></span>
            <%= l(:label_attachments_and_notes) %>
          </a>
        </li>
      </ul>
    </div>

    <div class="pr-form-content">
      <%= render partial: 'form', locals: {
        purchase_request: @purchase_request,
        form_url: project_purchase_requests_path(@project),
        button_label: l(:button_create_request),
        cancel_path: project_purchase_requests_path(@project)
      } %>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // ARIA tab activation helper (new page, vanilla JS)
  var tabLinks = document.querySelectorAll('.pr-tab-link');
  var tabPanes = document.querySelectorAll('.tab-pane');
  var progressSteps = document.querySelectorAll('.pr-progress-step');

  function activateNewTab(tabId, moveFocus) {
    // Hide all panes
    tabPanes.forEach(function(pane) {
      pane.style.display = 'none';
    });
    var targetPane = document.getElementById(tabId);
    if (!targetPane) { tabId = 'tab-general'; targetPane = document.getElementById('tab-general'); }
    targetPane.style.display = 'block';

    // Update ARIA state and active class on tab links
    tabLinks.forEach(function(link, idx) {
      var isActive = (link.getAttribute('data-tab') === tabId);
      link.setAttribute('aria-selected', isActive ? 'true' : 'false');
      link.setAttribute('tabindex', isActive ? '0' : '-1');
      link.parentElement.classList.toggle('active', isActive);

      if (progressSteps[idx]) {
        progressSteps[idx].classList.toggle('active', isActive);
      }
    });

    // Hash sync — use replaceState to avoid scroll jump
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', '#' + tabId);
    } else {
      window.location.hash = tabId;
    }

    if (moveFocus) {
      var focusTarget = document.querySelector('[data-tab="' + tabId + '"]');
      if (focusTarget) focusTarget.focus();
    }
  }

  // Click handlers
  tabLinks.forEach(function(link) {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      activateNewTab(this.getAttribute('data-tab'), false);
    });
  });

  // Keyboard navigation on the tablist (ArrowRight/Left/Home/End)
  var tabNav = document.querySelector('.pr-tab-nav');
  if (tabNav) {
    tabNav.addEventListener('keydown', function(e) {
      var tabs = Array.prototype.slice.call(document.querySelectorAll('.pr-tab-nav .pr-tab-link'));
      var idx = tabs.indexOf(document.activeElement);
      if (idx === -1) return;
      var next = idx;
      if (e.key === 'ArrowRight') { next = (idx + 1) % tabs.length; }
      else if (e.key === 'ArrowLeft') { next = (idx - 1 + tabs.length) % tabs.length; }
      else if (e.key === 'Home') { next = 0; }
      else if (e.key === 'End') { next = tabs.length - 1; }
      else { return; }
      e.preventDefault();
      activateNewTab(tabs[next].getAttribute('data-tab'), true);
    });
  }

  // Hash sync on load — activate from URL hash, fall back to general
  var initialHash = window.location.hash.replace('#', '');
  var validTabs = Array.prototype.slice.call(tabLinks).map(function(l) { return l.getAttribute('data-tab'); });
  var startTab = (initialHash && validTabs.indexOf(initialHash) !== -1) ? initialHash : 'tab-general';
  activateNewTab(startTab, false);
});
</script>
