<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/purchase_requests/show.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title "#{l(:label_purchase_request)} ##{@purchase_request.id}: #{h(@purchase_request.title)}" %>

<div class="contextual">
  <% if User.current.allowed_to?(:edit_purchase_requests, @project) %>
    <%= link_to edit_project_purchase_request_path(@project, @purchase_request), class: 'pr-button pr-button-secondary pr-button-icon small', title: l(:button_edit) do %>
      <span class="icon icon-edit"><%= l(:button_edit) %></span>
    <% end %>
  <% end %>
  <% if User.current.allowed_to?(:delete_purchase_requests, @project) %>
    <%= link_to project_purchase_request_path(@project, @purchase_request),
              method: :delete,
              data: { confirm: l(:text_are_you_sure) },
              class: 'pr-button pr-button-danger pr-button-icon small',
              title: l(:button_delete) do %>
      <span class="icon icon-del"><%= l(:button_delete) %></span>
    <% end %>
  <% end %>
  <% if @purchase_request.revisable? && User.current.allowed_to?(:revise_purchase_requests, @project) %>
    <%= link_to revise_project_purchase_request_path(@project, @purchase_request),
              method: :post,
              data: { confirm: l(:text_are_you_sure) },
              class: 'pr-button pr-button-primary pr-button-icon small',
              title: l(:button_revise) do %>
      <span class="icon icon-add"><%= l(:button_revise) %></span>
    <% end %>
  <% end %>
  <% if @purchase_request.cancellable? && User.current.allowed_to?(:cancel_purchase_requests, @project) %>
    <%= link_to cancel_project_purchase_request_path(@project, @purchase_request),
              class: 'pr-button pr-button-danger pr-button-icon small',
              title: l(:button_cancel_request) do %>
      <span class="icon icon-cancel"><%= l(:button_cancel_request) %></span>
    <% end %>
  <% end %>
  <% if @purchase_request.uncancellable? && User.current.allowed_to?(:cancel_purchase_requests, @project) %>
    <%= link_to uncancel_project_purchase_request_path(@project, @purchase_request),
              method: :post,
              class: 'pr-button pr-button-secondary pr-button-icon small',
              title: l(:button_reinstate_request) do %>
      <span class="icon icon-checked"><%= l(:button_reinstate_request) %></span>
    <% end %>
  <% end %>
  <%= link_to project_purchase_requests_path(@project), class: 'pr-button pr-button-cancel pr-button-icon small', title: l(:button_back_to_list) do %>
    <span class="icon icon-cancel"><%= l(:button_back_to_list) %></span>
  <% end %>
</div>

<%= render partial: 'purchase_requests/lifecycle_banner', locals: { request_record: @purchase_request } %>
<% if @purchase_request.revision_of.present? || @purchase_request.superseded_by.present? %>
  <div class="pr-hint pr-block-gap">
    <%= l(:label_revision_number, number: @purchase_request.revision_number) %>
    <% if @purchase_request.revision_of.present? %>
      &middot;
      <%= l(:label_revision_of) %>
      <%= link_to "##{@purchase_request.revision_of.id}", project_purchase_request_path(@project, @purchase_request.revision_of) %>
    <% end %>
  </div>
<% end %>

<div class="pr-form-container">
  <div class="pr-form-header">
    <div class="pr-form-title">
      <h2>
        <%= l(:label_purchase_request) %>
        <span class="request-id">#<%= @purchase_request.id %></span>
      </h2>
      <div class="pr-form-subtitle">
        <span class="icon icon-info"></span>
        <%= l(:text_purchase_request_details) %>
      </div>
    </div>
    <div class="pr-form-status">
      <div class="pr-status-info">
        <span class="status-badge" style="background-color: <%= @purchase_request.status.display_color %>; color: <%= readable_text_color(@purchase_request.status.display_color) %>">
          <%= @purchase_request.status.name %>
        </span>
        <span class="priority-badge <%= @purchase_request.priority %>">
          <%= l("label_priority_#{@purchase_request.priority}".to_sym) %>
        </span>
        <span class="last-updated">
          <%= l(:label_last_updated) %>: <%= format_time(@purchase_request.updated_at) %>
        </span>
      </div>
      <%# C2 summary strip — always visible, outside tabs %>
      <div class="pr-meta pr-header-summary">
        <span class="meta-item">
          <span class="label"><%= l(:field_estimated_price) %>:</span>
          <span class="value">
            <% if @purchase_request.estimated_price.present? %>
              <%= @purchase_request.formatted_price %>
              <% if @purchase_request.currency != Setting.plugin_redmine_purchase_requests['default_currency'] %>
                <span class="pr-badge pr-badge--neutral"><%= @purchase_request.currency %></span>
              <% end %>
            <% else %>
              &mdash;
            <% end %>
          </span>
        </span>
        <span class="meta-item">
          <span class="label"><%= l(:label_budget_type) %>:</span>
          <span class="value">
            <% if @purchase_request.capex.present? %>
              CAPEX: <%= link_to @purchase_request.capex.display_name,
                                 project_capex_path(@project, @purchase_request.capex),
                                 class: 'capex-link' %>
            <% elsif @purchase_request.opex.present? %>
              OPEX: <%= link_to @purchase_request.opex.display_name,
                                project_opex_path(@project, @purchase_request.opex),
                                class: 'opex-link' %>
            <% else %>
              No budget
            <% end %>
          </span>
        </span>
        <% tpc_summary = @purchase_request.tpc_code_display %>
        <% if tpc_summary.present? %>
          <span class="meta-item">
            <span class="label"><%= l(:label_tpc_code) %>:</span>
            <span class="value pr-badge pr-badge--violet"><%= tpc_summary %></span>
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="pr-form-instructions">
    <div class="pr-alert pr-alert-info">
      <span class="icon icon-info"></span>
      <div class="pr-alert-content">
        <h4><%= l(:label_request_details) %></h4>
        <div class="pr-request-title">
          <strong><%= h(@purchase_request.title) %></strong>
        </div>
      </div>
    </div>
  </div>

  <div class="pr-form-box">
    <div class="pr-tabs">
      <ul class="pr-tab-nav" role="tablist" aria-label="Purchase request sections">
        <li class="pr-tab-item active">
          <a href="#tab-general" class="pr-tab-link" data-tab="tab-general"
             role="tab" id="tab-general-tab" aria-controls="tab-general" aria-selected="true" tabindex="0">
            <span class="icon icon-edit"><%= l(:label_general) %></span>
          </a>
        </li>
        <li class="pr-tab-item">
          <a href="#tab-details" class="pr-tab-link" data-tab="tab-details"
             role="tab" id="tab-details-tab" aria-controls="tab-details" aria-selected="false" tabindex="-1">
            <span class="icon icon-package"><%= l(:label_details) %></span>
          </a>
        </li>
        <% if @purchase_request.attachments.any? %>
          <li class="pr-tab-item">
            <a href="#tab-attachments" class="pr-tab-link" data-tab="tab-attachments"
               role="tab" id="tab-attachments-tab" aria-controls="tab-attachments" aria-selected="false" tabindex="-1">
              <span class="icon icon-attachment"></span>
              <%= l(:label_attachment_plural) %>
            </a>
          </li>
        <% end %>
        <li class="pr-tab-item">
          <a href="#tab-workflow" class="pr-tab-link" data-tab="tab-workflow"
             role="tab" id="tab-workflow-tab" aria-controls="tab-workflow" aria-selected="false" tabindex="-1">
            <span class="icon icon-issue"></span>
            <%= l(:label_workflow) %>
            <% if @purchase_request.has_linked_issue? %>
              <span class="workflow-progress-badge"><%= @purchase_request.workflow_progress %>%</span>
            <% end %>
          </a>
        </li>
      </ul>
    </div>

    <div class="pr-form-content">
      <div class="purchase-request-content tab-content" id="tab-content">
    <div id="tab-general" class="tabbed-form" role="tabpanel" aria-labelledby="tab-general-tab" tabindex="0">
      <div class="purchase-meta">
        <div class="meta-item">
          <span class="label"><%= l(:field_created_on) %>:</span>
          <span class="value"><%= format_time(@purchase_request.created_at) %></span>
        </div>
        <div class="meta-item">
          <span class="label"><%= l(:field_author) %>:</span>
          <span class="value"><%= link_to_user @purchase_request.user %></span>
        </div>
        <% if @purchase_request.due_date.present? %>
          <div class="meta-item">
            <span class="label"><%= l(:field_due_date) %>:</span>
            <span class="value<%= ' overdue' if @purchase_request.due_date < Date.today && !@purchase_request.status.is_closed? %>">
              <%= format_date(@purchase_request.due_date) %>
            </span>
          </div>
        <% end %>
      </div>

      <div class="details-section">
        <h4><%= l(:field_description) %></h4>
        <div class="wiki">
          <%= textilizable(@purchase_request.description) %>
        </div>
      </div>
    </div>

    <div id="tab-details" class="tabbed-form" style="display: none;" role="tabpanel" aria-labelledby="tab-details-tab" tabindex="0">
      <div class="details-columns">
        <div class="column">
          <div class="details-section">
            <h4><%= l(:field_product_details) %></h4>
            <div class="details-grid">
              <% if @purchase_request.product_url.present? %>
                <div class="grid-row">
                  <span class="label"><%= l(:field_product_url) %>:</span>
                  <span class="value"><%= link_to @purchase_request.product_url, @purchase_request.product_url, target: "_blank", rel: "noopener noreferrer", class: "external" %></span>
                </div>
              <% end %>

              <% if @purchase_request.vendor.present? || @purchase_request.vendor_id.present? %>
                <div class="grid-row">
                  <span class="label"><%= l(:field_vendor) %>:</span>
                  <span class="value">
                    <%
                      vendor_obj = nil
                      if @purchase_request.vendor_id.present?
                        vendor_obj = Vendor.find_by(id: @purchase_request.vendor_id)
                        if vendor_obj
                          vendor_name = vendor_obj.name
                        else
                          vendor_name = @purchase_request.vendor
                        end
                      else
                        vendor_name = @purchase_request.vendor
                      end
                    %>
                    <%= vendor_name %>

                    <% if vendor_obj.present? %>
                      <div class="vendor-details-display">
                        <% if vendor_obj.vendor_id.present? %>
                          <div><strong><%= l(:field_vendor_id) %>:</strong> <%= vendor_obj.vendor_id %></div>
                        <% end %>

                        <% if vendor_obj.address.present? %>
                          <div><strong><%= l(:field_address) %>:</strong> <%= vendor_obj.address %></div>
                        <% end %>

                        <% if vendor_obj.contact_person.present? %>
                          <div><strong><%= l(:field_contact_person) %>:</strong> <%= vendor_obj.contact_person %></div>
                        <% end %>

                        <% if vendor_obj.phone.present? %>
                          <div><strong><%= l(:field_phone) %>:</strong> <%= vendor_obj.phone %></div>
                        <% end %>

                        <% if vendor_obj.email.present? %>
                          <div><strong><%= l(:field_email) %>:</strong>
                            <a href="mailto:<%= vendor_obj.email %>"><%= vendor_obj.email %></a>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </span>
                </div>
              <% end %>

              <% if @purchase_request.estimated_price.present? %>
                <div class="grid-row">
                  <span class="label"><%= l(:field_estimated_price) %>:</span>
                  <span class="value price">
                    <%= @purchase_request.formatted_price %>
                    <% if @purchase_request.currency != Setting.plugin_redmine_purchase_requests['default_currency'] %>
                      <span class="currency-badge"><%= @purchase_request.currency %></span>
                    <% end %>
                  </span>
                </div>
              <% end %>

              <% if @purchase_request.capex.present? %>
                <div class="grid-row">
                  <span class="label"><%= l(:field_capex_entry) %>:</span>
                  <span class="value">
                    <%= link_to @purchase_request.capex.display_name,
                              project_capex_path(@project, @purchase_request.capex),
                              class: 'capex-link' %>
                    <div class="capex-details-display">
                      <div><strong><%= l(:field_capex_year) %>:</strong> <%= @purchase_request.capex.year %></div>
                      <div><strong><%= l(:field_capex_tpc_code) %>:</strong> <%= @purchase_request.capex.tpc_code %></div>
                      <div><strong><%= l(:field_capex_total_amount) %>:</strong>
                        <%= format_price(@purchase_request.capex.total_amount, @purchase_request.capex.currency) %>
                      </div>
                      <div><strong><%= l(:field_capex_remaining_amount) %>:</strong>
                        <span class="<%= @purchase_request.capex.remaining_amount < 0 ? 'over-budget' : 'remaining-budget' %>">
                          <%= format_price(@purchase_request.capex.remaining_amount, @purchase_request.capex.currency) %>
                        </span>
                      </div>
                      <div><strong><%= l(:field_capex_utilization_percentage) %>:</strong>
                        <span class="utilization-percentage">
                          <%= @purchase_request.capex.utilization_percentage.round(1) %>%
                        </span>
                      </div>
                    </div>
                  </span>
                </div>
              <% elsif @purchase_request.opex.present? %>
                <div class="grid-row">
                  <span class="label"><%= l(:field_opex_entry) %>:</span>
                  <span class="value">
                    <%= link_to @purchase_request.opex.display_name,
                              project_opex_path(@project, @purchase_request.opex),
                              class: 'opex-link' %>
                    <div class="opex-details-display">
                      <div><strong><%= l(:field_opex_year) %>:</strong> <%= @purchase_request.opex.year %></div>
                      <div><strong><%= l(:field_opex_code) %>:</strong> <%= @purchase_request.opex.opex_code %></div>
                      <div><strong><%= l(:field_opex_category) %>:</strong> <%= @purchase_request.opex.category %></div>
                      <div><strong><%= l(:field_opex_total_amount) %>:</strong>
                        <%= format_price(@purchase_request.opex.total_amount, @purchase_request.opex.currency) %>
                      </div>
                      <div><strong><%= l(:field_opex_remaining_amount) %>:</strong>
                        <span class="<%= @purchase_request.opex.remaining_amount < 0 ? 'over-budget' : 'remaining-budget' %>">
                          <%= format_price(@purchase_request.opex.remaining_amount, @purchase_request.opex.currency) %>
                        </span>
                      </div>
                      <div><strong><%= l(:field_opex_utilization_percentage) %>:</strong>
                        <span class="utilization-percentage">
                          <%= @purchase_request.opex.utilization_percentage.round(1) %>%
                        </span>
                      </div>
                    </div>
                  </span>
                </div>
              <% end %>

              <% tpc_display = @purchase_request.tpc_code_display %>
              <% if tpc_display.present? %>
                <div class="grid-row">
                  <span class="label"><%= l(:label_tpc_code) %>:</span>
                  <span class="value">
                    <div class="tpc-code-details-display">
                      <div class="tpc-main-info">
                        <strong class="tpc-number"><%= tpc_display %></strong>
                        <% if @purchase_request.tpc_code.present? %>
                          <span class="tpc-source-badge direct">Direct Assignment</span>
                        <% elsif @purchase_request.capex&.tpc_code_record.present? %>
                          <span class="tpc-source-badge capex">Inherited from CAPEX</span>
                        <% elsif @purchase_request.opex&.tpc_code.present? %>
                          <span class="tpc-source-badge opex">Inherited from OPEX</span>
                        <% end %>
                      </div>

                      <%
                        tpc_record = @purchase_request.tpc_code ||
                                     @purchase_request.capex&.tpc_code_record ||
                                     @purchase_request.opex&.tpc_code
                      %>
                      <% if tpc_record.present? %>
                        <div class="tpc-owner-info">
                          <div><strong>Owner:</strong> <%= tpc_record.tpc_owner_name %></div>
                          <% if tpc_record.department.present? %>
                            <div><strong>Department:</strong> <%= tpc_record.department.name %></div>
                          <% end %>
                          <div><strong>Email:</strong> <%= mail_to tpc_record.tpc_email, tpc_record.tpc_email %></div>
                          <% if tpc_record.description.present? %>
                            <div><strong>Description:</strong> <%= tpc_record.description %></div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </span>
                </div>
              <% end %>

              <% if @purchase_request.has_quarterly_allocation? %>
                <div class="grid-row">
                  <span class="label"><%= l(:label_quarterly_allocation) %>:</span>
                  <span class="value">
                    <%= @purchase_request.quarter_name %> - <%= @purchase_request.formatted_price(@purchase_request.allocated_amount) %>
                    <div class="quarterly-allocation-display">
                      <% allocation_impact = @purchase_request.allocation_impact_on_budget %>
                      <% if allocation_impact.any? %>
                        <div><strong><%= l(:field_selected_quarter) %>:</strong> <%= allocation_impact[:quarter_name] %></div>
                        <div><strong><%= l(:field_allocated_amount) %>:</strong>
                          <%= format_price(allocation_impact[:allocated_amount], @purchase_request.currency) %>
                        </div>
                        <div><strong><%= l(:field_original_quarter_budget) %>:</strong>
                          <%= format_price(allocation_impact[:original_amount], @purchase_request.currency) %>
                        </div>
                        <div><strong><%= l(:field_remaining_quarter_budget) %>:</strong>
                          <span class="<%= allocation_impact[:is_over_allocated] ? 'over-budget' : 'remaining-budget' %>">
                            <%= format_price(allocation_impact[:remaining_amount], @purchase_request.currency) %>
                          </span>
                        </div>
                        <% if allocation_impact[:is_over_allocated] %>
                          <div class="pr-alert pr-alert-warning">
                            <span class="icon icon-warning"></span>
                            <div class="pr-alert-content"><strong><%= l(:warning_over_allocation) %></strong></div>
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                  </span>
                </div>
              <% end %>

            </div>
          </div>
        </div>

        <% if @purchase_request.notes.present? %>
          <div class="column">
            <div class="details-section">
              <h4><%= l(:label_additional_notes) %></h4>
              <div class="notes">
                <%= simple_format(h(@purchase_request.notes)) %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <% if @purchase_request.attachments.any? %>
      <div id="tab-attachments" class="tabbed-form" style="display: none;" role="tabpanel" aria-labelledby="tab-attachments-tab" tabindex="0">
        <div class="details-section">
          <h4><%= l(:label_attachment_plural) %></h4>
          <div class="attachments">
            <%= render partial: 'attachments/links', locals: { attachments: @purchase_request.attachments } %>
          </div>
        </div>
      </div>
    <% end %>

    <div id="tab-workflow" class="tabbed-form" style="display: none;" role="tabpanel" aria-labelledby="tab-workflow-tab" tabindex="0">
      <div class="details-section">
        <h4><%= l(:label_workflow_status) %></h4>

        <% if @purchase_request.has_linked_issue? %>
            <div class="workflow-main-issue">
              <div class="workflow-issue-header">
                <span class="icon icon-issue"></span>
                <strong><%= l(:label_linked_issue) %>:</strong>
                <%= link_to "##{@purchase_request.issue.id}: #{@purchase_request.issue.subject}",
                            issue_path(@purchase_request.issue),
                            class: 'workflow-issue-link' %>
                <span class="issue-status-badge">
                  <%= @purchase_request.issue.status.name %>
                </span>
              </div>

              <div class="workflow-progress-container">
                <div class="workflow-progress-label">
                  <span><%= l(:label_workflow_progress) %></span>
                  <span class="progress-percentage"><%= @purchase_request.workflow_progress %>%</span>
                </div>
                <div class="workflow-progress-bar">
                  <div class="workflow-progress-fill" style="width: <%= @purchase_request.workflow_progress %>%;"></div>
                </div>
              </div>

              <% if @purchase_request.subtask_issues.any? %>
                <div class="workflow-subtasks">
                  <h5><%= l(:label_workflow_subtasks) %></h5>
                  <table class="workflow-subtasks-table">
                    <thead>
                      <tr>
                        <th scope="col"><%= l(:field_subject) %></th>
                        <th scope="col"><%= l(:field_status) %></th>
                        <th scope="col"><%= l(:field_assigned_to) %></th>
                        <th scope="col"><%= l(:field_done_ratio) %></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% @purchase_request.subtask_issues.order(:id).each do |subtask| %>
                        <tr class="<%= subtask.status.is_closed? ? 'subtask-completed' : 'subtask-pending' %>">
                          <td>
                            <%= link_to "##{subtask.id}: #{subtask.subject}", issue_path(subtask) %>
                          </td>
                          <td>
                            <span class="subtask-status-badge">
                              <%= subtask.status.name %>
                            </span>
                          </td>
                          <td><%= subtask.assigned_to&.name || '-' %></td>
                          <td>
                            <div class="mini-progress-bar">
                              <div class="mini-progress-fill" style="width: <%= subtask.done_ratio %>%;"></div>
                              <span class="mini-progress-text"><%= subtask.done_ratio %>%</span>
                            </div>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>

              <% if @purchase_request.all_subtasks_completed? %>
                <div class="workflow-complete-notice">
                  <span class="icon icon-checked"></span>
                  <%= l(:notice_workflow_complete) %>
                </div>
              <% else %>
                <% next_task = @purchase_request.next_pending_subtask %>
                <% if next_task %>
                  <div class="workflow-next-task">
                    <span class="icon icon-bullet"></span>
                    <strong><%= l(:label_next_task) %>:</strong>
                    <%= link_to next_task.subject, issue_path(next_task) %>
                  </div>
                <% end %>
              <% end %>
            </div>
        <% elsif @purchase_request.workflow_enabled? %>
          <div class="workflow-not-started">
            <div class="workflow-notice">
              <span class="icon icon-info"></span>
              <%= l(:notice_workflow_not_started) %>
            </div>
            <% if User.current.allowed_to?(:edit_purchase_requests, @project) %>
              <%= link_to create_workflow_issue_project_purchase_request_path(@project, @purchase_request),
                          method: :post,
                          class: 'pr-button pr-button-primary workflow-create-button' do %>
                <span class="icon icon-add"></span>
                <%= l(:button_create_workflow_issue) %>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="workflow-not-enabled">
            <div class="workflow-notice">
              <span class="icon icon-warning"></span>
              <%= l(:text_workflow_not_enabled) %>
            </div>
            <% if User.current.admin? %>
              <p class="workflow-setup-hint">
                <%= link_to l(:label_configure_workflow, default: 'Configure Workflow'),
                            plugin_settings_path('redmine_purchase_requests', anchor: 'workflow'),
                            class: 'icon icon-settings' %>
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="pr-form-actions">
      <% if User.current.allowed_to?(:edit_purchase_requests, @project) %>
        <%= link_to edit_project_purchase_request_path(@project, @purchase_request), class: 'pr-button pr-button-primary' do %>
          <%= l(:button_edit) %>
        <% end %>
      <% end %>
      <%= link_to project_purchase_requests_path(@project), class: 'pr-button pr-button-cancel' do %>
        <%= l(:button_back_to_list) %>
      <% end %>
    </div>
    </div>
  </div>
</div>
</div>

<%= javascript_tag do %>
$(document).ready(function() {
  // ARIA tab activation helper (show page)
  function activateShowTab(tabId, moveFocus) {
    // Update pane visibility
    $('.tabbed-form').hide();
    var targetPane = $('#' + tabId);
    if (!targetPane.length) { tabId = 'tab-general'; targetPane = $('#tab-general'); }
    targetPane.show();

    // Update ARIA state on tab links
    $('.pr-tab-link').each(function() {
      var isActive = ($(this).data('tab') === tabId);
      $(this).attr('aria-selected', isActive ? 'true' : 'false')
             .attr('tabindex', isActive ? '0' : '-1');
      $(this).parent('.pr-tab-item').toggleClass('active', isActive);
    });

    // Hash sync — use replaceState to avoid scroll jump
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, '', '#' + tabId);
    } else {
      window.location.hash = tabId;
    }

    // Optionally move focus to tab link (keyboard nav)
    if (moveFocus) {
      $('[data-tab="' + tabId + '"]').focus();
    }
  }

  // Keyboard navigation on the tablist (ArrowRight/Left/Home/End)
  $('.pr-tab-nav').on('keydown', '.pr-tab-link', function(e) {
    var $tabs = $('.pr-tab-nav .pr-tab-link');
    var idx = $tabs.index(this);
    var next = idx;
    if (e.key === 'ArrowRight') { next = (idx + 1) % $tabs.length; }
    else if (e.key === 'ArrowLeft') { next = (idx - 1 + $tabs.length) % $tabs.length; }
    else if (e.key === 'Home') { next = 0; }
    else if (e.key === 'End') { next = $tabs.length - 1; }
    else { return; }
    e.preventDefault();
    activateShowTab($tabs.eq(next).data('tab'), true);
  });

  // Click handler
  $('.pr-tab-link').on('click', function(e) {
    e.preventDefault();
    activateShowTab($(this).data('tab'), false);
    return false;
  });

  // Hash sync on load — activate tab from URL hash, fall back to general
  var initialHash = window.location.hash.replace('#', '');
  var validTabs = [];
  $('.pr-tab-link').each(function() { validTabs.push($(this).data('tab')); });
  var startTab = (initialHash && validTabs.indexOf(initialHash) !== -1) ? initialHash : 'tab-general';
  activateShowTab(startTab, false);
});
<% end %>
