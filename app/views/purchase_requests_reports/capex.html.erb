<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/reports/capex.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% end %>

<% html_title("CAPEX Report#{@project ? " - #{@project.name}" : ""}") %>

<% unless @print_mode %>
<div class="contextual">
  <% reports_index_path = @project ? project_reports_path(@project) : reports_path %>
  <%= link_to reports_index_path, class: 'pr-button pr-button-cancel pr-button-icon' do %>
    <span class="icon icon-cancel">Back to Reports</span>
  <% end %>

  <% report_path_base = @project ?
       capex_project_reports_path(@project) :
       capex_reports_path %>

  <%= render 'export_actions', report_path_base: report_path_base %>
</div>
<% end %>

<h2>
  CAPEX Report<%= report_year_suffix %>
  <% if @project %>
    <span class="pr-badge pr-badge--accent pr-badge--heading"><%= @project.name %></span>
  <% end %>
</h2>

<% unless @print_mode %>
<%= render 'year_filter', filter_path: report_path_base %>
<% end %>

<div class="info-box">
  <p><strong>Generated:</strong> <%= @report_data[:generated_at].strftime('%B %d, %Y at %I:%M %p') %></p>
  <p style="margin:0;">
    <% if @project %>
      <strong>Scope:</strong> CAPEX items for <%= @project.name %>
    <% else %>
      <strong>Scope:</strong> All CAPEX items across the system
    <% end %>
  </p>
</div>

<!-- Executive Summary -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>CAPEX Overview</h3></div>
  <div class="dashboard-card-body">
    <div class="summary-stats">
      <div class="stat-box pr-stat--accent">
        <div class="stat-number"><%= @report_data[:summary][:total_items] %></div>
        <div class="stat-label">Total CAPEX Items</div>
      </div>
      <div class="stat-box pr-stat--warning">
        <div class="stat-number stat-currency">$<%= number_with_delimiter(@report_data[:summary][:total_value].round(0)) %></div>
        <div class="stat-label">Total CAPEX Value</div>
      </div>
      <div class="stat-box pr-stat--success">
        <div class="stat-number stat-currency">$<%= number_with_delimiter(@report_data[:summary][:current_year_value].round(0)) %></div>
        <div class="stat-label"><%= Date.current.year %> CAPEX</div>
      </div>
      <div class="stat-box pr-stat--accent">
        <div class="stat-number"><%= @report_data[:summary][:total_capex_prs] %></div>
        <div class="stat-label">Linked PRs</div>
      </div>
      <div class="stat-box pr-stat--success">
        <div class="stat-number stat-currency">$<%= number_with_delimiter(@report_data[:summary][:total_capex_pr_value].round(0)) %></div>
        <div class="stat-label">PR Total Value</div>
      </div>
      <div class="stat-box pr-stat--violet">
        <div class="stat-number"><%= @report_data[:summary][:years_covered].count %></div>
        <div class="stat-label">Years Covered</div>
      </div>
    </div>
  </div>
</div>

<!-- Utilization Status Breakdown -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>CAPEX Utilization Analysis</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid">
      <div>
        <p style="text-align:center;font-size: var(--pr-text-base);font-weight:600;color:var(--pr-ink-muted);margin:0 0 10px;">CAPEX Usage Status</p>
        <div style="height:260px;"><canvas id="utilizationChart"></canvas></div>
      </div>
      <div>
        <p style="text-align:center;font-size: var(--pr-text-base);font-weight:600;color:var(--pr-ink-muted);margin:0 0 10px;">Utilization Level Distribution</p>
        <div style="height:260px;"><canvas id="utilizationStatusChart"></canvas></div>
      </div>
    </div>

    <div class="summary-stats" style="margin-top:18px;">
      <% @report_data[:utilization_status_breakdown].each do |status, count| %>
        <%
          accent_class = case status
            when /over/i   then 'pr-stat--danger'
            when /high/i   then 'pr-stat--warning'
            when /medium/i then 'pr-stat--accent'
            when /low/i    then 'pr-stat--success'
            else 'pr-stat--violet'
          end
        %>
        <div class="stat-box <%= accent_class %>">
          <div class="stat-number"><%= count %></div>
          <div class="stat-label"><%= status %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Top Utilized CAPEX Items -->
<% if @report_data[:top_utilized].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Top CAPEX Items by Utilization</h3></div>
  <div class="dashboard-card-body">
    <div class="autoscroll">
      <table class="pr-table">
        <thead>
          <tr>
            <th scope="col">Year</th>
            <th scope="col">Description</th>
            <th scope="col">Budgeted</th>
            <th scope="col">Spent</th>
            <th scope="col">Remaining</th>
            <th scope="col">Utilization</th>
            <th scope="col">PRs</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @report_data[:top_utilized].each do |item| %>
            <tr>
              <td><%= item[:year] %></td>
              <td><%= truncate(item[:description], length: 40) %></td>
              <td class="stat-currency">$<%= number_with_delimiter(item[:budgeted].round(0)) %></td>
              <td class="stat-currency">$<%= number_with_delimiter(item[:spent].round(0)) %></td>
              <td class="<%= item[:remaining] < 0 ? 'over-budget' : 'remaining-budget' %>">
                $<%= number_with_delimiter(item[:remaining].round(0)) %>
              </td>
              <td style="min-width:130px;">
                <div class="utilization-bar">
                  <div class="utilization-fill <%= item[:status] == 'over_budget' ? 'over-utilized' : '' %>" style="width: <%= [item[:utilization_pct], 100].min %>%"></div>
                  <span class="utilization-text"><%= item[:utilization_pct] %>%</span>
                </div>
              </td>
              <td><%= item[:pr_count] %></td>
              <td>
                <%
                  badge_class = case item[:status]
                    when 'over_budget'        then 'pr-badge--danger'
                    when 'high_utilization'   then 'pr-badge--warning'
                    when 'medium_utilization' then 'pr-badge--accent'
                    when 'low_utilization'    then 'pr-badge--success'
                    else 'pr-badge--neutral'
                  end
                  badge_label = case item[:status]
                    when 'over_budget'        then 'Over Budget'
                    when 'high_utilization'   then 'High'
                    when 'medium_utilization' then 'Medium'
                    when 'low_utilization'    then 'Low'
                    when 'unused'             then 'Unused'
                    else item[:status]
                  end
                %>
                <span class="pr-badge <%= badge_class %>"><%= badge_label %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% end %>

<!-- Purchase Request Status Breakdown -->
<% if @report_data[:pr_status_breakdown].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Purchase Requests by Status</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid">
      <div class="pr-chart-box"><canvas id="prStatusChart"></canvas></div>
      <div>
        <% total_prs = @report_data[:pr_status_breakdown].values.sum %>
        <% @report_data[:pr_status_breakdown].each do |status, count| %>
          <div style="display:flex;align-items:center;gap:12px;padding:10px 12px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-radius:var(--pr-radius-sm);margin-bottom:8px;">
            <span style="flex:1;font-weight:500;color:var(--pr-ink);font-size: var(--pr-text-base);"><%= status %></span>
            <span style="font-size: var(--pr-text-lg);font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;"><%= count %></span>
            <span style="font-size: var(--pr-text-sm);color:var(--pr-ink-faint);min-width:44px;text-align:right;"><%= total_prs > 0 ? "#{((count.to_f / total_prs) * 100).round(1)}%" : "0%" %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>

<!-- Yearly Trend -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>CAPEX by Year</h3></div>
  <div class="dashboard-card-body">
    <div style="height:280px;max-width:700px;margin:0 auto 18px;"><canvas id="yearlyChart"></canvas></div>
    <div class="pr-grid--narrow" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;">
      <% @report_data[:yearly_totals].each do |year, total| %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-left:3px solid var(--pr-warning);border-radius:var(--pr-radius-sm);">
          <span style="font-weight:600;color:var(--pr-ink);font-size: var(--pr-text-base);"><%= year %></span>
          <span style="color:var(--pr-warning-ink);font-weight:700;font-size: var(--pr-text-base);font-variant-numeric:tabular-nums;">$<%= number_with_delimiter(total.round(2)) %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Quarterly Analysis -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3><%= Date.current.year %> Quarterly Breakdown</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid">
      <div class="pr-chart-box"><canvas id="quarterlyChart"></canvas></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;align-content:start;">
        <% [:q1, :q2, :q3, :q4].each_with_index do |quarter, index| %>
          <%
            total_quarterly = @report_data[:quarterly_breakdown].values.sum
            qpct = total_quarterly > 0 ? ((@report_data[:quarterly_breakdown][quarter] / total_quarterly) * 100).round(1) : 0
          %>
          <div style="text-align:center;padding:18px 14px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-top:3px solid var(--pr-accent);border-radius:var(--pr-radius);">
            <div style="font-size: var(--pr-text-base);font-weight:600;color:var(--pr-ink-muted);margin-bottom:6px;">Q<%= index + 1 %> <%= Date.current.year %></div>
            <div style="font-size: var(--pr-text-xl);font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;margin-bottom:4px;">$<%= number_with_delimiter(@report_data[:quarterly_breakdown][quarter].round(2)) %></div>
            <div style="font-size: var(--pr-text-sm);color:var(--pr-accent-ink);font-weight:500;"><%= qpct %>%</div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- TPC Distribution -->
<% if @report_data[:tpc_distribution].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Top TPC Code Allocations</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-card-stack">
      <% @report_data[:tpc_distribution].each_with_index do |(tpc_info, amount), index| %>
        <div class="pr-rank-row">
          <span class="pr-rank-badge" style="background:var(--pr-warning);color:var(--pr-ink-invert);">#<%= index + 1 %></span>
          <div class="pr-fill">
            <div class="tpc-number" style="font-weight:600;color:var(--pr-ink);margin-bottom:2px;"><%= tpc_info %></div>
            <div class="pr-hint">CAPEX Allocation</div>
          </div>
          <div style="font-size: var(--pr-text-lg);font-weight:700;color:var(--pr-warning-ink);font-variant-numeric:tabular-nums;">$<%= number_with_delimiter(amount.round(2)) %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Currency Distribution -->
<% if @report_data[:currency_breakdown].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Currency Distribution</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid">
      <div class="pr-chart-box"><canvas id="currencyChart"></canvas></div>
      <div style="display:grid;gap:8px;align-content:start;">
        <% @report_data[:currency_breakdown].each do |currency, amount| %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-radius:var(--pr-radius-sm);">
            <span class="currency-code"><%= currency %></span>
            <span style="font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;">$<%= number_with_delimiter(amount.round(2)) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>

<!-- Recent CAPEX Items -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Recent CAPEX Items</h3></div>
  <div class="dashboard-card-body">
    <div class="autoscroll">
      <table class="pr-table">
        <thead>
          <tr>
            <th scope="col">Year</th>
            <th scope="col">Description</th>
            <th scope="col">Project</th>
            <th scope="col">TPC Code</th>
            <th scope="col">Total Amount</th>
            <th scope="col">Currency</th>
            <th scope="col">PRs</th>
            <th scope="col">Q1</th>
            <th scope="col">Q2</th>
            <th scope="col">Q3</th>
            <th scope="col">Q4</th>
            <th scope="col">Created</th>
          </tr>
        </thead>
        <tbody>
          <% @report_data[:recent_items].each do |capex| %>
            <tr>
              <td><%= capex.year %></td>
              <td><%= truncate(capex.description, length: 35) %></td>
              <td><%= capex.project&.name %></td>
              <td class="tpc-code-cell"><%= capex.tpc_code %></td>
              <td class="stat-currency"><%= number_with_delimiter(capex.total_amount) %></td>
              <td><span class="currency-code"><%= capex.currency %></span></td>
              <td><%= capex.purchase_requests.count %></td>
              <td><%= number_with_delimiter(capex.q1_amount) %></td>
              <td><%= number_with_delimiter(capex.q2_amount) %></td>
              <td><%= number_with_delimiter(capex.q3_amount) %></td>
              <td><%= number_with_delimiter(capex.q4_amount) %></td>
              <td><%= capex.created_at.strftime('%Y-%m-%d') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= render 'purchase_requests_reports/chart_colors' %>

<% unless @print_mode %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Chart.js default configuration
  Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, sans-serif';

  // Utilization Chart (With/Without PRs)
  const utilizationCtx = document.getElementById('utilizationChart').getContext('2d');
  new Chart(utilizationCtx, {
    type: 'doughnut',
    data: {
      labels: <%= raw @report_data[:utilization_breakdown].keys.to_json %>,
      datasets: [{
        data: <%= raw @report_data[:utilization_breakdown].values.to_json %>,
        backgroundColor: [PR_CHART_COLORS[1], PR_CHART_NEUTRAL],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'CAPEX with Purchase Requests'
        }
      }
    }
  });

  // Utilization Status Chart
  const utilizationStatusCtx = document.getElementById('utilizationStatusChart').getContext('2d');
  new Chart(utilizationStatusCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:utilization_status_breakdown].keys.to_json %>,
      datasets: [{
        label: 'CAPEX Items',
        data: <%= raw @report_data[:utilization_status_breakdown].values.to_json %>,
        backgroundColor: PR_CHART_COLORS.slice(0, 5)
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Utilization Level'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Count'
          }
        }
      }
    }
  });

  <% if @report_data[:pr_status_breakdown].any? %>
  // PR Status Chart
  const prStatusCtx = document.getElementById('prStatusChart').getContext('2d');
  new Chart(prStatusCtx, {
    type: 'doughnut',
    data: {
      labels: <%= raw @report_data[:pr_status_breakdown].keys.to_json %>,
      datasets: [{
        data: <%= raw @report_data[:pr_status_breakdown].values.to_json %>,
        backgroundColor: <%= raw @report_data[:pr_status_breakdown].keys.to_json %>.map(function(_, i) { return PR_CHART_COLORS[i % PR_CHART_COLORS.length]; }),
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'right'
        },
        title: {
          display: true,
          text: 'CAPEX-Linked Purchase Requests by Status'
        }
      }
    }
  });
  <% end %>

  // Yearly Chart
  const yearlyCtx = document.getElementById('yearlyChart').getContext('2d');
  new Chart(yearlyCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:yearly_totals].keys.to_json %>,
      datasets: [{
        label: 'CAPEX Amount',
        data: <%= raw @report_data[:yearly_totals].values.to_json %>,
        backgroundColor: PR_CHART_COLORS[2] + 'b3',
        borderColor: PR_CHART_COLORS[2],
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'CAPEX by Year'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Amount'
          },
          ticks: {
            callback: function(value) {
              return '$' + value.toLocaleString();
            }
          }
        }
      }
    }
  });

  // Quarterly Chart
  const quarterlyCtx = document.getElementById('quarterlyChart').getContext('2d');
  new Chart(quarterlyCtx, {
    type: 'doughnut',
    data: {
      labels: ['Q1', 'Q2', 'Q3', 'Q4'],
      datasets: [{
        data: <%= raw @report_data[:quarterly_breakdown].values.to_json %>,
        backgroundColor: PR_CHART_COLORS.slice(0, 4),
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Quarterly Distribution'
        }
      }
    }
  });

  <% if @report_data[:currency_breakdown].any? %>
  // Currency Chart
  const currencyCtx = document.getElementById('currencyChart').getContext('2d');
  new Chart(currencyCtx, {
    type: 'pie',
    data: {
      labels: <%= raw @report_data[:currency_breakdown].keys.to_json %>,
      datasets: [{
        data: <%= raw @report_data[:currency_breakdown].values.to_json %>,
        backgroundColor: PR_CHART_COLORS,
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Currency Distribution'
        }
      }
    }
  });
  <% end %>
});
</script>
<% end %>

<% content_for :header_tags do %>
<style>
  .icon-pdf {
    background-image: url('<%= asset_path("files/pdf.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  .icon-csv-file {
    background-image: url('<%= asset_path("files/text.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  @media (max-width: 768px) {
    #content .pr-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<% end %>
