<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/reports/index.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title("Reports#{@project ? " - #{@project.name}" : ""}") %>

<div class="contextual">
  <% if @project %>
    <%= link_to project_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
      <span class="icon icon-cancel">Back to Project</span>
    <% end %>
  <% else %>
    <%= link_to home_path, class: 'pr-button pr-button-secondary pr-button-icon' do %>
      <span class="icon icon-cancel">Back to Home</span>
    <% end %>
  <% end %>
</div>

<h2>
  <%= @project ? "#{@project.name} - " : "" %>Purchase Request Reports
  <span class="pr-badge pr-badge--accent" style="font-size:13px;margin-left:10px;vertical-align:middle;"><%= @project ? "Project Scope" : "Global Scope" %></span>
</h2>

<%= render 'year_filter', filter_path: (@project ? project_reports_path(@project) : reports_path) %>

<div class="reports-dashboard">
  <div class="pr-alert pr-alert-info">
    <span class="icon icon-info"></span>
    <div class="pr-alert-content">
      <p>Generate comprehensive reports for purchase request management features. Reports can be viewed online, exported as PDF documents, downloaded as DOCX or CSV files for further analysis. The selected year above is preserved across exports.</p>
      <% if @project %>
        <p style="margin:0;"><strong>Project:</strong> <%= @project.name %> &nbsp;&nbsp; <strong>Identifier:</strong> <%= @project.identifier %></p>
      <% end %>
    </div>
  </div>

  <div class="reports-grid">
    <% @available_reports.each do |report| %>
      <div class="report-card dashboard-card">
        <div class="dashboard-card-header">
          <h3><span class="<%= report[:icon] %>" style="margin-right:8px;"></span><%= report[:name] %></h3>
        </div>
        <div class="dashboard-card-body">
          <p style="color:var(--pr-ink-muted);font-size:13px;margin:0 0 16px;"><%= report[:description] %></p>

          <div class="pr-form-actions left-aligned" style="margin-top:0;padding-top:0;border-top:none;">
            <%
              case report[:action]
              when 'purchase_requests'
                report_url = @project ? purchase_requests_project_reports_path(@project) : purchase_requests_reports_path
              when 'vendors'
                report_url = @project ? vendors_project_reports_path(@project) : vendors_reports_path
              when 'tpc_codes'
                report_url = @project ? tpc_codes_project_reports_path(@project) : tpc_codes_reports_path
              when 'capex'
                report_url = @project ? capex_project_reports_path(@project) : capex_reports_path
              when 'opex'
                report_url = @project ? opex_project_reports_path(@project) : opex_reports_path
              when 'overview'
                report_url = @project ? overview_project_reports_path(@project) : overview_reports_path
              else
                report_url = @project ? project_reports_path(@project) : reports_path
              end
            %>

            <% view_url = @selected_year.present? ? "#{report_url}?year=#{@selected_year}" : report_url %>

            <%= link_to view_url, class: 'pr-button pr-button-primary small' do %>
              <span class="icon icon-magnifier">View Report</span>
            <% end %>

            <%= link_to "#{report_url}?#{report_export_params(:pdf)}", class: 'pr-button pr-button-secondary small', target: '_blank', rel: 'noopener noreferrer' do %>
              <span class="icon icon-pdf">PDF</span>
            <% end %>

            <%= link_to "#{report_url}?#{report_export_params(:docx)}", class: 'pr-button pr-button-secondary small' do %>
              <span class="icon icon-document">DOCX</span>
            <% end %>

            <%= link_to "#{report_url}?#{report_export_params(:csv)}", class: 'pr-button pr-button-secondary small' do %>
              <span class="icon icon-csv-file">CSV</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="reports-help dashboard-card">
    <div class="dashboard-card-header">
      <h3>Report Information</h3>
    </div>
    <div class="dashboard-card-body">
      <ul style="margin:0 0 16px;padding-left:20px;font-size:13px;color:var(--pr-ink);">
        <li style="margin-bottom:6px;"><strong>View Report:</strong> Interactive HTML report with charts and detailed analysis</li>
        <li style="margin-bottom:6px;"><strong>PDF Export:</strong> Professional document suitable for printing and sharing</li>
        <li style="margin-bottom:6px;"><strong>CSV Export:</strong> Raw data for import into spreadsheet applications or custom analysis</li>
      </ul>

      <h4 style="margin:0 0 8px;color:var(--pr-ink);font-size:13px;font-weight:700;">Report Scope</h4>
      <% if @project %>
        <p style="margin:0;font-size:13px;color:var(--pr-ink-muted);">These reports are filtered to show data specific to the <strong><%= @project.name %></strong> project.
           Global vendors and TPC codes available to this project are included where relevant.</p>
      <% else %>
        <p style="margin:0;font-size:13px;color:var(--pr-ink-muted);">These reports show data from across all projects in the system.
           Use project-specific reports for focused analysis of individual projects.</p>
      <% end %>
    </div>
  </div>
</div>

<% content_for :header_tags do %>
<style>
  .reports-dashboard {
    max-width: 1200px;
  }

  .reports-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }

  .report-card {
    transition: box-shadow .2s ease, transform .2s ease;
  }

  .report-card:hover {
    box-shadow: var(--pr-shadow-md);
    transform: translateY(-2px);
  }

  .reports-help {
    margin-top: 4px;
  }

  .icon-pdf {
    background-image: url('<%= asset_path("files/pdf.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  .icon-csv-file {
    background-image: url('<%= asset_path("files/text.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  @media (max-width: 768px) {
    .reports-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<% end %>
