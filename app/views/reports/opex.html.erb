<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/reports/opex.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% end %>

<% html_title("OPEX Report#{@project ? " - #{@project.name}" : ""}") %>

<% unless @print_mode %>
<div class="contextual">
  <% reports_index_path = @project ? project_reports_path(@project) : reports_path %>
  <%= link_to reports_index_path, class: 'pr-button pr-button-cancel pr-button-icon' do %>
    <span class="icon icon-cancel">Back to Reports</span>
  <% end %>

  <% report_path_base = @project ?
       opex_project_reports_path(@project) :
       opex_reports_path %>

  <%= render 'export_actions', report_path_base: report_path_base %>
</div>
<% end %>

<h2>
  OPEX Report<%= report_year_suffix %>
  <% if @project %>
    <span class="pr-badge pr-badge--success" style="font-size:13px;vertical-align:middle;margin-left:10px;"><%= @project.name %></span>
  <% end %>
</h2>

<% unless @print_mode %>
<%= render 'year_filter', filter_path: report_path_base %>
<% end %>

<div class="info-box">
  <p><strong>Generated:</strong> <%= @report_data[:generated_at].strftime('%B %d, %Y at %I:%M %p') %></p>
  <p style="margin:0;">
    <% if @project %>
      <strong>Scope:</strong> OPEX items for <%= @project.name %>
    <% else %>
      <strong>Scope:</strong> All OPEX items across the system
    <% end %>
  </p>
</div>

<!-- Executive Summary -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>OPEX Overview</h3></div>
  <div class="dashboard-card-body">
    <div class="summary-stats">
      <div class="stat-box pr-stat--accent">
        <div class="stat-number"><%= @report_data[:summary][:total_items] %></div>
        <div class="stat-label">Total OPEX Items</div>
      </div>
      <div class="stat-box pr-stat--success">
        <div class="stat-number stat-currency">$<%= number_with_delimiter(@report_data[:summary][:total_value].round(0)) %></div>
        <div class="stat-label">Total OPEX Value</div>
      </div>
      <div class="stat-box pr-stat--warning">
        <div class="stat-number stat-currency">$<%= number_with_delimiter(@report_data[:summary][:current_year_value].round(0)) %></div>
        <div class="stat-label"><%= Date.current.year %> OPEX</div>
      </div>
      <div class="stat-box pr-stat--violet">
        <div class="stat-number"><%= @report_data[:category_breakdown].count %></div>
        <div class="stat-label">Categories Used</div>
      </div>
    </div>
  </div>
</div>

<!-- Category Analysis -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>OPEX by Category</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid">
      <div style="height:360px;"><canvas id="categoryChart"></canvas></div>
      <div style="display:grid;gap:8px;align-content:start;">
        <% @report_data[:category_breakdown].each_with_index do |(category, amount), index| %>
          <div class="pr-rank-row">
            <span class="pr-rank-badge" style="background:var(--pr-success);color:var(--pr-ink-invert);width:26px;height:26px;font-size:11px;">#<%= index + 1 %></span>
            <div style="flex:1;min-width:0;">
              <div style="font-weight:600;color:var(--pr-ink);font-size:13px;margin-bottom:2px;"><%= category %></div>
              <div style="font-size:12px;color:var(--pr-ink-faint);">OPEX Category</div>
            </div>
            <div style="font-size:16px;font-weight:700;color:var(--pr-success-ink);font-variant-numeric:tabular-nums;">$<%= number_with_delimiter(amount.round(2)) %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Yearly Trend -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>OPEX by Year</h3></div>
  <div class="dashboard-card-body">
    <div style="height:280px;max-width:700px;margin:0 auto 18px;"><canvas id="yearlyChart"></canvas></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;">
      <% @report_data[:yearly_totals].each do |year, total| %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-left:3px solid var(--pr-success);border-radius:var(--pr-radius-sm);">
          <span style="font-weight:600;color:var(--pr-ink);font-size:13px;"><%= year %></span>
          <span style="color:var(--pr-success-ink);font-weight:700;font-size:13px;font-variant-numeric:tabular-nums;">$<%= number_with_delimiter(total.round(2)) %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Quarterly Analysis -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3><%= Date.current.year %> Quarterly Breakdown</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid">
      <div style="height:280px;"><canvas id="quarterlyChart"></canvas></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;align-content:start;">
        <% [:q1, :q2, :q3, :q4].each_with_index do |quarter, index| %>
          <%
            total_quarterly = @report_data[:quarterly_breakdown].values.sum
            qpct = total_quarterly > 0 ? ((@report_data[:quarterly_breakdown][quarter] / total_quarterly) * 100).round(1) : 0
          %>
          <div style="text-align:center;padding:18px 14px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-top:3px solid var(--pr-success);border-radius:var(--pr-radius);">
            <div style="font-size:13px;font-weight:600;color:var(--pr-ink-muted);margin-bottom:6px;">Q<%= index + 1 %> <%= Date.current.year %></div>
            <div style="font-size:19px;font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;margin-bottom:4px;">$<%= number_with_delimiter(@report_data[:quarterly_breakdown][quarter].round(2)) %></div>
            <div style="font-size:12px;color:var(--pr-success-ink);font-weight:500;"><%= qpct %>%</div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- TPC Distribution -->
<% if @report_data[:tpc_distribution].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Top TPC Code Allocations</h3></div>
  <div class="dashboard-card-body">
    <div style="display:grid;gap:10px;">
      <% @report_data[:tpc_distribution].each_with_index do |(tpc_info, amount), index| %>
        <div class="pr-rank-row">
          <span class="pr-rank-badge" style="background:var(--pr-success);color:var(--pr-ink-invert);">#<%= index + 1 %></span>
          <div style="flex:1;min-width:0;">
            <div class="tpc-number" style="font-weight:600;color:var(--pr-ink);margin-bottom:2px;"><%= tpc_info %></div>
            <div style="font-size:12px;color:var(--pr-ink-faint);">OPEX Allocation</div>
          </div>
          <div style="font-size:17px;font-weight:700;color:var(--pr-success-ink);font-variant-numeric:tabular-nums;">$<%= number_with_delimiter(amount.round(2)) %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Currency Distribution -->
<% if @report_data[:currency_breakdown].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Currency Distribution</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid">
      <div style="height:280px;"><canvas id="currencyChart"></canvas></div>
      <div style="display:grid;gap:8px;align-content:start;">
        <% @report_data[:currency_breakdown].each do |currency, amount| %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-radius:var(--pr-radius-sm);">
            <span class="currency-code"><%= currency %></span>
            <span style="font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;">$<%= number_with_delimiter(amount.round(2)) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>

<!-- Recent OPEX Items -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Recent OPEX Items</h3></div>
  <div class="dashboard-card-body">
    <div class="autoscroll">
      <table class="pr-table">
        <thead>
          <tr>
            <th>Year</th>
            <th>Description</th>
            <th>Project</th>
            <th>Category</th>
            <th>TPC Code</th>
            <th>Total Amount</th>
            <th>Currency</th>
            <th>Q1</th>
            <th>Q2</th>
            <th>Q3</th>
            <th>Q4</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          <% @report_data[:recent_items].each do |opex| %>
            <tr>
              <td><%= opex.year %></td>
              <td><%= truncate(opex.description, length: 40) %></td>
              <td><%= opex.project&.name %></td>
              <td><%= opex.opex_category&.name %></td>
              <td class="tpc-code-cell"><%= opex.tpc_code&.tpc_number %></td>
              <td class="stat-currency"><%= number_with_delimiter(opex.total_amount) %></td>
              <td><span class="currency-code"><%= opex.currency %></span></td>
              <td><%= number_with_delimiter(opex.q1_amount) %></td>
              <td><%= number_with_delimiter(opex.q2_amount) %></td>
              <td><%= number_with_delimiter(opex.q3_amount) %></td>
              <td><%= number_with_delimiter(opex.q4_amount) %></td>
              <td><%= opex.created_at.strftime('%Y-%m-%d') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= render 'reports/chart_colors' %>

<% unless @print_mode %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Chart.js default configuration
  Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, sans-serif';

  // Category Chart (horizontal bar using indexAxis)
  const categoryCtx = document.getElementById('categoryChart').getContext('2d');
  new Chart(categoryCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:category_breakdown].keys.to_json %>,
      datasets: [{
        label: 'OPEX Amount',
        data: <%= raw @report_data[:category_breakdown].values.to_json %>,
        backgroundColor: PR_CHART_COLORS[1] + 'b3',
        borderColor: PR_CHART_COLORS[1],
        borderWidth: 1
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'OPEX by Category'
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Amount'
          },
          ticks: {
            callback: function(value) {
              return '$' + value.toLocaleString();
            }
          }
        }
      }
    }
  });

  // Yearly Chart
  const yearlyCtx = document.getElementById('yearlyChart').getContext('2d');
  new Chart(yearlyCtx, {
    type: 'line',
    data: {
      labels: <%= raw @report_data[:yearly_totals].keys.to_json %>,
      datasets: [{
        label: 'OPEX Amount',
        data: <%= raw @report_data[:yearly_totals].values.to_json %>,
        borderColor: PR_CHART_COLORS[1],
        backgroundColor: PR_CHART_COLORS[1] + '1a',
        tension: 0.4,
        fill: true,
        pointRadius: 5,
        pointHoverRadius: 8
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'OPEX Trend by Year'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Amount'
          },
          ticks: {
            callback: function(value) {
              return '$' + value.toLocaleString();
            }
          }
        }
      }
    }
  });

  // Quarterly Chart
  const quarterlyCtx = document.getElementById('quarterlyChart').getContext('2d');
  new Chart(quarterlyCtx, {
    type: 'doughnut',
    data: {
      labels: ['Q1', 'Q2', 'Q3', 'Q4'],
      datasets: [{
        data: <%= raw @report_data[:quarterly_breakdown].values.to_json %>,
        backgroundColor: PR_CHART_COLORS.slice(0, 4),
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Quarterly Distribution'
        }
      }
    }
  });

  <% if @report_data[:currency_breakdown].any? %>
  // Currency Chart
  const currencyCtx = document.getElementById('currencyChart').getContext('2d');
  new Chart(currencyCtx, {
    type: 'pie',
    data: {
      labels: <%= raw @report_data[:currency_breakdown].keys.to_json %>,
      datasets: [{
        data: <%= raw @report_data[:currency_breakdown].values.to_json %>,
        backgroundColor: PR_CHART_COLORS,
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Currency Distribution'
        }
      }
    }
  });
  <% end %>
});
</script>
<% end %>

<% content_for :header_tags do %>
<style>
  .icon-pdf {
    background-image: url('<%= asset_path("files/pdf.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  .icon-csv-file {
    background-image: url('<%= asset_path("files/text.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  @media (max-width: 768px) {
    #content .pr-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<% end %>
