<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/reports/overview.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% end %>

<% html_title("Executive Overview Report#{@project ? " - #{@project.name}" : ""}") %>

<% unless @print_mode %>
<div class="contextual">
  <% reports_index_path = @project ? project_reports_path(@project) : reports_path %>
  <%= link_to reports_index_path, class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-cancel">Back to Reports</span>
  <% end %>

  <% report_path_base = @project ?
       overview_project_reports_path(@project) :
       overview_reports_path %>

  <%= render 'export_actions', report_path_base: report_path_base %>
</div>
<% end %>

<h2>
  Executive Overview Report<%= report_year_suffix %>
  <% if @project %>
    <span class="pr-badge pr-badge--accent" style="font-size:13px;margin-left:10px;vertical-align:middle;"><%= @project.name %></span>
  <% end %>
</h2>

<% unless @print_mode %>
<%= render 'year_filter', filter_path: report_path_base %>
<% end %>

<div class="info-box" style="margin-bottom:24px;">
  <p style="margin:0 0 4px;"><strong>Generated:</strong> <%= @report_data[:generated_at].strftime('%B %d, %Y at %I:%M %p') %></p>
  <% if @project %>
    <p style="margin:0;"><strong>Scope:</strong> Comprehensive analysis for <%= @project.name %></p>
  <% else %>
    <p style="margin:0;"><strong>Scope:</strong> System-wide analysis across all projects</p>
  <% end %>
</div>

<!-- Executive Dashboard -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Executive Dashboard</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="executive-kpi-grid">
      <!-- Purchase Requests KPI -->
      <div class="executive-kpi-card pr-stat--accent">
        <div class="executive-kpi-icon">
          <span class="icon icon-package"></span>
        </div>
        <div class="executive-kpi-content">
          <div class="executive-kpi-title">Purchase Requests</div>
          <div class="executive-kpi-value"><%= @report_data[:executive_summary][:purchase_requests][:total] %></div>
          <div class="executive-kpi-subtitle">Total Requests</div>
          <div class="executive-kpi-details">
            <span><strong><%= @report_data[:executive_summary][:purchase_requests][:open] %></strong> Open</span>
            <span><strong>$<%= number_with_delimiter(@report_data[:executive_summary][:purchase_requests][:total_value].round(0)) %></strong> Est. Value</span>
          </div>
        </div>
      </div>

      <!-- Vendors KPI -->
      <div class="executive-kpi-card pr-stat--success">
        <div class="executive-kpi-icon">
          <span class="icon icon-group"></span>
        </div>
        <div class="executive-kpi-content">
          <div class="executive-kpi-title">Vendor Management</div>
          <div class="executive-kpi-value"><%= @report_data[:executive_summary][:vendors][:total] %></div>
          <div class="executive-kpi-subtitle">Total Vendors</div>
          <div class="executive-kpi-details">
            <span><strong><%= @report_data[:executive_summary][:vendors][:active] %></strong> Active</span>
            <span><strong><%= @report_data[:executive_summary][:vendors][:with_requests] %></strong> Engaged</span>
          </div>
        </div>
      </div>

      <!-- Budget Overview -->
      <div class="executive-kpi-card pr-stat--warning">
        <div class="executive-kpi-icon">
          <span class="icon icon-money"></span>
        </div>
        <div class="executive-kpi-content">
          <div class="executive-kpi-title">Budget Overview</div>
          <div class="executive-kpi-value">$<%= number_with_delimiter(@report_data[:total_budget].round(0)) %></div>
          <div class="executive-kpi-subtitle">Total Budget</div>
          <div class="executive-kpi-details">
            <span><strong>$<%= number_with_delimiter(@report_data[:executive_summary][:capex][:total_value].round(0)) %></strong> CAPEX</span>
            <span><strong>$<%= number_with_delimiter(@report_data[:executive_summary][:opex][:total_value].round(0)) %></strong> OPEX</span>
          </div>
        </div>
      </div>

      <!-- TPC Governance -->
      <div class="executive-kpi-card pr-stat--violet">
        <div class="executive-kpi-icon">
          <span class="icon icon-list"></span>
        </div>
        <div class="executive-kpi-content">
          <div class="executive-kpi-title">TPC Governance</div>
          <div class="executive-kpi-value"><%= @report_data[:executive_summary][:tpc_codes][:total] %></div>
          <div class="executive-kpi-subtitle">TPC Codes</div>
          <div class="executive-kpi-details">
            <span><strong><%= @report_data[:executive_summary][:tpc_codes][:active] %></strong> Active</span>
            <span><strong><%= (@report_data[:executive_summary][:capex][:total_items] + @report_data[:executive_summary][:opex][:total_items]) %></strong> Allocations</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- High-Level Performance Indicators -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Key Performance Indicators</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="kpi-indicators-grid">
      <div class="indicator-card completion">
        <div class="indicator-icon">✓</div>
        <div class="indicator-content">
          <div class="indicator-value"><%= @report_data[:high_level_indicators][:completion_rate] %>%</div>
          <div class="indicator-label">Completion Rate</div>
          <div class="indicator-detail"><%= @report_data[:executive_summary][:purchase_requests][:closed] %> of <%= @report_data[:executive_summary][:purchase_requests][:total] %> closed</div>
        </div>
      </div>

      <div class="indicator-card processing">
        <div class="indicator-icon">⏱</div>
        <div class="indicator-content">
          <div class="indicator-value"><%= @report_data[:high_level_indicators][:avg_processing_days] %></div>
          <div class="indicator-label">Avg. Days to Close</div>
          <div class="indicator-detail">Processing time</div>
        </div>
      </div>

      <div class="indicator-card monthly">
        <div class="indicator-icon">📈</div>
        <div class="indicator-content">
          <div class="indicator-value"><%= @report_data[:high_level_indicators][:this_month_prs] %></div>
          <div class="indicator-label">This Month's PRs</div>
          <div class="indicator-detail <%= @report_data[:high_level_indicators][:mom_growth] >= 0 ? 'positive' : 'negative' %>">
            <%= @report_data[:high_level_indicators][:mom_growth] >= 0 ? '+' : '' %><%= @report_data[:high_level_indicators][:mom_growth] %>% vs last month
          </div>
        </div>
      </div>

      <div class="indicator-card utilization">
        <div class="indicator-icon">💹</div>
        <div class="indicator-content">
          <div class="indicator-value"><%= @report_data[:high_level_indicators][:budget_utilization] %>%</div>
          <div class="indicator-label">Budget Utilization</div>
          <div class="indicator-detail">PR value vs total budget</div>
        </div>
      </div>

      <div class="indicator-card priority">
        <div class="indicator-icon">🔥</div>
        <div class="indicator-content">
          <div class="indicator-value"><%= @report_data[:high_level_indicators][:high_priority_count] %></div>
          <div class="indicator-label">High Priority PRs</div>
          <div class="indicator-detail"><%= @report_data[:high_level_indicators][:high_priority_pct] %>% of total</div>
        </div>
      </div>

      <div class="indicator-card engagement">
        <div class="indicator-icon">🤝</div>
        <div class="indicator-content">
          <div class="indicator-value"><%= @report_data[:high_level_indicators][:vendor_engagement] %>%</div>
          <div class="indicator-label">Vendor Engagement</div>
          <div class="indicator-detail">Active vendors with PRs</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Budget Distribution Analysis -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Budget Distribution by Source</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="budget-source-analysis">
      <div class="budget-chart-container">
        <canvas id="budgetSourceChart" height="280"></canvas>
      </div>

      <div class="budget-source-breakdown">
        <% total_budget_value = @report_data[:budget_distribution].values.sum %>
        <% @report_data[:budget_distribution].each do |source, value| %>
          <div class="budget-source-item <%= source.parameterize %>">
            <div class="source-header">
              <span class="source-name"><%= source %></span>
              <span class="source-percentage"><%= total_budget_value > 0 ? "#{((value / total_budget_value) * 100).round(1)}%" : "0%" %></span>
            </div>
            <div class="source-value">$<%= number_with_delimiter(value.round(0)) %></div>
            <div class="progress-bar" style="margin-top:8px;">
              <div class="progress-fill" style="width: <%= total_budget_value > 0 ? [(value / total_budget_value) * 100, 100].min : 0 %>%; background:var(--pr-accent);"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- CAPEX vs OPEX Comparison -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>CAPEX vs OPEX Overview</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="budget-analysis">
      <div class="budget-chart">
        <canvas id="budgetChart" width="300" height="300"></canvas>
      </div>

      <div class="budget-breakdown">
        <div class="budget-item capex">
          <div class="budget-icon">💰</div>
          <div class="budget-details">
            <div class="budget-title">Capital Expenditure (CAPEX)</div>
            <div class="budget-amount">$<%= number_with_delimiter(@report_data[:executive_summary][:capex][:total_value].round(2)) %></div>
            <div class="budget-items"><%= @report_data[:executive_summary][:capex][:total_items] %> items</div>
            <div class="budget-percentage">
              <%= @report_data[:total_budget] > 0 ?
                    "#{((@report_data[:executive_summary][:capex][:total_value] / @report_data[:total_budget]) * 100).round(1)}%" :
                    "0%" %> of total budget
            </div>
          </div>
        </div>

        <div class="budget-item opex">
          <div class="budget-icon">📊</div>
          <div class="budget-details">
            <div class="budget-title">Operational Expenditure (OPEX)</div>
            <div class="budget-amount">$<%= number_with_delimiter(@report_data[:executive_summary][:opex][:total_value].round(2)) %></div>
            <div class="budget-items"><%= @report_data[:executive_summary][:opex][:total_items] %> items</div>
            <div class="budget-percentage">
              <%= @report_data[:total_budget] > 0 ?
                    "#{((@report_data[:executive_summary][:opex][:total_value] / @report_data[:total_budget]) * 100).round(1)}%" :
                    "0%" %> of total budget
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Currency Usage Analysis -->
<% if @report_data[:currency_usage][:by_count].any? %>
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Currency Usage Analysis</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="currency-analysis-grid">
      <div class="currency-chart-container">
        <canvas id="currencyChart" height="280"></canvas>
      </div>

      <div class="currency-breakdown">
        <h4 style="margin:0 0 14px;color:var(--pr-ink);font-size:14px;font-weight:700;padding-bottom:8px;border-bottom:1px solid var(--pr-border);">Currency Distribution</h4>
        <% @report_data[:currency_usage][:by_value].sort_by { |_, v| -v }.each do |currency, value| %>
          <div class="currency-item">
            <div class="currency-header">
              <span class="currency-code"><%= currency %></span>
              <span class="currency-count"><%= @report_data[:currency_usage][:by_count][currency] || 0 %> PRs</span>
            </div>
            <div class="currency-value">$<%= number_with_delimiter(value.round(0)) %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>

<!-- Vendor Country Distribution -->
<% if @report_data[:vendor_countries][:distribution].any? || @report_data[:vendor_countries][:without_country] > 0 %>
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Vendor Geographic Distribution</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="summary-stats" style="margin-bottom:20px;">
      <div class="stat-box pr-stat--accent">
        <div class="stat-number"><%= @report_data[:vendor_countries][:total_countries] %></div>
        <div class="stat-label">Countries</div>
      </div>
      <div class="stat-box pr-stat--success">
        <div class="stat-number"><%= @report_data[:vendor_countries][:distribution].values.sum %></div>
        <div class="stat-label">Vendors with Country</div>
      </div>
      <div class="stat-box pr-stat--warning">
        <div class="stat-number"><%= @report_data[:vendor_countries][:without_country] %></div>
        <div class="stat-label">Unspecified</div>
      </div>
    </div>

    <% if @report_data[:vendor_countries][:distribution].any? %>
    <div class="geo-distribution-grid">
      <div class="geo-chart-container">
        <canvas id="countryChart" height="280"></canvas>
      </div>

      <div class="geo-country-list">
        <h4 style="margin:0 0 12px;color:var(--pr-ink);font-size:14px;font-weight:700;padding-bottom:8px;border-bottom:1px solid var(--pr-border);">Top Countries</h4>
        <% @report_data[:vendor_countries][:distribution].first(10).each_with_index do |(country, count), index| %>
          <div class="geo-country-item">
            <span class="geo-country-rank">#<%= index + 1 %></span>
            <span class="geo-country-name"><%= country %></span>
            <span class="geo-country-count"><%= count %> vendors</span>
          </div>
        <% end %>
      </div>
    </div>
    <% end %>
  </div>
</div>
<% end %>

<!-- Quick Links to Detailed Reports -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Detailed Reports</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="detailed-reports-grid">
      <% [
        { name: 'Purchase Requests', action: 'purchase_requests', icon: 'icon-package', color: 'accent' },
        { name: 'Vendors', action: 'vendors', icon: 'icon-group', color: 'success' },
        { name: 'TPC Codes', action: 'tpc_codes', icon: 'icon-list', color: 'violet' },
        { name: 'CAPEX', action: 'capex', icon: 'icon-money', color: 'warning' },
        { name: 'OPEX', action: 'opex', icon: 'icon-stats', color: 'danger' }
      ].each do |report| %>
        <div class="detailed-report-card detailed-report-card--<%= report[:color] %>">
          <span class="<%= report[:icon] %>" style="font-size:28px;display:block;margin-bottom:12px;"></span>
          <h4><%= report[:name] %></h4>
          <%
            case report[:action]
            when 'purchase_requests'
              detail_path = @project ? purchase_requests_project_reports_path(@project) : purchase_requests_reports_path
            when 'vendors'
              detail_path = @project ? vendors_project_reports_path(@project) : vendors_reports_path
            when 'tpc_codes'
              detail_path = @project ? tpc_codes_project_reports_path(@project) : tpc_codes_reports_path
            when 'capex'
              detail_path = @project ? capex_project_reports_path(@project) : capex_reports_path
            when 'opex'
              detail_path = @project ? opex_project_reports_path(@project) : opex_reports_path
            else
              detail_path = @project ? project_reports_path(@project) : reports_path
            end
          %>
          <%= link_to "View Details", detail_path, class: 'pr-button pr-button-secondary small' %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Summary Statistics -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Summary Statistics</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="stats-grid">
      <div class="stat-group">
        <h4>Purchase Request Activity</h4>
        <div class="stat-item">
          <span class="stat-item-label">Completion Rate:</span>
          <span class="stat-item-value">
            <%= @report_data[:purchase_requests][:summary][:total_count] > 0 ?
                  "#{((@report_data[:purchase_requests][:summary][:closed_count].to_f / @report_data[:purchase_requests][:summary][:total_count]) * 100).round(1)}%" :
                  "0%" %>
          </span>
        </div>
        <div class="stat-item">
          <span class="stat-item-label">Avg. Estimated Value:</span>
          <span class="stat-item-value">$<%= number_with_delimiter(@report_data[:purchase_requests][:summary][:avg_estimated_value].round(2)) %></span>
        </div>
      </div>

      <div class="stat-group">
        <h4>Vendor Engagement</h4>
        <div class="stat-item">
          <span class="stat-item-label">Engagement Rate:</span>
          <span class="stat-item-value">
            <%= @report_data[:vendors][:summary][:total_count] > 0 ?
                  "#{((@report_data[:vendors][:summary][:vendors_with_requests].to_f / @report_data[:vendors][:summary][:total_count]) * 100).round(1)}%" :
                  "0%" %>
          </span>
        </div>
        <div class="stat-item">
          <span class="stat-item-label">Active Vendors:</span>
          <span class="stat-item-value">
            <%= @report_data[:vendors][:summary][:total_count] > 0 ?
                  "#{((@report_data[:vendors][:summary][:active_count].to_f / @report_data[:vendors][:summary][:total_count]) * 100).round(1)}%" :
                  "0%" %>
          </span>
        </div>
      </div>

      <div class="stat-group">
        <h4>Budget Efficiency</h4>
        <div class="stat-item">
          <span class="stat-item-label">CAPEX vs OPEX Ratio:</span>
          <span class="stat-item-value">
            <%= @report_data[:executive_summary][:opex][:total_value] > 0 ?
                  "#{(@report_data[:executive_summary][:capex][:total_value] / @report_data[:executive_summary][:opex][:total_value]).round(2)}:1" :
                  "∞:1" %>
          </span>
        </div>
        <div class="stat-item">
          <span class="stat-item-label">TPC Utilization:</span>
          <span class="stat-item-value">
            <%= @report_data[:tpc_codes][:summary][:total_count] > 0 ?
                  "#{((@report_data[:tpc_codes][:summary][:active_count].to_f / @report_data[:tpc_codes][:summary][:total_count]) * 100).round(1)}%" :
                  "0%" %>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render 'reports/chart_colors' %>

<% unless @print_mode %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Budget Distribution Chart (CAPEX vs OPEX)
  const budgetCtx = document.getElementById('budgetChart').getContext('2d');
  const capexValue = <%= @report_data[:executive_summary][:capex][:total_value] %>;
  const opexValue = <%= @report_data[:executive_summary][:opex][:total_value] %>;

  new Chart(budgetCtx, {
    type: 'doughnut',
    data: {
      labels: ['CAPEX', 'OPEX'],
      datasets: [{
        data: [capexValue, opexValue],
        backgroundColor: [PR_CHART_COLORS[2], PR_CHART_COLORS[1]],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            padding: 20,
            usePointStyle: true
          }
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              const label = context.label || '';
              const value = context.parsed;
              const total = capexValue + opexValue;
              const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
              return `${label}: $${value.toLocaleString()} (${percentage}%)`;
            }
          }
        }
      }
    }
  });

  // Budget Source Distribution Chart (including Non-budgeted)
  const budgetSourceCtx = document.getElementById('budgetSourceChart').getContext('2d');
  new Chart(budgetSourceCtx, {
    type: 'doughnut',
    data: {
      labels: <%= raw @report_data[:budget_distribution].keys.to_json %>,
      datasets: [{
        data: <%= raw @report_data[:budget_distribution].values.to_json %>,
        backgroundColor: [PR_CHART_COLORS[0], PR_CHART_COLORS[1], PR_CHART_COLORS[2], PR_CHART_NEUTRAL],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'right',
          labels: {
            padding: 15,
            usePointStyle: true
          }
        },
        title: {
          display: true,
          text: 'PR Value by Budget Source'
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              const label = context.label || '';
              const value = context.parsed;
              const total = <%= @report_data[:budget_distribution].values.sum %>;
              const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
              return `${label}: $${value.toLocaleString()} (${percentage}%)`;
            }
          }
        }
      }
    }
  });

  <% if @report_data[:currency_usage][:by_value].any? %>
  // Currency Usage Chart
  const currencyCtx = document.getElementById('currencyChart').getContext('2d');
  new Chart(currencyCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:currency_usage][:by_value].keys.to_json %>,
      datasets: [{
        label: 'Total Value',
        data: <%= raw @report_data[:currency_usage][:by_value].values.to_json %>,
        backgroundColor: <%= raw @report_data[:currency_usage][:by_value].keys.to_json %>.map(function(_, i) { return PR_CHART_COLORS[i % PR_CHART_COLORS.length]; }),
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Purchase Requests Value by Currency'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Value'
          },
          ticks: {
            callback: function(value) {
              return '$' + value.toLocaleString();
            }
          }
        }
      }
    }
  });
  <% end %>

  <% if @report_data[:vendor_countries][:distribution].any? %>
  // Country Distribution Chart
  const countryCtx = document.getElementById('countryChart').getContext('2d');
  new Chart(countryCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:vendor_countries][:distribution].keys.first(8).to_json %>,
      datasets: [{
        label: 'Vendors',
        data: <%= raw @report_data[:vendor_countries][:distribution].values.first(8).to_json %>,
        backgroundColor: '#3a5bbf',
        borderWidth: 0
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Top Vendor Countries'
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Number of Vendors'
          }
        }
      }
    }
  });
  <% end %>
});
</script>
<% end %>

<% content_for :header_tags do %>
<style>
  /* ---- icon helpers ---- */
  .icon-pdf {
    background-image: url('<%= asset_path("files/pdf.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }
  .icon-csv-file {
    background-image: url('<%= asset_path("files/text.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  /* ---- section spacing ---- */
  .report-section {
    margin-bottom: 22px;
  }

  /* ---- Executive KPI grid ---- */
  .executive-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .executive-kpi-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px;
    background: var(--pr-surface);
    border: 1px solid var(--pr-border);
    border-left: 3px solid var(--pr-border-strong);
    border-radius: var(--pr-radius);
    box-shadow: var(--pr-shadow-xs);
    transition: box-shadow .2s ease;
  }
  .executive-kpi-card:hover { box-shadow: var(--pr-shadow-sm); }
  .executive-kpi-card.pr-stat--accent  { border-left-color: var(--pr-accent); }
  .executive-kpi-card.pr-stat--success { border-left-color: var(--pr-success); }
  .executive-kpi-card.pr-stat--warning { border-left-color: var(--pr-warning); }
  .executive-kpi-card.pr-stat--violet  { border-left-color: var(--pr-violet); }

  .executive-kpi-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--pr-radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--pr-surface-subtle);
    border: 1px solid var(--pr-border);
    color: var(--pr-ink-muted);
  }

  .executive-kpi-content { flex: 1; min-width: 0; }

  .executive-kpi-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--pr-ink-muted);
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-bottom: 4px;
  }

  .executive-kpi-value {
    font-size: 26px;
    font-weight: 700;
    color: var(--pr-ink);
    line-height: 1.1;
    margin-bottom: 2px;
    font-variant-numeric: tabular-nums;
  }

  .executive-kpi-subtitle {
    font-size: 11px;
    color: var(--pr-ink-faint);
    margin-bottom: 10px;
  }

  .executive-kpi-details {
    display: flex;
    gap: 14px;
    font-size: 12px;
    color: var(--pr-ink-muted);
  }
  .executive-kpi-details span strong { color: var(--pr-ink); }

  /* ---- KPI indicators ---- */
  .kpi-indicators-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
    gap: 16px;
  }

  .indicator-card {
    background: var(--pr-surface);
    border-radius: var(--pr-radius);
    padding: 18px;
    text-align: center;
    border: 1px solid var(--pr-border);
    border-top: 3px solid var(--pr-border-strong);
    box-shadow: var(--pr-shadow-xs);
    transition: box-shadow .2s ease, transform .2s ease;
  }
  .indicator-card:hover { transform: translateY(-2px); box-shadow: var(--pr-shadow-sm); }

  .indicator-card.completion  { border-top-color: var(--pr-success); }
  .indicator-card.processing  { border-top-color: var(--pr-accent); }
  .indicator-card.monthly     { border-top-color: var(--pr-warning); }
  .indicator-card.utilization { border-top-color: var(--pr-violet); }
  .indicator-card.priority    { border-top-color: var(--pr-danger); }
  .indicator-card.engagement  { border-top-color: var(--pr-info); }

  .indicator-icon { font-size: 26px; margin-bottom: 8px; }

  .indicator-value {
    font-size: 26px;
    font-weight: 700;
    color: var(--pr-ink);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .indicator-label {
    font-size: 12px;
    color: var(--pr-ink-muted);
    margin: 6px 0 4px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .indicator-detail { font-size: 11px; color: var(--pr-ink-faint); }
  .indicator-detail.positive { color: var(--pr-success-ink); }
  .indicator-detail.negative { color: var(--pr-danger-ink); }

  /* ---- Budget source analysis ---- */
  .budget-source-analysis {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 32px;
    align-items: start;
  }

  .budget-chart-container { height: 280px; }

  .budget-source-breakdown { display: grid; gap: 12px; }

  .budget-source-item {
    background: var(--pr-surface-subtle);
    border-radius: var(--pr-radius-sm);
    padding: 14px;
    border: 1px solid var(--pr-border);
    border-left: 3px solid var(--pr-border-strong);
  }
  .budget-source-item.capex       { border-left-color: var(--pr-warning); }
  .budget-source-item.opex        { border-left-color: var(--pr-success); }
  .budget-source-item.direct-tpc  { border-left-color: var(--pr-accent); }
  .budget-source-item.non-budgeted{ border-left-color: var(--pr-ink-faint); }

  .source-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .source-name { font-weight: 600; color: var(--pr-ink); font-size: 13px; }
  .source-percentage { font-size: 13px; font-weight: 700; color: var(--pr-ink-muted); font-variant-numeric: tabular-nums; }
  .source-value { font-size: 18px; font-weight: 700; color: var(--pr-ink); margin-bottom: 8px; font-variant-numeric: tabular-nums; }

  /* ---- CAPEX/OPEX comparison ---- */
  .budget-analysis {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
    align-items: center;
  }

  .budget-chart { height: 280px; }

  .budget-breakdown { display: grid; gap: 16px; }

  .budget-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    border-radius: var(--pr-radius);
    background: var(--pr-surface-subtle);
    border: 1px solid var(--pr-border);
    border-left: 3px solid var(--pr-border-strong);
  }
  .budget-item.capex { border-left-color: var(--pr-warning); }
  .budget-item.opex  { border-left-color: var(--pr-success); }

  .budget-icon { font-size: 28px; flex-shrink: 0; }

  .budget-title { font-size: 14px; font-weight: 700; color: var(--pr-ink); margin-bottom: 4px; }
  .budget-amount { font-size: 22px; font-weight: 700; color: var(--pr-ink); margin-bottom: 2px; font-variant-numeric: tabular-nums; }
  .budget-items { font-size: 13px; color: var(--pr-ink-muted); margin-bottom: 2px; }
  .budget-percentage { font-size: 12px; color: var(--pr-accent); font-weight: 600; }

  /* ---- Currency analysis ---- */
  .currency-analysis-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  .currency-chart-container { height: 280px; }

  .currency-item {
    padding: 10px 12px;
    background: var(--pr-surface-subtle);
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius-sm);
    margin-bottom: 8px;
  }

  .currency-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
  }

  .currency-count { font-size: 12px; color: var(--pr-ink-muted); }
  .currency-value { font-size: 17px; font-weight: 700; color: var(--pr-accent-ink); font-variant-numeric: tabular-nums; }

  /* ---- Geo distribution ---- */
  .geo-distribution-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .geo-chart-container {
    background: var(--pr-surface-subtle);
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius-sm);
    padding: 16px;
    height: 300px;
  }

  .geo-country-list {
    background: var(--pr-surface-subtle);
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius-sm);
    padding: 16px;
  }

  .geo-country-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 1px solid var(--pr-border);
    font-size: 13px;
  }
  .geo-country-item:last-child { border-bottom: none; }

  .geo-country-rank {
    font-weight: 700;
    color: var(--pr-accent);
    min-width: 28px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .geo-country-name { flex: 1; font-weight: 500; color: var(--pr-ink); }

  .geo-country-count {
    font-size: 12px;
    color: var(--pr-ink-muted);
    background: var(--pr-surface-sunken);
    padding: 2px 8px;
    border-radius: var(--pr-radius-pill);
  }

  /* ---- Detailed reports grid ---- */
  .detailed-reports-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
  }

  .detailed-report-card {
    text-align: center;
    padding: 22px 16px;
    border-radius: var(--pr-radius);
    background: var(--pr-surface);
    border: 1px solid var(--pr-border);
    border-top: 3px solid var(--pr-border-strong);
    transition: box-shadow .2s ease, transform .2s ease;
  }
  .detailed-report-card:hover { transform: translateY(-2px); box-shadow: var(--pr-shadow-sm); }

  .detailed-report-card h4 { margin: 0 0 14px; font-size: 14px; color: var(--pr-ink); }

  .detailed-report-card--accent  { border-top-color: var(--pr-accent); }
  .detailed-report-card--success { border-top-color: var(--pr-success); }
  .detailed-report-card--violet  { border-top-color: var(--pr-violet); }
  .detailed-report-card--warning { border-top-color: var(--pr-warning); }
  .detailed-report-card--danger  { border-top-color: var(--pr-danger); }

  /* ---- Summary statistics ---- */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .stat-group {
    background: var(--pr-surface-subtle);
    padding: 18px;
    border-radius: var(--pr-radius);
    border: 1px solid var(--pr-border);
    border-left: 3px solid var(--pr-accent);
  }

  .stat-group h4 {
    margin: 0 0 14px;
    color: var(--pr-ink);
    font-size: 13px;
    font-weight: 700;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--pr-border);
  }

  .stat-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 0;
    border-bottom: 1px solid var(--pr-border);
    font-size: 13px;
  }
  .stat-item:last-child { border-bottom: none; }

  .stat-item-label { font-weight: 500; color: var(--pr-ink-muted); }
  .stat-item-value { font-weight: 700; color: var(--pr-accent-ink); font-variant-numeric: tabular-nums; }

  /* ---- Responsive ---- */
  @media (max-width: 992px) {
    .budget-source-analysis,
    .budget-analysis,
    .currency-analysis-grid,
    .geo-distribution-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .executive-kpi-grid,
    .detailed-reports-grid,
    .stats-grid {
      grid-template-columns: 1fr;
    }
    .kpi-indicators-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
<% end %>
