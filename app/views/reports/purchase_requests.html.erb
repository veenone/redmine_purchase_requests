  .priority-item.priority-low { background: #4CAF50; color: white; }
  .priority-item.priority-normal { background: #2196F3; color: white; }
  .priority-item.priority-high { background: #FF9800; color: white; }
  .priority-item.priority-urgent { background: #F44336; color: white; }

  .priority-label {
    font-size: 14px;
    margin-bottom: 5px;
  }

  .priority-count {
    font-size: 20px;
    font-weight: bold;
  }

  .requester-list {
    display: grid;
    gap: 10px;
  }

  .requester-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 12px;
    background: #f8f9fa;
    border-radius: 6px;
  }

  .requester-rank {
    background: #2196F3;
    color: white;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 12px;
  }

  .requester-name {
    flex: 1;
    font-weight: 500;
  }

  .requester-count {
    color: #666;
    font-size: 14px;
  }

  .tpc-breakdown {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }

  .tpc-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 12px;
    background: #f8f9fa;
    border-radius: 6px;
  }

  .tpc-rank {
    background: #9C27B0;
    color: white;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 12px;
  }

  .tpc-details {
    flex: 1;
  }

  .tpc-code {
    font-weight: 600;
    font-family: 'Monaco', 'Menlo', monospace;
  }

  .tpc-stats {
    font-size: 12px;
    color: #666;
  }

  .tpc-value {
    font-size: 16px;
    font-weight: bold;
    color: #4CAF50;
  }

  .vendor-stats {
    display: grid;
    gap: 10px;
  }

  .vendor-stat-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 12px;
    background: #f8f9fa;
    border-radius: 4px;
  }

  .vendor-rank {
    background: #007bff;
    color: white;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 12px;
  }

  .vendor-name {
    flex: 1;
    font-weight: 500;
  }

  .vendor-count {
    color: #666;
    font-size: 14px;
  }

  .source-badge {
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 10px;
    font-weight: bold;
    text-transform: uppercase;
  }

  .source-badge.capex { background: #2196F3; color: white; }
  .source-badge.opex { background: #4CAF50; color: white; }
  .source-badge.direct-tpc { background: #FF9800; color: white; }
  .source-badge.non-budgeted { background: #9E9E9E; color: white; }

  .status-badge, .priority-badge {
    padding: 3px 8px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
  }

  .status-badge { background: #f0f0f0; color: #333; }
  .priority-badge.priority-low { background: #4CAF50; color: white; }
  .priority-badge.priority-normal { background: #2196F3; color: white; }
  .priority-badge.priority-high { background: #FF9800; color: white; }
  .priority-badge.priority-urgent { background: #F44336; color: white; }

  .icon-pdf {
    background-image: url('<%= asset_path("files/pdf.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: center;
    padding-left: 20px;
  }

  .icon-csv-file {
    background-image: url('<%= asset_path("files/text.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: center;
    padding-left: 20px;
  }

  @media (max-width: 992px) {
    .charts-row, .budget-analysis {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .summary-cards {
      grid-template-columns: 1fr;
    }

    .priority-breakdown {
      justify-content: center;
    }

    .budget-breakdown {
      grid-template-columns: 1fr;
    }
  }

  <% if @print_mode %>
  @media all {
    body {
      font-family: Arial, sans-serif;
      font-size: 12px;
      line-height: 1.4;
      color: #000;
      background: #fff;
    }

    .chart-container, .chart-container-sm, .trend-chart-container {
      display: none !important;
    }

    .report-section {
      page-break-inside: avoid;
      margin-bottom: 20px;
    }

    h2, h3 {
      color: #000;
      border-bottom: 1px solid #ccc;
    }

    .summary-cards {
      display: block;
    }

    .summary-card {
      display: inline-block;
      width: 200px;
      margin: 10px;
      page-break-inside: avoid;
    }
