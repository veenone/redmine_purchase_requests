<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/reports/purchase_requests.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% end %>

<% html_title("Purchase Requests Report#{@project ? " - #{@project.name}" : ""}") %>

<% unless @print_mode %>
<div class="contextual">
  <% reports_index_path = @project ? project_reports_path(@project) : reports_path %>
  <%= link_to reports_index_path, class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-cancel">Back to Reports</span>
  <% end %>

  <% report_path_base = @project ?
       purchase_requests_project_reports_path(@project) :
       purchase_requests_reports_path %>

  <%= render 'export_actions', report_path_base: report_path_base %>
</div>
<% end %>

<h2>
  Purchase Requests Report<%= report_year_suffix %>
  <% if @project %>
    <span class="pr-badge pr-badge--accent" style="font-size: var(--pr-text-base);margin-left:10px;vertical-align:middle;"><%= @project.name %></span>
  <% end %>
</h2>

<% unless @print_mode %>
<%= render 'year_filter', filter_path: report_path_base %>
<% end %>

<div class="info-box" style="margin-bottom:24px;">
  <p style="margin:0 0 4px;"><strong>Generated:</strong> <%= @report_data[:generated_at].strftime('%B %d, %Y at %I:%M %p') %></p>
  <% if @project %>
    <p style="margin:0;"><strong>Scope:</strong> Project-specific data for <%= @project.name %></p>
  <% else %>
    <p style="margin:0;"><strong>Scope:</strong> System-wide data across all projects</p>
  <% end %>
</div>

<!-- Executive Summary -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Executive Summary</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="summary-stats">
      <div class="stat-box pr-stat--accent">
        <div class="stat-number"><%= @report_data[:summary][:total_count] %></div>
        <div class="stat-label">Total Requests</div>
      </div>
      <div class="stat-box pr-stat--warning">
        <div class="stat-number"><%= @report_data[:summary][:open_count] %></div>
        <div class="stat-label">Open Requests</div>
      </div>
      <div class="stat-box pr-stat--success">
        <div class="stat-number"><%= @report_data[:summary][:closed_count] %></div>
        <div class="stat-label">Closed Requests</div>
      </div>
      <div class="stat-box pr-stat--violet">
        <div class="stat-number stat-currency">$<%= number_with_delimiter(@report_data[:summary][:total_estimated_value].round(0)) %></div>
        <div class="stat-label">Total Est. Value</div>
      </div>
      <div class="stat-box">
        <div class="stat-number stat-currency">$<%= number_with_delimiter(@report_data[:summary][:avg_estimated_value].round(0)) %></div>
        <div class="stat-label">Avg. Est. Value</div>
      </div>
    </div>
  </div>
</div>

<!-- Budget Source Analysis -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Purchase Requests by Budget Source</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="charts-row">
      <div class="chart-half">
        <h4 style="margin:0 0 12px;color:var(--pr-ink-muted);font-size: var(--pr-text-sm);font-weight:700;text-transform:uppercase;letter-spacing:.04em;text-align:center;">By Count</h4>
        <div class="chart-container-sm">
          <canvas id="budgetSourceChart" height="250"></canvas>
        </div>
      </div>

      <div class="chart-half">
        <h4 style="margin:0 0 12px;color:var(--pr-ink-muted);font-size: var(--pr-text-sm);font-weight:700;text-transform:uppercase;letter-spacing:.04em;text-align:center;">By Value</h4>
        <div class="chart-container-sm">
          <canvas id="budgetValueChart" height="250"></canvas>
        </div>
      </div>
    </div>

    <div class="budget-breakdown-grid">
      <div class="budget-breakdown-item budget-breakdown-item--capex">
        <div class="budget-breakdown-label">CAPEX</div>
        <div class="budget-breakdown-count"><%= @report_data[:budget_source_breakdown]['CAPEX'] %> requests</div>
        <div class="budget-breakdown-value">$<%= number_with_delimiter(@report_data[:budget_source_value]['CAPEX'].round(0)) %></div>
      </div>
      <div class="budget-breakdown-item budget-breakdown-item--opex">
        <div class="budget-breakdown-label">OPEX</div>
        <div class="budget-breakdown-count"><%= @report_data[:budget_source_breakdown]['OPEX'] %> requests</div>
        <div class="budget-breakdown-value">$<%= number_with_delimiter(@report_data[:budget_source_value]['OPEX'].round(0)) %></div>
      </div>
      <div class="budget-breakdown-item budget-breakdown-item--direct-tpc">
        <div class="budget-breakdown-label">Direct TPC</div>
        <div class="budget-breakdown-count"><%= @report_data[:budget_source_breakdown]['Direct TPC'] %> requests</div>
        <div class="budget-breakdown-value">$<%= number_with_delimiter(@report_data[:budget_source_value]['Direct TPC'].round(0)) %></div>
      </div>
      <div class="budget-breakdown-item budget-breakdown-item--non-budgeted">
        <div class="budget-breakdown-label">Non-budgeted</div>
        <div class="budget-breakdown-count"><%= @report_data[:budget_source_breakdown]['Non-budgeted'] %> requests</div>
        <div class="budget-breakdown-value">$<%= number_with_delimiter(@report_data[:budget_source_value]['Non-budgeted'].round(0)) %></div>
      </div>
    </div>
  </div>
</div>

<!-- Status & Priority Analysis -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Status &amp; Priority Distribution</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="charts-row">
      <div class="chart-half">
        <h4 style="margin:0 0 12px;color:var(--pr-ink-muted);font-size: var(--pr-text-sm);font-weight:700;text-transform:uppercase;letter-spacing:.04em;text-align:center;">Status Distribution</h4>
        <div class="chart-container-sm">
          <canvas id="statusChart" height="250"></canvas>
        </div>
      </div>

      <div class="chart-half">
        <h4 style="margin:0 0 12px;color:var(--pr-ink-muted);font-size: var(--pr-text-sm);font-weight:700;text-transform:uppercase;letter-spacing:.04em;text-align:center;">Priority Distribution</h4>
        <div class="chart-container-sm">
          <canvas id="priorityChart" height="250"></canvas>
        </div>
      </div>
    </div>

    <div class="priority-breakdown">
      <% @report_data[:priority_breakdown].each do |priority, count| %>
        <div class="priority-chip priority-chip--<%= priority %>">
          <span class="priority-chip-label"><%= priority.capitalize %></span>
          <span class="priority-chip-count"><%= count %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Requester Analysis -->
<% if @report_data[:requester_breakdown].any? %>
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Purchase Requests by Requester</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="charts-row">
      <div class="chart-half">
        <div class="chart-container-sm">
          <canvas id="requesterChart" height="300"></canvas>
        </div>
      </div>

      <div class="chart-half">
        <div class="ranked-list">
          <% @report_data[:requester_breakdown].each_with_index do |requester, index| %>
            <div class="ranked-list-item">
              <span class="ranked-list-rank"><%="##{index + 1}" %></span>
              <span class="ranked-list-name"><%= requester[:name] %></span>
              <span class="ranked-list-count"><%= requester[:count] %> requests</span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<% end %>

<!-- TPC Code Distribution -->
<% if @report_data[:tpc_distribution].any? %>
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Distribution by TPC Code</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="charts-row">
      <div class="chart-half">
        <h4 style="margin:0 0 12px;color:var(--pr-ink-muted);font-size: var(--pr-text-sm);font-weight:700;text-transform:uppercase;letter-spacing:.04em;text-align:center;">By Request Count</h4>
        <div class="chart-container-sm">
          <canvas id="tpcCountChart" height="300"></canvas>
        </div>
      </div>

      <div class="chart-half">
        <h4 style="margin:0 0 12px;color:var(--pr-ink-muted);font-size: var(--pr-text-sm);font-weight:700;text-transform:uppercase;letter-spacing:.04em;text-align:center;">By Total Value</h4>
        <div class="chart-container-sm">
          <canvas id="tpcValueChart" height="300"></canvas>
        </div>
      </div>
    </div>

    <div class="ranked-list" style="margin-top:20px;">
      <% @report_data[:tpc_distribution].each_with_index do |(tpc_number, count), index| %>
        <div class="ranked-list-item">
          <span class="ranked-list-rank"><%="##{index + 1}" %></span>
          <div style="flex:1;">
            <div class="tpc-number" style="font-size: var(--pr-text-base);"><%= tpc_number %></div>
            <div style="font-size: var(--pr-text-sm);color:var(--pr-ink-muted);"><%= count %> requests</div>
          </div>
          <% value = @report_data[:tpc_value_distribution][tpc_number] || 0 %>
          <span style="font-size: var(--pr-text-md);font-weight:700;color:var(--pr-success-ink);font-variant-numeric:tabular-nums;">$<%= number_with_delimiter(value.round(0)) %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Cost Consumption Trend -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Total Cost Consumption Trend (Last 12 Months)</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="trend-chart-container">
      <canvas id="costTrendChart" height="300"></canvas>
    </div>
  </div>
</div>

<!-- Monthly Creation Trend -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Monthly Creation Trend (Last 12 Months)</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="trend-chart-container">
      <canvas id="trendChart" height="250"></canvas>
    </div>
  </div>
</div>

<!-- Vendor Analysis -->
<% if @report_data[:vendor_stats].any? %>
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Top Vendors by Request Count</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="ranked-list">
      <% @report_data[:vendor_stats].each_with_index do |(vendor_info, count), index| %>
        <div class="ranked-list-item">
          <span class="ranked-list-rank"><%="##{index + 1}" %></span>
          <span class="ranked-list-name"><%= vendor_info.first %></span>
          <span class="ranked-list-count"><%= count %> requests</span>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Recent Requests -->
<div class="report-section dashboard-card">
  <div class="dashboard-card-header">
    <h3>Recent Purchase Requests</h3>
  </div>
  <div class="dashboard-card-body">
    <div class="autoscroll">
      <table class="pr-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Project</th>
            <th>Budget Source</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Est. Price</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          <% @report_data[:recent_requests].each do |request| %>
            <tr>
              <td><%= request.id %></td>
              <td><%= truncate(request.title, length: 40) %></td>
              <td><%= request.project&.name %></td>
              <td>
                <% if request.capex_id %>
                  <span class="pr-badge pr-badge--accent">CAPEX</span>
                <% elsif request.opex_id %>
                  <span class="pr-badge pr-badge--success">OPEX</span>
                <% elsif request.tpc_code_id %>
                  <span class="pr-badge pr-badge--warning">Direct TPC</span>
                <% else %>
                  <span class="pr-badge pr-badge--neutral">Non-budgeted</span>
                <% end %>
              </td>
              <td>
                <span class="status-badge">
                  <%= request.status&.name %>
                </span>
              </td>
              <td>
                <span class="priority-badge <%= request.priority %>">
                  <%= request.priority&.capitalize %>
                </span>
              </td>
              <td>
                <% if request.estimated_price %>
                  <%= request.currency %> <%= number_with_delimiter(request.estimated_price) %>
                <% else %>
                  -
                <% end %>
              </td>
              <td><%= request.created_at.strftime('%Y-%m-%d') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= render 'reports/chart_colors' %>

<% unless @print_mode %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Chart.js default configuration
  Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, sans-serif';

  // Budget Source Chart (Count)
  const budgetCtx = document.getElementById('budgetSourceChart').getContext('2d');
  new Chart(budgetCtx, {
    type: 'doughnut',
    data: {
      labels: <%= raw @report_data[:budget_source_breakdown].keys.to_json %>,
      datasets: [{
        data: <%= raw @report_data[:budget_source_breakdown].values.to_json %>,
        backgroundColor: [PR_CHART_COLORS[0], PR_CHART_COLORS[1], PR_CHART_COLORS[2], PR_CHART_NEUTRAL],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Requests by Budget Source'
        }
      }
    }
  });

  // Budget Value Chart
  const budgetValueCtx = document.getElementById('budgetValueChart').getContext('2d');
  new Chart(budgetValueCtx, {
    type: 'doughnut',
    data: {
      labels: <%= raw @report_data[:budget_source_value].keys.to_json %>,
      datasets: [{
        data: <%= raw @report_data[:budget_source_value].values.to_json %>,
        backgroundColor: [PR_CHART_COLORS[0], PR_CHART_COLORS[1], PR_CHART_COLORS[2], PR_CHART_NEUTRAL],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Value by Budget Source'
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return context.label + ': $' + context.raw.toLocaleString();
            }
          }
        }
      }
    }
  });

  // Status Chart
  const statusCtx = document.getElementById('statusChart').getContext('2d');
  new Chart(statusCtx, {
    type: 'doughnut',
    data: {
      labels: <%= raw @report_data[:status_breakdown].keys.to_json %>,
      datasets: [{
        data: <%= raw @report_data[:status_breakdown].values.to_json %>,
        backgroundColor: <%= raw @report_data[:status_breakdown].keys.to_json %>.map(function(_, i) { return PR_CHART_COLORS[i % PR_CHART_COLORS.length]; }),
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Status Distribution'
        }
      }
    }
  });

  // Priority Chart
  const priorityCtx = document.getElementById('priorityChart').getContext('2d');
  new Chart(priorityCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:priority_breakdown].keys.map(&:capitalize).to_json %>,
      datasets: [{
        label: 'Requests',
        data: <%= raw @report_data[:priority_breakdown].values.to_json %>,
        backgroundColor: PR_CHART_COLORS.slice(0, 4)
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Priority Distribution'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Count'
          }
        }
      }
    }
  });

  <% if @report_data[:requester_breakdown].any? %>
  // Requester Chart
  const requesterCtx = document.getElementById('requesterChart').getContext('2d');
  new Chart(requesterCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:requester_breakdown].map { |r| r[:name] }.to_json %>,
      datasets: [{
        label: 'Requests',
        data: <%= raw @report_data[:requester_breakdown].map { |r| r[:count] }.to_json %>,
        backgroundColor: PR_CHART_COLORS[0] + 'b3',
        borderColor: PR_CHART_COLORS[0],
        borderWidth: 1
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Top Requesters'
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Number of Requests'
          }
        }
      }
    }
  });
  <% end %>

  <% if @report_data[:tpc_distribution].any? %>
  // TPC Count Chart
  const tpcCountCtx = document.getElementById('tpcCountChart').getContext('2d');
  new Chart(tpcCountCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:tpc_distribution].keys.to_json %>,
      datasets: [{
        label: 'Requests',
        data: <%= raw @report_data[:tpc_distribution].values.to_json %>,
        backgroundColor: PR_CHART_COLORS[5] + 'b3',
        borderColor: PR_CHART_COLORS[5],
        borderWidth: 1
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Requests by TPC Code'
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Number of Requests'
          }
        }
      }
    }
  });

  // TPC Value Chart
  const tpcValueCtx = document.getElementById('tpcValueChart').getContext('2d');
  new Chart(tpcValueCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:tpc_value_distribution].keys.to_json %>,
      datasets: [{
        label: 'Value',
        data: <%= raw @report_data[:tpc_value_distribution].values.to_json %>,
        backgroundColor: PR_CHART_COLORS[1] + 'b3',
        borderColor: PR_CHART_COLORS[1],
        borderWidth: 1
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Value by TPC Code'
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return '$' + context.raw.toLocaleString();
            }
          }
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Total Value'
          },
          ticks: {
            callback: function(value) {
              return '$' + value.toLocaleString();
            }
          }
        }
      }
    }
  });
  <% end %>

  // Cost Consumption Trend Chart
  const costTrendCtx = document.getElementById('costTrendChart').getContext('2d');
  new Chart(costTrendCtx, {
    type: 'line',
    data: {
      labels: <%= raw @report_data[:monthly_cost_trend].keys.to_json %>,
      datasets: [{
        label: 'Total Cost',
        data: <%= raw @report_data[:monthly_cost_trend].values.to_json %>,
        borderColor: PR_CHART_COLORS[1],
        backgroundColor: PR_CHART_COLORS[1] + '1a',
        tension: 0.4,
        fill: true,
        pointRadius: 5,
        pointHoverRadius: 8
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Monthly Cost Consumption'
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return '$' + context.raw.toLocaleString();
            }
          }
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Total Value'
          },
          ticks: {
            callback: function(value) {
              return '$' + value.toLocaleString();
            }
          }
        }
      }
    }
  });

  // Creation Trend Chart
  const trendCtx = document.getElementById('trendChart').getContext('2d');
  new Chart(trendCtx, {
    type: 'line',
    data: {
      labels: <%= raw @report_data[:monthly_trend].keys.map { |date| date.strftime('%b %Y') }.to_json %>,
      datasets: [{
        label: 'Purchase Requests Created',
        data: <%= raw @report_data[:monthly_trend].values.to_json %>,
        borderColor: PR_CHART_COLORS[0],
        backgroundColor: PR_CHART_COLORS[0] + '1a',
        tension: 0.4,
        fill: true,
        pointRadius: 5,
        pointHoverRadius: 8
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Monthly Request Creation'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Number of Requests'
          }
        }
      }
    }
  });
});
</script>
<% end %>

<% content_for :header_tags do %>
<style>
  /* ---- icon helpers ---- */
  .icon-pdf {
    background-image: url('<%= asset_path("files/pdf.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }
  .icon-csv-file {
    background-image: url('<%= asset_path("files/text.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  /* ---- section spacing ---- */
  .report-section { margin-bottom: 22px; }

  /* ---- chart layout ---- */
  .charts-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 20px;
  }

  .chart-half { min-height: 260px; }

  .chart-container-sm { height: 260px; }

  .trend-chart-container { height: 320px; margin: 4px 0 0; }

  /* ---- budget source breakdown tiles ---- */
  .budget-breakdown-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-top: 20px;
  }

  .budget-breakdown-item {
    padding: 14px 16px;
    border-radius: var(--pr-radius);
    background: var(--pr-surface-subtle);
    border: 1px solid var(--pr-border);
    border-left: 3px solid var(--pr-border-strong);
    text-align: center;
  }
  .budget-breakdown-item--capex       { border-left-color: var(--pr-accent); }
  .budget-breakdown-item--opex        { border-left-color: var(--pr-success); }
  .budget-breakdown-item--direct-tpc  { border-left-color: var(--pr-warning); }
  .budget-breakdown-item--non-budgeted{ border-left-color: var(--pr-ink-faint); }

  .budget-breakdown-label {
    font-size: var(--pr-text-sm);
    font-weight: 700;
    color: var(--pr-ink-muted);
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-bottom: 6px;
  }

  .budget-breakdown-count {
    font-size: var(--pr-text-sm);
    color: var(--pr-ink-faint);
    margin-bottom: 4px;
  }

  .budget-breakdown-value {
    font-size: 18px;
    font-weight: 700;
    color: var(--pr-ink);
    font-variant-numeric: tabular-nums;
  }

  /* ---- priority chips ---- */
  .priority-breakdown {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 18px;
    justify-content: center;
  }

  .priority-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 14px 20px;
    border-radius: var(--pr-radius);
    min-width: 90px;
    border: 1px solid var(--pr-border);
    background: var(--pr-surface-subtle);
    border-top: 3px solid var(--pr-border-strong);
  }
  .priority-chip--low     { border-top-color: var(--pr-info); }
  .priority-chip--normal  { border-top-color: var(--pr-success); }
  .priority-chip--high    { border-top-color: var(--pr-warning); }
  .priority-chip--urgent  { border-top-color: var(--pr-danger); }

  .priority-chip-label {
    font-size: var(--pr-text-sm);
    font-weight: 700;
    color: var(--pr-ink-muted);
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-bottom: 4px;
  }

  .priority-chip-count {
    font-size: 22px;
    font-weight: 700;
    color: var(--pr-ink);
    font-variant-numeric: tabular-nums;
  }

  /* ---- ranked list (requesters, vendors, TPC) ---- */
  .ranked-list { display: grid; gap: 8px; }

  .ranked-list-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--pr-surface-subtle);
    border: 1px solid var(--pr-border);
    border-radius: var(--pr-radius-sm);
    font-size: var(--pr-text-base);
  }

  .ranked-list-rank {
    background: var(--pr-accent);
    color: var(--pr-ink-invert);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: var(--pr-text-xs);
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .ranked-list-name { flex: 1; font-weight: 600; color: var(--pr-ink); }
  .ranked-list-count { color: var(--pr-ink-muted); font-size: var(--pr-text-sm); }

  /* ---- responsive ---- */
  @media (max-width: 992px) {
    .charts-row { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .budget-breakdown-grid { grid-template-columns: 1fr 1fr; }
    .priority-breakdown { justify-content: center; }
  }

  <% if @print_mode %>
  @media all {
    body {
      font-family: Arial, sans-serif;
      font-size: var(--pr-text-sm);
      line-height: 1.4;
      color: #000;
      background: var(--pr-surface);
    }

    .chart-container-sm, .trend-chart-container {
      display: none !important;
    }

    .report-section {
      page-break-inside: avoid;
      margin-bottom: 20px;
    }

    h2, h3 {
      color: #000;
      border-bottom: 1px solid #ccc;
    }
  }
  <% end %>
</style>
<% end %>
