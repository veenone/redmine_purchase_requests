<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/reports/purchase_requests.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% end %>

<% html_title("Purchase Requests Report#{@project ? " - #{@project.name}" : ""}") %>

<% unless @print_mode %>
<div class="contextual">
  <% reports_index_path = @project ? project_reports_path(@project) : reports_path %>
  <%= link_to reports_index_path, class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-cancel">Back to Reports</span>
  <% end %>

  <% report_path_base = @project ?
       purchase_requests_project_reports_path(@project) :
       purchase_requests_reports_path %>

  <%= link_to "#{report_path_base}?format=pdf", class: 'pr-button pr-button-primary pr-button-icon', target: '_blank' do %>
    <span class="icon icon-pdf">Export PDF</span>
  <% end %>

  <%= link_to "#{report_path_base}?format=csv", class: 'pr-button pr-button-outline pr-button-icon' do %>
    <span class="icon icon-csv-file">Export CSV</span>
  <% end %>
</div>
<% end %>

<h2>
  Purchase Requests Report
  <% if @project %>
    <span class="project-badge"><%= @project.name %></span>
  <% end %>
</h2>

<div class="report-meta">
  <p><strong>Generated:</strong> <%= @report_data[:generated_at].strftime('%B %d, %Y at %I:%M %p') %></p>
  <% if @project %>
    <p><strong>Scope:</strong> Project-specific data for <%= @project.name %></p>
  <% else %>
    <p><strong>Scope:</strong> System-wide data across all projects</p>
  <% end %>
</div>

<!-- Executive Summary -->
<div class="report-section">
  <h3>Executive Summary</h3>

  <div class="summary-cards">
    <div class="summary-card">
      <div class="card-icon"><span class="icon icon-package"></span></div>
      <div class="card-content">
        <div class="card-value"><%= @report_data[:summary][:total_count] %></div>
        <div class="card-label">Total Requests</div>
      </div>
    </div>

    <div class="summary-card open">
      <div class="card-icon"><span class="icon icon-time"></span></div>
      <div class="card-content">
        <div class="card-value"><%= @report_data[:summary][:open_count] %></div>
        <div class="card-label">Open Requests</div>
      </div>
    </div>

    <div class="summary-card closed">
      <div class="card-icon"><span class="icon icon-checked"></span></div>
      <div class="card-content">
        <div class="card-value"><%= @report_data[:summary][:closed_count] %></div>
        <div class="card-label">Closed Requests</div>
      </div>
    </div>

    <div class="summary-card financial">
      <div class="card-icon"><span class="icon icon-money"></span></div>
      <div class="card-content">
        <div class="card-value">$<%= number_with_delimiter(@report_data[:summary][:total_estimated_value].round(0)) %></div>
        <div class="card-label">Total Est. Value</div>
      </div>
    </div>

    <div class="summary-card avg">
      <div class="card-icon"><span class="icon icon-stats"></span></div>
      <div class="card-content">
        <div class="card-value">$<%= number_with_delimiter(@report_data[:summary][:avg_estimated_value].round(0)) %></div>
        <div class="card-label">Avg. Est. Value</div>
      </div>
    </div>
  </div>
</div>

<!-- Budget Source Analysis -->
<div class="report-section">
  <h3>Purchase Requests by Budget Source</h3>

  <div class="budget-analysis">
    <div class="chart-half">
      <h4>By Count</h4>
      <div class="chart-container-sm">
        <canvas id="budgetSourceChart" height="250"></canvas>
      </div>
    </div>

    <div class="chart-half">
      <h4>By Value</h4>
      <div class="chart-container-sm">
        <canvas id="budgetValueChart" height="250"></canvas>
      </div>
    </div>
  </div>

  <div class="budget-breakdown">
    <div class="budget-item capex">
      <div class="budget-label">CAPEX</div>
      <div class="budget-count"><%= @report_data[:budget_source_breakdown]['CAPEX'] %> requests</div>
      <div class="budget-value">$<%= number_with_delimiter(@report_data[:budget_source_value]['CAPEX'].round(0)) %></div>
    </div>
    <div class="budget-item opex">
      <div class="budget-label">OPEX</div>
      <div class="budget-count"><%= @report_data[:budget_source_breakdown]['OPEX'] %> requests</div>
      <div class="budget-value">$<%= number_with_delimiter(@report_data[:budget_source_value]['OPEX'].round(0)) %></div>
    </div>
    <div class="budget-item direct-tpc">
      <div class="budget-label">Direct TPC</div>
      <div class="budget-count"><%= @report_data[:budget_source_breakdown]['Direct TPC'] %> requests</div>
      <div class="budget-value">$<%= number_with_delimiter(@report_data[:budget_source_value]['Direct TPC'].round(0)) %></div>
    </div>
    <div class="budget-item non-budgeted">
      <div class="budget-label">Non-budgeted</div>
      <div class="budget-count"><%= @report_data[:budget_source_breakdown]['Non-budgeted'] %> requests</div>
      <div class="budget-value">$<%= number_with_delimiter(@report_data[:budget_source_value]['Non-budgeted'].round(0)) %></div>
    </div>
  </div>
</div>

<!-- Status & Priority Analysis -->
<div class="report-section">
  <h3>Status & Priority Distribution</h3>

  <div class="charts-row">
    <div class="chart-half">
      <h4>Status Distribution</h4>
      <div class="chart-container-sm">
        <canvas id="statusChart" height="250"></canvas>
      </div>
    </div>

    <div class="chart-half">
      <h4>Priority Distribution</h4>
      <div class="chart-container-sm">
        <canvas id="priorityChart" height="250"></canvas>
      </div>
    </div>
  </div>

  <div class="priority-breakdown">
    <% @report_data[:priority_breakdown].each do |priority, count| %>
      <div class="priority-item priority-<%= priority %>">
        <span class="priority-label"><%= priority.capitalize %></span>
        <span class="priority-count"><%= count %></span>
      </div>
    <% end %>
  </div>
</div>

<!-- Requester Analysis -->
<% if @report_data[:requester_breakdown].any? %>
<div class="report-section">
  <h3>Purchase Requests by Requester</h3>

  <div class="charts-row">
    <div class="chart-half">
      <div class="chart-container-sm">
        <canvas id="requesterChart" height="300"></canvas>
      </div>
    </div>

    <div class="chart-half">
      <div class="requester-list">
        <% @report_data[:requester_breakdown].each_with_index do |requester, index| %>
          <div class="requester-item">
            <span class="requester-rank">#<%= index + 1 %></span>
            <span class="requester-name"><%= requester[:name] %></span>
            <span class="requester-count"><%= requester[:count] %> requests</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>

<!-- TPC Code Distribution -->
<% if @report_data[:tpc_distribution].any? %>
<div class="report-section">
  <h3>Distribution by TPC Code</h3>

  <div class="charts-row">
    <div class="chart-half">
      <h4>By Request Count</h4>
      <div class="chart-container-sm">
        <canvas id="tpcCountChart" height="300"></canvas>
      </div>
    </div>

    <div class="chart-half">
      <h4>By Total Value</h4>
      <div class="chart-container-sm">
        <canvas id="tpcValueChart" height="300"></canvas>
      </div>
    </div>
  </div>

  <div class="tpc-breakdown">
    <% @report_data[:tpc_distribution].each_with_index do |(tpc_number, count), index| %>
      <div class="tpc-item">
        <span class="tpc-rank">#<%= index + 1 %></span>
        <div class="tpc-details">
          <div class="tpc-code"><%= tpc_number %></div>
          <div class="tpc-stats"><%= count %> requests</div>
        </div>
        <div class="tpc-value">
          <% value = @report_data[:tpc_value_distribution][tpc_number] || 0 %>
          $<%= number_with_delimiter(value.round(0)) %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<!-- Cost Consumption Trend -->
<div class="report-section">
  <h3>Total Cost Consumption Trend (Last 12 Months)</h3>

  <div class="trend-chart-container">
    <canvas id="costTrendChart" height="300"></canvas>
  </div>
</div>

<!-- Monthly Creation Trend -->
<div class="report-section">
  <h3>Monthly Creation Trend (Last 12 Months)</h3>

  <div class="chart-container">
    <canvas id="trendChart" height="250"></canvas>
  </div>
</div>

<!-- Vendor Analysis -->
<% if @report_data[:vendor_stats].any? %>
<div class="report-section">
  <h3>Top Vendors by Request Count</h3>

  <div class="vendor-stats">
    <% @report_data[:vendor_stats].each_with_index do |(vendor_info, count), index| %>
      <div class="vendor-stat-item">
        <span class="vendor-rank">#<%= index + 1 %></span>
        <span class="vendor-name"><%= vendor_info.first %></span>
        <span class="vendor-count"><%= count %> requests</span>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<!-- Recent Requests -->
<div class="report-section">
  <h3>Recent Purchase Requests</h3>

  <div class="autoscroll">
    <table class="list recent-requests">
      <thead>
        <tr>
          <th>ID</th>
          <th>Title</th>
          <th>Project</th>
          <th>Budget Source</th>
          <th>Status</th>
          <th>Priority</th>
          <th>Est. Price</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <% @report_data[:recent_requests].each do |request| %>
          <tr>
            <td><%= request.id %></td>
            <td><%= truncate(request.title, length: 40) %></td>
            <td><%= request.project&.name %></td>
            <td>
              <% if request.capex_id %>
                <span class="source-badge capex">CAPEX</span>
              <% elsif request.opex_id %>
                <span class="source-badge opex">OPEX</span>
              <% elsif request.tpc_code_id %>
                <span class="source-badge direct-tpc">Direct TPC</span>
              <% else %>
                <span class="source-badge non-budgeted">Non-budgeted</span>
              <% end %>
            </td>
            <td>
              <span class="status-badge">
                <%= request.status&.name %>
              </span>
            </td>
            <td>
              <span class="priority-badge priority-<%= request.priority %>">
                <%= request.priority&.capitalize %>
              </span>
            </td>
            <td>
              <% if request.estimated_price %>
                <%= request.currency %> <%= number_with_delimiter(request.estimated_price) %>
              <% else %>
                -
              <% end %>
            </td>
            <td><%= request.created_at.strftime('%Y-%m-%d') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<% unless @print_mode %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Chart.js default configuration
  Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, sans-serif';

  // Budget Source Chart (Count)
  const budgetCtx = document.getElementById('budgetSourceChart').getContext('2d');
  new Chart(budgetCtx, {
    type: 'doughnut',
    data: {
      labels: <%= raw @report_data[:budget_source_breakdown].keys.to_json %>,
      datasets: [{
        data: <%= raw @report_data[:budget_source_breakdown].values.to_json %>,
        backgroundColor: ['#2196F3', '#4CAF50', '#FF9800', '#9E9E9E'],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Requests by Budget Source'
        }
      }
    }
  });

  // Budget Value Chart
  const budgetValueCtx = document.getElementById('budgetValueChart').getContext('2d');
  new Chart(budgetValueCtx, {
    type: 'doughnut',
    data: {
      labels: <%= raw @report_data[:budget_source_value].keys.to_json %>,
      datasets: [{
        data: <%= raw @report_data[:budget_source_value].values.to_json %>,
        backgroundColor: ['#2196F3', '#4CAF50', '#FF9800', '#9E9E9E'],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Value by Budget Source'
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return context.label + ': $' + context.raw.toLocaleString();
            }
          }
        }
      }
    }
  });

  // Status Chart
  const statusCtx = document.getElementById('statusChart').getContext('2d');
  new Chart(statusCtx, {
    type: 'doughnut',
    data: {
      labels: <%= raw @report_data[:status_breakdown].keys.to_json %>,
      datasets: [{
        data: <%= raw @report_data[:status_breakdown].values.to_json %>,
        backgroundColor: [
          '#4CAF50', '#2196F3', '#FF9800', '#F44336', '#9C27B0', '#607D8B'
        ],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Status Distribution'
        }
      }
    }
  });

  // Priority Chart
  const priorityCtx = document.getElementById('priorityChart').getContext('2d');
  new Chart(priorityCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:priority_breakdown].keys.map(&:capitalize).to_json %>,
      datasets: [{
        label: 'Requests',
        data: <%= raw @report_data[:priority_breakdown].values.to_json %>,
        backgroundColor: ['#4CAF50', '#2196F3', '#FF9800', '#F44336']
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Priority Distribution'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Count'
          }
        }
      }
    }
  });

  <% if @report_data[:requester_breakdown].any? %>
  // Requester Chart
  const requesterCtx = document.getElementById('requesterChart').getContext('2d');
  new Chart(requesterCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:requester_breakdown].map { |r| r[:name] }.to_json %>,
      datasets: [{
        label: 'Requests',
        data: <%= raw @report_data[:requester_breakdown].map { |r| r[:count] }.to_json %>,
        backgroundColor: 'rgba(33, 150, 243, 0.7)',
        borderColor: 'rgba(33, 150, 243, 1)',
        borderWidth: 1
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Top Requesters'
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Number of Requests'
          }
        }
      }
    }
  });
  <% end %>

  <% if @report_data[:tpc_distribution].any? %>
  // TPC Count Chart
  const tpcCountCtx = document.getElementById('tpcCountChart').getContext('2d');
  new Chart(tpcCountCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:tpc_distribution].keys.to_json %>,
      datasets: [{
        label: 'Requests',
        data: <%= raw @report_data[:tpc_distribution].values.to_json %>,
        backgroundColor: 'rgba(156, 39, 176, 0.7)',
        borderColor: 'rgba(156, 39, 176, 1)',
        borderWidth: 1
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Requests by TPC Code'
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Number of Requests'
          }
        }
      }
    }
  });

  // TPC Value Chart
  const tpcValueCtx = document.getElementById('tpcValueChart').getContext('2d');
  new Chart(tpcValueCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:tpc_value_distribution].keys.to_json %>,
      datasets: [{
        label: 'Value',
        data: <%= raw @report_data[:tpc_value_distribution].values.to_json %>,
        backgroundColor: 'rgba(76, 175, 80, 0.7)',
        borderColor: 'rgba(76, 175, 80, 1)',
        borderWidth: 1
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Value by TPC Code'
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return '$' + context.raw.toLocaleString();
            }
          }
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Total Value'
          },
          ticks: {
            callback: function(value) {
              return '$' + value.toLocaleString();
            }
          }
        }
      }
    }
  });
  <% end %>

  // Cost Consumption Trend Chart
  const costTrendCtx = document.getElementById('costTrendChart').getContext('2d');
  new Chart(costTrendCtx, {
    type: 'line',
    data: {
      labels: <%= raw @report_data[:monthly_cost_trend].keys.to_json %>,
      datasets: [{
        label: 'Total Cost',
        data: <%= raw @report_data[:monthly_cost_trend].values.to_json %>,
        borderColor: '#4CAF50',
        backgroundColor: 'rgba(76, 175, 80, 0.1)',
        tension: 0.4,
        fill: true,
        pointRadius: 5,
        pointHoverRadius: 8
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Monthly Cost Consumption'
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              return '$' + context.raw.toLocaleString();
            }
          }
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Total Value'
          },
          ticks: {
            callback: function(value) {
              return '$' + value.toLocaleString();
            }
          }
        }
      }
    }
  });

  // Creation Trend Chart
  const trendCtx = document.getElementById('trendChart').getContext('2d');
  new Chart(trendCtx, {
    type: 'line',
    data: {
      labels: <%= raw @report_data[:monthly_trend].keys.map { |date| date.strftime('%b %Y') }.to_json %>,
      datasets: [{
        label: 'Purchase Requests Created',
        data: <%= raw @report_data[:monthly_trend].values.to_json %>,
        borderColor: '#2196F3',
        backgroundColor: 'rgba(33, 150, 243, 0.1)',
        tension: 0.4,
        fill: true,
        pointRadius: 5,
        pointHoverRadius: 8
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Monthly Request Creation'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Number of Requests'
          }
        }
      }
    }
  });
});
</script>
<% end %>

<% content_for :header_tags do %>
<style>
  .project-badge {
    background: #e3f2fd;
    color: #1976d2;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: normal;
    margin-left: 15px;
  }

  .report-meta {
    background: #f8f9fa;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    padding: 15px;
    margin-bottom: 25px;
  }

  .report-meta p {
    margin: 0 0 5px 0;
  }

  .report-section {
    margin-bottom: 40px;
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 25px;
  }

  .report-section h3 {
    margin: 0 0 20px 0;
    color: #333;
    border-bottom: 2px solid #eee;
    padding-bottom: 10px;
  }

  .report-section h4 {
    margin: 0 0 15px 0;
    color: #555;
    font-size: 14px;
    text-align: center;
  }

  .summary-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
  }

  .summary-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 20px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .summary-card.open {
    background: linear-gradient(135deg, #ffeaa7 0%, #fab1a0 100%);
  }

  .summary-card.closed {
    background: linear-gradient(135deg, #00b894 0%, #00cec9 100%);
  }

  .summary-card.financial {
    background: linear-gradient(135deg, #fdcb6e 0%, #e17055 100%);
  }

  .summary-card.avg {
    background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
  }

  .card-icon {
    font-size: 24px;
    opacity: 0.9;
  }

  .card-value {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 5px;
  }

  .card-label {
    font-size: 13px;
    opacity: 0.9;
  }

  .charts-row, .budget-analysis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-bottom: 20px;
  }

  .chart-half {
    min-height: 280px;
  }

  .chart-container {
    max-width: 800px;
    height: 300px;
    margin: 20px auto;
  }

  .chart-container-sm {
    height: 280px;
  }

  .trend-chart-container {
    height: 350px;
    margin: 20px 0;
  }

  .budget-breakdown {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    margin-top: 20px;
  }

  .budget-item {
    padding: 15px;
    border-radius: 8px;
    text-align: center;
    color: white;
  }

  .budget-item.capex {
    background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
  }

  .budget-item.opex {
    background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  }

  .budget-item.direct-tpc {
    background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
  }

  .budget-item.non-budgeted {
    background: linear-gradient(135deg, #9E9E9E 0%, #757575 100%);
