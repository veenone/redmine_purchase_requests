<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/reports/tpc_codes.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% end %>

<% html_title("TPC Codes Report#{@project ? " - #{@project.name}" : ""}") %>

<% unless @print_mode %>
<div class="contextual">
  <% reports_index_path = @project ? project_reports_path(@project) : reports_path %>
  <%= link_to reports_index_path, class: 'pr-button pr-button-cancel pr-button-icon' do %>
    <span class="icon icon-cancel">Back to Reports</span>
  <% end %>

  <% report_path_base = @project ?
       tpc_codes_project_reports_path(@project) :
       tpc_codes_reports_path %>

  <%= render 'export_actions', report_path_base: report_path_base %>
</div>
<% end %>

<h2>
  TPC Codes Report<%= report_year_suffix %>
  <% if @project %>
    <span class="pr-badge pr-badge--violet pr-badge--heading"><%= @project.name %></span>
  <% end %>
</h2>

<% unless @print_mode %>
<%= render 'year_filter', filter_path: report_path_base %>
<% end %>

<div class="info-box">
  <p><strong>Generated:</strong> <%= @report_data[:generated_at].strftime('%B %d, %Y at %I:%M %p') %></p>
  <p style="margin:0;">
    <% if @project %>
      <strong>Scope:</strong> TPC codes available for <%= @project.name %>
    <% else %>
      <strong>Scope:</strong> All TPC codes across the system
    <% end %>
  </p>
</div>

<!-- Executive Summary -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>TPC Code Overview</h3></div>
  <div class="dashboard-card-body">
    <div class="summary-stats">
      <div class="stat-box pr-stat--violet">
        <div class="stat-number"><%= @report_data[:summary][:total_count] %></div>
        <div class="stat-label">Total TPC Codes</div>
      </div>
      <div class="stat-box pr-stat--success">
        <div class="stat-number"><%= @report_data[:summary][:active_count] %></div>
        <div class="stat-label">Active Codes</div>
      </div>
      <div class="stat-box pr-stat--danger">
        <div class="stat-number"><%= @report_data[:summary][:inactive_count] %></div>
        <div class="stat-label">Inactive Codes</div>
      </div>
      <div class="stat-box pr-stat--accent">
        <div class="stat-number"><%= @report_data[:summary][:global_count] %></div>
        <div class="stat-label">Global Codes</div>
      </div>
      <div class="stat-box pr-stat--warning">
        <div class="stat-number"><%= @report_data[:summary][:with_capex] + @report_data[:summary][:with_opex] + @report_data[:summary][:with_direct_pr] %></div>
        <div class="stat-label">TPCs with Requests</div>
      </div>
      <div class="stat-box pr-stat--danger">
        <div class="stat-number"><%= @report_data[:summary][:non_budgeted_count] %></div>
        <div class="stat-label">Non-Budgeted PRs</div>
        <div class="stat-label" style="margin-top:4px;font-variant-numeric:tabular-nums;"><%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %> <%= number_with_delimiter(@report_data[:summary][:non_budgeted_value].round(2)) %></div>
      </div>
    </div>
  </div>
</div>

<!-- Usage Analysis -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>TPC Code Usage Analysis</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid">
      <div class="pr-chart-box"><canvas id="usageChart"></canvas></div>
      <div style="display:grid;gap:12px;align-content:start;">
        <div class="pr-usage-card" style="border-left:3px solid var(--pr-warning);">
          <span class="pr-usage-card__icon" style="background:var(--pr-warning);color:var(--pr-ink-invert);">C</span>
          <div class="pr-usage-card__body">
            <div style="font-size: var(--pr-text-md);font-weight:600;color:var(--pr-ink);margin-bottom:3px;">CAPEX Allocations</div>
            <div style="font-size: var(--pr-text-base);color:var(--pr-ink-muted);margin-bottom:3px;"><%= @report_data[:summary][:with_capex] %> TPC codes</div>
            <div style="font-size: var(--pr-text-lg);font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;"><%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %> <%= number_with_delimiter(@report_data[:capex_totals].values.sum.round(2)) %></div>
          </div>
        </div>

        <div class="pr-usage-card" style="border-left:3px solid var(--pr-success);">
          <span class="pr-usage-card__icon" style="background:var(--pr-success);color:var(--pr-ink-invert);">O</span>
          <div class="pr-usage-card__body">
            <div style="font-size: var(--pr-text-md);font-weight:600;color:var(--pr-ink);margin-bottom:3px;">OPEX Allocations</div>
            <div style="font-size: var(--pr-text-base);color:var(--pr-ink-muted);margin-bottom:3px;"><%= @report_data[:summary][:with_opex] %> TPC codes</div>
            <div style="font-size: var(--pr-text-lg);font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;"><%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %> <%= number_with_delimiter(@report_data[:opex_totals].values.sum.round(2)) %></div>
          </div>
        </div>

        <div class="pr-usage-card" style="border-left:3px solid var(--pr-violet);">
          <span class="pr-usage-card__icon" style="background:var(--pr-violet);color:var(--pr-ink-invert);">D</span>
          <div class="pr-usage-card__body">
            <div style="font-size: var(--pr-text-md);font-weight:600;color:var(--pr-ink);margin-bottom:3px;">Direct TPC Assignments</div>
            <div style="font-size: var(--pr-text-base);color:var(--pr-ink-muted);margin-bottom:3px;"><%= @report_data[:summary][:with_direct_pr] %> TPC codes</div>
            <div class="pr-hint">Purchase requests directly linked to TPC codes</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Department Breakdown -->
<% if @report_data[:department_breakdown].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>TPC Codes by Department</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid">
      <div class="pr-chart-box"><canvas id="departmentChart"></canvas></div>
      <div style="display:flex;flex-direction:column;gap:8px;align-content:start;">
        <% @report_data[:department_breakdown].sort_by { |_, count| -count }.each do |dept, count| %>
          <div class="pr-accentblock" style="display:flex;justify-content:space-between;align-items:center;border-left:3px solid var(--pr-violet);">
            <span style="font-weight:500;color:var(--pr-ink);font-size: var(--pr-text-base);"><%= dept %></span>
            <span style="color:var(--pr-ink-muted);font-size: var(--pr-text-base);font-variant-numeric:tabular-nums;"><%= count %> codes</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>

<!-- Top TPC Codes by Purchase Requests -->
<% if @report_data[:tpc_by_purchase_request].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Top TPC Codes by Purchase Requests</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-card-stack">
      <% @report_data[:tpc_by_purchase_request].each_with_index do |tpc, index| %>
        <div class="pr-rank-row">
          <span class="pr-rank-badge" style="background:var(--pr-accent);color:var(--pr-ink-invert);">#<%= index + 1 %></span>
          <div class="pr-fill">
            <div class="tpc-number" style="font-weight:600;color:var(--pr-violet-ink);margin-bottom:2px;"><%= tpc[:tpc_number] %></div>
            <div class="pr-hint"><%= tpc[:department].present? ? tpc[:department] : 'No Department' %> — <%= tpc[:owner] %></div>
          </div>
          <div style="font-size: var(--pr-text-lg);font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;"><%= tpc[:count] %> requests</div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Top TPC Codes by Total Cost -->
<% if @report_data[:tpc_utilization].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Top TPC Codes by Total Cost</h3></div>
  <div class="dashboard-card-body">
    <div class="autoscroll">
      <table class="pr-table">
        <caption class="sr-only">Top TPC codes by total cost</caption>
        <thead>
          <tr>
            <th scope="col">Rank</th>
            <th scope="col">TPC Code</th>
            <th scope="col">TPC Name</th>
            <th scope="col">Department</th>
            <th scope="col">Owner</th>
            <th scope="col">Total Cost</th>
            <th scope="col">Total Requests</th>
            <th scope="col">CAPEX</th>
            <th scope="col">OPEX</th>
            <th scope="col">Direct</th>
          </tr>
        </thead>
        <tbody>
          <% @report_data[:tpc_utilization].each_with_index do |tpc, index| %>
            <tr>
              <td style="font-weight:700;color:var(--pr-accent);">#<%= index + 1 %></td>
              <td class="tpc-code-cell"><strong><%= tpc[:tpc_code] %></strong></td>
              <td><%= tpc[:tpc_name].presence || '-' %></td>
              <td><%= tpc[:department].presence || '-' %></td>
              <td><%= tpc[:owner] %></td>
              <td class="stat-currency">
                <%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %>
                <%= number_with_delimiter(tpc[:total_cost]) %>
              </td>
              <td style="text-align:center;font-weight:500;"><%= tpc[:request_count] %></td>
              <td style="text-align:center;font-weight:500;color:var(--pr-warning-ink);"><%= tpc[:capex_count] %></td>
              <td style="text-align:center;font-weight:500;color:var(--pr-success-ink);"><%= tpc[:opex_count] %></td>
              <td style="text-align:center;font-weight:500;color:var(--pr-violet-ink);"><%= tpc[:direct_count] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% end %>

<!-- Monthly TPC Usage Trend -->
<% if @report_data[:monthly_trend].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>TPC Usage Trend (Last 12 Months)</h3></div>
  <div class="dashboard-card-body">
    <p class="pr-subhead">Purchase requests linked to TPC codes (via direct, CAPEX, or OPEX)</p>
    <div style="height:280px;width:100%;"><canvas id="monthlyTrendChart"></canvas></div>
  </div>
</div>
<% end %>

<!-- Top CAPEX Allocations -->
<% if @report_data[:capex_totals].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Top CAPEX Allocations by TPC Code</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-card-stack">
      <% @report_data[:capex_totals].sort_by { |_, amount| -amount }.first(10).each_with_index do |(tpc_code, amount), index| %>
        <div class="pr-rank-row" style="border-left:3px solid var(--pr-warning);">
          <span class="pr-rank-badge" style="background:var(--pr-warning);color:var(--pr-ink-invert);">#<%= index + 1 %></span>
          <div class="pr-fill">
            <div class="tpc-number" style="font-weight:600;color:var(--pr-violet-ink);margin-bottom:2px;"><%= tpc_code %></div>
            <div class="pr-hint">CAPEX Budget Allocation</div>
          </div>
          <div style="font-size: var(--pr-text-lg);font-weight:700;color:var(--pr-warning-ink);font-variant-numeric:tabular-nums;"><%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %> <%= number_with_delimiter(amount.round(2)) %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Top OPEX Allocations -->
<% if @report_data[:opex_totals].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Top OPEX Allocations by TPC Code</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-card-stack">
      <% @report_data[:opex_totals].sort_by { |_, amount| -amount }.first(10).each_with_index do |(tpc_code, amount), index| %>
        <div class="pr-rank-row" style="border-left:3px solid var(--pr-success);">
          <span class="pr-rank-badge" style="background:var(--pr-success);color:var(--pr-ink-invert);">#<%= index + 1 %></span>
          <div class="pr-fill">
            <div class="tpc-number" style="font-weight:600;color:var(--pr-violet-ink);margin-bottom:2px;"><%= tpc_code %></div>
            <div class="pr-hint">OPEX Budget Allocation</div>
          </div>
          <div style="font-size: var(--pr-text-lg);font-weight:700;color:var(--pr-success-ink);font-variant-numeric:tabular-nums;"><%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %> <%= number_with_delimiter(amount.round(2)) %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Recent TPC Codes -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Recently Added TPC Codes</h3></div>
  <div class="dashboard-card-body">
    <div class="autoscroll">
      <table class="pr-table">
        <caption class="sr-only">Recently added TPC codes</caption>
        <thead>
          <tr>
            <th scope="col">TPC Number</th>
            <th scope="col">Owner Name</th>
            <th scope="col">Department</th>
            <th scope="col">Email</th>
            <th scope="col">Description</th>
            <th scope="col">Scope</th>
            <th scope="col">Status</th>
            <th scope="col">CAPEX</th>
            <th scope="col">OPEX</th>
            <th scope="col">Direct PRs</th>
            <th scope="col">Created</th>
          </tr>
        </thead>
        <tbody>
          <% @report_data[:recent_codes].each do |tpc_code| %>
            <tr>
              <td class="tpc-code-cell"><strong><%= tpc_code.tpc_number %></strong></td>
              <td><%= tpc_code.tpc_owner_name %></td>
              <td><%= tpc_code.department&.name || '-' %></td>
              <td><%= tpc_code.tpc_email %></td>
              <td><%= truncate(tpc_code.description, length: 40) %></td>
              <td>
                <% if tpc_code.project_id? %>
                  <span class="pr-badge pr-badge--violet">Project</span>
                <% else %>
                  <span class="pr-badge pr-badge--accent">Global</span>
                <% end %>
              </td>
              <td>
                <% if tpc_code.is_active? %>
                  <span class="pr-badge pr-badge--success">Active</span>
                <% else %>
                  <span class="pr-badge pr-badge--neutral">Inactive</span>
                <% end %>
              </td>
              <td><%= tpc_code.capex.count %></td>
              <td><%= tpc_code.opex.count %></td>
              <td><%= tpc_code.purchase_requests.count %></td>
              <td><%= tpc_code.created_at.strftime('%Y-%m-%d') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= render 'reports/chart_colors' %>

<% unless @print_mode %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Usage Chart
  const usageCtx = document.getElementById('usageChart').getContext('2d');
  const capexCount = <%= @report_data[:summary][:with_capex] %>;
  const opexCount = <%= @report_data[:summary][:with_opex] %>;
  const directCount = <%= @report_data[:summary][:with_direct_pr] %>;
  const totalUsed = capexCount + opexCount + directCount;
  const unusedCount = <%= @report_data[:summary][:total_count] %> - Math.min(totalUsed, <%= @report_data[:summary][:total_count] %>);

  new Chart(usageCtx, {
    type: 'doughnut',
    data: {
      labels: ['CAPEX Usage', 'OPEX Usage', 'Direct PR', 'Unused'],
      datasets: [{
        data: [capexCount, opexCount, directCount, Math.max(0, unusedCount)],
        backgroundColor: [PR_CHART_COLORS[0], PR_CHART_COLORS[1], PR_CHART_COLORS[2], PR_CHART_NEUTRAL],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            padding: 20,
            usePointStyle: true
          }
        }
      }
    }
  });

  // Department Chart
  <% if @report_data[:department_breakdown].any? %>
  const deptCtx = document.getElementById('departmentChart').getContext('2d');
  const deptData = <%= raw @report_data[:department_breakdown].to_json %>;
  const deptLabels = Object.keys(deptData);
  const deptValues = Object.values(deptData);
  new Chart(deptCtx, {
    type: 'bar',
    data: {
      labels: deptLabels,
      datasets: [{
        label: 'TPC Codes',
        data: deptValues,
        backgroundColor: deptLabels.map(function(_, i) { return PR_CHART_COLORS[i % PR_CHART_COLORS.length]; }),
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            stepSize: 1
          }
        }
      }
    }
  });
  <% end %>

  // Monthly Trend Chart
  <% if @report_data[:monthly_trend].any? %>
  const trendCtx = document.getElementById('monthlyTrendChart').getContext('2d');
  const trendData = <%= raw @report_data[:monthly_trend].map { |date, count| { month: date.strftime('%b %Y'), count: count } }.to_json %>;

  new Chart(trendCtx, {
    type: 'line',
    data: {
      labels: trendData.map(d => d.month),
      datasets: [{
        label: 'TPC-Linked Purchase Requests',
        data: trendData.map(d => d.count),
        borderColor: PR_CHART_COLORS[5],
        backgroundColor: PR_CHART_COLORS[5] + '1a',
        fill: true,
        tension: 0.3,
        pointRadius: 5,
        pointBackgroundColor: PR_CHART_COLORS[5]
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'top'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            stepSize: 1
          }
        }
      }
    }
  });
  <% end %>
});
</script>
<% end %>

<% content_for :header_tags do %>
<style>
  .icon-pdf {
    background-image: url('<%= asset_path("files/pdf.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  .icon-csv-file {
    background-image: url('<%= asset_path("files/text.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  @media (max-width: 768px) {
    #content .pr-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<% end %>
