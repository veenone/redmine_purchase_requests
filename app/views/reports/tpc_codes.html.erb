<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/reports/tpc_codes.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% end %>

<% html_title("TPC Codes Report#{@project ? " - #{@project.name}" : ""}") %>

<% unless @print_mode %>
<div class="contextual">
  <% reports_index_path = @project ? project_reports_path(@project) : reports_path %>
  <%= link_to reports_index_path, class: 'pr-button pr-button-cancel pr-button-icon' do %>
    <span class="icon icon-cancel">Back to Reports</span>
  <% end %>

  <% report_path_base = @project ?
       tpc_codes_project_reports_path(@project) :
       tpc_codes_reports_path %>

  <%= link_to "#{report_path_base}?format=pdf", class: 'pr-button pr-button-primary pr-button-icon', target: '_blank' do %>
    <span class="icon icon-pdf">Export PDF</span>
  <% end %>

  <%= link_to "#{report_path_base}?format=csv", class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-csv-file">Export CSV</span>
  <% end %>
</div>
<% end %>

<h2>
  TPC Codes Report
  <% if @project %>
    <span class="pr-badge pr-badge--violet" style="font-size:13px;vertical-align:middle;margin-left:10px;"><%= @project.name %></span>
  <% end %>
</h2>

<div class="info-box">
  <p><strong>Generated:</strong> <%= @report_data[:generated_at].strftime('%B %d, %Y at %I:%M %p') %></p>
  <p style="margin:0;">
    <% if @project %>
      <strong>Scope:</strong> TPC codes available for <%= @project.name %>
    <% else %>
      <strong>Scope:</strong> All TPC codes across the system
    <% end %>
  </p>
</div>

<!-- Executive Summary -->
<div class="dashboard-card" style="margin-bottom:22px;">
  <div class="dashboard-card-header"><h3>TPC Code Overview</h3></div>
  <div class="dashboard-card-body">
    <div class="summary-stats">
      <div class="stat-box pr-stat--violet">
        <div class="stat-number"><%= @report_data[:summary][:total_count] %></div>
        <div class="stat-label">Total TPC Codes</div>
      </div>
      <div class="stat-box pr-stat--success">
        <div class="stat-number"><%= @report_data[:summary][:active_count] %></div>
        <div class="stat-label">Active Codes</div>
      </div>
      <div class="stat-box pr-stat--danger">
        <div class="stat-number"><%= @report_data[:summary][:inactive_count] %></div>
        <div class="stat-label">Inactive Codes</div>
      </div>
      <div class="stat-box pr-stat--accent">
        <div class="stat-number"><%= @report_data[:summary][:global_count] %></div>
        <div class="stat-label">Global Codes</div>
      </div>
      <div class="stat-box pr-stat--warning">
        <div class="stat-number"><%= @report_data[:summary][:with_capex] + @report_data[:summary][:with_opex] + @report_data[:summary][:with_direct_pr] %></div>
        <div class="stat-label">TPCs with Requests</div>
      </div>
      <div class="stat-box pr-stat--danger">
        <div class="stat-number"><%= @report_data[:summary][:non_budgeted_count] %></div>
        <div class="stat-label">Non-Budgeted PRs</div>
        <div class="stat-label" style="margin-top:4px;font-variant-numeric:tabular-nums;"><%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %> <%= number_with_delimiter(@report_data[:summary][:non_budgeted_value].round(2)) %></div>
      </div>
    </div>
  </div>
</div>

<!-- Usage Analysis -->
<div class="dashboard-card" style="margin-bottom:22px;">
  <div class="dashboard-card-header"><h3>TPC Code Usage Analysis</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid">
      <div style="height:280px;"><canvas id="usageChart"></canvas></div>
      <div style="display:grid;gap:12px;align-content:start;">
        <div style="display:flex;align-items:center;gap:16px;padding:16px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-left:3px solid var(--pr-warning);border-radius:var(--pr-radius-sm);">
          <span style="width:36px;height:36px;border-radius:50%;background:var(--pr-warning);color:var(--pr-ink-invert);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;flex-shrink:0;">C</span>
          <div style="flex:1;min-width:0;">
            <div style="font-size:14px;font-weight:600;color:var(--pr-ink);margin-bottom:3px;">CAPEX Allocations</div>
            <div style="font-size:13px;color:var(--pr-ink-muted);margin-bottom:3px;"><%= @report_data[:summary][:with_capex] %> TPC codes</div>
            <div style="font-size:15px;font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;"><%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %> <%= number_with_delimiter(@report_data[:capex_totals].values.sum.round(2)) %></div>
          </div>
        </div>

        <div style="display:flex;align-items:center;gap:16px;padding:16px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-left:3px solid var(--pr-success);border-radius:var(--pr-radius-sm);">
          <span style="width:36px;height:36px;border-radius:50%;background:var(--pr-success);color:var(--pr-ink-invert);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;flex-shrink:0;">O</span>
          <div style="flex:1;min-width:0;">
            <div style="font-size:14px;font-weight:600;color:var(--pr-ink);margin-bottom:3px;">OPEX Allocations</div>
            <div style="font-size:13px;color:var(--pr-ink-muted);margin-bottom:3px;"><%= @report_data[:summary][:with_opex] %> TPC codes</div>
            <div style="font-size:15px;font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;"><%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %> <%= number_with_delimiter(@report_data[:opex_totals].values.sum.round(2)) %></div>
          </div>
        </div>

        <div style="display:flex;align-items:center;gap:16px;padding:16px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-left:3px solid var(--pr-violet);border-radius:var(--pr-radius-sm);">
          <span style="width:36px;height:36px;border-radius:50%;background:var(--pr-violet);color:var(--pr-ink-invert);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;flex-shrink:0;">D</span>
          <div style="flex:1;min-width:0;">
            <div style="font-size:14px;font-weight:600;color:var(--pr-ink);margin-bottom:3px;">Direct TPC Assignments</div>
            <div style="font-size:13px;color:var(--pr-ink-muted);margin-bottom:3px;"><%= @report_data[:summary][:with_direct_pr] %> TPC codes</div>
            <div style="font-size:12px;color:var(--pr-ink-faint);">Purchase requests directly linked to TPC codes</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Department Breakdown -->
<% if @report_data[:department_breakdown].any? %>
<div class="dashboard-card" style="margin-bottom:22px;">
  <div class="dashboard-card-header"><h3>TPC Codes by Department</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid">
      <div style="height:280px;"><canvas id="departmentChart"></canvas></div>
      <div style="display:flex;flex-direction:column;gap:8px;align-content:start;">
        <% @report_data[:department_breakdown].sort_by { |_, count| -count }.each do |dept, count| %>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 13px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-left:3px solid var(--pr-violet);border-radius:var(--pr-radius-sm);">
            <span style="font-weight:500;color:var(--pr-ink);font-size:13px;"><%= dept %></span>
            <span style="color:var(--pr-ink-muted);font-size:13px;font-variant-numeric:tabular-nums;"><%= count %> codes</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<% end %>

<!-- Top TPC Codes by Purchase Requests -->
<% if @report_data[:tpc_by_purchase_request].any? %>
<div class="dashboard-card" style="margin-bottom:22px;">
  <div class="dashboard-card-header"><h3>Top TPC Codes by Purchase Requests</h3></div>
  <div class="dashboard-card-body">
    <div style="display:grid;gap:10px;">
      <% @report_data[:tpc_by_purchase_request].each_with_index do |tpc, index| %>
        <div style="display:flex;align-items:center;gap:14px;padding:13px 14px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-radius:var(--pr-radius-sm);">
          <span style="background:var(--pr-accent);color:var(--pr-ink-invert);width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;flex-shrink:0;">#<%= index + 1 %></span>
          <div style="flex:1;min-width:0;">
            <div class="tpc-number" style="font-weight:600;color:var(--pr-violet-ink);margin-bottom:2px;"><%= tpc[:tpc_number] %></div>
            <div style="font-size:12px;color:var(--pr-ink-faint);"><%= tpc[:department].present? ? tpc[:department] : 'No Department' %> — <%= tpc[:owner] %></div>
          </div>
          <div style="font-size:16px;font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;"><%= tpc[:count] %> requests</div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Top TPC Codes by Total Cost -->
<% if @report_data[:tpc_utilization].any? %>
<div class="dashboard-card" style="margin-bottom:22px;">
  <div class="dashboard-card-header"><h3>Top TPC Codes by Total Cost</h3></div>
  <div class="dashboard-card-body">
    <div class="autoscroll">
      <table class="pr-table">
        <thead>
          <tr>
            <th>Rank</th>
            <th>TPC Code</th>
            <th>Department</th>
            <th>Owner</th>
            <th>Total Cost</th>
            <th>Total Requests</th>
            <th>CAPEX</th>
            <th>OPEX</th>
            <th>Direct</th>
          </tr>
        </thead>
        <tbody>
          <% @report_data[:tpc_utilization].each_with_index do |tpc, index| %>
            <tr>
              <td style="font-weight:700;color:var(--pr-accent);">#<%= index + 1 %></td>
              <td class="tpc-code-cell"><strong><%= tpc[:tpc_code] %></strong></td>
              <td><%= tpc[:department].presence || '-' %></td>
              <td><%= tpc[:owner] %></td>
              <td class="stat-currency">
                <%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %>
                <%= number_with_delimiter(tpc[:total_cost]) %>
              </td>
              <td style="text-align:center;font-weight:500;"><%= tpc[:request_count] %></td>
              <td style="text-align:center;font-weight:500;color:var(--pr-warning-ink);"><%= tpc[:capex_count] %></td>
              <td style="text-align:center;font-weight:500;color:var(--pr-success-ink);"><%= tpc[:opex_count] %></td>
              <td style="text-align:center;font-weight:500;color:var(--pr-violet-ink);"><%= tpc[:direct_count] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% end %>

<!-- Monthly TPC Usage Trend -->
<% if @report_data[:monthly_trend].any? %>
<div class="dashboard-card" style="margin-bottom:22px;">
  <div class="dashboard-card-header"><h3>TPC Usage Trend (Last 12 Months)</h3></div>
  <div class="dashboard-card-body">
    <p class="pr-subhead">Purchase requests linked to TPC codes (via direct, CAPEX, or OPEX)</p>
    <div style="height:280px;width:100%;"><canvas id="monthlyTrendChart"></canvas></div>
  </div>
</div>
<% end %>

<!-- Top CAPEX Allocations -->
<% if @report_data[:capex_totals].any? %>
<div class="dashboard-card" style="margin-bottom:22px;">
  <div class="dashboard-card-header"><h3>Top CAPEX Allocations by TPC Code</h3></div>
  <div class="dashboard-card-body">
    <div style="display:grid;gap:10px;">
      <% @report_data[:capex_totals].sort_by { |_, amount| -amount }.first(10).each_with_index do |(tpc_code, amount), index| %>
        <div style="display:flex;align-items:center;gap:14px;padding:13px 14px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-left:3px solid var(--pr-warning);border-radius:var(--pr-radius-sm);">
          <span style="background:var(--pr-warning);color:var(--pr-ink-invert);width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;flex-shrink:0;">#<%= index + 1 %></span>
          <div style="flex:1;min-width:0;">
            <div class="tpc-number" style="font-weight:600;color:var(--pr-violet-ink);margin-bottom:2px;"><%= tpc_code %></div>
            <div style="font-size:12px;color:var(--pr-ink-faint);">CAPEX Budget Allocation</div>
          </div>
          <div style="font-size:16px;font-weight:700;color:var(--pr-warning-ink);font-variant-numeric:tabular-nums;"><%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %> <%= number_with_delimiter(amount.round(2)) %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Top OPEX Allocations -->
<% if @report_data[:opex_totals].any? %>
<div class="dashboard-card" style="margin-bottom:22px;">
  <div class="dashboard-card-header"><h3>Top OPEX Allocations by TPC Code</h3></div>
  <div class="dashboard-card-body">
    <div style="display:grid;gap:10px;">
      <% @report_data[:opex_totals].sort_by { |_, amount| -amount }.first(10).each_with_index do |(tpc_code, amount), index| %>
        <div style="display:flex;align-items:center;gap:14px;padding:13px 14px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-left:3px solid var(--pr-success);border-radius:var(--pr-radius-sm);">
          <span style="background:var(--pr-success);color:var(--pr-ink-invert);width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;flex-shrink:0;">#<%= index + 1 %></span>
          <div style="flex:1;min-width:0;">
            <div class="tpc-number" style="font-weight:600;color:var(--pr-violet-ink);margin-bottom:2px;"><%= tpc_code %></div>
            <div style="font-size:12px;color:var(--pr-ink-faint);">OPEX Budget Allocation</div>
          </div>
          <div style="font-size:16px;font-weight:700;color:var(--pr-success-ink);font-variant-numeric:tabular-nums;"><%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %> <%= number_with_delimiter(amount.round(2)) %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Recent TPC Codes -->
<div class="dashboard-card" style="margin-bottom:22px;">
  <div class="dashboard-card-header"><h3>Recently Added TPC Codes</h3></div>
  <div class="dashboard-card-body">
    <div class="autoscroll">
      <table class="pr-table">
        <thead>
          <tr>
            <th>TPC Number</th>
            <th>Owner Name</th>
            <th>Department</th>
            <th>Email</th>
            <th>Description</th>
            <th>Scope</th>
            <th>Status</th>
            <th>CAPEX</th>
            <th>OPEX</th>
            <th>Direct PRs</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          <% @report_data[:recent_codes].each do |tpc_code| %>
            <tr>
              <td class="tpc-code-cell"><strong><%= tpc_code.tpc_number %></strong></td>
              <td><%= tpc_code.tpc_owner_name %></td>
              <td><%= tpc_code.department.presence || '-' %></td>
              <td><%= tpc_code.tpc_email %></td>
              <td><%= truncate(tpc_code.description, length: 40) %></td>
              <td>
                <% if tpc_code.project_id? %>
                  <span class="pr-badge pr-badge--violet">Project</span>
                <% else %>
                  <span class="pr-badge pr-badge--accent">Global</span>
                <% end %>
              </td>
              <td>
                <% if tpc_code.is_active? %>
                  <span class="pr-badge pr-badge--success">Active</span>
                <% else %>
                  <span class="pr-badge pr-badge--neutral">Inactive</span>
                <% end %>
              </td>
              <td><%= tpc_code.capex.count %></td>
              <td><%= tpc_code.opex.count %></td>
              <td><%= tpc_code.purchase_requests.count %></td>
              <td><%= tpc_code.created_at.strftime('%Y-%m-%d') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% unless @print_mode %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Usage Chart
  const usageCtx = document.getElementById('usageChart').getContext('2d');
  const capexCount = <%= @report_data[:summary][:with_capex] %>;
  const opexCount = <%= @report_data[:summary][:with_opex] %>;
  const directCount = <%= @report_data[:summary][:with_direct_pr] %>;
  const totalUsed = capexCount + opexCount + directCount;
  const unusedCount = <%= @report_data[:summary][:total_count] %> - Math.min(totalUsed, <%= @report_data[:summary][:total_count] %>);

  new Chart(usageCtx, {
    type: 'doughnut',
    data: {
      labels: ['CAPEX Usage', 'OPEX Usage', 'Direct PR', 'Unused'],
      datasets: [{
        data: [capexCount, opexCount, directCount, Math.max(0, unusedCount)],
        backgroundColor: ['#FF9800', '#4CAF50', '#2196F3', '#9E9E9E'],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            padding: 20,
            usePointStyle: true
          }
        }
      }
    }
  });

  // Department Chart
  <% if @report_data[:department_breakdown].any? %>
  const deptCtx = document.getElementById('departmentChart').getContext('2d');
  const deptData = <%= raw @report_data[:department_breakdown].to_json %>;
  const deptLabels = Object.keys(deptData);
  const deptValues = Object.values(deptData);
  const deptColors = ['#6f42c1', '#2196F3', '#4CAF50', '#FF9800', '#F44336', '#00BCD4', '#FFEB3B', '#9C27B0', '#795548', '#607D8B'];

  new Chart(deptCtx, {
    type: 'bar',
    data: {
      labels: deptLabels,
      datasets: [{
        label: 'TPC Codes',
        data: deptValues,
        backgroundColor: deptColors.slice(0, deptLabels.length),
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            stepSize: 1
          }
        }
      }
    }
  });
  <% end %>

  // Monthly Trend Chart
  <% if @report_data[:monthly_trend].any? %>
  const trendCtx = document.getElementById('monthlyTrendChart').getContext('2d');
  const trendData = <%= raw @report_data[:monthly_trend].map { |date, count| { month: date.strftime('%b %Y'), count: count } }.to_json %>;

  new Chart(trendCtx, {
    type: 'line',
    data: {
      labels: trendData.map(d => d.month),
      datasets: [{
        label: 'TPC-Linked Purchase Requests',
        data: trendData.map(d => d.count),
        borderColor: '#6f42c1',
        backgroundColor: 'rgba(111, 66, 193, 0.1)',
        fill: true,
        tension: 0.3,
        pointRadius: 5,
        pointBackgroundColor: '#6f42c1'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'top'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            stepSize: 1
          }
        }
      }
    }
  });
  <% end %>
});
</script>
<% end %>

<% content_for :header_tags do %>
<style>
  .icon-pdf {
    background-image: url('<%= asset_path("files/pdf.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  .icon-csv-file {
    background-image: url('<%= asset_path("files/text.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  @media (max-width: 768px) {
    #content .pr-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<% end %>
