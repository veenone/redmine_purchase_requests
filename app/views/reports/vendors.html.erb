<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/reports/vendors.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<% end %>

<% html_title("Vendors Report#{@project ? " - #{@project.name}" : ""}") %>

<% unless @print_mode %>
<div class="contextual">
  <% reports_index_path = @project ? project_reports_path(@project) : reports_path %>
  <%= link_to reports_index_path, class: 'pr-button pr-button-cancel pr-button-icon' do %>
    <span class="icon icon-cancel">Back to Reports</span>
  <% end %>

  <% report_path_base = @project ?
       vendors_project_reports_path(@project) :
       vendors_reports_path %>

  <%= render 'export_actions', report_path_base: report_path_base %>
</div>
<% end %>

<h2>
  Vendors Report<%= report_year_suffix %>
  <% if @project %>
    <span class="pr-badge pr-badge--info" style="font-size:13px;vertical-align:middle;margin-left:10px;"><%= @project.name %></span>
  <% end %>
</h2>

<% unless @print_mode %>
<%= render 'year_filter', filter_path: report_path_base %>
<% end %>

<div class="info-box">
  <p><strong>Generated:</strong> <%= @report_data[:generated_at].strftime('%B %d, %Y at %I:%M %p') %></p>
  <p style="margin:0;">
    <% if @project %>
      <strong>Scope:</strong> Vendors available for <%= @project.name %> (including global vendors)
    <% else %>
      <strong>Scope:</strong> All vendors across the system
    <% end %>
  </p>
</div>

<!-- Executive Summary -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Vendor Overview</h3></div>
  <div class="dashboard-card-body">
    <div class="summary-stats">
      <div class="stat-box pr-stat--accent">
        <div class="stat-number"><%= @report_data[:summary][:total_count] %></div>
        <div class="stat-label">Total Vendors</div>
      </div>
      <div class="stat-box pr-stat--success">
        <div class="stat-number"><%= @report_data[:summary][:active_count] %></div>
        <div class="stat-label">Active Vendors</div>
      </div>
      <div class="stat-box pr-stat--danger">
        <div class="stat-number"><%= @report_data[:summary][:inactive_count] %></div>
        <div class="stat-label">Inactive Vendors</div>
      </div>
      <div class="stat-box pr-stat--violet">
        <div class="stat-number"><%= @report_data[:summary][:global_count] %></div>
        <div class="stat-label">Global Vendors</div>
      </div>
      <div class="stat-box pr-stat--accent">
        <div class="stat-number"><%= @report_data[:summary][:vendors_with_requests] %></div>
        <div class="stat-label">With Purchase Requests</div>
      </div>
      <div class="stat-box pr-stat--warning">
        <div class="stat-number"><%= @report_data[:summary][:vendors_without_requests] %></div>
        <div class="stat-label">Without Requests</div>
      </div>
    </div>
  </div>
</div>

<!-- Vendor Activity -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Top Active Vendors</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid" style="margin-bottom:18px;">
      <div>
        <p style="text-align:center;font-size:13px;font-weight:600;color:var(--pr-ink-muted);margin:0 0 10px;">By Purchase Request Count</p>
        <div style="height:280px;"><canvas id="vendorActivityChart"></canvas></div>
      </div>
      <div>
        <p style="text-align:center;font-size:13px;font-weight:600;color:var(--pr-ink-muted);margin:0 0 10px;">By Total Value</p>
        <div style="height:280px;"><canvas id="vendorValueChart"></canvas></div>
      </div>
    </div>

    <div style="display:grid;gap:8px;margin-top:8px;">
      <% @report_data[:vendor_activity].first(10).each_with_index do |(vendor_info, count), index| %>
        <div class="pr-rank-row" style="gap:13px;padding:11px 13px;">
          <span class="pr-rank-badge" style="background:var(--pr-accent);color:var(--pr-ink-invert);">#<%= index + 1 %></span>
          <div style="flex:1;min-width:0;">
            <div style="font-weight:600;color:var(--pr-ink);font-size:13px;margin-bottom:2px;"><%= vendor_info[1] %></div>
            <div style="font-size:12px;color:var(--pr-ink-muted);"><%= count %> purchase requests</div>
          </div>
          <div style="width:90px;height:8px;background:var(--pr-surface-sunken);border-radius:var(--pr-radius-pill);overflow:hidden;flex-shrink:0;">
            <% max_count = @report_data[:vendor_activity].first&.last || 1 %>
            <div style="height:100%;background:var(--pr-accent);border-radius:var(--pr-radius-pill);width:<%= count > 0 ? [(count.to_f / max_count * 100), 100].min.round(1) : 0 %>%;"></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Vendor Status & Engagement Analysis -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Vendor Status &amp; Engagement Analysis</h3></div>
  <div class="dashboard-card-body">
    <div class="pr-grid" style="margin-bottom:18px;">
      <div style="height:280px;"><canvas id="statusChart"></canvas></div>
      <div style="height:280px;"><canvas id="engagementChart"></canvas></div>
    </div>

    <div class="summary-stats" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));">
      <div class="pr-accentblock" style="border-left:3px solid var(--pr-success);">
        <div style="font-size:13px;color:var(--pr-ink-muted);margin-bottom:5px;">Active Vendors</div>
        <div style="font-size:22px;font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;margin-bottom:3px;"><%= @report_data[:summary][:active_count] %></div>
        <div style="font-size:12px;color:var(--pr-accent);font-weight:500;">
          <%= @report_data[:summary][:total_count] > 0 ?
                "#{((@report_data[:summary][:active_count].to_f / @report_data[:summary][:total_count]) * 100).round(1)}%" :
                "0%" %>
        </div>
      </div>

      <div class="pr-accentblock" style="border-left:3px solid var(--pr-ink-faint);">
        <div style="font-size:13px;color:var(--pr-ink-muted);margin-bottom:5px;">Inactive Vendors</div>
        <div style="font-size:22px;font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;margin-bottom:3px;"><%= @report_data[:summary][:inactive_count] %></div>
        <div style="font-size:12px;color:var(--pr-accent);font-weight:500;">
          <%= @report_data[:summary][:total_count] > 0 ?
                "#{((@report_data[:summary][:inactive_count].to_f / @report_data[:summary][:total_count]) * 100).round(1)}%" :
                "0%" %>
        </div>
      </div>

      <div class="pr-accentblock" style="border-left:3px solid var(--pr-accent);">
        <div style="font-size:13px;color:var(--pr-ink-muted);margin-bottom:5px;">With Purchase Requests</div>
        <div style="font-size:22px;font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;margin-bottom:3px;"><%= @report_data[:summary][:vendors_with_requests] %></div>
        <div style="font-size:12px;color:var(--pr-accent);font-weight:500;">
          <%= @report_data[:summary][:total_count] > 0 ?
                "#{((@report_data[:summary][:vendors_with_requests].to_f / @report_data[:summary][:total_count]) * 100).round(1)}%" :
                "0%" %>
        </div>
      </div>

      <div class="pr-accentblock" style="border-left:3px solid var(--pr-warning);">
        <div style="font-size:13px;color:var(--pr-ink-muted);margin-bottom:5px;">Without Requests</div>
        <div style="font-size:22px;font-weight:700;color:var(--pr-ink);font-variant-numeric:tabular-nums;margin-bottom:3px;"><%= @report_data[:summary][:vendors_without_requests] %></div>
        <div style="font-size:12px;color:var(--pr-accent);font-weight:500;">
          <%= @report_data[:summary][:total_count] > 0 ?
                "#{((@report_data[:summary][:vendors_without_requests].to_f / @report_data[:summary][:total_count]) * 100).round(1)}%" :
                "0%" %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Monthly Trends -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Monthly Trends</h3></div>
  <div class="dashboard-card-body">
    <div style="height:280px;"><canvas id="monthlyTrendChart"></canvas></div>
  </div>
</div>

<!-- Project Distribution (Global View Only) -->
<% if @project.nil? && @report_data[:project_distribution] && @report_data[:project_distribution].any? %>
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Project-Specific Vendor Distribution</h3></div>
  <div class="dashboard-card-body">
    <div style="height:280px;max-width:800px;margin:0 auto 18px;"><canvas id="projectDistributionChart"></canvas></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin-top:8px;">
      <% @report_data[:project_distribution].each do |project, count| %>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:var(--pr-surface-subtle);border:1px solid var(--pr-border);border-radius:var(--pr-radius-sm);">
          <span style="font-weight:500;color:var(--pr-ink);font-size:13px;"><%= project %></span>
          <span style="color:var(--pr-ink-muted);font-size:13px;font-variant-numeric:tabular-nums;"><%= count %> vendors</span>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Recent Vendors -->
<div class="dashboard-card pr-card--gap">
  <div class="dashboard-card-header"><h3>Recently Added Vendors</h3></div>
  <div class="dashboard-card-body">
    <div class="autoscroll">
      <table class="pr-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Vendor ID</th>
            <th>Contact</th>
            <th>Scope</th>
            <th>Status</th>
            <th>Requests</th>
            <th>Added</th>
          </tr>
        </thead>
        <tbody>
          <% @report_data[:recent_vendors].each do |vendor| %>
            <tr>
              <td><strong><%= vendor.name %></strong></td>
              <td><%= vendor.vendor_id %></td>
              <td>
                <% if vendor.contact_person.present? %>
                  <%= vendor.contact_person %>
                  <% if vendor.email.present? %>
                    <br><small style="color:var(--pr-ink-faint);"><%= vendor.email %></small>
                  <% end %>
                <% elsif vendor.email.present? %>
                  <%= vendor.email %>
                <% else %>
                  -
                <% end %>
              </td>
              <td>
                <% if vendor.project_id? %>
                  <span class="pr-badge pr-badge--warning">Project</span>
                <% else %>
                  <span class="pr-badge pr-badge--accent">Global</span>
                <% end %>
              </td>
              <td>
                <% if vendor.is_active? %>
                  <span class="pr-badge pr-badge--success">Active</span>
                <% else %>
                  <span class="pr-badge pr-badge--neutral">Inactive</span>
                <% end %>
              </td>
              <td><%= vendor.purchase_requests.count %></td>
              <td><%= vendor.created_at.strftime('%Y-%m-%d') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= render 'reports/chart_colors' %>

<% unless @print_mode %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Chart.js default configuration
  Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, sans-serif';

  // Top Active Vendors Chart (horizontal bar)
  const activityData = <%= raw @report_data[:vendor_activity].first(10).map { |info, count| { name: info[1], count: count } }.to_json %>;
  const activityCtx = document.getElementById('vendorActivityChart').getContext('2d');

  new Chart(activityCtx, {
    type: 'bar',
    data: {
      labels: activityData.map(item => item.name),
      datasets: [{
        label: 'Purchase Requests',
        data: activityData.map(item => item.count),
        backgroundColor: PR_CHART_COLORS[0] + 'b3',
        borderColor: PR_CHART_COLORS[0],
        borderWidth: 1
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Purchase Requests by Vendor'
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Number of Requests'
          }
        }
      }
    }
  });

  // Vendor by Value Chart
  <% if @report_data[:vendor_by_value] && @report_data[:vendor_by_value].any? %>
  const valueData = <%= raw @report_data[:vendor_by_value].map { |info, value| { name: info[1], value: value.to_f } }.to_json %>;
  const valueCtx = document.getElementById('vendorValueChart').getContext('2d');

  new Chart(valueCtx, {
    type: 'bar',
    data: {
      labels: valueData.map(item => item.name),
      datasets: [{
        label: 'Total Value',
        data: valueData.map(item => item.value),
        backgroundColor: PR_CHART_COLORS[1] + 'b3',
        borderColor: PR_CHART_COLORS[1],
        borderWidth: 1
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Total Purchase Value by Vendor'
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Total Value'
          },
          ticks: {
            callback: function(value) {
              return value.toLocaleString();
            }
          }
        }
      }
    }
  });
  <% end %>

  // Status Chart (Doughnut - Active vs Inactive)
  const statusCtx = document.getElementById('statusChart').getContext('2d');
  new Chart(statusCtx, {
    type: 'doughnut',
    data: {
      labels: ['Active', 'Inactive'],
      datasets: [{
        data: [<%= @report_data[:summary][:active_count] %>, <%= @report_data[:summary][:inactive_count] %>],
        backgroundColor: [PR_CHART_COLORS[1], PR_CHART_NEUTRAL],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Vendor Status Distribution'
        }
      }
    }
  });

  // Engagement Chart (Doughnut - With/Without Requests)
  const engagementCtx = document.getElementById('engagementChart').getContext('2d');
  new Chart(engagementCtx, {
    type: 'doughnut',
    data: {
      labels: ['With Requests', 'Without Requests'],
      datasets: [{
        data: [<%= @report_data[:summary][:vendors_with_requests] %>, <%= @report_data[:summary][:vendors_without_requests] %>],
        backgroundColor: [PR_CHART_COLORS[4], PR_CHART_COLORS[2]],
        borderWidth: 2,
        borderColor: '#fff'
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        },
        title: {
          display: true,
          text: 'Vendor Engagement'
        }
      }
    }
  });

  // Monthly Trend Chart (Line - dual dataset)
  const trendCtx = document.getElementById('monthlyTrendChart').getContext('2d');
  new Chart(trendCtx, {
    type: 'line',
    data: {
      labels: <%= raw @report_data[:monthly_vendor_trend].keys.to_json %>,
      datasets: [
        {
          label: 'New Vendors Added',
          data: <%= raw @report_data[:monthly_vendor_trend].values.to_json %>,
          borderColor: PR_CHART_COLORS[0],
          backgroundColor: PR_CHART_COLORS[0] + '1a',
          fill: true,
          tension: 0.3
        },
        {
          label: 'Purchase Requests with Vendors',
          data: <%= raw @report_data[:monthly_pr_trend].values.to_json %>,
          borderColor: PR_CHART_COLORS[3],
          backgroundColor: PR_CHART_COLORS[3] + '1a',
          fill: true,
          tension: 0.3
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'top'
        },
        title: {
          display: true,
          text: 'Monthly Vendor & Engagement Trends (Last 12 Months)'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Count'
          }
        }
      }
    }
  });

  <% if @project.nil? && @report_data[:project_distribution] && @report_data[:project_distribution].any? %>
  // Project Distribution Chart
  const projDistCtx = document.getElementById('projectDistributionChart').getContext('2d');
  new Chart(projDistCtx, {
    type: 'bar',
    data: {
      labels: <%= raw @report_data[:project_distribution].keys.to_json %>,
      datasets: [{
        label: 'Project-Specific Vendors',
        data: <%= raw @report_data[:project_distribution].values.to_json %>,
        backgroundColor: PR_CHART_COLORS[5] + 'b3',
        borderColor: PR_CHART_COLORS[5],
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          display: false
        },
        title: {
          display: true,
          text: 'Vendors by Project'
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          title: {
            display: true,
            text: 'Number of Vendors'
          }
        }
      }
    }
  });
  <% end %>
});
</script>
<% end %>

<% content_for :header_tags do %>
<style>
  .icon-pdf {
    background-image: url('<%= asset_path("files/pdf.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  .icon-csv-file {
    background-image: url('<%= asset_path("files/text.png") %>');
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position: 0 50%;
    padding-left: 20px;
  }

  @media (max-width: 992px) {
    #content .pr-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
<% end %>
