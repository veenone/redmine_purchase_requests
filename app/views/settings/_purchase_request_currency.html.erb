<%# app/views/settings/_purchase_request_currency.html.erb %>
<div class="box tabular settings">
  <div class="pr-settings-header">
    <h3><%= l(:label_currency_settings) %></h3>
  </div>

  <!-- Default Currency Section -->
  <div class="dashboard-card" style="margin-bottom: 18px;">
    <div class="dashboard-card-header">
      <h3>Default Currency</h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead">Select the primary currency for your purchase requests</p>
      <div class="form-row">
        <p>
          <label class="pr-settings-label"><%= l(:label_default_currency) %></label>
          <%
            currency_options = [
              ['US Dollar ($)', 'USD'],
              ['Euro (€)', 'EUR'],
              ['British Pound (£)', 'GBP'],
              ['Japanese Yen (¥)', 'JPY'],
              ['Canadian Dollar (C$)', 'CAD'],
              ['Australian Dollar (A$)', 'AUD'],
              ['Swiss Franc (CHF)', 'CHF'],
              ['Chinese Yuan (¥)', 'CNY'],
              ['Swedish Krona (kr)', 'SEK'],
              ['New Zealand Dollar (NZ$)', 'NZD'],
              ['Mexican Peso (Mex$)', 'MXN'],
              ['Singapore Dollar (S$)', 'SGD'],
              ['Hong Kong Dollar (HK$)', 'HKD'],
              ['Indonesian Rupiah (Rp)', 'IDR'],
              ['Norwegian Krone (kr)', 'NOK'],
              ['South Korean Won (₩)', 'KRW'],
              ['Turkish Lira (₺)', 'TRY'],
              ['Russian Ruble (₽)', 'RUB'],
              ['Indian Rupee (₹)', 'INR'],
              ['Brazilian Real (R$)', 'BRL'],
              ['South African Rand (R)', 'ZAR']
            ]
            current_currency = @settings['default_currency'].to_s || 'USD'
          %>
          <%= select_tag 'settings[default_currency]',
                        options_for_select(currency_options, current_currency),
                        class: 'form-control',
                        id: 'settings_default_currency',
                        style: 'max-width: 300px;' %>
        </p>
      </div>
    </div>
  </div>

  <!-- Enabled Currencies Section -->
  <div class="dashboard-card" style="margin-bottom: 18px;">
    <div class="dashboard-card-header">
      <h3>Enabled Currencies</h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead">Choose which currencies are available for purchase requests</p>

      <% all_currencies = [
        ['US Dollar ($)', 'USD'],
        ['Euro (€)', 'EUR'],
        ['British Pound (£)', 'GBP'],
        ['Japanese Yen (¥)', 'JPY'],
        ['Canadian Dollar (C$)', 'CAD'],
        ['Australian Dollar (A$)', 'AUD'],
        ['Swiss Franc (CHF)', 'CHF'],
        ['Chinese Yuan (¥)', 'CNY'],
        ['Swedish Krona (kr)', 'SEK'],
        ['New Zealand Dollar (NZ$)', 'NZD'],
        ['Mexican Peso (Mex$)', 'MXN'],
        ['Singapore Dollar (S$)', 'SGD'],
        ['Hong Kong Dollar (HK$)', 'HKD'],
        ['Indonesian Rupiah (Rp)', 'IDR'],
        ['Norwegian Krone (kr)', 'NOK'],
        ['South Korean Won (₩)', 'KRW'],
        ['Turkish Lira (₺)', 'TRY'],
        ['Russian Ruble (₽)', 'RUB'],
        ['Indian Rupee (₹)', 'INR'],
        ['Brazilian Real (R$)', 'BRL'],
        ['South African Rand (R)', 'ZAR']
      ] %>

      <% enabled_currencies = @settings['enabled_currencies'].is_a?(Array) ? @settings['enabled_currencies'] : (@settings['enabled_currencies'] ? @settings['enabled_currencies'].split(',') : ['USD']) %>

      <div style="max-height: 400px; overflow-y: auto; border: 1px solid var(--pr-border); border-radius: var(--pr-radius);">
        <table class="pr-table" style="margin: 0;">
          <thead>
            <tr>
              <th scope="col" style="width: 55%;"><%= l(:field_currency) %></th>
              <th scope="col" style="width: 25%;">Code</th>
              <th scope="col" style="width: 20%; text-align: center;">
                <span class="select-all-toggle" title="Toggle All" style="cursor: pointer; color: var(--pr-accent);">Enabled</span>
              </th>
            </tr>
          </thead>
          <tbody>
            <% all_currencies.each_with_index do |(currency_name, currency_code), index| %>
              <tr class="currency-row">
                <td>
                  <span style="font-weight: 500; color: var(--pr-ink);">
                    <label for="currency_<%= currency_code %>" style="cursor: pointer; margin: 0; font-weight: 500;">
                      <%= currency_name %>
                    </label>
                  </span>
                </td>
                <td>
                  <span class="pr-badge pr-badge--neutral pr-mono"><%= currency_code %></span>
                </td>
                <td style="text-align: center;">
                  <%= check_box_tag "settings[enabled_currencies][]", currency_code,
                                  enabled_currencies.include?(currency_code),
                                  id: "currency_#{currency_code}",
                                  class: 'currency-checkbox' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= hidden_field_tag "settings[enabled_currencies][]", "" %>
    </div>
  </div>

  <!-- Exchange Rates Section -->
  <div class="dashboard-card" style="margin-bottom: 18px;">
    <div class="dashboard-card-header">
      <h3>Exchange Rates</h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead">Configure currency conversion rates</p>

      <div class="form-row">
        <p>
          <label>
            <%= check_box_tag 'settings[show_exchange_rates]', '1', @settings['show_exchange_rates'] == '1',
                              id: 'show_exchange_rates' %>
            <%= l(:label_show_exchange_rates) %>
          </label>
          <em class="info"><%= l(:text_show_exchange_rates_info) rescue 'Enable this option to configure exchange rates for multi-currency support' %></em>
        </p>
      </div>

      <div id="exchange_rates_section">
        <div class="pr-alert pr-alert-info" style="margin-bottom: 16px;">
          <span class="icon icon-info"></span>
          <%= l(:text_exchange_rates_setup_info) rescue 'Configure exchange rates for currency conversion. Enter the rate to convert to your default currency.' %>
        </div>

        <%
          default_currency = @settings['default_currency'] || 'USD'
          exchange_rates = @settings['exchange_rates'].is_a?(Hash) ? @settings['exchange_rates'] : {}
          enabled_currencies = @settings['enabled_currencies'].is_a?(Array) ? @settings['enabled_currencies'] : (@settings['enabled_currencies'] ? @settings['enabled_currencies'].split(',') : ['USD'])
        %>

        <table class="pr-table">
          <thead>
            <tr>
              <th scope="col" style="width: 20%;"><%= l(:field_currency) %></th>
              <th scope="col" style="width: 40%;"><%= l(:label_rate_to) %> <span class="pr-badge pr-badge--accent pr-mono"><%= default_currency %></span></th>
              <th scope="col" style="width: 40%;"><%= l(:field_description) %></th>
            </tr>
          </thead>
          <tbody>
            <% enabled_currencies.each do |currency| %>
              <% next if currency == default_currency %>
              <tr class="rate-row">
                <td>
                  <span class="pr-badge pr-badge--neutral pr-mono"><%= currency %></span>
                </td>
                <td>
                  <span style="display: inline-flex; align-items: center; gap: 6px;">
                    <span style="color: var(--pr-ink-faint); font-size: var(--pr-text-sm);">1 <%= currency %> =</span>
                    <%= text_field_tag "settings[exchange_rate_#{currency}]",
                                   exchange_rates[currency].to_s,
                                   class: 'form-control exchange-rate-input',
                                   placeholder: '1.0',
                                   step: '0.0001',
                                   style: 'width: 100px; display: inline-block; margin: 0 4px;' %>
                    <span style="color: var(--pr-ink-faint); font-size: var(--pr-text-sm);"><%= default_currency %></span>
                  </span>
                </td>
                <td>
                  <span class="example-text pr-capex-example">
                    100 <%= currency %> = <%= (100.0 / (exchange_rates[currency].to_f > 0 ? exchange_rates[currency].to_f : 1.0)).round(2) %> <%= default_currency %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <div class="pr-alert pr-alert-warning" style="margin-top: 12px;">
          <span class="icon icon-warning"></span>
          <%= l(:text_exchange_rates_note) rescue 'Exchange rates should be updated regularly. Ensure they are accurate for financial reporting.' %>
        </div>
      </div>
    </div>
  </div>
</div>


<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', function() {
    // Get the default currency select element
    var defaultCurrencySelect = document.getElementById('settings_default_currency');
    if (defaultCurrencySelect) {
      // Make the default currency always checked
      defaultCurrencySelect.addEventListener('change', function() {
        var selectedCurrency = this.value;
        var checkbox = document.getElementById('currency_' + selectedCurrency);
        if (checkbox) {
          checkbox.checked = true;
        }
      });

      // Initially make sure default currency is checked
      var defaultCurrency = defaultCurrencySelect.value;
      var defaultCheckbox = document.getElementById('currency_' + defaultCurrency);
      if (defaultCheckbox) {
        defaultCheckbox.checked = true;
      }
    }

    // Toggle all checkboxes
    var selectAllToggle = document.querySelector('.select-all-toggle');
    if (selectAllToggle) {
      selectAllToggle.addEventListener('click', function() {
        var checkboxes = document.querySelectorAll('.currency-checkbox');
        var allChecked = true;

        checkboxes.forEach(function(cb) {
          if (!cb.checked) {
            allChecked = false;
          }
        });

        checkboxes.forEach(function(cb) {
          cb.checked = !allChecked;
        });

        // Ensure default currency is always checked
        if (defaultCurrencySelect) {
          var defaultCurrency = defaultCurrencySelect.value;
          var defaultCheckbox = document.getElementById('currency_' + defaultCurrency);
          if (defaultCheckbox) {
            defaultCheckbox.checked = true;
          }
        }
      });
    }

    // Show/hide exchange rates section
    var showExchangeRatesCheckbox = document.getElementById('show_exchange_rates');
    var exchangeRatesSection = document.getElementById('exchange_rates_section');

    if (showExchangeRatesCheckbox && exchangeRatesSection) {
      function toggleExchangeRatesSection() {
        if (showExchangeRatesCheckbox.checked) {
          exchangeRatesSection.style.display = 'block';
        } else {
          exchangeRatesSection.style.display = 'none';
        }
      }

      // Initial state
      toggleExchangeRatesSection();

      // Toggle on change
      showExchangeRatesCheckbox.addEventListener('change', toggleExchangeRatesSection);
    }

    // Auto-update exchange rate examples
    var exchangeRateInputs = document.querySelectorAll('.exchange-rate-input');
    exchangeRateInputs.forEach(function(input) {
      input.addEventListener('input', function() {
        var rate = parseFloat(this.value) || 1.0;
        var currency = this.name.replace('settings[exchange_rate_', '').replace(']', '');
        var exampleSpan = this.closest('tr').querySelector('.example-text');
        if (exampleSpan) {
          var defaultCurrency = document.getElementById('settings_default_currency').value;
          var convertedAmount = (100.0 / rate).toFixed(2);
          exampleSpan.textContent = '100 ' + currency + ' = ' + convertedAmount + ' ' + defaultCurrency;
        }
      });
    });
  });
</script>
