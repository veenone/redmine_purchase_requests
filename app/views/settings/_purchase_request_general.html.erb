<%# app/views/settings/_purchase_request_general.html.erb %>
<div class="box tabular settings">
  <div class="pr-settings-header">
    <h3><%= l(:label_general_settings) %></h3>
  </div>

  <!-- Default Status Section -->
  <div class="dashboard-card pr-block-gap">
    <div class="dashboard-card-header">
      <h3><%= l(:label_default_status) %></h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead"><%= l(:text_default_status_description) || 'Select the default status for new purchase requests' %></p>
      <div class="form-row">
        <p>
          <label class="pr-settings-label"><%= l(:label_default_status) %></label>
          <%= select_tag 'settings[default_status_id]',
                        options_from_collection_for_select(PurchaseRequestStatus.sorted, :id, :name, @settings['default_status_id'].to_i),
                        include_blank: true,
                        class: 'form-control',
                        id: 'settings_default_status_id',
                        style: 'max-width: 300px;' %>
        </p>
      </div>
    </div>
  </div>

  <!-- Maximum Purchase Amount Section -->
  <div class="dashboard-card pr-block-gap">
    <div class="dashboard-card-header">
      <h3><%= l(:label_max_purchase_amount) %></h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead"><%= l(:text_max_purchase_amount_description) %></p>
      <div class="form-row">
        <p>
          <label class="pr-settings-label" for="settings_max_purchase_amount"><%= l(:label_max_purchase_amount) %></label>
          <%= text_field_tag 'settings[max_purchase_amount]',
                            @settings['max_purchase_amount'] || '9999999999999.99',
                            size: 20,
                            class: 'form-control',
                            id: 'settings_max_purchase_amount',
                            style: 'max-width: 300px;' %>
          <em class="info"><%= l(:text_max_purchase_amount_help) %></em>
        </p>
      </div>
    </div>
  </div>

  <!-- Notification Settings Section -->
  <div class="dashboard-card pr-block-gap">
    <div class="dashboard-card-header">
      <h3><%= l(:label_notifications) %></h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead"><%= l(:text_notification_settings_description) || 'Configure notification settings for purchase requests' %></p>
      <div class="form-row">
        <p>
          <label>
            <%= check_box_tag 'settings[enable_notifications]', '1', @settings['enable_notifications'] == '1',
                              id: 'enable_notifications' %>
            <%= l(:label_enable_notifications) %>
          </label>
          <em class="info"><%= l(:text_notification_help) || 'Enable email notifications for purchase request status changes' %></em>
        </p>
      </div>
    </div>
  </div>

  <!-- Default Assignment Section -->
  <div class="dashboard-card pr-block-gap">
    <div class="dashboard-card-header">
      <h3><%= l(:label_default_assignment) %></h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead"><%= l(:text_default_assignment_description) || 'Select the default user for purchase request assignments' %></p>
      <div class="form-row">
        <p>
          <label class="pr-settings-label"><%= l(:label_default_assigned_to) %></label>
          <%= select_tag 'settings[default_assigned_to_id]',
                        options_from_collection_for_select(User.active, :id, :name, @settings['default_assigned_to_id'].to_i),
                        include_blank: true,
                        class: 'form-control',
                        id: 'settings_default_assigned_to_id',
                        style: 'max-width: 300px;' %>
        </p>
      </div>
    </div>
  </div>

  <!-- Global Menu Visibility Section -->
  <div class="dashboard-card pr-block-gap">
    <div class="dashboard-card-header">
      <h3><%= l(:label_global_menu_settings) %></h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead"><%= l(:text_global_menu_settings_description) %></p>

      <div class="form-row">
        <p>
          <label>
            <%= check_box_tag 'settings[global_tpc_menu_enabled]', '1', @settings['global_tpc_menu_enabled'] == '1',
                              id: 'global_tpc_menu_enabled' %>
            <%= l(:label_global_tpc_menu_enabled) %>
          </label>
          <em class="info"><%= l(:text_global_tpc_menu_enabled_info) %></em>
        </p>
      </div>

      <div class="form-row">
        <p>
          <label>
            <%= check_box_tag 'settings[global_tpc_dashboard_menu_enabled]', '1', @settings['global_tpc_dashboard_menu_enabled'] == '1',
                              id: 'global_tpc_dashboard_menu_enabled' %>
            <%= l(:label_global_tpc_dashboard_menu_enabled) %>
          </label>
          <em class="info"><%= l(:text_global_tpc_dashboard_menu_enabled_info) %></em>
        </p>
      </div>

      <div class="form-row">
        <p>
          <label>
            <%= check_box_tag 'settings[global_vendor_menu_enabled]', '1', @settings['global_vendor_menu_enabled'] == '1',
                              id: 'global_vendor_menu_enabled' %>
            <%= l(:label_global_vendor_menu_enabled) %>
          </label>
          <em class="info"><%= l(:text_global_vendor_menu_enabled_info) %></em>
        </p>
      </div>

      <div class="form-row">
        <p>
          <label>
            <%= check_box_tag 'settings[global_reports_menu_enabled]', '1', @settings['global_reports_menu_enabled'] == '1',
                              id: 'global_reports_menu_enabled' %>
            <%= l(:label_global_reports_menu_enabled) %>
          </label>
          <em class="info"><%= l(:text_global_reports_menu_enabled_info) %></em>
        </p>
      </div>
    </div>
  </div>
</div>

