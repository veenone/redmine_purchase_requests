<%# OPEX Category Management Tab for Plugin Settings %>
<div class="box tabular settings">
  <div class="pr-settings-header">
    <h3><%= l(:label_opex_category_settings, default: 'OPEX Category Settings') %></h3>
    <div class="contextual">
      <%= link_to '/opex_categories',
          class: 'pr-button pr-button-secondary pr-button-icon',
          target: '_blank', rel: 'noopener noreferrer',
          title: 'Manage OPEX Categories' do %>
        <span class="icon icon-edit"><%= l(:label_manage_opex_categories, default: 'Manage OPEX Categories') %></span>
      <% end %>
    </div>
  </div>

  <!-- Category Overview Section -->
  <div class="dashboard-card" style="margin-bottom: 18px;">
    <div class="dashboard-card-header">
      <h3>Category Overview</h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead">View and manage your OPEX categories for expense classification</p>

      <div class="pr-alert pr-alert-info" style="margin-bottom: 16px;">
        <span class="icon icon-info"></span>
        <%= l(:text_opex_categories_managed_separately, default: 'OPEX categories are managed independently from plugin settings.') %>
        Use the "Manage OPEX Categories" button to add, edit, or remove categories.
      </div>

      <table class="pr-table" id="opex-categories-table">
        <thead>
          <tr>
            <th style="width: 50%;"><%= l(:field_opex_category_name, default: 'Category Name') %></th>
            <th style="width: 25%;"><%= l(:label_created_on, default: 'Created') %></th>
            <th style="width: 25%;">Status</th>
          </tr>
        </thead>
        <tbody>
          <% if OpexCategory.respond_to?(:all) && OpexCategory.all.any? %>
            <% OpexCategory.all.each do |category| %>
              <tr>
                <td style="font-weight: 500; color: var(--pr-ink);"><%= category.name %></td>
                <td>
                  <% if category.respond_to?(:created_at) && category.created_at %>
                    <span class="pr-badge pr-badge--neutral pr-mono" style="font-size: var(--pr-text-xs);"><%= category.created_at.strftime('%Y-%m-%d') %></span>
                  <% else %>
                    <span class="pr-badge pr-badge--neutral" style="font-size: var(--pr-text-xs);">Unknown</span>
                  <% end %>
                </td>
                <td>
                  <span class="pr-badge pr-badge--success">Active</span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="3">
                <div class="pr-empty">
                  <div class="pr-empty__icon">📁</div>
                  <h3>No Categories Found</h3>
                  <p><%= l(:text_no_opex_categories, default: 'No OPEX categories have been created yet.') %></p>
                  <%= link_to '/opex_categories',
                      class: 'pr-button pr-button-primary pr-button-icon',
                      target: '_blank', rel: 'noopener noreferrer' do %>
                    <span class="icon icon-add"></span> Create First Category
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Category Management Information Section -->
  <div class="dashboard-card" style="margin-bottom: 18px;">
    <div class="dashboard-card-header">
      <h3>Category Management</h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead">Information about managing your OPEX categories</p>

      <div class="pr-grid pr-grid--narrow" style="margin-bottom: 18px;">
        <div class="dashboard-card">
          <div class="dashboard-card-body">
            <span class="icon icon-add" style="color: var(--pr-accent);"></span>
            <strong style="display: block; margin: 6px 0 4px; color: var(--pr-ink);">Add Categories</strong>
            <span style="color: var(--pr-ink-muted); font-size: var(--pr-text-base);">Create new OPEX categories to classify your operational expenses effectively.</span>
          </div>
        </div>

        <div class="dashboard-card">
          <div class="dashboard-card-body">
            <span class="icon icon-edit" style="color: var(--pr-warning);"></span>
            <strong style="display: block; margin: 6px 0 4px; color: var(--pr-ink);">Edit Categories</strong>
            <span style="color: var(--pr-ink-muted); font-size: var(--pr-text-base);">Modify existing category names and properties as your business needs evolve.</span>
          </div>
        </div>

        <div class="dashboard-card">
          <div class="dashboard-card-body">
            <span class="icon icon-del" style="color: var(--pr-danger);"></span>
            <strong style="display: block; margin: 6px 0 4px; color: var(--pr-ink);">Remove Categories</strong>
            <span style="color: var(--pr-ink-muted); font-size: var(--pr-text-base);">Delete unused categories while preserving historical expense data.</span>
          </div>
        </div>
      </div>

      <div class="dashboard-card">
        <div class="dashboard-card-header">
          <h3>Current Categories Summary</h3>
        </div>
        <div class="dashboard-card-body">
          <% if OpexCategory.respond_to?(:all) && OpexCategory.all.any? %>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 14px;">
              <span class="pr-badge pr-badge--accent" style="font-size: var(--pr-text-md); padding: 6px 12px;"><%= OpexCategory.all.count %></span>
              <span style="color: var(--pr-ink-muted); font-size: var(--pr-text-base);">categories defined</span>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              <% OpexCategory.all.each do |category| %>
                <span class="pr-badge pr-badge--neutral" style="padding: 6px 12px; font-size: var(--pr-text-base);">📁 <%= category.name %></span>
              <% end %>
            </div>
          <% else %>
            <div class="pr-empty">
              <div class="pr-empty__icon">📋</div>
              <h3>No categories defined</h3>
              <p>Get started by creating your first OPEX category.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions Section -->
  <div class="dashboard-card" style="margin-bottom: 18px;">
    <div class="dashboard-card-header">
      <h3>Quick Actions</h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead">Common tasks for OPEX category management</p>

      <div class="pr-form-actions left-aligned" style="border-top: none; padding-top: 0; margin-top: 0;">
        <%= link_to '/opex_categories',
            class: 'pr-button pr-button-primary pr-button-icon',
            target: '_blank', rel: 'noopener noreferrer' do %>
          <span class="icon icon-edit">Manage All Categories</span>
        <% end %>

        <%= link_to '/opex_categories/new',
            class: 'pr-button pr-button-secondary pr-button-icon',
            target: '_blank', rel: 'noopener noreferrer' do %>
          <span class="icon icon-add">Add New Category</span>
        <% end %>
      </div>

      <div class="pr-alert pr-alert-warning" style="margin-top: 14px;">
        <span class="icon icon-help"></span>
        <strong>Need Help?</strong> OPEX categories help organize operational expenses like utilities, rent, and maintenance.
        Well-defined categories improve expense tracking and financial reporting accuracy.
      </div>
    </div>
  </div>
</div>

