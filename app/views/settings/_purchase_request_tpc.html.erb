<%# TPC Configuration Settings %>
<div class="pr-settings-header">
  <h3><%= l(:label_tpc_settings, default: 'TPC Code Settings') %></h3>
</div>

<div class="pr-grid pr-grid--narrow" style="margin-bottom: 22px;">

  <!-- Global TPC Codes Setting -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_tpc_global_enabled) %></h3>
    </div>
    <div class="dashboard-card-body">
      <div class="form-row">
        <p>
          <label>
            <%= check_box_tag 'settings[tpc_global_enabled]', '1',
                             settings['tpc_global_enabled'] == '1',
                             { id: 'settings_tpc_global_enabled' } %>
            <%= l(:text_tpc_global_enabled_description) %>
          </label>
        </p>
      </div>
      <div class="pr-alert pr-alert-info">
        <span class="icon icon-info"></span>
        <%= l(:text_tpc_global_enabled_help) %>
      </div>
    </div>
  </div>

  <!-- Auto-link TPC Codes Setting -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_tpc_auto_link) %></h3>
    </div>
    <div class="dashboard-card-body">
      <div class="form-row">
        <p>
          <label>
            <%= check_box_tag 'settings[tpc_auto_link]', '1',
                             settings['tpc_auto_link'] == '1',
                             { id: 'settings_tpc_auto_link' } %>
            <%= l(:text_tpc_auto_link_description) %>
          </label>
        </p>
      </div>
      <div class="pr-alert pr-alert-info">
        <span class="icon icon-info"></span>
        <%= l(:text_tpc_auto_link_help) %>
      </div>
    </div>
  </div>

  <!-- Require TPC for CAPEX Setting -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_tpc_require_for_capex) %></h3>
    </div>
    <div class="dashboard-card-body">
      <div class="form-row">
        <p>
          <label>
            <%= check_box_tag 'settings[tpc_require_for_capex]', '1',
                             settings['tpc_require_for_capex'] == '1',
                             { id: 'settings_tpc_require_for_capex' } %>
            <%= l(:text_tpc_require_for_capex_description) %>
          </label>
        </p>
      </div>
      <div class="pr-alert pr-alert-info">
        <span class="icon icon-info"></span>
        <%= l(:text_tpc_require_for_capex_help) %>
      </div>
    </div>
  </div>

  <!-- Require TPC for OPEX Setting -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_tpc_require_for_opex) %></h3>
    </div>
    <div class="dashboard-card-body">
      <div class="form-row">
        <p>
          <label>
            <%= check_box_tag 'settings[tpc_require_for_opex]', '1',
                             settings['tpc_require_for_opex'] == '1',
                             { id: 'settings_tpc_require_for_opex' } %>
            <%= l(:text_tpc_require_for_opex_description) %>
          </label>
        </p>
      </div>
      <div class="pr-alert pr-alert-info">
        <span class="icon icon-info"></span>
        <%= l(:text_tpc_require_for_opex_help) %>
      </div>
    </div>
  </div>

</div>

<!-- TPC Management Overview -->
<div class="dashboard-card" style="background: var(--pr-accent); border-color: var(--pr-accent-hover);">
  <div class="dashboard-card-body" style="background: var(--pr-accent);">
    <h3 style="margin: 0 0 10px; color: var(--pr-ink-invert); font-size: 15px; font-weight: 700;">
      <span class="icon icon-projects" style="margin-right: 6px;"></span>
      <%= l(:label_tpc_management_overview) %>
    </h3>
    <p style="margin: 0 0 16px; color: rgba(255,255,255,0.92); line-height: 1.55; font-size: 13px;">
      <%= l(:text_tpc_management_description) %>
    </p>
    <div>
      <% if User.current.admin? || User.current.allowed_to?(:manage_purchase_requests, nil, global: true) %>
        <%= link_to global_tpc_codes_path, target: '_blank',
            style: 'display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; background: rgba(255,255,255,0.18); color: #fff; text-decoration: none; border-radius: var(--pr-radius-sm); font-size: 13px; font-weight: 600; border: 1px solid rgba(255,255,255,0.30); transition: background .15s;',
            onmouseover: "this.style.background='rgba(255,255,255,0.28)'",
            onmouseout: "this.style.background='rgba(255,255,255,0.18)'" do %>
          <span class="icon icon-projects"></span>
          <%= l(:label_manage_global_tpc_codes) %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

