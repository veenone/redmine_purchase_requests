<%# app/views/settings/_purchase_request_vendors.html.erb %>
<div class="box tabular settings">
  <div class="pr-settings-header">
    <h3><%= l(:label_vendor_settings) %></h3>
  </div>

  <!-- Vendor Configuration Section -->
  <div class="dashboard-card" style="margin-bottom: 18px;">
    <div class="dashboard-card-header">
      <h3><%= l(:label_vendor_configuration) %></h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead"><%= l(:text_vendor_settings_description) rescue 'Configure vendor management options for purchase requests' %></p>

      <div class="form-row">
        <p>
          <label>
            <%= check_box_tag 'settings[allow_custom_vendors]', '1',
                              @settings['allow_custom_vendors'] == '1',
                              id: 'allow_custom_vendors' %>
            <%= l(:label_allow_custom_vendors) %>
          </label>
          <em class="info"><%= l(:text_allow_custom_vendors_info) %></em>
        </p>
      </div>
    </div>
  </div>

  <!-- Vendor Management Section -->
  <div class="dashboard-card" style="margin-bottom: 18px;">
    <div class="dashboard-card-header">
      <h3><%= l(:label_vendor_management) rescue 'Vendor Management' %></h3>
    </div>
    <div class="dashboard-card-body">
      <p class="pr-subhead"><%= l(:text_vendor_database_info) %></p>

      <div class="pr-form-actions left-aligned" style="border-top: none; padding-top: 0; margin-top: 0;">
        <%= link_to vendors_path, class: 'pr-button pr-button-secondary pr-button-icon' do %>
          <span class="icon icon-edit"><%= l(:label_global_vendor_settings) %></span>
        <% end %>
      </div>

      <% if Setting.plugin_redmine_purchase_requests['vendors'].is_a?(Array) && Setting.plugin_redmine_purchase_requests['vendors'].any? %>
        <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--pr-border);">
          <div class="pr-alert pr-alert-warning" style="margin-bottom: 14px;">
            <span class="icon icon-info"></span>
            <strong><%= l(:label_notice) %>:</strong> <%= l(:text_vendor_management_moved_to_project) %>
          </div>

          <%= form_tag({controller: 'vendors', action: 'migrate_from_settings'}, {method: :post}) do %>
            <%= button_tag type: 'submit', class: 'pr-button pr-button-primary pr-button-icon' do %>
              <span class="icon icon-import"><%= l(:button_migrate_vendors) rescue 'Migrate Vendors' %></span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  .pr-settings-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--pr-border);
  }
  .pr-settings-header h3 {
    margin: 0;
    color: var(--pr-ink);
    font-size: 1.2em;
    font-weight: 700;
  }
</style>
