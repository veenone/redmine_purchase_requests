<div class="pr-settings-header">
  <h3><%= l(:label_workflow_settings, default: 'Issue Workflow Settings') %></h3>
</div>

<div class="info-box pr-block-gap">
  <%= l(:text_workflow_description, default: 'Link purchase requests with Redmine issues to track workflow progress. Each purchase request can have a parent issue with configurable subtasks.') %>
</div>

<!-- General Settings -->
<div class="dashboard-card pr-block-gap">
  <div class="dashboard-card-header">
    <h3><%= l(:label_workflow_general, default: 'General Settings') %></h3>
  </div>
  <div class="dashboard-card-body">

    <div class="form-row">
      <p>
        <label>
          <%= hidden_field_tag 'settings[workflow_enabled]', '0' %>
          <%= check_box_tag 'settings[workflow_enabled]', '1',
              @settings['workflow_enabled'] == '1',
              id: 'settings_workflow_enabled' %>
          <%= l(:label_enable_workflow, default: 'Enable issue workflow for purchase requests') %>
        </label>
      </p>
    </div>

    <div class="form-row">
      <p>
        <label>
          <%= hidden_field_tag 'settings[workflow_auto_create]', '0' %>
          <%= check_box_tag 'settings[workflow_auto_create]', '1',
              @settings['workflow_auto_create'] == '1',
              id: 'settings_workflow_auto_create' %>
          <%= l(:label_auto_create_issues, default: 'Automatically create issues when a new purchase request is created') %>
        </label>
      </p>
    </div>

    <div class="form-row">
      <p>
        <label>
          <%= hidden_field_tag 'settings[workflow_sync_status]', '0' %>
          <%= check_box_tag 'settings[workflow_sync_status]', '1',
              @settings['workflow_sync_status'] == '1',
              id: 'settings_workflow_sync_status' %>
          <%= l(:label_sync_issue_status, default: 'Sync purchase request status when issue is closed') %>
        </label>
        <em class="info"><%= l(:hint_sync_issue_status, default: 'When enabled, closing the linked issue will automatically close the purchase request') %></em>
      </p>
    </div>
  </div>
</div>

<!-- Tracker Settings -->
<div class="dashboard-card pr-block-gap">
  <div class="dashboard-card-header">
    <h3><%= l(:label_tracker_settings, default: 'Tracker Settings') %></h3>
  </div>
  <div class="dashboard-card-body">

    <div class="form-row">
      <p>
        <label for="settings_workflow_tracker_id" class="pr-settings-label">
          <%= l(:label_main_issue_tracker, default: 'Main Issue Tracker') %>
        </label>
        <%= select_tag 'settings[workflow_tracker_id]',
            options_from_collection_for_select(Tracker.sorted, :id, :name, @settings['workflow_tracker_id'].to_i),
            include_blank: true,
            id: 'settings_workflow_tracker_id',
            class: 'form-control',
            style: 'max-width: 300px;' %>
        <em class="info"><%= l(:hint_main_tracker, default: 'Tracker used for the main purchase request issue') %></em>
      </p>
    </div>

    <div class="form-row">
      <p>
        <label for="settings_workflow_subtask_tracker_id" class="pr-settings-label">
          <%= l(:label_subtask_tracker, default: 'Subtask Tracker') %>
        </label>
        <%= select_tag 'settings[workflow_subtask_tracker_id]',
            options_from_collection_for_select(Tracker.sorted, :id, :name, @settings['workflow_subtask_tracker_id'].to_i),
            include_blank: l(:label_same_as_main, default: '-- Same as main tracker --'),
            id: 'settings_workflow_subtask_tracker_id',
            class: 'form-control',
            style: 'max-width: 300px;' %>
        <em class="info"><%= l(:hint_subtask_tracker, default: 'Tracker used for workflow subtasks (defaults to main tracker if not specified)') %></em>
      </p>
    </div>
  </div>
</div>

<!-- Workflow Templates -->
<div class="dashboard-card pr-block-gap">
  <div class="dashboard-card-header">
    <h3><%= l(:label_workflow_templates, default: 'Workflow Subtask Templates') %></h3>
  </div>
  <div class="dashboard-card-body">

    <div class="info-box" style="margin-bottom: 14px;">
      <%= l(:text_workflow_templates_description, default: 'Define the subtasks that will be created for each purchase request. These represent the workflow steps.') %>
    </div>

    <div id="workflow-templates-container">
      <div class="autoscroll">
        <table class="pr-table">
          <thead>
            <tr>
              <th scope="col"><%= l(:field_position, default: 'Order') %></th>
              <th scope="col"><%= l(:field_name, default: 'Name') %></th>
              <th scope="col"><%= l(:field_description, default: 'Description') %></th>
              <th scope="col"><%= l(:field_tracker, default: 'Tracker') %></th>
              <th scope="col"><%= l(:field_active, default: 'Active') %></th>
              <th scope="col"><%= l(:label_auto_create, default: 'Auto Create') %></th>
              <th scope="col"><%= l(:label_actions, default: 'Actions') %></th>
            </tr>
          </thead>
          <tbody id="workflow-templates-list">
            <% templates = PurchaseRequestWorkflowTemplate.sorted rescue [] %>
            <% if templates.any? %>
              <% templates.each do |template| %>
                <tr class="workflow-template-row" data-id="<%= template.id %>">
                  <td>
                    <span class="pr-badge pr-badge--neutral"><%= template.position %></span>
                  </td>
                  <td style="font-weight: 500; color: var(--pr-ink);"><%= template.name %></td>
                  <td style="color: var(--pr-ink-muted); font-size: var(--pr-text-sm);"><%= truncate(template.description, length: 50) %></td>
                  <td style="color: var(--pr-ink-muted);"><%= template.tracker&.name || l(:label_default, default: 'Default') %></td>
                  <td>
                    <% if template.is_active? %>
                      <span class="pr-badge pr-badge--success"><%= l(:general_text_Yes, default: 'Yes') %></span>
                    <% else %>
                      <span class="pr-badge pr-badge--neutral"><%= l(:general_text_No, default: 'No') %></span>
                    <% end %>
                  </td>
                  <td>
                    <% if template.auto_create? %>
                      <span class="pr-badge pr-badge--info"><%= l(:general_text_Yes, default: 'Yes') %></span>
                    <% else %>
                      <span class="pr-badge pr-badge--neutral"><%= l(:general_text_No, default: 'No') %></span>
                    <% end %>
                  </td>
                  <td>
                    <div class="pr-table-actions">
                      <%= link_to l(:button_edit, default: 'Edit'),
                          edit_purchase_request_workflow_template_path(template),
                          class: 'pr-button pr-button-secondary pr-button-icon small',
                          remote: true %>
                      <%= link_to l(:button_delete, default: 'Delete'),
                          purchase_request_workflow_template_path(template),
                          method: :delete,
                          data: { confirm: l(:text_are_you_sure, default: 'Are you sure?') },
                          class: 'pr-button pr-button-danger pr-button-icon small' %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 30px 20px; color: var(--pr-ink-faint); font-style: italic;">
                  <%= l(:label_no_workflow_templates, default: 'No workflow templates defined. Click "Add Template" to create one or "Create Defaults" to add standard templates.') %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="pr-form-actions left-aligned" style="margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--pr-border);">
      <%= link_to l(:button_add_template, default: 'Add Template'),
          new_purchase_request_workflow_template_path,
          class: 'pr-button pr-button-primary pr-button-icon',
          remote: true %>

      <%= link_to l(:button_create_defaults, default: 'Create Default Templates'),
          create_defaults_purchase_request_workflow_templates_path,
          method: :post,
          data: { confirm: l(:text_create_default_templates_confirm, default: 'This will create the default workflow templates (Vendor Registration, PR Creation, PO Creation, Payment Finalization). Continue?') },
          class: 'pr-button pr-button-secondary pr-button-icon' %>
    </div>
  </div>
</div>

