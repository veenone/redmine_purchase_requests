<%#
  Shared per-group card grid used by both the CAPEX (TPC code) and OPEX
  (category) dashboards. CAPEX and OPEX differ only in the grouping key and
  how its card title is rendered (CAPEX wraps the TPC code in a
  <span class="tpc-number">; OPEX renders the plain category name), so those
  two bits are passed as locals rather than forking the whole partial.

  Locals:
    grouping  - Hash of group_key => figures hash with keys :mixed_currency,
                :entries_count, :total_budget, :total_utilized,
                :utilization_percentage, :budget_undefined, :currency_symbol
                (CAPEX: @tpc_grouping; OPEX: @category_grouping)
    heading   - localized heading shown above the card grid
    title_for - lambda/proc taking a group_key and returning the markup (or
                plain string — either is fine, both get run through `<%=`)
                for the card's <h3>
    show_all_path - dashboard URL carrying all_groups=1. Optional, but a
                caller that omits it gets an UNCAPPED grid rather than a
                silently truncated one: hiding groups with no way to reveal
                them is the worse failure, and a missing local must fail in
                the safe direction.
%>
<% if grouping && grouping.any? %>
  <%
    # The grid answers "which lines are at risk", and that is answered by the
    # first screenful. A year with dozens of groups turned the answer into a
    # scroll — 60 cards at a 420px minimum before the entries table even
    # starts. Sorted worst-first, so the cap keeps the part that matters.
    can_show_all = defined?(show_all_path) && show_all_path.present?
    cap    = (params[:all_groups].present? || !can_show_all) ? grouping.size : 12
    shown  = grouping.first(cap)
    hidden = grouping.size - shown.size
  %>
  <div class="details-section">
    <h4><%= heading %></h4>
    <div class="dashboard-container">
      <% shown.each do |group_key, data| %>
        <div class="dashboard-card">
          <div class="dashboard-card-header">
            <h3>
              <%# A card is the answer to "which line is at risk"; linking it is
                  the only way to then ask "on what". Callers that have no
                  filtered view to point at return nil and the title stays text. %>
              <% href = defined?(link_for) && link_for ? link_for.call(group_key, data) : nil %>
              <% if href %><%= link_to title_for.call(group_key), href %><% else %><%= title_for.call(group_key) %><% end %>
              <%# Budget-less spend is checked first and named differently.
                  Its ratio is undefined, not 100% — calling it "over budget by"
                  would imply a budget it could be over. %>
              <% if data[:budget_undefined] %>
                <span class="pr-badge pr-badge--danger"><%= l(:label_no_budget_set) %></span>
              <% elsif data[:utilization_percentage].to_f >= 100 %>
                <span class="pr-badge pr-badge--danger"><%= l(:label_over_budget_by) %></span>
              <% end %>
            </h3>
          </div>
          <div class="dashboard-card-body">
            <div class="summary-stats" style="margin-bottom:12px;">
              <div class="stat-box pr-stat--accent">
                <div class="stat-number stat-currency" style="font-size: var(--pr-text-lg);">
                  <%= data[:currency_symbol] %><%= number_with_precision(data[:total_budget], precision: 2, delimiter: ',') %>
                </div>
                <div class="stat-label"><%= l(:label_total_budget) %></div>
              </div>
              <div class="stat-box pr-stat--success">
                <div class="stat-number stat-currency" style="font-size: var(--pr-text-lg);">
                  <%= data[:currency_symbol] %><%= number_with_precision(data[:total_utilized], precision: 2, delimiter: ',') %>
                  <% if data[:mixed_currency] %><span class="pr-badge pr-badge--warning"><%= l(:label_multi_currency) %></span><% end %>
                </div>
                <div class="stat-label"><%= l(:label_utilized) %></div>
              </div>
              <div class="stat-box">
                <div class="stat-number" style="font-size: var(--pr-text-lg);"><%= data[:entries_count] %></div>
                <div class="stat-label"><%= l(:label_entries) %></div>
              </div>
            </div>
            <div class="utilization-bar">
              <div class="utilization-fill <%= data[:budget_undefined] || data[:utilization_percentage].to_f >= 100 ? 'high' : (data[:utilization_percentage].to_f >= 80 ? 'medium' : 'low') %>" style="width: <%= data[:budget_undefined] ? 100 : [data[:utilization_percentage].to_f, 100].min %>%"></div>
            </div>
            <div style="text-align:center;margin-top:8px;font-size: var(--pr-text-base);color:var(--pr-ink-muted);">
              <% if data[:budget_undefined] %>
                <%# No denominator, so no percentage to print. Saying "0%"
                    here is what made budget-less spend the greenest card on
                    the page. %>
                <span class="stat-currency--over"><%= l(:label_no_budget_set) %></span>
              <% else %>
                <%# The bar is clamped so it cannot overflow its track, so the
                    figure beside it carries the real magnitude — otherwise 101%
                    and 300% render identically. %>
                <%= content_tag :span, "#{data[:utilization_percentage]}%",
                      class: (data[:utilization_percentage].to_f >= 100 ? 'stat-currency--over' : nil) %>
                <%= l(:label_utilization) %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <% if hidden > 0 %>
      <p class="pr-grouping-more">
        <%= link_to l(:label_show_all_groups, count: grouping.size), show_all_path %>
        <span class="pr-grouping-more__note"><%= l(:label_groups_hidden, count: hidden) %></span>
      </p>
    <% end %>
  </div>
<% end %>
