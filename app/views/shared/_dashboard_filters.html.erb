<%#
  Shared dashboard filter bar for CAPEX / OPEX / Purchase Requests / TPC
  dashboards, index views and reports.

  Path-agnostic: submits to request.path via GET and builds facet-removal links
  from request.query_parameters, so it works on every route that renders it.

  Locals:
    year_mode             - :fixed (fixed range, year always set), :list (nullable + "All Years"),
                            or :none (omit the year facet entirely, for views without a year concept)
    selected_year         - currently selected year value        (omit when year_mode is :none)
    available_years       - array of years to offer              (omit when year_mode is :none)
    available_tpc_codes   - relation/array of TpcCode for the dropdown (responds to display_name/tpc_number/id)
    selected_tpc_code_ids - array of currently selected TPC ids (strings); [] when unfiltered
%>
<%
  qp = request.query_parameters
  year_mode             = local_assigns.fetch(:year_mode, :none)
  selected_year         = local_assigns[:selected_year]
  available_years       = local_assigns[:available_years] || []
  show_year             = year_mode != :none
  selected_tpc_code_ids = Array(local_assigns[:selected_tpc_code_ids]).map(&:to_s)

  strip = ->(key) {
    remaining = qp.except(key.to_s)
    remaining.empty? ? request.path : "#{request.path}?#{remaining.to_query}"
  }

  # Removes a single TPC from the selection, keeping the others applied.
  strip_tpc = ->(id) {
    remaining_ids = selected_tpc_code_ids - [id.to_s]
    rest = qp.except('tpc_code_id')
    rest = rest.merge('tpc_code_id' => remaining_ids) if remaining_ids.any?
    rest.empty? ? request.path : "#{request.path}?#{rest.to_query}"
  }

  year_active   = (show_year && year_mode == :list && selected_year.present?)
  tpc_active    = selected_tpc_code_ids.any?
  selected_tpcs = tpc_active ? available_tpc_codes.select { |t| selected_tpc_code_ids.include?(t.id.to_s) } : []
  any_active    = year_active || tpc_active
%>
<%= form_tag request.path, method: :get, class: 'pr-filters-form' do %>
  <fieldset class="pr-filters">
    <legend>Filters</legend>
    <div class="filter-row">
      <% if show_year %>
        <label for="df_year">Year</label>
        <% if year_mode == :list %>
          <%= select_tag 'year',
                         options_for_select([['All Years', '']] + available_years.map { |y| [y.to_s, y.to_s] }, selected_year),
                         id: 'df_year' %>
        <% else %>
          <%= select_tag 'year',
                         options_for_select(available_years.map { |y| [y, y] }, selected_year),
                         id: 'df_year' %>
        <% end %>
      <% end %>

      <%= render 'shared/tpc_filter_field', available_tpc_codes: available_tpc_codes, selected_tpc_code_ids: selected_tpc_code_ids %>

      <%= submit_tag 'Apply', class: 'pr-button pr-button-primary', name: nil %>
      <% if any_active %>
        <%= link_to 'Clear', request.path, class: 'pr-button pr-button-secondary' %>
      <% end %>
    </div>

    <% if any_active %>
      <div class="pr-filter-chips">
        <% if year_active %>
          <span class="pr-badge pr-badge--accent">Year: <%= selected_year %><%= link_to '×', strip.call('year'), class: 'pr-chip-remove', title: 'Remove year filter' %></span>
        <% end %>
        <% selected_tpcs.each do |tpc| %>
          <span class="pr-badge pr-badge--accent" title="<%= tpc.display_name %>">TPC: <%= tpc.tpc_number %><%= link_to '×', strip_tpc.call(tpc.id), class: 'pr-chip-remove', title: "Remove #{tpc.tpc_number} filter" %></span>
        <% end %>
        <% if tpc_active && selected_tpcs.size < selected_tpc_code_ids.size %>
          <%# ids that are filtered but not in available_tpc_codes (inactive or out of project scope) %>
          <span class="pr-badge pr-badge--neutral" title="<%= l(:text_tpc_filter_unavailable, default: 'Some selected TPC codes are not in the current list') %>">TPC: +<%= selected_tpc_code_ids.size - selected_tpcs.size %><%= link_to '×', strip.call('tpc_code_id'), class: 'pr-chip-remove', title: 'Remove TPC filter' %></span>
        <% end %>
      </div>
    <% end %>
  </fieldset>
<% end %>
