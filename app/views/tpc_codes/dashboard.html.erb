<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title @project ? "#{@project.name} - TPC Codes Dashboard" : "TPC Codes Dashboard" %>

<div class="contextual">
  <% if @project %>
    <%= link_to project_tpc_codes_path(@project), class: 'pr-button pr-button-secondary pr-button-icon' do %>
      <span class="icon icon-list">View TPC Codes</span>
    <% end %>
    <% if User.current.allowed_to?(:manage_tpc_codes, @project) %>
      <%= link_to new_project_tpc_code_path(@project), class: 'pr-button pr-button-primary pr-button-icon' do %>
        <span class="icon icon-add">New TPC Code</span>
      <% end %>
    <% end %>
  <% else %>
    <%= link_to global_tpc_codes_path, class: 'pr-button pr-button-secondary pr-button-icon' do %>
      <span class="icon icon-list">View All TPC Codes</span>
    <% end %>
    <%= link_to new_global_tpc_codes_path, class: 'pr-button pr-button-primary pr-button-icon' do %>
      <span class="icon icon-add">New TPC Code</span>
    <% end %>
  <% end %>
</div>

<h2><%= @project ? "#{@project.name} - TPC Codes Dashboard" : "TPC Codes Dashboard" %></h2>

<%# Dashboard filters (shared partial) %>
<%= render 'shared/dashboard_filters',
      year_mode: :list,
      selected_year: @selected_year,
      available_years: @available_years,
      available_tpc_codes: @available_tpc_codes,
      selected_tpc_code_ids: selected_tpc_code_ids %>

<%# Summary stat tiles %>
<div class="summary-stats">
  <div class="stat-box pr-stat--success">
    <div class="stat-number"><%= @active_tpcs %></div>
    <div class="stat-label">Active TPC Codes</div>
  </div>

  <div class="stat-box pr-stat--warning">
    <div class="stat-number"><%= @inactive_tpcs %></div>
    <div class="stat-label">Inactive TPC Codes</div>
  </div>

  <div class="stat-box pr-stat--accent">
    <div class="stat-number"><%= @tpc_by_purchase_request.count %></div>
    <div class="stat-label">TPCs with Requests</div>
  </div>

  <div class="stat-box pr-stat--violet">
    <div class="stat-number"><%= @tpc_by_department.count %></div>
    <div class="stat-label">Departments</div>
  </div>
</div>

<%# Charts grid %>
<div class="dashboard-container">

  <%# Top TPC Codes by Purchase Requests %>
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3>Top TPC Codes by Purchase Requests<%= @selected_year ? " (#{@selected_year})" : "" %></h3>
    </div>
    <div class="dashboard-card-body">
      <% if @tpc_by_purchase_request.any? %>
        <div class="chart-hbar-container" id="tpc-by-pr-chart"></div>
      <% else %>
        <p class="no-data">No purchase requests with TPC codes</p>
      <% end %>
    </div>
  </div>

  <%# TPC Codes by Department %>
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3>TPC Codes by Department</h3>
    </div>
    <div class="dashboard-card-body">
      <% if @tpc_by_department.any? %>
        <div class="chart-hbar-container" id="tpc-by-department-chart"></div>
      <% else %>
        <p class="no-data">No departments assigned</p>
      <% end %>
    </div>
  </div>

  <%# Top 10 TPC Codes by Cost — full width %>
  <div class="dashboard-card" style="grid-column: 1 / -1;">
    <div class="dashboard-card-header">
      <h3>Top 10 TPC Codes by Total Cost<%= @selected_year ? " (#{@selected_year})" : "" %></h3>
    </div>
    <div class="dashboard-card-body">
      <% if @tpc_utilization.any? %>
        <div class="autoscroll">
          <table class="dashboard-table">
            <caption class="sr-only">Top TPC codes by total cost</caption>
            <thead>
              <tr>
                <th scope="col">TPC Code</th>
                <th scope="col">TPC Name</th>
                <th scope="col">Department</th>
                <th scope="col">Owner</th>
                <th scope="col">Total Cost</th>
                <th scope="col">Requests</th>
              </tr>
            </thead>
            <tbody>
              <% @tpc_utilization.each do |tpc| %>
                <tr>
                  <td><strong class="tpc-number"><%= tpc[:tpc_code] %></strong></td>
                  <td><%= tpc[:tpc_name].presence || '-' %></td>
                  <td><%= tpc[:department].presence || '-' %></td>
                  <td><%= tpc[:owner] %></td>
                  <td>
                    <span class="currency-code"><%= Setting.plugin_redmine_purchase_requests['default_currency'] || 'USD' %></span>
                    <%= number_with_precision(tpc[:total_cost], precision: 2, delimiter: ',') %>
                  </td>
                  <td><%= tpc[:request_count] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="chart-hbar-container" id="tpc-cost-chart" style="margin-top: 20px;"></div>
      <% else %>
        <p class="no-data">No utilization data available</p>
      <% end %>
    </div>
  </div>

  <%# Monthly TPC Budget Expense Trend %>
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3>TPC Budget Expense Trend<%= @selected_year ? " (#{@selected_year})" : " (Last 12 Months)" %></h3>
    </div>
    <div class="dashboard-card-body">
      <div class="chart-line-container" id="monthly-budget-chart"></div>
      <div id="budget-legend" style="display:flex;flex-wrap:wrap;gap:12px;margin-top:12px;padding-top:12px;border-top:1px solid var(--pr-border);justify-content:center;"></div>
    </div>
  </div>

  <%# Monthly TPC Usage in Purchase Requests Trend %>
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3>TPC Usage in Purchase Requests<%= @selected_year ? " (#{@selected_year})" : " (Last 12 Months)" %></h3>
    </div>
    <div class="dashboard-card-body">
      <div class="chart-line-container" id="monthly-usage-chart"></div>
      <div id="usage-legend" style="display:flex;flex-wrap:wrap;gap:12px;margin-top:12px;padding-top:12px;border-top:1px solid var(--pr-border);justify-content:center;"></div>
    </div>
  </div>

</div>

<%= render 'reports/chart_colors' %>
<script>
// TPC Codes by Purchase Request - Bar Chart
<% if @tpc_by_purchase_request.any? %>
const prData = <%= raw @tpc_by_purchase_request.to_json %>;
const prContainer = document.getElementById('tpc-by-pr-chart');

if (prContainer) {
  const colors = [PR_TOKEN('--pr-violet'), PR_TOKEN('--pr-accent'), PR_TOKEN('--pr-success'), PR_TOKEN('--pr-warning'), PR_TOKEN('--pr-danger'), PR_TOKEN('--pr-info'), PR_TOKEN('--pr-violet-ink'), PR_TOKEN('--pr-success-ink'), PR_TOKEN('--pr-warning-ink'), PR_TOKEN('--pr-danger-ink')];
  const maxCount = Math.max(...prData.map(p => p.count));

  prData.forEach((item, index) => {
    const bar = document.createElement('div');
    bar.style.cssText = 'display:flex;align-items:center;margin:10px 0;';

    const label = document.createElement('div');
    label.style.cssText = 'width:120px;font-size: var(--pr-text-xs);font-family:var(--pr-font-mono,monospace);color:var(--pr-violet);font-weight:bold;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
    label.textContent = item.name;
    label.title = item.name + (item.department ? ' (' + item.department + ')' : '');

    const barContainer = document.createElement('div');
    barContainer.style.cssText = 'flex:1;background:var(--pr-surface-sunken);height:30px;border-radius:4px;overflow:hidden;';

    const barFill = document.createElement('div');
    const percentage = (item.count / maxCount) * 100;
    barFill.style.cssText = `width:${percentage}%;background:${colors[index % colors.length]};height:100%;display:flex;align-items:center;padding:0 10px;color:#fff;font-weight:bold;font-size: var(--pr-text-sm);`;
    barFill.textContent = item.count + ' requests';

    barContainer.appendChild(barFill);
    bar.appendChild(label);
    bar.appendChild(barContainer);
    prContainer.appendChild(bar);
  });
}
<% end %>

// TPC Codes by Department - Bar Chart
<% if @tpc_by_department.any? %>
const departmentData = <%= raw @tpc_by_department.to_json %>;
const departmentContainer = document.getElementById('tpc-by-department-chart');

if (departmentContainer) {
  const deptEntries = Object.entries(departmentData).sort((a, b) => b[1] - a[1]).slice(0, 10);
  const maxDeptCount = Math.max(...deptEntries.map(e => e[1]));

  deptEntries.forEach(([dept, count], index) => {
    const bar = document.createElement('div');
    bar.style.cssText = 'display:flex;align-items:center;margin:10px 0;';

    const label = document.createElement('div');
    label.style.cssText = 'width:120px;font-size: var(--pr-text-xs);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
    label.textContent = dept;
    label.title = dept;

    const barContainer = document.createElement('div');
    barContainer.style.cssText = 'flex:1;background:var(--pr-surface-sunken);height:25px;border-radius:4px;overflow:hidden;';

    const barFill = document.createElement('div');
    const percentage = (count / maxDeptCount) * 100;
    barFill.style.cssText = `width:${percentage}%;background:var(--pr-violet);height:100%;display:flex;align-items:center;padding:0 8px;color:#fff;font-weight:bold;font-size: var(--pr-text-xs);`;
    barFill.textContent = count;

    barContainer.appendChild(barFill);
    bar.appendChild(label);
    bar.appendChild(barContainer);
    departmentContainer.appendChild(bar);
  });
}
<% end %>

// Top 10 TPC Codes by Cost - Bar Chart
<% if @tpc_utilization.any? %>
const utilizationData = <%= raw @tpc_utilization.to_json %>;
const costChartContainer = document.getElementById('tpc-cost-chart');

if (costChartContainer) {
  const maxCost = Math.max(...utilizationData.map(t => t.total_cost));

  utilizationData.forEach((tpc, index) => {
    const bar = document.createElement('div');
    bar.style.cssText = 'display:flex;align-items:center;margin:10px 0;';

    const label = document.createElement('div');
    label.style.cssText = 'width:150px;font-size: var(--pr-text-sm);font-family:var(--pr-font-mono,monospace);color:var(--pr-violet);font-weight:bold;';
    label.textContent = tpc.tpc_code;

    const barContainer = document.createElement('div');
    barContainer.style.cssText = 'flex:1;background:var(--pr-surface-sunken);height:30px;border-radius:4px;overflow:hidden;';

    const barFill = document.createElement('div');
    const percentage = maxCost > 0 ? (tpc.total_cost / maxCost) * 100 : 0;
    barFill.style.cssText = `width:${percentage}%;background:var(--pr-accent);height:100%;display:flex;align-items:center;padding:0 10px;color:#fff;font-weight:bold;font-size: var(--pr-text-sm);`;
    barFill.textContent = tpc.total_cost.toLocaleString();

    barContainer.appendChild(barFill);
    bar.appendChild(label);
    bar.appendChild(barContainer);
    costChartContainer.appendChild(bar);
  });
}
<% end %>

// Compute a "nice" axis maximum and step so the peak never touches the top
// gridline and tick labels are round numbers (e.g. 1900 -> max 2500 step 500).
function niceScale(dataMax, integerSteps) {
  if (!dataMax || dataMax <= 0) return { max: 5, step: 1 };
  const targetTicks = 5;
  let step = dataMax / targetTicks;
  const pow = Math.pow(10, Math.floor(Math.log10(step)));
  const fraction = step / pow;
  let niceFraction;
  if (fraction <= 1) niceFraction = 1;
  else if (fraction <= 2) niceFraction = 2;
  else if (fraction <= 2.5) niceFraction = 2.5;
  else if (fraction <= 5) niceFraction = 5;
  else niceFraction = 10;
  step = niceFraction * pow;
  if (integerSteps) step = Math.max(1, Math.ceil(step));
  let max = step * targetTicks;
  if (max <= dataMax) max += step; // guarantee headroom above the peak
  return { max: max, step: step };
}

// Function to create single line chart with Y-axis labels
function createLineChart(containerId, data, color, valueKey = 'count', isCurrency = false) {
  const container = document.getElementById(containerId);
  if (!container || !data || data.length === 0) return;

  const maxCount = Math.max(...data.map(m => m[valueKey] || 0)) || 1;
  const scale = niceScale(maxCount, !isCurrency);
  const chartMax = scale.max;
  const chartHeight = 250;
  const chartWidth = container.clientWidth || 400;
  const leftPadding = 70;
  const rightPadding = 20;
  const topPadding = 20;
  const bottomPadding = 30;
  const currency = '<%= Setting.plugin_redmine_purchase_requests["default_currency"] || "USD" %>';

  function formatYAxisValue(value, isCurr) {
    if (value >= 1000000) {
      return (isCurr ? currency + ' ' : '') + (value / 1000000).toFixed(1) + 'M';
    } else if (value >= 1000) {
      return (isCurr ? currency + ' ' : '') + (value / 1000).toFixed(1) + 'K';
    }
    return (isCurr ? currency + ' ' : '') + value.toLocaleString();
  }

  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('width', chartWidth);
  svg.setAttribute('height', chartHeight);
  svg.style.cssText = 'overflow:visible;';

  const chartAreaWidth = chartWidth - leftPadding - rightPadding;
  const chartAreaHeight = chartHeight - topPadding - bottomPadding;

  const tickCount = Math.round(chartMax / scale.step);
  for (let i = 0; i <= tickCount; i++) {
    const y = topPadding + chartAreaHeight * i / tickCount;
    const yValue = scale.step * (tickCount - i);

    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', leftPadding);
    line.setAttribute('y1', y);
    line.setAttribute('x2', chartWidth - rightPadding);
    line.setAttribute('y2', y);
    line.setAttribute('stroke', PR_TOKEN('--pr-border'));
    line.setAttribute('stroke-width', '1');
    svg.appendChild(line);

    const yLabel = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    yLabel.setAttribute('x', leftPadding - 8);
    yLabel.setAttribute('y', y + 4);
    yLabel.setAttribute('text-anchor', 'end');
    yLabel.setAttribute('font-size', '10');
    yLabel.setAttribute('fill', PR_TOKEN('--pr-ink-muted'));
    yLabel.textContent = formatYAxisValue(yValue, isCurrency);
    svg.appendChild(yLabel);
  }

  const yAxis = document.createElementNS('http://www.w3.org/2000/svg', 'line');
  yAxis.setAttribute('x1', leftPadding);
  yAxis.setAttribute('y1', topPadding);
  yAxis.setAttribute('x2', leftPadding);
  yAxis.setAttribute('y2', chartHeight - bottomPadding);
  yAxis.setAttribute('stroke', PR_TOKEN('--pr-border-strong'));
  yAxis.setAttribute('stroke-width', '1');
  svg.appendChild(yAxis);

  const xAxis = document.createElementNS('http://www.w3.org/2000/svg', 'line');
  xAxis.setAttribute('x1', leftPadding);
  xAxis.setAttribute('y1', chartHeight - bottomPadding);
  xAxis.setAttribute('x2', chartWidth - rightPadding);
  xAxis.setAttribute('y2', chartHeight - bottomPadding);
  xAxis.setAttribute('stroke', PR_TOKEN('--pr-border-strong'));
  xAxis.setAttribute('stroke-width', '1');
  svg.appendChild(xAxis);

  const points = data.map((item, index) => {
    const x = leftPadding + chartAreaWidth * index / (data.length - 1 || 1);
    const y = topPadding + chartAreaHeight - (chartAreaHeight * (item[valueKey] || 0) / chartMax);
    return `${x},${y}`;
  }).join(' ');

  const polyline = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
  polyline.setAttribute('points', points);
  polyline.setAttribute('fill', 'none');
  polyline.setAttribute('stroke', color);
  polyline.setAttribute('stroke-width', '3');
  svg.appendChild(polyline);

  data.forEach((item, index) => {
    const x = leftPadding + chartAreaWidth * index / (data.length - 1 || 1);
    const y = topPadding + chartAreaHeight - (chartAreaHeight * (item[valueKey] || 0) / chartMax);

    const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    circle.setAttribute('cx', x);
    circle.setAttribute('cy', y);
    circle.setAttribute('r', '5');
    circle.setAttribute('fill', color);
    circle.setAttribute('stroke', '#fff');
    circle.setAttribute('stroke-width', '2');

    const title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
    const displayValue = isCurrency ? currency + ' ' + (item[valueKey] || 0).toLocaleString() : (item[valueKey] || 0);
    title.textContent = `${item.month}: ${displayValue}`;
    circle.appendChild(title);

    svg.appendChild(circle);

    if (index % Math.max(1, Math.ceil(data.length / 6)) === 0) {
      const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      text.setAttribute('x', x);
      text.setAttribute('y', chartHeight - 10);
      text.setAttribute('text-anchor', 'middle');
      text.setAttribute('font-size', '10');
      text.setAttribute('fill', PR_TOKEN('--pr-ink-muted'));
      text.textContent = item.month;
      svg.appendChild(text);
    }
  });

  container.appendChild(svg);
}

// Function to create multi-line chart with legend and Y-axis labels
function createMultiLineChart(containerId, legendContainerId, monthLabels, dataSeries, isCurrency = false) {
  const container = document.getElementById(containerId);
  const legendContainer = document.getElementById(legendContainerId);
  if (!container || !monthLabels || monthLabels.length === 0) return;

  const colors = [PR_TOKEN('--pr-violet'), PR_TOKEN('--pr-accent'), PR_TOKEN('--pr-success'), PR_TOKEN('--pr-warning'), PR_TOKEN('--pr-danger'), PR_TOKEN('--pr-info')];
  const chartHeight = 250;
  const chartWidth = container.clientWidth || 400;
  const leftPadding = 70;
  const rightPadding = 20;
  const topPadding = 20;
  const bottomPadding = 30;
  const currency = '<%= Setting.plugin_redmine_purchase_requests["default_currency"] || "USD" %>';

  let maxCount = 1;
  Object.values(dataSeries).forEach(values => {
    const seriesMax = Math.max(...values);
    if (seriesMax > maxCount) maxCount = seriesMax;
  });
  const scale = niceScale(maxCount, !isCurrency);
  const chartMax = scale.max;

  function formatYAxisValue(value, isCurr) {
    if (value >= 1000000) {
      return (isCurr ? currency + ' ' : '') + (value / 1000000).toFixed(1) + 'M';
    } else if (value >= 1000) {
      return (isCurr ? currency + ' ' : '') + (value / 1000).toFixed(1) + 'K';
    }
    return (isCurr ? currency + ' ' : '') + value.toLocaleString();
  }

  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('width', chartWidth);
  svg.setAttribute('height', chartHeight);
  svg.style.cssText = 'overflow:visible;';

  const chartAreaWidth = chartWidth - leftPadding - rightPadding;
  const chartAreaHeight = chartHeight - topPadding - bottomPadding;

  const tickCount = Math.round(chartMax / scale.step);
  for (let i = 0; i <= tickCount; i++) {
    const y = topPadding + chartAreaHeight * i / tickCount;
    const yValue = scale.step * (tickCount - i);

    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', leftPadding);
    line.setAttribute('y1', y);
    line.setAttribute('x2', chartWidth - rightPadding);
    line.setAttribute('y2', y);
    line.setAttribute('stroke', PR_TOKEN('--pr-border'));
    line.setAttribute('stroke-width', '1');
    svg.appendChild(line);

    const yLabel = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    yLabel.setAttribute('x', leftPadding - 8);
    yLabel.setAttribute('y', y + 4);
    yLabel.setAttribute('text-anchor', 'end');
    yLabel.setAttribute('font-size', '10');
    yLabel.setAttribute('fill', PR_TOKEN('--pr-ink-muted'));
    yLabel.textContent = formatYAxisValue(yValue, isCurrency);
    svg.appendChild(yLabel);
  }

  const yAxis = document.createElementNS('http://www.w3.org/2000/svg', 'line');
  yAxis.setAttribute('x1', leftPadding);
  yAxis.setAttribute('y1', topPadding);
  yAxis.setAttribute('x2', leftPadding);
  yAxis.setAttribute('y2', chartHeight - bottomPadding);
  yAxis.setAttribute('stroke', PR_TOKEN('--pr-border-strong'));
  yAxis.setAttribute('stroke-width', '1');
  svg.appendChild(yAxis);

  const xAxis = document.createElementNS('http://www.w3.org/2000/svg', 'line');
  xAxis.setAttribute('x1', leftPadding);
  xAxis.setAttribute('y1', chartHeight - bottomPadding);
  xAxis.setAttribute('x2', chartWidth - rightPadding);
  xAxis.setAttribute('y2', chartHeight - bottomPadding);
  xAxis.setAttribute('stroke', PR_TOKEN('--pr-border-strong'));
  xAxis.setAttribute('stroke-width', '1');
  svg.appendChild(xAxis);

  let colorIndex = 0;
  Object.entries(dataSeries).forEach(([tpcCode, values]) => {
    const color = colors[colorIndex % colors.length];

    const points = values.map((value, index) => {
      const x = leftPadding + chartAreaWidth * index / (values.length - 1 || 1);
      const y = topPadding + chartAreaHeight - (chartAreaHeight * value / chartMax);
      return `${x},${y}`;
    }).join(' ');

    const polyline = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
    polyline.setAttribute('points', points);
    polyline.setAttribute('fill', 'none');
    polyline.setAttribute('stroke', color);
    polyline.setAttribute('stroke-width', '2');
    svg.appendChild(polyline);

    values.forEach((value, index) => {
      const x = leftPadding + chartAreaWidth * index / (values.length - 1 || 1);
      const y = topPadding + chartAreaHeight - (chartAreaHeight * value / chartMax);

      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      circle.setAttribute('cx', x);
      circle.setAttribute('cy', y);
      circle.setAttribute('r', '4');
      circle.setAttribute('fill', color);
      circle.setAttribute('stroke', '#fff');
      circle.setAttribute('stroke-width', '1');

      const title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
      const displayValue = isCurrency ? currency + ' ' + value.toLocaleString() : value;
      title.textContent = `${tpcCode} - ${monthLabels[index]}: ${displayValue}`;
      circle.appendChild(title);

      svg.appendChild(circle);
    });

    if (legendContainer) {
      const legendItem = document.createElement('div');
      legendItem.className = 'legend-item';
      const colorSpan = document.createElement('span');
      colorSpan.className = 'legend-color';
      colorSpan.style.backgroundColor = color;
      const labelSpan = document.createElement('span');
      labelSpan.className = 'legend-label';
      labelSpan.textContent = tpcCode;
      legendItem.appendChild(colorSpan);
      legendItem.appendChild(labelSpan);
      legendContainer.appendChild(legendItem);
    }

    colorIndex++;
  });

  monthLabels.forEach((month, index) => {
    if (index % Math.max(1, Math.ceil(monthLabels.length / 6)) === 0) {
      const x = leftPadding + chartAreaWidth * index / (monthLabels.length - 1 || 1);
      const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      text.setAttribute('x', x);
      text.setAttribute('y', chartHeight - 10);
      text.setAttribute('text-anchor', 'middle');
      text.setAttribute('font-size', '10');
      text.setAttribute('fill', PR_TOKEN('--pr-ink-muted'));
      text.textContent = month;
      svg.appendChild(text);
    }
  });

  container.appendChild(svg);
}

// Monthly TPC Budget Expense Trend - Multi-Line Chart by TPC Code
const budgetData = <%= raw @monthly_tpc_budget.to_json %>;
const budgetByCode = <%= raw @monthly_tpc_budget_by_code.to_json %>;
const budgetMonthLabels = budgetData.map(m => m.month);

if (Object.keys(budgetByCode).length > 0) {
  createMultiLineChart('monthly-budget-chart', 'budget-legend', budgetMonthLabels, budgetByCode, true);
} else {
  createLineChart('monthly-budget-chart', budgetData, PR_TOKEN('--pr-violet'), 'total', true);
  const budgetLegendContainer = document.getElementById('budget-legend');
  if (budgetLegendContainer) {
    const li = document.createElement('div');
    li.className = 'legend-item';
    const cs = document.createElement('span');
    cs.className = 'legend-color';
    cs.style.backgroundColor = PR_TOKEN('--pr-violet');
    const ls = document.createElement('span');
    ls.className = 'legend-label';
    ls.textContent = 'Total Budget';
    li.appendChild(cs);
    li.appendChild(ls);
    budgetLegendContainer.appendChild(li);
  }
}

// Monthly TPC Usage in Purchase Requests - Multi-Line Chart by TPC Code
const usageData = <%= raw @monthly_tpc_usage.to_json %>;
const usageByCode = <%= raw @monthly_tpc_usage_by_code.to_json %>;
const usageMonthLabels = usageData.map(m => m.month);

if (Object.keys(usageByCode).length > 0) {
  createMultiLineChart('monthly-usage-chart', 'usage-legend', usageMonthLabels, usageByCode, false);
} else {
  createLineChart('monthly-usage-chart', usageData, PR_TOKEN('--pr-accent'), 'total');
  const usageLegendContainer = document.getElementById('usage-legend');
  if (usageLegendContainer) {
    const li = document.createElement('div');
    li.className = 'legend-item';
    const cs = document.createElement('span');
    cs.className = 'legend-color';
    cs.style.backgroundColor = PR_TOKEN('--pr-accent');
    const ls = document.createElement('span');
    ls.className = 'legend-label';
    ls.textContent = 'Total TPC Usage';
    li.appendChild(cs);
    li.appendChild(ls);
    usageLegendContainer.appendChild(li);
  }
}
</script>
