<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title "TPC Code: #{@tpc_code.tpc_number}" %>

<div class="contextual">
  <%= link_to (@project ? project_tpc_codes_path(@project) : global_tpc_codes_path),
              class: 'pr-button pr-button-cancel pr-button-icon small' do %>
    <span class="icon icon-cancel">Back to TPC Codes</span>
  <% end %>

  <% can_edit = @project ? User.current.allowed_to?(:manage_tpc_codes, @project) : User.current.admin? %>
  <% if can_edit && (@project || @tpc_code.global?) %>
    <%= link_to (@project ? edit_project_tpc_code_path(@project, @tpc_code) : edit_global_tpc_code_path(@tpc_code)),
                class: 'pr-button pr-button-secondary pr-button-icon' do %>
      <span class="icon icon-edit">Edit</span>
    <% end %>

    <% if @tpc_code.can_be_deleted? %>
      <%= link_to (@project ? project_tpc_code_path(@project, @tpc_code) : global_tpc_code_path(@tpc_code)),
                  method: :delete,
                  data: { confirm: 'Are you sure you want to delete this TPC code?' },
                  class: 'pr-button pr-button-danger pr-button-icon' do %>
        <span class="icon icon-del">Delete</span>
      <% end %>
    <% end %>
  <% end %>
</div>

<h2>
  <span class="tpc-number"><%= @tpc_code.tpc_number %></span>
</h2>

<div class="pr-form-container">
  <div class="pr-form-box">
    <div class="pr-form-content">

      <%# ── Summary stat tiles ────────────────────────────────────────────── %>
      <div class="summary-stats">
        <div class="stat-box pr-stat--violet">
          <div class="stat-number tpc-number"><%= @tpc_code.tpc_number %></div>
          <div class="stat-label">TPC Number</div>
        </div>

        <div class="stat-box <%= @tpc_code.is_active? ? 'pr-stat--success' : 'pr-stat--warning' %>">
          <div class="stat-number">
            <span class="pr-badge <%= @tpc_code.is_active? ? 'pr-badge--success' : 'pr-badge--neutral' %>">
              <%= @tpc_code.status_display %>
            </span>
          </div>
          <div class="stat-label">Status</div>
        </div>

        <div class="stat-box pr-stat--accent">
          <div class="stat-number">
            <span class="pr-badge <%= @tpc_code.global? ? 'pr-badge--violet' : 'pr-badge--neutral' %>">
              <%= @tpc_code.scope_display %>
            </span>
          </div>
          <div class="stat-label">Scope</div>
        </div>

        <div class="stat-box pr-stat--info">
          <div class="stat-number"><%= @tpc_code.linked_capex_count %></div>
          <div class="stat-label">Linked CAPEX</div>
        </div>
      </div>

      <%# ── Two-column detail grid ─────────────────────────────────────────── %>
      <div class="dashboard-container pr-grid--narrow">

        <%# Left card: TPC Code Information %>
        <div class="dashboard-card">
          <div class="dashboard-card-header">
            <h3>TPC Code Information</h3>
          </div>
          <div class="dashboard-card-body">
            <div class="tpc-code-details-display">
              <div class="tpc-main-info">
                <strong class="tpc-number"><%= @tpc_code.tpc_number %></strong>
              </div>

              <div class="details-grid">
                <% if @tpc_code.tpc_name.present? %>
                  <div class="grid-row">
                    <span class="label">TPC Name:</span>
                    <span class="value"><%= @tpc_code.tpc_name %></span>
                  </div>
                <% end %>
                <div class="grid-row">
                  <span class="label">Owner Name:</span>
                  <span class="value"><%= @tpc_code.tpc_owner_name %></span>
                </div>
                <% if @tpc_code.department.present? %>
                  <div class="grid-row">
                    <span class="label">Department:</span>
                    <span class="value"><%= @tpc_code.department.display_name %></span>
                  </div>
                <% end %>
                <div class="grid-row">
                  <span class="label">Email:</span>
                  <span class="value"><%= mail_to @tpc_code.tpc_email, @tpc_code.tpc_email, encode: 'hex' %></span>
                </div>
                <div class="grid-row">
                  <span class="label">Status:</span>
                  <span class="value">
                    <span class="pr-badge <%= @tpc_code.is_active? ? 'pr-badge--success' : 'pr-badge--neutral' %>">
                      <%= @tpc_code.status_display %>
                    </span>
                  </span>
                </div>
                <div class="grid-row">
                  <span class="label">Scope:</span>
                  <span class="value">
                    <span class="pr-badge <%= @tpc_code.global? ? 'pr-badge--violet' : 'pr-badge--neutral' %>">
                      <%= @tpc_code.scope_display %>
                    </span>
                  </span>
                </div>
                <% if @tpc_code.description.present? %>
                  <div class="grid-row">
                    <span class="label">Description:</span>
                    <span class="value"><%= simple_format(@tpc_code.description) %></span>
                  </div>
                <% end %>
                <% if @tpc_code.notes.present? %>
                  <div class="grid-row">
                    <span class="label">Notes:</span>
                    <span class="value"><%= simple_format(@tpc_code.notes) %></span>
                  </div>
                <% end %>
                <div class="grid-row">
                  <span class="label">Created:</span>
                  <span class="value"><%= format_time(@tpc_code.created_at) %></span>
                </div>
                <div class="grid-row">
                  <span class="label">Updated:</span>
                  <span class="value"><%= format_time(@tpc_code.updated_at) %></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%# Right card: Linked CAPEX %>
        <div class="dashboard-card">
          <div class="dashboard-card-header">
            <h3>Linked CAPEX Entries</h3>
          </div>
          <div class="dashboard-card-body">
            <% if @tpc_code.capex.any? %>
              <table class="dashboard-table">
                <thead>
                  <tr>
                    <th scope="col">TPC Code</th>
                    <th scope="col">Description</th>
                    <th scope="col">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <% @tpc_code.capex.limit(10).each do |capex| %>
                    <tr>
                      <td class="tpc-number"><strong><%= capex.tpc_code %></strong></td>
                      <td><%= capex.description %></td>
                      <td>
                        <span class="stat-currency"><%= capex.currency_symbol %></span><%= number_with_precision(capex.total_amount, precision: 2, delimiter: ',') %>
                        <span class="currency-code"><%= capex.currency %></span>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>

              <% if @tpc_code.capex.count > 10 %>
                <p class="no-data"><em>… and <%= @tpc_code.capex.count - 10 %> more CAPEX entries</em></p>
              <% end %>
            <% else %>
              <div class="pr-empty">
                <div class="pr-empty__icon">📂</div>
                <h3>No CAPEX Entries</h3>
                <p>No CAPEX entries are currently linked to this TPC code.</p>
                <% if @project && User.current.allowed_to?(:manage_capex, @project) %>
                  <p>
                    <%= link_to new_project_capex_path(@project, tpc_code_id: @tpc_code.id),
                                class: 'pr-button pr-button-primary pr-button-icon' do %>
                      <span class="icon icon-add"></span> Create CAPEX with this TPC Code
                    <% end %>
                  </p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

      </div><%# /.dashboard-container %>

      <div class="pr-form-actions">
        <% if can_edit && (@project || @tpc_code.global?) %>
          <%= link_to (@project ? edit_project_tpc_code_path(@project, @tpc_code) : edit_global_tpc_code_path(@tpc_code)),
                      class: 'pr-button pr-button-primary' do %>
            Edit TPC Code
          <% end %>
        <% end %>
        <%= link_to (@project ? project_tpc_codes_path(@project) : global_tpc_codes_path),
                    class: 'pr-button pr-button-cancel' do %>
          Back to TPC Codes
        <% end %>
      </div>

    </div>
  </div>
</div>
