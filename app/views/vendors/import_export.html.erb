<%# filepath: /opt/redmine/plugins/redmine_purchase_requests/app/views/vendors/import_export.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<div class="contextual">
  <%= link_to vendors_path, class: 'pr-button pr-button-cancel pr-button-icon small' do %>
    <span class="icon icon-cancel"><%= l(:button_back) %></span>
  <% end %>
</div>

<h2><%= l(:label_vendor_import_export) %></h2>

<div class="dashboard-container pr-grid--narrow">
  <!-- Export -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_export_vendors) %></h3>
    </div>
    <div class="dashboard-card-body">
      <p class="info"><%= l(:text_vendor_export_info) %></p>
      <div class="pr-form-actions left-aligned">
        <%= link_to export_vendors_path(format: :csv),
                    class: 'pr-button pr-button-primary pr-button-icon',
                    method: :get do %>
          <span class="icon icon-file"><%= l(:button_export_csv) %></span>
        <% end %>
        <%= link_to export_vendors_path(format: :json),
                    class: 'pr-button pr-button-secondary pr-button-icon',
                    method: :get do %>
          <span class="icon icon-file"><%= l(:button_export_json) %></span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Import -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3><%= l(:label_import_vendors) %></h3>
    </div>
    <div class="dashboard-card-body">
      <p class="info"><%= l(:text_vendor_import_info) %></p>

      <div class="pr-alert pr-alert-info">
        <span class="icon icon-info"></span>
        <div class="pr-alert-content">
          <h4>Import Requirements</h4>
          <ul>
            <li><%= l(:text_vendor_import_format) %></li>
            <li><%= l(:text_vendor_import_requirements) %></li>
          </ul>
        </div>
      </div>

      <%= form_with url: import_vendors_path, local: true, multipart: true, class: 'import-form' do |f| %>
        <div class="form-row">
          <%= f.file_field :file,
                          accept: '.csv,.json',
                          required: true,
                          class: 'attachments-field form-control' %>
        </div>

        <div class="pr-form-actions left-aligned">
          <%= f.submit l(:button_import_file), class: 'pr-button pr-button-primary' %>
          <%= link_to import_template_vendors_path(format: :csv),
                      class: 'pr-button pr-button-secondary pr-button-icon' do %>
            <span class="icon icon-download"><%= l(:button_download_template) %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
