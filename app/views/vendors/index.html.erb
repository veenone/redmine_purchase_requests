<%# filepath: app/views/vendors/index.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
  <%= javascript_include_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title "Global Vendor Management" %>

<div class="contextual">
  <%= link_to import_export_vendors_path, class: 'pr-button pr-button-secondary pr-button-icon' do %>
    <span class="icon icon-package">Import/Export</span>
  <% end %>

  <% if User.current.admin? || User.current.allowed_to?(:manage_vendors, nil, global: true) %>
    <%= link_to new_vendor_path, class: 'pr-button pr-button-primary pr-button-icon' do %>
      <span class="icon icon-add">New Vendor</span>
    <% end %>
  <% end %>
</div>

<h2>
  Global Vendor Management
  <span class="count">(<%= @vendors.count %>)</span>
</h2>

<div class="info-box">
  <p><strong>Global Vendor Management</strong></p>
  <p>Manage vendors globally across all projects. These vendors can be used by any project and are shared across the entire system.</p>
</div>

<fieldset class="pr-filters">
  <legend>Filters</legend>
  <%= form_with url: vendors_path, method: :get, local: true do |f| %>
    <div class="filter-row">
      <label for="search">Search:</label>
      <%= f.text_field :search, value: params[:search], placeholder: "Vendor name, email, phone, or contact person" %>

      <label for="active">Status:</label>
      <%= f.select :active, options_for_select([
            ['All', ''],
            ['Active Only', 'true'],
            ['Inactive Only', 'false']
          ], params[:active]), { include_blank: false } %>

      <%= f.submit 'Filter', class: 'pr-button pr-button-secondary small' %>
      <% if params[:search].present? || params[:active].present? %>
        <%= link_to 'Clear', vendors_path, class: 'pr-button pr-button-cancel small' %>
      <% end %>
    </div>
  <% end %>
</fieldset>

<% if @vendors.any? %>
  <div class="autoscroll">
    <table class="pr-table">
      <thead>
        <tr>
          <%= sort_header_tag('name', caption: 'Vendor Name') %>
          <%= sort_header_tag('vendor_id', caption: 'Vendor ID') %>
          <%= sort_header_tag('country', caption: 'Country') %>
          <%= sort_header_tag('email', caption: 'Email') %>
          <%= sort_header_tag('phone', caption: 'Phone') %>
          <%= sort_header_tag('contact_person', caption: 'Contact Person') %>
          <%= sort_header_tag('project_id', caption: 'Scope') %>
          <%= sort_header_tag('is_active', caption: 'Status') %>
          <th>Purchase Requests</th>
          <th class="buttons">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @vendors.each do |vendor| %>
          <tr class="<%= 'is-muted' unless vendor.is_active? %>">
            <td>
              <strong><%= vendor.name %></strong>
            </td>
            <td><%= vendor.vendor_id %></td>
            <td>
              <% if vendor.respond_to?(:country) && vendor.country.present? %>
                <%= vendor.country %>
              <% else %>
                <span class="no-data">--</span>
              <% end %>
            </td>
            <td>
              <% if vendor.email.present? %>
                <%= mail_to vendor.email, vendor.email, encode: 'hex' %>
              <% end %>
            </td>
            <td><%= vendor.phone %></td>
            <td><%= vendor.contact_person %></td>
            <td>
              <span class="pr-badge <%= vendor.global? ? 'pr-badge--accent' : 'pr-badge--warning' %>">
                <%= vendor.scope_display %>
              </span>
            </td>
            <td>
              <span class="pr-badge <%= vendor.is_active? ? 'pr-badge--success' : 'pr-badge--neutral' %>">
                <%= vendor.is_active? ? 'ACTIVE' : 'INACTIVE' %>
              </span>
            </td>
            <td>
              <% purchase_requests_count = vendor.purchase_requests.count %>
              <% if purchase_requests_count > 0 %>
                <span class="pr-badge pr-badge--info"><%= purchase_requests_count %></span>
              <% else %>
                <span class="no-data">0</span>
              <% end %>
            </td>
            <td class="buttons">
              <span class="pr-table-actions">
                <%= link_to vendor_path(vendor),
                            class: 'pr-button pr-button-secondary pr-button-icon small',
                            title: 'View vendor details' do %>
                  <span class="icon icon-magnifier"><%= l(:button_view) %></span>
                <% end %>

                <% if User.current.admin? || User.current.allowed_to?(:manage_vendors, nil, global: true) %>
                  <%= link_to edit_vendor_path(vendor),
                              class: 'pr-button pr-button-secondary pr-button-icon small',
                              title: 'Edit vendor' do %>
                    <span class="icon icon-edit"><%= l(:button_edit) %></span>
                  <% end %>

                  <% if vendor.purchase_requests.count == 0 %>
                    <%= link_to vendor_path(vendor),
                                method: :delete,
                                data: { confirm: 'Are you sure you want to delete this vendor?' },
                                class: 'pr-button pr-button-danger pr-button-icon small',
                                title: 'Delete vendor' do %>
                      <span class="icon icon-del"><%= l(:button_delete) %></span>
                    <% end %>
                  <% else %>
                    <span class="pr-button pr-button-secondary pr-button-icon small"
                          style="opacity:.45; cursor:not-allowed;"
                          title="Cannot delete vendor with associated purchase requests">
                      <span class="icon icon-del"><%= l(:button_delete) %></span>
                    </span>
                  <% end %>
                <% end %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

<% else %>
  <div class="pr-empty">
    <div class="pr-empty__icon">🏢</div>
    <% if params[:search].present? || params[:active].present? %>
      <h3>No Vendors Match Filters</h3>
      <p>No vendors match the current filters.</p>
      <p><%= link_to 'Show all vendors', vendors_path, class: 'pr-button pr-button-secondary' %></p>
    <% else %>
      <h3>No Vendors Yet</h3>
      <p>No vendors have been created yet.</p>
      <% if User.current.admin? || User.current.allowed_to?(:manage_vendors, nil, global: true) %>
        <p>
          <%= link_to new_vendor_path, class: 'pr-button pr-button-primary pr-button-icon' do %>
            <span class="icon icon-add">Create your first vendor</span>
          <% end %>
        </p>
      <% end %>
    <% end %>
  </div>
<% end %>
