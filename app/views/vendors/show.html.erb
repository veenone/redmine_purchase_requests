<%# filepath: app/views/vendors/show.html.erb %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'purchase_requests', plugin: 'redmine_purchase_requests' %>
<% end %>

<% html_title "#{l(:label_vendor)}: #{@vendor.name}" %>

<div class="contextual">
  <% if params[:project_id].present? %>
    <% project = Project.find_by(id: params[:project_id]) %>
    <% if project %>
      <%= link_to project_vendors_path(project), class: 'pr-button pr-button-cancel pr-button-icon' do %>
        <span class="icon icon-cancel"><%= l(:label_back_to_vendor_list) %> (<%= project.name %>)</span>
      <% end %>
    <% else %>
      <%= link_to vendors_path, class: 'pr-button pr-button-cancel pr-button-icon' do %>
        <span class="icon icon-cancel"><%= l(:label_back_to_vendor_list) %></span>
      <% end %>
    <% end %>
  <% else %>
    <%= link_to vendors_path, class: 'pr-button pr-button-cancel pr-button-icon' do %>
      <span class="icon icon-cancel"><%= l(:label_back_to_vendor_list) %></span>
    <% end %>
  <% end %>

  <% if params[:project_id].present? %>
    <%= link_to edit_vendor_path(@vendor, project_id: params[:project_id]), class: 'pr-button pr-button-primary pr-button-icon' do %>
      <span class="icon icon-edit"> <%= l(:button_edit) %></span>
    <% end %>
  <% else %>
    <%= link_to edit_vendor_path(@vendor), class: 'pr-button pr-button-primary pr-button-icon' do %>
      <span class="icon icon-edit"> <%= l(:button_edit) %></span>
    <% end %>
  <% end %>

  <% if params[:project_id].present? %>
    <%= link_to vendor_path(@vendor, project_id: params[:project_id]),
              method: :delete,
              data: { confirm: l(:text_are_you_sure) },
              class: 'pr-button pr-button-danger pr-button-icon' do %>
      <span class="icon icon-del"> <%= l(:button_delete) %></span>
    <% end %>
  <% else %>
    <%= link_to vendor_path(@vendor),
              method: :delete,
              data: { confirm: l(:text_are_you_sure) },
              class: 'pr-button pr-button-danger pr-button-icon' do %>
      <span class="icon icon-del"> <%= l(:button_delete) %></span>
    <% end %>
  <% end %>
</div>

<h2>
  <%= l(:label_vendor) %>: <%= @vendor.name %>
  <span class="<%= @vendor.is_active? ? 'status-active' : 'status-inactive' %>" style="font-size:.7em; font-weight:400;">
    (<%= @vendor.is_active? ? l(:label_active) : l(:label_inactive) %>)
  </span>
</h2>

<div class="splitcontent">
  <div class="splitcontentleft">

    <div class="dashboard-card" style="margin-bottom:18px;">
      <div class="dashboard-card-header">
        <h3><%= l(:label_vendor_information) %></h3>
      </div>
      <div class="dashboard-card-body">
        <div class="vendor-details">
          <table class="vendor-info-table">
            <tr>
              <td class="vendor-label"><%= l(:field_vendor_name) %></td>
              <td class="vendor-value"><strong><%= @vendor.name %></strong></td>
            </tr>
            <% if @vendor.vendor_id.present? %>
            <tr>
              <td class="vendor-label"><%= l(:field_vendor_id) %></td>
              <td class="vendor-value"><%= @vendor.vendor_id %></td>
            </tr>
            <% end %>
            <% if @vendor.email.present? %>
            <tr>
              <td class="vendor-label"><%= l(:field_email) %></td>
              <td class="vendor-value"><%= mail_to @vendor.email %></td>
            </tr>
            <% end %>
            <% if @vendor.phone.present? %>
            <tr>
              <td class="vendor-label"><%= l(:field_phone) %></td>
              <td class="vendor-value"><%= @vendor.phone %></td>
            </tr>
            <% end %>
            <% if @vendor.website.present? %>
            <tr>
              <td class="vendor-label"><%= l(:field_website) %></td>
              <td class="vendor-value"><%= link_to @vendor.website, @vendor.website, target: '_blank', rel: 'noopener noreferrer' %></td>
            </tr>
            <% end %>
            <% if @vendor.contact_person.present? %>
            <tr>
              <td class="vendor-label"><%= l(:field_contact_person) %></td>
              <td class="vendor-value"><%= @vendor.contact_person %></td>
            </tr>
            <% end %>
            <% if @vendor.address.present? %>
            <tr>
              <td class="vendor-label"><%= l(:field_address) %></td>
              <td class="vendor-value"><%= simple_format(@vendor.address) %></td>
            </tr>
            <% end %>
            <% if @vendor.respond_to?(:country) && @vendor.country.present? %>
            <tr>
              <td class="vendor-label"><%= l(:field_country) %></td>
              <td class="vendor-value"><%= @vendor.country %></td>
            </tr>
            <% end %>
            <tr>
              <td class="vendor-label"><%= l(:field_is_active) %></td>
              <td class="vendor-value">
                <span class="pr-badge <%= @vendor.is_active? ? 'pr-badge--success' : 'pr-badge--neutral' %>">
                  <%= @vendor.is_active? ? l(:label_active) : l(:label_inactive) %>
                </span>
              </td>
            </tr>
          </table>
        </div>

        <% if @vendor.notes.present? %>
          <div class="details-section" style="margin-top:16px;">
            <h4><%= l(:field_notes) %></h4>
            <div class="notes-content">
              <%= simple_format(@vendor.notes) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <div class="splitcontentright">

    <div class="dashboard-card" style="margin-bottom:18px;">
      <div class="dashboard-card-header">
        <h3><%= l(:label_associated_purchase_requests) %></h3>
      </div>
      <div class="dashboard-card-body">
        <% if @purchase_requests.any? %>
          <div class="autoscroll">
            <table class="pr-table">
              <thead>
                <tr>
                  <th scope="col"><%= l(:field_title) %></th>
                  <th scope="col"><%= l(:field_project) %></th>
                  <th scope="col"><%= l(:field_status) %></th>
                  <th scope="col"><%= l(:field_created_on) %></th>
                </tr>
              </thead>
              <tbody>
                <% @purchase_requests.each do |pr| %>
                  <tr>
                    <td><%= link_to pr.title, project_purchase_request_path(pr.project, pr) if pr.project %></td>
                    <td><%= link_to pr.project.name, project_path(pr.project) if pr.project %></td>
                    <td>
                      <span class="status-badge">
                        <%= pr.status.name if pr.status %>
                      </span>
                    </td>
                    <td><%= format_date(pr.created_at) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <% if @vendor.purchase_requests.count > 10 %>
            <p class="pagination-info">
              <%= l(:text_showing_x_of_y,
                    count: @purchase_requests.size,
                    total: @vendor.purchase_requests.count) %>
            </p>
          <% end %>
        <% else %>
          <p class="nodata"><%= l(:label_no_purchase_requests_for_vendor) %></p>
        <% end %>
      </div>
    </div>

    <div class="dashboard-card">
      <div class="dashboard-card-header">
        <h3><%= l(:label_vendor_statistics) %></h3>
      </div>
      <div class="dashboard-card-body">
        <ul class="vendor-stats">
          <li>
            <strong><%= l(:label_total_purchase_requests) %>:</strong>
            <%= @vendor.purchase_requests.count %>
          </li>
          <li>
            <strong><%= l(:label_vendor_member_since) %>:</strong>
            <%= format_date(@vendor.created_at) %>
          </li>
          <li>
            <strong><%= l(:label_last_updated) %>:</strong>
            <%= format_date(@vendor.updated_at) %>
          </li>
        </ul>
      </div>
    </div>

  </div>
</div>

<% content_for :sidebar do %>
  <h3><%= l(:label_vendor_actions) %></h3>
  <ul>
    <li>
      <% if params[:project_id].present? %>
        <%= link_to l(:button_edit), edit_vendor_path(@vendor, project_id: params[:project_id]) %>
      <% else %>
        <%= link_to l(:button_edit), edit_vendor_path(@vendor) %>
      <% end %>
    </li>
    <li>
      <% if params[:project_id].present? %>
        <% project = Project.find_by(id: params[:project_id]) %>
        <% if project %>
          <%= link_to l(:label_back_to_vendor_list), project_vendors_path(project) %>
        <% else %>
          <%= link_to l(:label_back_to_vendor_list), vendors_path %>
        <% end %>
      <% else %>
        <%= link_to l(:label_back_to_vendor_list), vendors_path %>
      <% end %>
    </li>
    <li><%= link_to l(:label_vendor_new), new_vendor_path %></li>
  </ul>

  <h3><%= l(:label_vendor_export) %></h3>
  <ul>
    <li><%= link_to l(:label_export_csv), export_vendors_path(format: :csv) %></li>
    <li><%= link_to l(:label_export_json), export_vendors_path(format: :json) %></li>
  </ul>
<% end %>
